---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const copyMap: Record<string, { label: string; text: string; accept: string; reject: string; policy: string }> = {
  tr: {
    label: 'Çerez tercihleri',
    text: 'Anonim sayfa sayımı ve sınırlı çerezsiz ölçüm izinsiz çalışabilir. Analitik çerezler ve oturum kayıtları yalnızca onayınızla açılır.',
    accept: 'Onayla',
    reject: 'Reddet',
    policy: 'Çerez politikası',
  },
  en: {
    label: 'Cookie preferences',
    text: 'Anonymous page counts and limited cookieless measurement may work without consent. Analytics cookies and session recordings require your approval.',
    accept: 'Accept',
    reject: 'Reject',
    policy: 'Cookie policy',
  },
  az: {
    label: 'Kuki seçimləri',
    text: 'Anonim səhifə sayımı və məhdud kukisiz ölçmə razılıq olmadan işləyə bilər. Analitik kukilər və sessiya yazıları yalnız razılığınızla aktivləşir.',
    accept: 'Qəbul et',
    reject: 'Rədd et',
    policy: 'Kuki siyasəti',
  },
};

const c = copyMap[lang] || copyMap.tr;
const policyUrl = lang === 'en' ? '/en/cookie-policy/' : lang === 'az' ? '/az/kuki-siyaseti/' : '/cerez-politikasi/';
---

<div
  class="qct-cookie-consent"
  data-cookie-consent
  role="region"
  aria-label={c.label}
  hidden
>
  <div class="qct-cookie-consent__content">
    <strong>{c.label}</strong>
    <p>{c.text} <a href={policyUrl}>{c.policy}</a></p>
  </div>

  <div class="qct-cookie-consent__actions">
    <button type="button" data-cookie-reject>{c.reject}</button>
    <button type="button" class="is-primary" data-cookie-accept>{c.accept}</button>
  </div>
</div>


<script>
  import { createAnalytics } from '../lib/analytics-stack';
  import { analyticsConfig } from '../lib/analytics-config';
  const analytics = createAnalytics(analyticsConfig);
  const w = window as any;
  w.qctTrackEvent = analytics.track;
  const key = 'qct-analytics-consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie-consent]');
  const show = (open: boolean) => { if (banner) banner.hidden = !open; };
  let saved: string | null = null;
  try { saved = localStorage.getItem(key); } catch {}
  let recording = false;
  try { recording = localStorage.getItem('qct-recording-consent-v1') === 'granted'; } catch {}
  analytics.setConsent({ analytics: saved === 'granted', recording });
  show(!['granted', 'denied'].includes(saved || '') || (saved === 'granted' && !!analyticsConfig.clarity && !recording));
  const choose = (state: string) => {
    try { localStorage.setItem(key, state); localStorage.setItem('qct-recording-consent-v1', state); } catch {}
    analytics.setConsent({ analytics: state === 'granted', recording: state === 'granted' });
    show(false);
  };
  document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => choose('granted'));
  document.querySelector('[data-cookie-reject]')?.addEventListener('click', () => choose('denied'));
  document.querySelectorAll('[data-cookie-settings]').forEach((button) => {
    button.addEventListener('click', () => {
      show(true);
      banner?.querySelector<HTMLButtonElement>('[data-cookie-reject]')?.focus();
    });
  });
</script>

<style>
  /* The banner is a compact, readable preference surface, not a full-screen modal.
     Keep consent behaviour in the script above; styles must never imply consent. */
  .qct-cookie-consent {
    position: fixed;
    z-index: 9998;
    inset: auto 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(14px, 2.5vw, 32px);
    width: 100%;
    margin: 0;
    padding: 13px clamp(16px, 3vw, 40px) max(13px, env(safe-area-inset-bottom));
    color: #f4f7ff;
    background: #0b172d;
    border: 0;
    border-top: 1px solid rgba(155, 192, 255, .27);
    border-radius: 0;
    box-shadow: 0 -12px 32px rgba(4, 15, 38, .22);
  }
  .qct-cookie-consent[hidden] { display: none; }
  .qct-cookie-consent__content {
    min-width: 0;
    display: grid;
    gap: 4px;
  }
  .qct-cookie-consent strong {
    color: #fff;
    font-size: 12.5px;
    line-height: 1.35;
    font-weight: 800;
  }
  .qct-cookie-consent p {
    max-width: 100ch;
    min-width: 0;
    margin: 0;
    color: #bdcce1;
    font-size: 12.5px;
    line-height: 1.45;
    overflow: visible;
    white-space: normal;
  }
  .qct-cookie-consent a {
    color: #c9e4ff;
    font-weight: 750;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .qct-cookie-consent__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(110px, 1fr));
    align-items: stretch;
    gap: 9px;
    flex: 0 0 auto;
  }
  .qct-cookie-consent button {
    min-height: 44px;
    padding: 8px 18px;
    font: inherit;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 800;
    cursor: pointer;
    color: #e6efff;
    background: #122540;
    border: 1px solid rgba(186, 207, 243, .4);
    border-radius: 8px;
    box-shadow: none;
  }
  .qct-cookie-consent button.is-primary {
    color: #fff;
    background: #1250d3;
    border-color: #3977f2;
  }
  .qct-cookie-consent button:hover {
    border-color: #b4d8ff;
  }
  .qct-cookie-consent button:focus-visible,
  .qct-cookie-consent a:focus-visible {
    outline: 3px solid #a5cbff;
    outline-offset: 3px;
  }
  @media (max-width: 720px) {
    .qct-cookie-consent {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 11px;
      padding: 11px 14px max(12px, env(safe-area-inset-bottom));
    }
    .qct-cookie-consent__content { gap: 3px; }
    .qct-cookie-consent strong { font-size: 12.5px; }
    .qct-cookie-consent p {
      font-size: 12px;
      line-height: 1.42;
    }
    .qct-cookie-consent__actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      gap: 8px;
    }
    .qct-cookie-consent button { min-height: 44px; padding: 8px 12px; }
  }
  @media (max-width: 340px) {
    .qct-cookie-consent { padding-inline: 10px; gap: 8px; }
    .qct-cookie-consent p { font-size: 11.5px; }
  }
</style>
