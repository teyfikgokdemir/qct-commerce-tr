---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const copyMap: Record<string, { label: string; text: string; accept: string; reject: string; policy: string }> = {
  tr: {
    label: 'Çerez tercihleri',
    text: 'Site kullanımını anlamak için isteğe bağlı analiz çerezleri kullanıyoruz. Analiz yalnızca onay verirseniz başlar.',
    accept: 'Onayla',
    reject: 'Reddet',
    policy: 'Çerez politikası',
  },
  en: {
    label: 'Cookie preferences',
    text: 'We use optional analytics cookies to understand site usage. Analytics starts only after your consent.',
    accept: 'Accept',
    reject: 'Reject',
    policy: 'Cookie policy',
  },
  ka: {
    label: 'ქუქიების პარამეტრები',
    text: 'ჩვენ ვიყენებთ არასავალდებულო ანალიტიკურ ქუქიებს საიტის გამოყენების გასაგებად. ანალიტიკა იწყება მხოლოდ თქვენი თანხმობის შემდეგ.',
    accept: 'დათანხმება',
    reject: 'უარყოფა',
    policy: 'ქუქიების პოლიტიკა',
  },
};

const c = copyMap[lang] || copyMap.tr;
const policyUrl = '/cerez-politikasi/';
---

<div
  class="qct-cookie-consent"
  data-cookie-consent
  role="region"
  aria-label={c.label}
  hidden
>
  <div>
    <strong>{c.label}</strong>
    <p>{c.text} <a href={policyUrl}>{c.policy}</a></p>
  </div>

  <div class="qct-cookie-consent__actions">
    <button type="button" data-cookie-reject>{c.reject}</button>
    <button type="button" class="is-primary" data-cookie-accept>{c.accept}</button>
  </div>
</div>

<script is:inline>
  (() => {
    const storageKey = 'qct-analytics-consent';
    const measurementId = 'G-ZGC820MP20';
    const banner = document.querySelector('[data-cookie-consent]');
    const accept = document.querySelector('[data-cookie-accept]');
    const reject = document.querySelector('[data-cookie-reject]');

    let analyticsLoaded = false;

    const loadAnalytics = () => {
      if (analyticsLoaded) return;
      analyticsLoaded = true;

      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };

      window.gtag('js', new Date());
      window.gtag('config', measurementId, { anonymize_ip: true });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(script);
    };

    window.addEventListener('load', () => {
      if (window.requestIdleCallback) {
        window.requestIdleCallback(loadAnalytics, { timeout: 2200 });
      } else {
        window.setTimeout(loadAnalytics, 1600);
      }
    });

    const closeBanner = () => {
      if (banner) banner.hidden = true;
    };

    const openBanner = () => {
      if (banner) banner.hidden = false;
    };

    const savedConsent = localStorage.getItem(storageKey);

    if (savedConsent === 'granted' || savedConsent === 'denied') {
      closeBanner();
    } else {
      openBanner();
    }

    accept?.addEventListener('click', () => {
      localStorage.setItem(storageKey, 'granted');
      loadAnalytics();
      closeBanner();
    });

    reject?.addEventListener('click', () => {
      localStorage.setItem(storageKey, 'denied');
      closeBanner();
    });
  })();
</script>

<style>
  .qct-cookie-consent {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 9999;
    display: grid;
    gap: 0.85rem;
    width: min(500px, calc(100vw - 2rem));
    padding: 0.95rem 1rem;
    color: #f8f5ef;
    background:
      linear-gradient(135deg, rgba(230, 107, 95, 0.24), transparent 52%),
      #1c181f;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-top: 2px solid #e66b5f;
    border-radius: 0.9rem;
    box-shadow:
      0 20px 56px rgba(23, 21, 26, 0.28),
      0 4px 12px rgba(23, 21, 26, 0.14);
    backdrop-filter: blur(16px);
  }

  .qct-cookie-consent[hidden] { display: none; }
  .qct-cookie-consent strong { display: block; margin-bottom: 0.25rem; color: #fff; font-size: 0.92rem; line-height: 1.3; }
  .qct-cookie-consent p { margin: 0; color: rgba(248, 245, 239, 0.72); font-size: 0.78rem; line-height: 1.5; }
  .qct-cookie-consent a { color: rgba(248, 245, 239, 0.92); text-decoration-color: rgba(231, 87, 87, 0.8); text-underline-offset: 3px; }
  .qct-cookie-consent__actions { display: flex; align-items: center; justify-content: flex-end; gap: 0.45rem; }
  .qct-cookie-consent button { min-height: 44px; padding: 0.55rem 0.82rem; font: inherit; font-size: 0.78rem; font-weight: 700; cursor: pointer; color: rgba(248, 245, 239, 0.82); background: transparent; border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 999px; transition: color 180ms ease, background 180ms ease, border-color 180ms ease, transform 180ms ease; }
  .qct-cookie-consent button:hover { color: #fff; border-color: rgba(255, 255, 255, 0.42); transform: translateY(-1px); }
  .qct-cookie-consent button.is-primary { color: #17151a; background: #e66b5f; border-color: #e66b5f; box-shadow: 0 8px 24px rgba(231, 87, 87, 0.22); }
  .qct-cookie-consent button.is-primary:hover { background: #f4a097; border-color: #f4a097; }
  .qct-cookie-consent button:focus-visible, .qct-cookie-consent a:focus-visible { outline: 3px solid rgba(231, 87, 87, 0.45); outline-offset: 3px; }

  @media (max-width: 760px) {
    .qct-cookie-consent { right: 0.65rem; bottom: 0.65rem; left: 0.65rem; width: auto; gap: 0.7rem; padding: 0.82rem; border-radius: 0.8rem; }
    .qct-cookie-consent p { font-size: 0.74rem; line-height: 1.45; }
    .qct-cookie-consent__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
    .qct-cookie-consent button { width: 100%; padding: 0.5rem 0.65rem; font-size: 0.74rem; }
  }

  @media (max-width: 390px) {
    .qct-cookie-consent strong { font-size: 0.86rem; }
    .qct-cookie-consent p { font-size: 0.7rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .qct-cookie-consent button { transition: none; }
  }
</style>
