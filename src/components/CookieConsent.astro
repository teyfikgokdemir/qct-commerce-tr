---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const copyMap: Record<string, { label: string; text: string; accept: string; reject: string; policy: string }> = {
  tr: {
    label: 'Çerez tercihleri',
    text: 'Site kullanımını anlamak için isteğe bağlı analiz çerezleri kullanıyoruz. Analiz yalnızca onay verirseniz başlar.',
    accept: 'Onayla',
    reject: 'Reddet',
    policy: 'Çerez politikası',
  },
  en: {
    label: 'Cookie preferences',
    text: 'We use optional analytics cookies to understand site usage. Analytics starts only after your consent.',
    accept: 'Accept',
    reject: 'Reject',
    policy: 'Cookie policy',
  },
  ka: {
    label: 'ქუქიების პარამეტრები',
    text: 'ჩვენ ვიყენებთ არასავალდებულო ანალიტიკურ ქუქიებს საიტის გამოყენების გასაგებად. ანალიტიკა იწყება მხოლოდ თქვენი თანხმობის შემდეგ.',
    accept: 'დათანხმება',
    reject: 'უარყოფა',
    policy: 'ქუქიების პოლიტიკა',
  },
};

const c = copyMap[lang] || copyMap.tr;
const policyUrl = '/cerez-politikasi/';
---

<div
  class="qct-cookie-consent"
  data-cookie-consent
  role="region"
  aria-label={c.label}
  hidden
>
  <div class="qct-cookie-consent__content">
    <div class="qct-cookie-consent__icon" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div>
      <div class="qct-cookie-consent__eyebrow">GİZLİLİK TERCİHİ</div>
      <strong>{c.label}</strong>
      <p>{c.text} <a href={policyUrl}>{c.policy}</a></p>
    </div>
  </div>

  <div class="qct-cookie-consent__actions">
    <button type="button" data-cookie-reject>{c.reject}</button>
    <button type="button" class="is-primary" data-cookie-accept>{c.accept}</button>
  </div>
</div>

<script is:inline>
  (() => {
    const storageKey = 'qct-analytics-consent';
    const measurementId = 'G-ZGC820MP20';
    const banner = document.querySelector('[data-cookie-consent]');
    const accept = document.querySelector('[data-cookie-accept]');
    const reject = document.querySelector('[data-cookie-reject]');

    let analyticsLoaded = false;

    const loadAnalytics = () => {
      if (analyticsLoaded) return;
      analyticsLoaded = true;

      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };

      window.gtag('js', new Date());
      window.gtag('config', measurementId, { anonymize_ip: true });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(script);
    };

    const closeBanner = () => {
      if (banner) banner.hidden = true;
    };

    const openBanner = () => {
      if (banner) banner.hidden = false;
    };

    window.addEventListener('load', () => {
      if (window.requestIdleCallback) {
        window.requestIdleCallback(loadAnalytics, { timeout: 2200 });
      } else {
        window.setTimeout(loadAnalytics, 1600);
      }
    });

    const savedConsent = localStorage.getItem(storageKey);

    if (savedConsent === 'granted' || savedConsent === 'denied') {
      closeBanner();
    } else {
      openBanner();
    }

    accept?.addEventListener('click', () => {
      localStorage.setItem(storageKey, 'granted');
      loadAnalytics();
      closeBanner();
    });

    reject?.addEventListener('click', () => {
      localStorage.setItem(storageKey, 'denied');
      closeBanner();
    });
  })();
</script>

<style>
  .qct-cookie-consent {
    position: fixed;
    left: 50%;
    bottom: .8rem;
    transform: translateX(-50%);
    z-index: 9998;
    width: min(1320px, calc(100vw - 2rem));
    min-height: 64px;
    padding: .55rem .7rem .55rem .8rem;
    color: #f7f1e9;
    background:
      radial-gradient(circle at 0% 50%, rgba(255,123,103,.07), transparent 22%),
      radial-gradient(circle at 100% 50%, rgba(200,255,61,.07), transparent 22%),
      #171614;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 16px;
    box-shadow: 0 16px 46px rgba(0,0,0,.22);
    backdrop-filter: blur(18px);
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    gap: .8rem;
    align-items: center;
  }

  .qct-cookie-consent::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 1px;
    background: linear-gradient(90deg, rgba(255,123,103,.34), rgba(255,255,255,.03) 50%, rgba(200,255,61,.34));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .qct-cookie-consent[hidden] { display: none; }

  .qct-cookie-consent__content {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: .65rem;
  }

  .qct-cookie-consent__icon {
    position: relative;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: #c8ff3d;
  }

  .qct-cookie-consent__icon::before {
    content: "";
    position: absolute;
    inset: 8px;
    border: 2px solid #171614;
    border-radius: 50%;
    border-right-color: transparent;
  }

  .qct-cookie-consent__icon span {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #171614;
  }

  .qct-cookie-consent__icon span:nth-child(1) { left: 9px; top: 15px; }
  .qct-cookie-consent__icon span:nth-child(2) { left: 16px; top: 9px; }
  .qct-cookie-consent__icon span:nth-child(3) { left: 17px; top: 21px; }

  .qct-cookie-consent__content > div:last-child {
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: .55rem;
    flex-wrap: nowrap;
  }

  .qct-cookie-consent__eyebrow {
    color: #ff7b67;
    font-size: .55rem;
    font-weight: 800;
    letter-spacing: .15em;
    white-space: nowrap;
  }

  .qct-cookie-consent strong {
    color: #fff;
    font-size: .83rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .qct-cookie-consent p {
    margin: 0;
    color: rgba(247,241,233,.68);
    font-size: .72rem;
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .qct-cookie-consent a {
    color: #f7f1e9;
    text-decoration-color: #ff7b67;
    text-underline-offset: 3px;
  }

  .qct-cookie-consent__actions {
    display: flex;
    align-items: center;
    gap: .4rem;
  }

  .qct-cookie-consent button {
    min-height: 38px;
    padding: .45rem .8rem;
    font: inherit;
    font-size: .72rem;
    font-weight: 800;
    cursor: pointer;
    color: rgba(247,241,233,.9);
    background: rgba(255,255,255,.045);
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 10px;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
    white-space: nowrap;
  }

  .qct-cookie-consent button:hover {
    transform: translateY(-1px);
    background: rgba(255,255,255,.075);
    border-color: rgba(255,255,255,.24);
  }

  .qct-cookie-consent button.is-primary {
    color: #171614;
    background: #c8ff3d;
    border-color: #c8ff3d;
  }

  .qct-cookie-consent button.is-primary:hover {
    background: #d7ff72;
    border-color: #d7ff72;
  }

  .qct-cookie-consent button:focus-visible,
  .qct-cookie-consent a:focus-visible {
    outline: 3px solid rgba(255,123,103,.45);
    outline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .qct-cookie-consent {
      width: min(900px, calc(100vw - 1.5rem));
      grid-template-columns: 1fr auto;
    }
    .qct-cookie-consent__content > div:last-child { flex-wrap: wrap; }
    .qct-cookie-consent p { white-space: normal; }
  }

  @media (max-width: 760px) {
    .qct-cookie-consent {
      left: .65rem;
      right: .65rem;
      bottom: .65rem;
      transform: none;
      width: auto;
      grid-template-columns: 1fr;
      padding: .8rem;
      gap: .65rem;
    }

    .qct-cookie-consent__content { align-items: flex-start; }
    .qct-cookie-consent__content > div:last-child { display: block; }
    .qct-cookie-consent__eyebrow { display:block; margin-bottom:.25rem; }
    .qct-cookie-consent strong { display:block; margin-bottom:.3rem; white-space:normal; }
    .qct-cookie-consent p { font-size:.72rem; white-space:normal; }
    .qct-cookie-consent__actions { display:grid; grid-template-columns:1fr 1fr; }
    .qct-cookie-consent button { width:100%; min-height:44px; }
  }

  @media (max-width: 390px) {
    .qct-cookie-consent__icon { display:none; }
    .qct-cookie-consent__content { display:block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .qct-cookie-consent button { transition:none; }
  }
</style>
