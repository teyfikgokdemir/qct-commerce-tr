---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const copyMap: Record<string, { label: string; text: string; accept: string; reject: string; policy: string }> = {
  tr: {
    label: 'Çerez tercihleri',
    text: 'Anonim sayım ve sınırlı çerezsiz ölçüm tercihinizden bağımsız çalışabilir. Analitik çerezler ve oturum kayıtları yalnızca onayla açılır.',
    accept: 'Onayla',
    reject: 'Reddet',
    policy: 'Çerez politikası',
  },
  en: {
    label: 'Cookie preferences',
    text: 'Anonymous counts and limited cookieless analytics may run regardless of your choice. Analytics cookies and session recording require consent.',
    accept: 'Accept',
    reject: 'Reject',
    policy: 'Cookie policy',
  },
  az: {
    label: 'Kuki seçimləri',
    text: 'Anonim sayım və məhdud kukisiz ölçmə seçiminizdən asılı olmadan işləyə bilər. Analitik kukilər və sessiya yazısı yalnız razılıqla aktivləşir.',
    accept: 'Qəbul et',
    reject: 'Rədd et',
    policy: 'Kuki siyasəti',
  },
};

const c = copyMap[lang] || copyMap.tr;
const policyUrl = lang === 'en' ? '/en/cookie-policy/' : lang === 'az' ? '/az/kuki-siyaseti/' : '/cerez-politikasi/';
---

<div
  class="qct-cookie-consent"
  data-cookie-consent
  role="region"
  aria-label={c.label}
  hidden
>
  <div class="qct-cookie-consent__content">
    <div class="qct-cookie-consent__heading">
      <strong>{c.label}</strong>
      <a href={policyUrl}>{c.policy}</a>
    </div>
    <p>{c.text}</p>
  </div>

  <div class="qct-cookie-consent__actions">
    <button type="button" data-cookie-reject>{c.reject}</button>
    <button type="button" class="is-primary" data-cookie-accept>{c.accept}</button>
  </div>
</div>


<script>
  import { createAnalytics } from '../lib/analytics-stack';
  import { analyticsConfig } from '../lib/analytics-config';
  const analytics = createAnalytics(analyticsConfig);
  const w = window as any;
  w.qctTrackEvent = analytics.track;
  const key = 'qct-analytics-consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie-consent]');
  const show = (open: boolean) => { if (banner) banner.hidden = !open; };
  let saved: string | null = null;
  try { saved = localStorage.getItem(key); } catch {}
  let recording = false;
  try { recording = localStorage.getItem('qct-recording-consent-v1') === 'granted'; } catch {}
  analytics.setConsent({ analytics: saved === 'granted', recording });
  show(!['granted', 'denied'].includes(saved || '') || (saved === 'granted' && !!analyticsConfig.clarity && !recording));
  const choose = (state: string) => {
    try { localStorage.setItem(key, state); localStorage.setItem('qct-recording-consent-v1', state); } catch {}
    analytics.setConsent({ analytics: state === 'granted', recording: state === 'granted' });
    show(false);
  };
  document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => choose('granted'));
  document.querySelector('[data-cookie-reject]')?.addEventListener('click', () => choose('denied'));
  document.querySelectorAll('[data-cookie-settings]').forEach((button) => {
    button.addEventListener('click', () => {
      show(true);
      banner?.querySelector<HTMLButtonElement>('[data-cookie-reject]')?.focus();
    });
  });
</script>

<style>
  /* Consent options remain visible and equally accessible. Text is never
     clipped; the short disclosure links to the full cookie policy. */
  .qct-cookie-consent {
    position: fixed;
    z-index: 9998;
    inset: auto 0 0;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 9px clamp(14px, 2.5vw, 34px) max(9px, env(safe-area-inset-bottom));
    margin: 0;
    color: #f0f8f5;
    background: #102029;
    border: 0;
    border-top: 1px solid rgba(137, 204, 185, .24);
    border-radius: 0;
    box-shadow: 0 -9px 32px rgba(7, 24, 32, .18);
    backdrop-filter: none;
  }
  .qct-cookie-consent[hidden] { display: none; }
  .qct-cookie-consent__content {
    display: flex;
    align-items: center;
    gap: 15px;
    min-width: 0;
  }
  .qct-cookie-consent__heading {
    display: flex;
    gap: 12px;
    align-items: baseline;
    flex: 0 0 auto;
  }
  .qct-cookie-consent strong {
    color: #f7faf8;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.3;
  }
  .qct-cookie-consent p {
    margin: 0;
    min-width: 0;
    color: #c4d7d1;
    font-size: 12px;
    font-weight: 450;
    line-height: 1.45;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }
  .qct-cookie-consent a {
    color: #a9e7d4;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 650;
    font-size: 12px;
  }
  .qct-cookie-consent__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(90px, auto));
    align-items: center;
    gap: 8px;
  }
  .qct-cookie-consent button {
    min-height: 44px;
    padding: 8px 17px;
    border: 1px solid rgba(187, 218, 209, .36);
    border-radius: 8px;
    background: #162a33;
    color: #f2f9f5;
    font: inherit;
    font-size: 13px;
    line-height: 1.25;
    font-weight: 750;
    cursor: pointer;
  }
  .qct-cookie-consent button.is-primary {
    background: #81ddc5;
    border-color: #81ddc5;
    color: #0e332b;
  }
  .qct-cookie-consent button:hover { border-color: #c7f4e5; }
  .qct-cookie-consent button:focus-visible,
  .qct-cookie-consent a:focus-visible {
    outline: 3px solid #d3fff0;
    outline-offset: 2px;
  }
  @media (max-width: 940px) {
    .qct-cookie-consent {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
    }
    .qct-cookie-consent__content {
      display: grid;
      gap: 4px;
    }
  }
  @media (max-width: 720px) {
    .qct-cookie-consent {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 9px;
      padding: 10px 14px max(12px, env(safe-area-inset-bottom));
    }
    .qct-cookie-consent__content { gap: 5px; }
    .qct-cookie-consent__heading {
      justify-content: space-between;
      gap: 10px;
    }
    .qct-cookie-consent p {
      font-size: 11.75px;
      line-height: 1.43;
    }
    .qct-cookie-consent__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
    }
    .qct-cookie-consent button {
      width: 100%;
      min-height: 44px;
      padding: 8px 12px;
    }
  }
  @media (max-width: 350px) {
    .qct-cookie-consent { gap: 7px; padding-inline: 10px; }
    .qct-cookie-consent p { font-size: 11.5px; }
  }
</style>
