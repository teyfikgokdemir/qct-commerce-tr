---
import { analyticsDisclosure } from "../lib/analytics-disclosure";
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const copyMap: Record<string, { label: string; text: string; accept: string; reject: string; policy: string }> = {
  tr: {
    label: 'Çerez tercihleri',
    text: 'Site kullanımını anlamak için ölçüm kullanıyoruz. İzin verilmediğinde analitik depolama kapalı kalır ve yalnızca çerezsiz ölçüm sinyalleri kullanılır.',
    accept: 'Onayla',
    reject: 'Reddet',
    policy: 'Çerez politikası',
  },
  en: {
    label: 'Cookie preferences',
    text: 'We use measurement to understand site usage. If consent is denied, analytics storage stays disabled and only cookieless measurement signals are used.',
    accept: 'Accept',
    reject: 'Reject',
    policy: 'Cookie policy',
  },
  ka: {
    label: 'ქუქიების პარამეტრები',
    text: 'ჩვენ ვიყენებთ არასავალდებულო ანალიტიკურ ქუქიებს საიტის გამოყენების გასაგებად. ანალიტიკა იწყება მხოლოდ თქვენი თანხმობის შემდეგ.',
    accept: 'დათანხმება',
    reject: 'უარყოფა',
    policy: 'ქუქიების პოლიტიკა',
  },
};

const c = copyMap[lang] || copyMap.tr;
const policyUrl = lang === 'en' ? '/en/cookie-policy/' : '/cerez-politikasi/';
---

<div
  class="qct-cookie-consent"
  data-cookie-consent
  role="region"
  aria-label={c.label}
  hidden
>
  <div class="qct-cookie-consent__content">
    <div class="qct-cookie-consent__icon" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div>
      <div class="qct-cookie-consent__eyebrow">{lang === 'en' ? 'PRIVACY PREFERENCES' : 'GİZLİLİK TERCİHİ'}</div>
      <strong>{c.label}</strong>
      <p>{c.text} {analyticsDisclosure[lang] || analyticsDisclosure.en} <a href={policyUrl}>{c.policy}</a></p>
    </div>
  </div>

  <div class="qct-cookie-consent__actions">
    <button type="button" data-cookie-reject>{c.reject}</button>
    <button type="button" class="is-primary" data-cookie-accept>{c.accept}</button>
  </div>
</div>

<button type="button" data-cookie-settings hidden style="position:fixed;bottom:8px;left:8px;z-index:9997">{c.label}</button>

<script>
  import { createAnalytics } from '../lib/analytics-stack';
  import { analyticsConfig } from '../lib/analytics-config';
  const analytics = createAnalytics(analyticsConfig);
  const w = window as any;
  w.qctTrackEvent = analytics.track;
  const key = 'qct-analytics-consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie-consent]');
  const settings = document.querySelector<HTMLElement>('[data-cookie-settings]');
  const show = (open: boolean) => { if (banner) banner.hidden = !open; if (settings) settings.hidden = open; };
  let saved: string | null = null;
  try { saved = localStorage.getItem(key); } catch {}
  let recording = false;
  try { recording = localStorage.getItem('qct-recording-consent-v1') === 'granted'; } catch {}
  analytics.setConsent({ analytics: saved === 'granted', recording });
  show(!['granted', 'denied'].includes(saved || '') || (saved === 'granted' && !!analyticsConfig.clarity && !recording));
  const choose = (state: string) => {
    try { localStorage.setItem(key, state); localStorage.setItem('qct-recording-consent-v1', state); } catch {}
    analytics.setConsent({ analytics: state === 'granted', recording: state === 'granted' });
    show(false);
  };
  document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => choose('granted'));
  document.querySelector('[data-cookie-reject]')?.addEventListener('click', () => choose('denied'));
  settings?.addEventListener('click', () => show(true));
</script>

<style>
  .qct-cookie-consent {
    position: fixed;
    left: 50%;
    bottom: .9rem;
    transform: translateX(-50%);
    z-index: 9998;
    width: min(1320px, calc(100vw - 2rem));
    min-height: 58px;
    padding: .48rem .56rem .48rem .7rem;
    color: #f6f0e8;
    background: rgba(22,21,19,.96);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 14px;
    box-shadow: 0 12px 34px rgba(0,0,0,.18);
    backdrop-filter: blur(16px);
    display: grid;
    grid-template-columns: minmax(0,1fr) auto;
    gap: .7rem;
    align-items: center;
  }

  .qct-cookie-consent::before {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,123,103,.48), rgba(200,255,61,.36), transparent);
    pointer-events: none;
  }

  .qct-cookie-consent[hidden] { display: none; }

  .qct-cookie-consent__content {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: .55rem;
  }

  .qct-cookie-consent__icon {
    position: relative;
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    background: #c8ff3d;
  }

  .qct-cookie-consent__icon::before {
    content: "";
    position: absolute;
    inset: 7px;
    border: 1.7px solid #171614;
    border-radius: 50%;
    border-right-color: transparent;
  }

  .qct-cookie-consent__icon span {
    position: absolute;
    width: 2.5px;
    height: 2.5px;
    border-radius: 50%;
    background: #171614;
  }

  .qct-cookie-consent__icon span:nth-child(1) { left: 8px; top: 13px; }
  .qct-cookie-consent__icon span:nth-child(2) { left: 13px; top: 8px; }
  .qct-cookie-consent__icon span:nth-child(3) { left: 14px; top: 17px; }

  .qct-cookie-consent__content > div:last-child {
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: .5rem;
    flex-wrap: nowrap;
  }

  .qct-cookie-consent__eyebrow {
    color: #ff8b78;
    font-size: .52rem;
    font-weight: 700;
    letter-spacing: .14em;
    white-space: nowrap;
    opacity: .9;
  }

  .qct-cookie-consent strong {
    color: #fff;
    font-size: .8rem;
    line-height: 1.2;
    font-weight: 750;
    white-space: nowrap;
  }

  .qct-cookie-consent p {
    margin: 0;
    color: rgba(246,240,232,.58);
    font-size: .69rem;
    line-height: 1.35;
    white-space: normal;
  }

  .qct-cookie-consent a {
    color: rgba(246,240,232,.9);
    text-decoration-color: rgba(255,139,120,.7);
    text-underline-offset: 3px;
  }

  .qct-cookie-consent__actions {
    display: flex;
    align-items: center;
    gap: .35rem;
  }

  .qct-cookie-consent button {
    min-height: 34px;
    padding: .38rem .72rem;
    font: inherit;
    font-size: .68rem;
    font-weight: 750;
    cursor: pointer;
    color: rgba(246,240,232,.82);
    background: transparent;
    border: 1px solid rgba(255,255,255,.11);
    border-radius: 9px;
    transition: transform 160ms ease, background 160ms ease, border-color 160ms ease;
    white-space: nowrap;
  }

  .qct-cookie-consent button:hover {
    transform: translateY(-1px);
    background: rgba(255,255,255,.05);
    border-color: rgba(255,255,255,.20);
  }

  .qct-cookie-consent button.is-primary {
    color: #171614;
    background: #d2ff59;
    border-color: #d2ff59;
    box-shadow: none;
  }

  .qct-cookie-consent button.is-primary:hover {
    background: #dcff78;
    border-color: #dcff78;
  }

  .qct-cookie-consent button:focus-visible,
  .qct-cookie-consent a:focus-visible {
    outline: 2px solid rgba(255,139,120,.48);
    outline-offset: 2px;
  }

  @media (max-width: 1100px) {
    .qct-cookie-consent {
      width: min(900px, calc(100vw - 1.5rem));
    }
    .qct-cookie-consent__content > div:last-child { flex-wrap: wrap; }
    .qct-cookie-consent p { white-space: normal; }
  }

  @media (max-width: 760px) {
    .qct-cookie-consent {
      left: .65rem;
      right: .65rem;
      bottom: .65rem;
      transform: none;
      width: auto;
      grid-template-columns: 1fr;
      padding: .72rem;
      gap: .55rem;
      border-radius: 14px;
    }

    .qct-cookie-consent__content { align-items: flex-start; }
    .qct-cookie-consent__content > div:last-child { display: block; }
    .qct-cookie-consent__eyebrow { display:block; margin-bottom:.2rem; }
    .qct-cookie-consent strong { display:block; margin-bottom:.25rem; white-space:normal; }
    .qct-cookie-consent p { font-size:.7rem; white-space:normal; }
    .qct-cookie-consent__actions { display:grid; grid-template-columns:1fr 1fr; }
    .qct-cookie-consent button { width:100%; min-height:42px; }
  }

  @media (max-width: 390px) {
    .qct-cookie-consent__icon { display:none; }
    .qct-cookie-consent__content { display:block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .qct-cookie-consent button { transition:none; }
  }
</style>
