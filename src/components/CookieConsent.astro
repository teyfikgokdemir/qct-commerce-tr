---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const copyMap: Record<string, { label: string; text: string; accept: string; reject: string; policy: string }> = {
  tr: {
    label: 'Çerez tercihleri',
    text: 'Site kullanımını anlamak için isteğe bağlı analiz çerezleri kullanıyoruz. Analiz yalnızca onay verirseniz başlar.',
    accept: 'Onayla',
    reject: 'Reddet',
    policy: 'Çerez politikası',
  },
  en: {
    label: 'Cookie preferences',
    text: 'We use optional analytics cookies to understand site usage. Analytics starts only after your consent.',
    accept: 'Accept',
    reject: 'Reject',
    policy: 'Cookie policy',
  },
  ka: {
    label: 'ქუქიების პარამეტრები',
    text: 'ჩვენ ვიყენებთ არასავალდებულო ანალიტიკურ ქუქიებს საიტის გამოყენების გასაგებად. ანალიტიკა იწყება მხოლოდ თქვენი თანხმობის შემდეგ.',
    accept: 'დათანხმება',
    reject: 'უარყოფა',
    policy: 'ქუქიების პოლიტიკა',
  },
};

const c = copyMap[lang] || copyMap.tr;
const policyUrl = '/cerez-politikasi/';
---

<div
  class="qct-cookie-consent"
  data-cookie-consent
  role="region"
  aria-label={c.label}
  hidden
>
  <div class="qct-cookie-consent__content">
    <div class="qct-cookie-consent__icon" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div>
      <div class="qct-cookie-consent__eyebrow">GİZLİLİK TERCİHİ</div>
      <strong>{c.label}</strong>
      <p>{c.text} <a href={policyUrl}>{c.policy}</a></p>
    </div>
  </div>

  <div class="qct-cookie-consent__actions">
    <button type="button" data-cookie-reject>{c.reject}</button>
    <button type="button" class="is-primary" data-cookie-accept>{c.accept}</button>
  </div>
</div>

<script is:inline>
  (() => {
    const storageKey = 'qct-analytics-consent';
    const measurementId = 'G-ZGC820MP20';
    const banner = document.querySelector('[data-cookie-consent]');
    const accept = document.querySelector('[data-cookie-accept]');
    const reject = document.querySelector('[data-cookie-reject]');

    let analyticsLoaded = false;

    const loadAnalytics = () => {
      if (analyticsLoaded) return;
      analyticsLoaded = true;

      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };

      window.gtag('js', new Date());
      window.gtag('config', measurementId, { anonymize_ip: true });

      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(script);
    };

    const closeBanner = () => {
      if (banner) banner.hidden = true;
    };

    const openBanner = () => {
      if (banner) banner.hidden = false;
    };

    window.addEventListener('load', () => {
      if (window.requestIdleCallback) {
        window.requestIdleCallback(loadAnalytics, { timeout: 2200 });
      } else {
        window.setTimeout(loadAnalytics, 1600);
      }
    });

    const savedConsent = localStorage.getItem(storageKey);

    if (savedConsent === 'granted' || savedConsent === 'denied') {
      closeBanner();
    } else {
      openBanner();
    }

    accept?.addEventListener('click', () => {
      localStorage.setItem(storageKey, 'granted');
      loadAnalytics();
      closeBanner();
    });

    reject?.addEventListener('click', () => {
      localStorage.setItem(storageKey, 'denied');
      closeBanner();
    });
  })();
</script>

<style>
  .qct-cookie-consent {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 9998;
    width: min(560px, calc(100vw - 2.5rem));
    padding: 1.15rem;
    color: #f7f1e9;
    background:
      radial-gradient(circle at 92% 16%, rgba(200,255,61,.08), transparent 28%),
      radial-gradient(circle at 8% 100%, rgba(255,123,103,.08), transparent 34%),
      #171614;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 24px;
    box-shadow: 0 24px 70px rgba(0,0,0,.28);
    backdrop-filter: blur(18px);
    display: grid;
    gap: 1rem;
    overflow: hidden;
  }

  .qct-cookie-consent::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 24px;
    padding: 1px;
    background: linear-gradient(135deg, rgba(200,255,61,.46), rgba(255,123,103,.32), rgba(255,255,255,.04));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .qct-cookie-consent[hidden] { display: none; }

  .qct-cookie-consent__content {
    display: grid;
    grid-template-columns: 46px 1fr;
    gap: .9rem;
    align-items: start;
  }

  .qct-cookie-consent__icon {
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: #c8ff3d;
    box-shadow: 0 0 0 5px rgba(200,255,61,.06);
  }

  .qct-cookie-consent__icon::before {
    content: "";
    position: absolute;
    inset: 11px;
    border: 2px solid #171614;
    border-radius: 50%;
    border-right-color: transparent;
  }

  .qct-cookie-consent__icon span {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #171614;
  }

  .qct-cookie-consent__icon span:nth-child(1) { left: 13px; top: 20px; }
  .qct-cookie-consent__icon span:nth-child(2) { left: 22px; top: 13px; }
  .qct-cookie-consent__icon span:nth-child(3) { left: 23px; top: 27px; }

  .qct-cookie-consent__eyebrow {
    margin: .1rem 0 .35rem;
    color: #ff7b67;
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .18em;
  }

  .qct-cookie-consent strong {
    display: block;
    margin: 0 0 .4rem;
    color: #fff;
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: -.015em;
  }

  .qct-cookie-consent p {
    margin: 0;
    color: rgba(247,241,233,.68);
    font-size: .8rem;
    line-height: 1.55;
  }

  .qct-cookie-consent a {
    color: #f7f1e9;
    text-decoration-color: #ff7b67;
    text-underline-offset: 4px;
  }

  .qct-cookie-consent__actions {
    display: grid;
    grid-template-columns: 1fr 1.18fr;
    gap: .6rem;
    padding-top: .2rem;
  }

  .qct-cookie-consent button {
    min-height: 48px;
    padding: .65rem .9rem;
    font: inherit;
    font-size: .8rem;
    font-weight: 800;
    cursor: pointer;
    color: rgba(247,241,233,.9);
    background: rgba(255,255,255,.045);
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 14px;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .qct-cookie-consent button:hover {
    transform: translateY(-1px);
    background: rgba(255,255,255,.075);
    border-color: rgba(255,255,255,.24);
  }

  .qct-cookie-consent button.is-primary {
    color: #171614;
    background: #c8ff3d;
    border-color: #c8ff3d;
    box-shadow: 0 10px 24px rgba(200,255,61,.10);
  }

  .qct-cookie-consent button.is-primary:hover {
    background: #d7ff72;
    border-color: #d7ff72;
  }

  .qct-cookie-consent button:focus-visible,
  .qct-cookie-consent a:focus-visible {
    outline: 3px solid rgba(255,123,103,.45);
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .qct-cookie-consent {
      right: .75rem;
      bottom: .75rem;
      left: .75rem;
      width: auto;
      padding: 1rem;
      border-radius: 20px;
    }

    .qct-cookie-consent::before { border-radius: 20px; }

    .qct-cookie-consent__content {
      grid-template-columns: 40px 1fr;
      gap: .75rem;
    }

    .qct-cookie-consent__icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
    }

    .qct-cookie-consent__icon::before { inset: 9px; }
    .qct-cookie-consent__icon span:nth-child(1) { left: 11px; top: 18px; }
    .qct-cookie-consent__icon span:nth-child(2) { left: 19px; top: 11px; }
    .qct-cookie-consent__icon span:nth-child(3) { left: 20px; top: 24px; }

    .qct-cookie-consent p { font-size: .76rem; }
    .qct-cookie-consent__actions { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 390px) {
    .qct-cookie-consent {
      right: .55rem;
      left: .55rem;
      bottom: .55rem;
      padding: .9rem;
    }

    .qct-cookie-consent__content { grid-template-columns: 1fr; }
    .qct-cookie-consent__icon { display: none; }
    .qct-cookie-consent strong { font-size: .95rem; }
    .qct-cookie-consent p { font-size: .72rem; }
    .qct-cookie-consent button { min-height: 46px; font-size: .76rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .qct-cookie-consent button { transition: none; }
  }
</style>
