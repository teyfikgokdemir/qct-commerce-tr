---
import { analyticsDisclosure } from "../lib/analytics-disclosure";
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const copyMap: Record<string, { label: string; text: string; accept: string; reject: string; policy: string }> = {
  tr: {
    label: 'Çerez tercihleri',
    text: 'Site kullanımını anlamak için ölçüm kullanıyoruz. İzin verilmediğinde analitik depolama kapalı kalır ve yalnızca çerezsiz ölçüm sinyalleri kullanılır.',
    accept: 'Onayla',
    reject: 'Reddet',
    policy: 'Çerez politikası',
  },
  en: {
    label: 'Cookie preferences',
    text: 'We use measurement to understand site usage. If consent is denied, analytics storage stays disabled and only cookieless measurement signals are used.',
    accept: 'Accept',
    reject: 'Reject',
    policy: 'Cookie policy',
  },
  az: {
    label: 'Kuki seçimləri',
    text: 'Saytdan istifadəni anlamaq üçün ölçmə vasitələrindən istifadə edirik. Razılıq verilmədikdə analitik yaddaş bağlı qalır və yalnız kukisiz ölçmə siqnalları davam edir.',
    accept: 'Qəbul et',
    reject: 'Rədd et',
    policy: 'Kuki siyasəti',
  },
};

const c = copyMap[lang] || copyMap.tr;
const policyUrl = lang === 'en' ? '/en/cookie-policy/' : lang === 'az' ? '/az/kuki-siyaseti/' : '/cerez-politikasi/';
---

<div
  class="qct-cookie-consent"
  data-cookie-consent
  role="region"
  aria-label={c.label}
  hidden
>
  <div class="qct-cookie-consent__content">
    <strong>{c.label}</strong>
    <p>{c.text} <a href={policyUrl}>{c.policy}</a></p>
  </div>

  <div class="qct-cookie-consent__actions">
    <button type="button" data-cookie-reject>{c.reject}</button>
    <button type="button" class="is-primary" data-cookie-accept>{c.accept}</button>
  </div>
</div>


<script>
  import { createAnalytics } from '../lib/analytics-stack';
  import { analyticsConfig } from '../lib/analytics-config';
  const analytics = createAnalytics(analyticsConfig);
  const w = window as any;
  w.qctTrackEvent = analytics.track;
  const key = 'qct-analytics-consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie-consent]');
  const show = (open: boolean) => { if (banner) banner.hidden = !open; };
  let saved: string | null = null;
  try { saved = localStorage.getItem(key); } catch {}
  let recording = false;
  try { recording = localStorage.getItem('qct-recording-consent-v1') === 'granted'; } catch {}
  const ANALYTICS_TEST_MODE = true;
  analytics.setConsent({ analytics: ANALYTICS_TEST_MODE ? true : saved === 'granted', recording: ANALYTICS_TEST_MODE ? true : recording });
  show(!['granted', 'denied'].includes(saved || '') || (saved === 'granted' && !!analyticsConfig.clarity && !recording));
  const choose = (state: string) => {
    try { localStorage.setItem(key, state); localStorage.setItem('qct-recording-consent-v1', state); } catch {}
    analytics.setConsent({ analytics: ANALYTICS_TEST_MODE ? true : state === 'granted', recording: ANALYTICS_TEST_MODE ? true : state === 'granted' });
    show(false);
  };
  document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => choose('granted'));
  document.querySelector('[data-cookie-reject]')?.addEventListener('click', () => choose('denied'));
  document.querySelectorAll('[data-cookie-settings]').forEach((button) => {
    button.addEventListener('click', () => {
      show(true);
      banner?.querySelector<HTMLButtonElement>('[data-cookie-reject]')?.focus();
    });
  });
</script>

<style>
  .qct-cookie-consent {
    position: fixed;
    z-index: 9998;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin: 0;
    padding: .48rem clamp(1rem,3vw,2rem);
    color: #f6f0e8;
    background: rgba(22,21,19,.98);
    border: 0;
    border-top: 1px solid rgba(255,255,255,.12);
    border-radius: 0;
    box-shadow: 0 -10px 30px rgba(0,0,0,.22);
    backdrop-filter: blur(14px);
  }
  .qct-cookie-consent[hidden] { display:none; }
  .qct-cookie-consent__content {
    min-width:0;
    display:flex;
    align-items:baseline;
    gap:.85rem;
    white-space:nowrap;
  }
  .qct-cookie-consent strong {
    flex:0 0 auto;
    color:#fff;
    font-size:.76rem;
    line-height:1.2;
    font-weight:800;
  }
  .qct-cookie-consent p {
    min-width:0;
    margin:0;
    color:rgba(246,240,232,.72);
    font-size:.75rem;
    line-height:1.25;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .qct-cookie-consent a {
    color:#ff9a87;
    text-decoration:underline;
    text-underline-offset:3px;
  }
  .qct-cookie-consent__actions {
    display:flex;
    flex:0 0 auto;
    align-items:center;
    gap:.5rem;
  }
  .qct-cookie-consent button {
    min-height:32px;
    padding:.38rem .78rem;
    font:inherit;
    font-size:.8rem;
    font-weight:800;
    cursor:pointer;
    color:#f6f0e8;
    background:transparent;
    border:1px solid rgba(255,255,255,.18);
    border-radius:999px;
  }
  .qct-cookie-consent button.is-primary {
    color:#171614;
    background:#d2ff59;
    border-color:#d2ff59;
  }
  .qct-cookie-consent button:hover { border-color:#ff9a87; }
  .qct-cookie-consent button:focus-visible,
  .qct-cookie-consent a:focus-visible { outline:3px solid #fff; outline-offset:3px; }
  @media(max-width:720px){
    .qct-cookie-consent{align-items:stretch;flex-direction:column;gap:.55rem;padding:.58rem .7rem}
    .qct-cookie-consent__content{display:block;white-space:normal}
    .qct-cookie-consent strong{display:block;margin-bottom:.18rem;font-size:.86rem}
    .qct-cookie-consent p{overflow:visible;text-overflow:clip;font-size:.76rem;line-height:1.35}
    .qct-cookie-consent__actions{width:100%;gap:.45rem}
    .qct-cookie-consent button{flex:1;min-height:34px;padding:.42rem .65rem;font-size:.8rem}
  }
</style>
