---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro';
const { sector } = Astro.props as { sector: readonly [string,string,string,readonly string[],string] }; const [slug,title,description,modules,approach] = sector;
import { sectorEditorial } from '../data/sector-editorial';
const editorial=sectorEditorial[slug]; if(!editorial) throw new Error(`Missing sector editorial: ${slug}`);
const faqs=editorial.faqs;
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<BaseLayout title={`${title} | QCT Commerce`} description={description} lang="tr" pageType="WebPage" service={{name:title,description}} breadcrumbs={[{name:'Ana sayfa',url:'/'},{name:'Sektörler',url:'/sektorler/'},{name:title,url:`/sektorler/${slug}/`}] }><Header slot="header" lang="tr"/><script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)}/><article class="sector"><header class="sector__hero container"><p>SEKTÖREL WEB SİTESİ</p><h1>{title}</h1><div>{description}</div></header><div class="container sector__body"><section><h2>Bu sektörde web sitesi neyi çözmeli?</h2><p>{editorial.problem}</p></section><section><h2>Önerilen site yapısı ve modüller</h2><ul>{editorial.features.map((module)=><li>{module}</li>)}</ul></section><section><h2>SEO ve görünürlük fırsatları</h2><p>{editorial.seo}</p></section><section><h2>Ziyaretçiden nitelikli talebe</h2><p>{editorial.journey}</p></section><section><h2>Yaklaşık proje yaklaşımı</h2><p>{editorial.approach}</p></section><section><h2>Sık sorulan sorular</h2>{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section><nav class="sector__related" aria-label="İlgili hizmet ve rehberler"><h2>İlgili hizmet ve rehberler</h2>{editorial.related.map((item)=><a href={item.href}>{item.label} →</a>)}</nav><section class="sector__cta"><h2>{editorial.cta}</h2><a href="/iletisim/">Talep oluştur</a></section></div></article><Footer slot="footer" lang="tr"/></BaseLayout>
<style>.sector__related{display:grid;gap:.7rem;padding-block:30px}.sector__related a{color:var(--qct-color-accent-strong);line-height:1.6}.sector{background:var(--qct-color-background)}.sector__hero{padding:calc(var(--qct-hero-clearance) + 68px) 20px 72px;text-align:center;border-bottom:1px solid var(--qct-color-line)}.sector__hero p{color:var(--qct-color-accent-strong);font-size:.75rem;font-weight:800;letter-spacing:.14em}.sector h1,.sector h2{color:var(--qct-color-ink);letter-spacing:-.05em;text-wrap:balance}.sector h1{font-size:clamp(2.4rem,5vw,4.3rem);line-height:1.02;margin:.5rem auto 1.2rem;max-width:18ch}.sector__hero div{color:var(--qct-color-muted);line-height:1.7;margin:auto;max-width:700px}.sector__body{max-width:840px;padding-block:70px}.sector__body section{border-top:1px solid var(--qct-color-line-strong);padding:34px 0}.sector h2{font-size:clamp(1.5rem,3vw,2.2rem);margin:0 0 1rem}.sector p,.sector li{color:var(--qct-color-muted);line-height:1.75}.sector li{margin:.45rem}.sector details{border-top:1px solid var(--qct-color-line);padding:1rem 0}.sector summary{color:var(--qct-color-ink);font-weight:750;cursor:pointer}.sector__cta{background:#171412!important;border:0!important;padding:36px!important}.sector__cta h2{color:#fffaf5}.sector__cta a{background:var(--qct-color-accent);color:#171412;display:inline-block;font-weight:800;padding:.9rem 1.1rem;text-decoration:none}</style>
