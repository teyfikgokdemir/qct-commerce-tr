---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const phoneNumber = '905433856656';

const copy = {
  en: {
    label: 'Chat with QCT Studio on WhatsApp',
    message: 'Hello QCT Studio, I would like to discuss a digital project.',
  },
  sq: {
    label: 'Bisedoni me QCT Studio në WhatsApp',
    message: 'Përshëndetje QCT Studio, dëshiroj të diskutoj një projekt digjital.',
  },
  mk: {
    label: 'Разговарајте со QCT Studio на WhatsApp',
    message: 'Здраво QCT Studio, би сакал/а да разговарам за дигитален проект.',
  },
  sr: {
    label: 'Razgovarajte sa QCT Studio putem WhatsApp-a',
    message: 'Zdravo QCT Studio, želeo/la bih da razgovaram o digitalnom projektu.',
  },
};

const c = copy[lang as keyof typeof copy] ?? copy.en;
const href = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(c.message)}`;
---

<a
  class="qct-whatsapp"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={c.label}
  data-whatsapp-link
  data-lang={lang}
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20.52 3.48A11.81 11.81 0 0 0 12.1 0C5.56 0 .24 5.32.24 11.87c0 2.09.55 4.13 1.59 5.93L.14 24l6.35-1.67a11.84 11.84 0 0 0 5.61 1.43h.01c6.54 0 11.86-5.33 11.86-11.87 0-3.17-1.22-6.16-3.45-8.41Zm-8.41 18.27h-.01a9.83 9.83 0 0 1-5.01-1.37l-.36-.21-3.77.99 1.01-3.67-.24-.38a9.84 9.84 0 1 1 8.38 4.64Zm5.4-7.37c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.93 1.16-.17.2-.34.22-.64.07-.29-.15-1.25-.46-2.38-1.47a8.9 8.9 0 0 1-1.64-2.04c-.17-.3-.02-.46.13-.6.13-.13.3-.34.44-.52.15-.17.2-.29.3-.49.09-.2.04-.37-.03-.52-.08-.15-.67-1.61-.91-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.19 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.19-.56-.34Z"/>
  </svg>
</a>

<script is:inline>
  document.querySelector('[data-whatsapp-link]')?.addEventListener('click', (event) => {
    const link = event.currentTarget;
    try {
      if (
        localStorage.getItem('qct-analytics-consent') === 'granted' &&
        typeof window.gtag === 'function'
      ) {
        window.gtag('event', 'whatsapp_click', {
          link_url: link.href,
          page_language: link.dataset.lang,
        });
      }
    } catch {
      // The link must remain usable even when storage is unavailable.
    }
  });
</script>

<style>
  .qct-whatsapp {
    align-items: center;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    background: linear-gradient(145deg, rgba(77, 46, 98, 0.98), rgba(38, 23, 48, 0.98));
    border: 1px solid rgba(255, 122, 115, 0.42);
    border-radius: 50%;
    bottom: 1rem;
    box-shadow: 0 16px 42px rgba(38, 23, 48, 0.32);
    color: #f8f5ef;
    box-sizing: border-box;
    display: flex !important;
    flex: 0 0 52px;
    height: 52px !important;
    justify-content: center;
    line-height: 0;
    max-height: 52px;
    max-width: 52px;
    min-height: 52px !important;
    min-width: 52px !important;
    overflow: visible;
    padding: 0 !important;
    position: fixed;
    right: 1rem;
    text-decoration: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    width: 52px !important;
    z-index: 9000;
  }

  .qct-whatsapp::after {
    background: #25d366;
    border: 2px solid #2b1936;
    border-radius: 50%;
    bottom: 3px;
    box-sizing: border-box;
    content: '';
    height: 11px;
    position: absolute;
    right: 2px;
    width: 11px;
  }

  .qct-whatsapp svg {
    display: block !important;
    fill: currentColor !important;
    flex: 0 0 23px;
    height: 23px !important;
    max-height: 23px;
    max-width: 23px;
    min-height: 23px;
    min-width: 23px;
    width: 23px !important;
  }

  .qct-whatsapp:hover,
  .qct-whatsapp:focus-visible {
    border-color: rgba(255, 122, 115, 0.78);
    box-shadow: 0 20px 48px rgba(38, 23, 48, 0.4), 0 0 0 4px rgba(255, 122, 115, 0.1);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .qct-whatsapp:focus-visible {
    outline: 2px solid #f8f5ef;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .qct-whatsapp {
      transition: none;
    }
  }
</style>
