---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import FounderSection from './FounderSection.astro';
import ServicePage from './service/ServicePage.astro';
import { getPageSeo } from '../i18n/seo';

interface Props { lang: string; }
const { lang } = Astro.props;
const seo = getPageSeo('about');
---

<BaseLayout title={seo.title} description={seo.description} lang={lang} pageType="AboutPage" breadcrumbLabel="Hakkımızda" includeFounder includeServiceCardStyles>
  <Header slot="header" lang={lang} />
  <ServicePage
    lang={lang}
    eyebrow="Hakkımızda"
    title="QCT Commerce — web, e-ticaret ve dijital görünürlük için tek merkez."
    lead="QCT Commerce; yeni web sitesi ve e-ticaret projelerinin yanı sıra mevcut sitelerin yenilenmesi, hızlandırılması, görünürlüğünün geliştirilmesi ve satış altyapısının güçlendirilmesi için uçtan uca çalışan dijital uygulama yapısıdır."
    ctaPrimary="Marka yapımızı konuşalım"
    brandRelationship={{
      title: 'QCT Commerce, QCT ekosisteminin web, e-ticaret ve dijital görünürlük odaklı uygulama markasıdır.',
      text: 'Kurucusu Teyfik Gökdemir’in liderliğindeki QCT ekosisteminde QCT Commerce ve QCT Studio ayrı markalar olarak konumlanır. QCT Commerce; Türkiye’de web sitesi, e-ticaret, site iyileştirme ve görünürlük ihtiyacı olan işletmelere odaklanır.',
      linkLabel: 'Kurucu ve QCT ekosistemini inceleyin',
      linkHref: 'https://teyfikgokdemir.com/tr/',
    }}
    benefits={{
      eyebrow: 'YAKLAŞIMIMIZ',
      title: 'Teknoloji, ticari hedefe hizmet etmeli.',
      lead: 'Her projeye hazır bir platform veya araç önerisiyle değil, işletmenin mevcut yapısını ve öncelikli darboğazını anlayarak başlarız. Teknik kararları müşteri yolculuğu, satış hedefi, ekip kapasitesi, ölçülebilirlik ve sürdürülebilir işletme maliyetiyle birlikte değerlendiririz. Gereksiz karmaşa üretmeyen, ekip tarafından yönetilebilen ve gerçek kullanıcı davranışıyla geliştirilebilen sistemler kurmayı hedefleriz.',
      items: [
        { title: 'İşletmeye göre çözüm', text: 'Hazır reçete yerine ürün, müşteri ve operasyon yapısına uygun kapsam.' },
        { title: 'Açık kararlar', text: 'Her tasarım ve teknoloji kararının iş hedefiyle bağlantısı.' },
        { title: 'Sürdürülebilir sistem', text: 'Yayın sonrasında ekip tarafından yönetilebilen altyapı.' },
      ],
    }}
    included={{
      eyebrow: 'KİMLER İÇİN',
      title: 'Web sitesi olan ya da dijital varlığını yeni kurmak isteyen herkes için',
      lead: 'Kurumsal, kişisel veya e-ticaret sitesi kurmak; mevcut sitesini yenilemek, hızlandırmak, taşımak ya da Google ve yapay zekâ aramalarında daha görünür hale getirmek isteyen markalara odaklanıyoruz.',
      items: [
        { title: 'KOBİ’ler', text: 'Dağınık dijital kanallarını düzenlemek isteyen işletmeler.' },
        { title: 'Üreticiler', text: 'Ürünlerini dijitalde daha açık sunmak ve talep toplamak isteyen markalar.' },
        { title: 'Perakendeciler', text: 'Fiziksel satış deneyimini e-ticaretle tamamlamak isteyen işletmeler.' },
        { title: 'E-ticaret markaları', text: 'Mağaza, reklam ve operasyon akışını geliştirmek isteyen ekipler.' },
      ],
    }}
    process={{
      eyebrow: 'ÇALIŞMA BİÇİMİ',
      title: 'Net kapsam, görünür süreç, ölçülebilir öncelikler.',
      steps: [
        { number: '01', title: 'Dinleriz', text: 'İşletmeyi ve mevcut sorunları anlarız.' },
        { number: '02', title: 'Önceliklendiririz', text: 'En kritik kaybı ve uygulanabilir ilk adımı seçeriz.' },
        { number: '03', title: 'Üretiriz', text: 'Tasarım, geliştirme ve içerik çalışmalarını yürütürüz.' },
        { number: '04', title: 'Ölçeriz', text: 'Yayına alınan sistemin kritik sinyallerini izleriz.' },
      ],
    }}
    relatedLinks={[
      { title: 'Teyfik Gökdemir', text: 'QCT ekosisteminin kurucusunu ve diğer girişimleri inceleyin.', href: 'https://teyfikgokdemir.com/tr/' },
      { title: 'QCT Studio', text: 'Balkan pazarına odaklanan QCT Studio çalışmalarını inceleyin.', href: 'https://qctstudio.com/' },
      { title: 'Hizmetler', text: 'E-ticaret ve dijital büyüme çalışma alanlarını inceleyin.', href: '/hizmetler/' },
      { title: 'İletişim', text: 'İşletmenizin öncelikli dijital sorununu paylaşın.', href: '/iletisim/' },
    ]}
    faq={{
      eyebrow: 'SIK SORULANLAR',
      title: 'QCT Commerce hakkında',
      items: [
        { q: 'QCT Commerce ne zaman kuruldu?', a: 'QCT Commerce, 2025 yılında Teyfik Gökdemir tarafından QCT ekosisteminin Türkiye pazarına odaklanan dijital ticaret markası olarak kuruldu.' },
        { q: 'QCT Commerce ile QCT Studio arasındaki ilişki nedir?', a: 'Her iki marka da Teyfik Gökdemir tarafından geliştirilen QCT ekosisteminin parçasıdır. QCT Commerce Türkiye’ye, QCT Studio ise Balkan pazarlarına odaklanır.' },
        { q: 'Projeleri kim yönetiyor?', a: 'Projeler, QCT Commerce Kurucusu Teyfik Gökdemir tarafından yönetilir. Çalışmalarında e-ticaret, web ve dijital büyüme alanındaki deneyiminden yararlanır.' },
        { q: 'Hangi satış kanalları ve pazaryerleri konusunda deneyiminiz var?', a: 'Deneyim alanları Etsy, Amazon, Türkiye’deki yerel pazaryerleri ve markaların kendi bağımsız e-ticaret mağazalarını kapsar. Kanal seçimi işletmenin ürün, operasyon ve büyüme hedeflerine göre değerlendirilir.' },
        { q: 'Hangi dillerde çalışıyorsunuz?', a: 'Çalışmalar Türkçe ve İngilizce yürütülebilir. QCT Commerce sitesinin ve pazar odağının dili Türkçedir.' },
      ],
    }}
    final={{
      title: 'Dijital altyapınızı satış hedefinizle birlikte ele alalım.',
      text: 'Mevcut yapınızı, hedefinizi ve öncelikli darboğazı paylaşın; uygun başlangıç kapsamını birlikte belirleyelim.',
      cta: 'İlk adımı konuşalım',
    }}
  >
    <FounderSection slot="after-brand" />
  </ServicePage>
  <Footer slot="footer" lang={lang} />
</BaseLayout>