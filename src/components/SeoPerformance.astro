---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import ServicePage from './service/ServicePage.astro'; import {getPageSeo} from '../i18n/seo'; interface Props{lang:string} const{lang}=Astro.props; const seo=getPageSeo('seo-performance'); const d='İşletmenizin Google’da ve yapay zekâ destekli yanıt sistemlerinde doğru bağlamla bulunmasını sağlayan teknik ve içerik altyapısını geliştiriyoruz.';
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="SEO, GEO, AEO ve AIO" service={{name:'SEO, GEO, AEO ve AIO',description:d}}><Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="SEO, GEO, AEO ve AIO" title="Arama sonuçlarında ve yapay zekâ yanıtlarında anlaşılır bir marka olun." lead={d} ctaPrimary="Görünürlüğünüzü konuşalım" ctaSecondary="Tüm hizmetler"
problem={{eyebrow:'SORUN',title:'Yalnızca yayında olmak, bulunmak için yeterli değildir.',intro:['Teknik engeller, zayıf içerik yapısı ve belirsiz marka sinyalleri arama sistemlerinin işletmenizi anlamasını zorlaştırır.'],items:[{title:'Taranabilirlik sorunları',text:'Sayfalar doğru keşfedilemez veya önceliklendirilemez.'},{title:'Arama niyetiyle uyumsuz içerik',text:'İçerik müşterinin gerçek sorularına yanıt vermez.'},{title:'Zayıf varlık sinyalleri',text:'Marka, hizmet ve pazar ilişkisi açık kurulmaz.'}]}}
benefits={{eyebrow:'YAKLAŞIM',title:'Teknik temel, içerik mimarisi ve varlık netliği birlikte çalışır.',lead:'SEO’yu yalnızca anahtar kelime sıralaması olarak değil, doğru müşterinin doğru bilgiye ulaşması olarak ele alırız.',items:[{title:'SEO',text:'Teknik taranabilirlik, sayfa yapısı ve arama niyeti.'},{title:'GEO ve AEO',text:'Üretken arama ve yanıt motorlarının anlayabileceği açık içerik.'},{title:'AIO',text:'Yapay zekâ sistemleri için tutarlı marka ve konu sinyalleri.'}]}}
included={{eyebrow:'KAPSAM',title:'Görünürlük çalışmasının temelleri',lead:'Öncelikler mevcut durum analizine göre belirlenir.',items:[{title:'Teknik denetim',text:'Taranabilirlik, indeksleme ve performans.'},{title:'İçerik mimarisi',text:'Konu, sayfa ve iç bağlantı yapısı.'},{title:'Metadata',text:'Sayfaya özgü başlık ve açıklamalar.'},{title:'Yapılandırılmış veri',text:'Uygun schema.org işaretlemeleri.'},{title:'Arama niyeti',text:'Müşteri sorularıyla uyumlu içerik.'},{title:'Ölçüm',text:'Organik görünürlük ve eylem takibi.'}]}}
process={{eyebrow:'SÜREÇ',title:'Önce görünürlük engellerini belirleriz.',steps:[{number:'01',title:'Denetim',text:'Teknik yapı ve mevcut içeriği inceleriz.'},{number:'02',title:'Önceliklendirme',text:'Etkisi ve uygulanabilirliği yüksek işleri sıralarız.'},{number:'03',title:'Uygulama',text:'Teknik, içerik ve şema iyileştirmelerini yaparız.'},{number:'04',title:'İzleme',text:'Sonuçları ölçer ve yeni fırsatları belirleriz.'}]}}
answers={{title:'SEO, GEO, AEO ve AIO neyi çözer?',lead:'Bu çalışmaların ortak amacı, işletmenin sayfalarını hem kullanıcılar hem arama ve yapay zekâ sistemleri için açık, tutarlı ve doğrulanabilir hale getirmektir.',items:[{question:'SEO nedir?',answer:'SEO; sayfaların arama motorları tarafından taranmasını, anlaşılmasını ve ilgili aramalarda değerlendirilebilmesini destekleyen teknik ve içerik çalışmalarıdır.'},{question:'GEO ve AEO nedir?',answer:'GEO üretken arama deneyimlerinde, AEO ise doğrudan yanıt sistemlerinde içeriğin açık ve kaynak gösterilebilir biçimde sunulmasına odaklanır.'},{question:'AIO nedir?',answer:'AIO, marka ve hizmet bilgilerinin yapay zekâ sistemleri tarafından tutarlı bağlamla anlaşılmasını destekleyen içerik, varlık ve teknik sinyaller bütünüdür.'},{question:'Ne zaman gerekir?',answer:'Sayfalar indekslenmediğinde, yanlış sorgularla eşleştiğinde, içerikler gerçek soruları yanıtlamadığında veya marka bilgileri kanallar arasında tutarsız olduğunda gerekir.'}]}}
relatedLinks={[{title:'Web tasarım',text:'Semantik, hızlı ve erişilebilir sayfa temelini kurun.',href:'/web-tasarim/'},{title:'E-ticaret altyapısı',text:'Kategori ve ürün sayfalarını arama niyetine göre düzenleyin.',href:'/e-ticaret/'},{title:'E-ticaret rehberleri',text:'Kullanıcı sorularını ayrıntılı ve doğrulanabilir içerikle yanıtlayın.',href:'/blog/'}]}
faq={{eyebrow:'SIK SORULANLAR',title:'SEO ve yapay zekâ görünürlüğü hakkında',items:[{q:'GEO, AEO ve AIO nedir?',a:'Bu kavramlar içeriğin üretken arama, yanıt motorları ve yapay zekâ sistemleri tarafından daha iyi anlaşılması ve kaynak olarak değerlendirilebilmesiyle ilgilidir.'},{q:'Sonuç garantisi veriyor musunuz?',a:'Hayır. Arama sistemleri üçüncü taraf platformlardır; belirli sıralama veya görünürlük garantisi verilemez.'},{q:'E-ticaret siteleri için SEO yapıyor musunuz?',a:'Evet. Kategori, ürün, teknik taranabilirlik ve iç bağlantı yapısı e-ticaret özelinde planlanabilir.'}]}}
final={{title:'İşletmenizin dijital olarak daha kolay anlaşılmasını sağlayın.',text:'Mevcut görünürlük yapınızı birlikte inceleyelim.',cta:'İletişime geçin',ctaSecondary:'E-posta gönderin'}}/><Footer slot="footer" lang={lang}/></BaseLayout>
