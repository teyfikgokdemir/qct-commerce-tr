---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ServicePage from './service/ServicePage.astro';
import { getPageSeo } from '../i18n/seo';
interface Props { lang: string; }
const { lang } = Astro.props;
const seo = getPageSeo('seo-performance');
const d = 'Mevcut web sitenizi teknik SEO, içerik, arama niyeti, yapılandırılmış veri, GEO, AEO ve AI görünürlük açısından analiz ediyor; Google ve yapay zekâ destekli aramalarda daha doğru anlaşılması için gerekli iyileştirmeleri uyguluyoruz.';
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="SEO, GEO, AEO ve AIO" service={{ name: 'SEO, GEO, AEO ve AIO', description: d }} includeServiceCardStyles>
<Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="SEO, GEO, AEO VE AIO" title="Google’da ve yapay zekâ aramalarında daha görünür olun." lead={d} ctaPrimary="Görünürlük yapımızı değerlendirelim" ctaSecondary="Tüm hizmetler"
problem={{eyebrow:'KİMLER İÇİN UYGUN?',title:'Arama görünürlüğünü ticari büyüme ve marka güveniyle birlikte ele almak isteyen işletmeler için.',intro:['Arama dünyası artık yalnızca klasik Google sonuçlarından oluşmuyor. Kullanıcılar arama motorlarından, yapay zekâ destekli yanıt sistemlerinden, haritalardan, ürün sonuçlarından ve doğrudan cevap kutularından bilgi alıyor. Bu nedenle işletmenin teknik olarak erişilebilir, içerik olarak açık ve marka olarak tutarlı görünmesi gerekir.'],items:[{title:'Üreticiler ve ihracatçılar',text:'Teknik ürünlerini, üretim kabiliyetlerini, sertifikalarını ve hedef pazarlarını hem arama motorlarına hem kurumsal alıcılara doğru anlatmak isteyen işletmeler için.'},{title:'Toptancılar ve e-ticaret markaları',text:'Kategori, ürün, marka ve satın alma rehberi sayfalarıyla ticari aramalardan daha nitelikli trafik almak isteyen işletmeler için.'},{title:'Hizmet şirketleri ve büyüyen KOBİ’ler',text:'Uzmanlık alanlarını, hizmet bölgelerini, vaka çalışmalarını ve güven sinyallerini daha görünür hale getirmek isteyen işletmeler için.'}]}}
benefits={{eyebrow:'ÇÖZDÜĞÜ İŞ PROBLEMLERİ',title:'Arama görünürlüğü sorunu çoğu zaman yalnızca anahtar kelime eksikliği değildir.',lead:'Teknik engeller, yanlış sayfa yapısı, birbirini tekrar eden içerikler, zayıf marka sinyalleri ve ölçüm eksikliği birlikte çalıştığında işletme doğru sorgularda görünmez veya yanlış bağlamla değerlendirilir.',items:[{title:'İndeksleme ve tarama sorunları',text:'Arama motorları önemli sayfaları keşfedemez, gereksiz sayfaları önceliklendirir veya içerik ilişkilerini doğru anlayamaz.'},{title:'Arama niyetiyle uyumsuz içerik',text:'Sayfalar müşterinin gerçek sorularını yanıtlamak yerine genel tanıtım metinleriyle sınırlı kalır.'},{title:'Ürün ve hizmet mimarisinin zayıf olması',text:'Kategori, ürün, sektör, kullanım alanı ve hizmet sayfaları arasında anlamlı ilişki kurulmadığında konu otoritesi gelişmez.'},{title:'Marka ve varlık sinyallerinin tutarsızlığı',text:'İsim, hizmet, lokasyon, kurucu, sosyal profil ve iletişim bilgileri farklı kanallarda çelişirse güvenilirlik zayıflar.'},{title:'Yapay zekâ sistemlerinde bağlam eksikliği',text:'Açık tanımlar, soru-cevap yapıları, kaynak niteliğinde içerik ve doğrulanabilir işletme bilgileri yoksa marka yanlış veya eksik temsil edilebilir.'},{title:'Trafiğin ticari sonuca bağlanamaması',text:'Organik ziyaret, form, WhatsApp, telefon, teklif ve satış arasındaki ilişki ölçülmediğinde SEO çalışması yalnızca görünürlük raporuna dönüşür.'}]}}
included={{eyebrow:'QCT COMMERCE YAKLAŞIMI',title:'Teknik SEO, içerik mimarisi, varlık netliği ve dönüşüm birlikte çalışır.',lead:'SEO’yu sıralama takibiyle sınırlamayız. İşletmenin hangi sorulara, hangi pazarda, hangi içerik ve güven sinyalleriyle cevap vermesi gerektiğini belirler; Google ve yapay zekâ sistemlerinin anlayabileceği, müşterinin kullanabileceği bir yapı kurarız.',items:[{title:'Teknik SEO ve indekslenebilirlik',text:'Tarama, canonical, sitemap, robots, performans, mobil kullanım, yönlendirme ve indeksleme sorunları incelenir.'},{title:'Arama niyeti ve içerik haritası',text:'Web sitesi fiyatları, hizmet, ürün, karşılaştırma ve satın alma niyetli sorgular uygun sayfa türleriyle eşleştirilir.'},{title:'GEO — Generative Engine Optimization',text:'ChatGPT, Gemini, Perplexity ve üretken arama deneyimlerinde kaynak olabilmeyi destekleyen özgün, doğrulanabilir ve açık içerik yapısı kurulur.'},{title:'AEO ve AI görünürlüğü',text:'Kullanıcı sorularına doğrudan cevap veren içerik, güçlü marka/varlık sinyalleri ve tutarlı yapılandırılmış verilerle cevap motorlarının içeriği anlaması kolaylaştırılır.'},{title:'Yapılandırılmış veri ve iç bağlantılar',text:'Uygun schema.org türleri ve konu ilişkisini güçlendiren doğal iç bağlantılar uygulanır.'},{title:'Dönüşüm ve performans ölçümü',text:'Organik görünürlük ile form, WhatsApp, teklif ve satış niyeti arasındaki ilişki izlenir.'}]}}
process={{eyebrow:'8 ADIMLI SÜREÇ',title:'Teknik engellerden sürdürülebilir görünürlük sistemine.',steps:[{number:'',title:'İş ve pazar analizi',text:'Ürünleri, hizmetleri, hedef müşterileri, satış bölgelerini ve organik görünürlükten beklenen ticari sonucu netleştiririz.'},{number:'',title:'Teknik denetim',text:'Tarama, indeksleme, hız, mobil kullanım, URL, canonical, sitemap, yönlendirme ve yapılandırılmış veri durumunu inceleriz.'},{number:'',title:'Arama ve niyet araştırması',text:'Müşterilerin ürün, sorun, kategori, karşılaştırma ve satın alma aşamalarında kullandığı sorguları değerlendiririz.'},{number:'',title:'İçerik ve sayfa mimarisi',text:'Ana sayfa, hizmet, kategori, ürün, sektör, lokasyon, rehber ve vaka çalışması sayfalarının görevini belirleriz.'},{number:'',title:'Önceliklendirme planı',text:'Ticari etki, teknik gereklilik, rekabet ve uygulama maliyetine göre işleri sıralarız.'},{number:'',title:'Teknik ve içerik uygulaması',text:'Metadata, başlıklar, içerik, iç bağlantılar, schema ve gerekli teknik düzeltmeleri uygularız.'},{number:'',title:'Doğrulama ve ölçüm',text:'İndekslenebilirlik, schema, sayfa çıktıları, temel analitik olaylar ve arama konsolu verileri kontrol edilir.'},{number:'',title:'İzleme ve gelişim',text:'Sorgu, sayfa, görünürlük ve dönüşüm verilerine göre yeni içerik ve iyileştirme fırsatları belirlenir.'}]}}
answers={{title:'SEO, GEO, AEO ve AIO arasındaki fark ve iş etkisi',lead:'Bu disiplinler farklı kanallara odaklansa da ortak amaç işletmenin doğru soruda, doğru bağlamla ve güvenilir bilgiyle bulunmasını sağlamaktır.',items:[{question:'SEO ne sağlar?',answer:'Sayfaların Google ve diğer arama motorları tarafından taranmasını, anlaşılmasını ve ilgili sorgularda değerlendirilmesini destekler; teknik temel, içerik ve otorite sinyallerini kapsar.'},{question:'GEO neyi hedefler?',answer:'Generative Engine Optimization; üretken yapay zekâ ve AI destekli arama deneyimlerinde içeriğin doğru bağlamda bulunmasını ve kaynak olarak değerlendirilebilmesini destekler.'},{question:'AEO neyi değiştirir?',answer:'Kullanıcının sorusuna açık, doğrudan ve doğrulanabilir cevaplar sunarak cevap motorları ve soru odaklı arama deneyimleri için içeriği daha kullanılabilir hale getirir.'},{question:'AIO / AI görünürlüğü neden önemlidir?',answer:'Marka, hizmet, uzmanlık ve içerik ilişkilerinin yapay zekâ destekli keşif ortamlarında açık ve tutarlı biçimde anlaşılmasına odaklanır.'},{question:'Dönüşüm odaklı SEO ne demektir?',answer:'Yalnızca trafik artışını değil, doğru kullanıcının ürün, teklif, iletişim, WhatsApp veya satın alma adımına ilerlemesini hedefleyen görünürlük yaklaşımıdır.'}]}}
relatedLinks={[{title:'B2B web tasarım',text:'Semantik, hızlı, erişilebilir ve arama sistemleri tarafından anlaşılabilir web temelini kurun.',href:'/web-tasarim/'},{title:'E-ticaret çözümleri',text:'Kategori ve ürün mimarisini arama niyeti, ürün verisi ve dönüşüm hedefiyle birlikte planlayın.',href:'/e-ticaret/'},{title:'Meta reklamları ve landing page',text:'Organik görünürlüğü ücretli kampanya verileri ve dönüşüm odaklı sayfalarla tamamlayın.',href:'/meta-reklamlari/'},{title:'E-ticaret ve dijital büyüme blogu',text:'Müşteri sorularını ayrıntılı, doğrulanabilir ve doğal iç bağlantılarla desteklenen içeriklerle yanıtlayın.',href:'/blog/'}]}
faq={{eyebrow:'SIK SORULANLAR',title:'SEO, GEO, AEO ve AIO hakkında',items:[{q:'SEO, GEO, AEO ve AIO aynı şey mi?',a:'Hayır. SEO klasik arama görünürlüğünü, GEO üretken arama deneyimlerini, AEO doğrudan yanıt sistemlerini, AIO ise yapay zekâ sistemlerinin marka ve içerik bağlamını anlamasını destekler.'},{q:'Google’da birinci sıra garantisi veriyor musunuz?',a:'Hayır. Arama sistemleri üçüncü taraf platformlardır ve sıralamalar birçok etkene bağlıdır. Teknik ve içerik altyapısını güçlendirir, ölçülebilir gelişim hedefleriz.'},{q:'Ne kadar sürede sonuç alınır?',a:'Süre teknik durum, rekabet, site geçmişi, içerik kapsamı ve uygulama hızına bağlıdır. Bazı teknik etkiler erken görülürken rekabetçi sorgular daha uzun sürebilir.'},{q:'Yeni web sitesi olmadan SEO yapılabilir mi?',a:'Evet. Mevcut altyapı uygunsa iyileştirme yapılabilir. Ancak teknik sınırlar büyümeyi engelliyorsa yeniden yapılandırma gerekebilir.'},{q:'E-ticaret siteleri için SEO yapıyor musunuz?',a:'Evet. Kategori, ürün, filtre, varyasyon, stok dışı sayfalar, ürün verisi, iç bağlantı ve ticari arama niyeti e-ticaret özelinde ele alınır.'},{q:'İçerikleri siz hazırlıyor musunuz?',a:'Kapsama göre hizmet, kategori, ürün, rehber, FAQ ve vaka çalışması içerikleri planlanabilir veya mevcut içerikler yeniden yapılandırılabilir.'},{q:'Yapay zekâ tarafından kaynak gösterilme garantisi var mı?',a:'Hayır. Üçüncü taraf yapay zekâ sistemlerinin kaynak seçimi garanti edilemez. İçeriğin açık, tutarlı, doğrulanabilir ve kaynak olmaya uygun hale gelmesini destekleriz.'},{q:'Schema kullanmak sıralamayı garanti eder mi?',a:'Hayır. Yapılandırılmış veri içeriğin anlamını açıklamaya yardımcı olur; tek başına sıralama garantisi vermez ve yalnızca sayfada gerçekten bulunan bilgiler için kullanılmalıdır.'},{q:'Yerel SEO çalışması yapıyor musunuz?',a:'İşletme lokasyonu, hizmet bölgesi, Google işletme profili ve yerel sayfa ihtiyacı gerçek operasyon ve doğrulanabilir bilgiler temelinde değerlendirilebilir.'},{q:'Çok dilli SEO yapılabilir mi?',a:'Evet. Dil ve ülke hedefleri, URL yapısı, hreflang, çeviri eşdeğerliği ve yerel arama niyeti ayrı ayrı planlanır.'},{q:'Backlink hizmeti veriyor musunuz?',a:'Kalitesiz veya yapay bağlantı paketleri uygulamıyoruz. Gerçek yayın, iş ortaklığı, sektör kaynağı ve değerli içerik temelli kazanımlar ayrıca değerlendirilebilir.'},{q:'SEO çalışmasını nasıl ölçüyorsunuz?',a:'İndeksleme, sorgu görünürlüğü, nitelikli organik trafik, önemli sayfa performansı ve form, WhatsApp veya teklif gibi ticari eylemler birlikte izlenir.'},{q:'Mevcut ajansımız veya yazılım ekibimizle çalışabilir misiniz?',a:'Evet. Teknik bulgular ve içerik planı açık görevler halinde paylaşılabilir; uygulama sorumluluğu ve doğrulama süreci başlangıçta netleştirilir.'}]}}
final={{title:'Arama motorları ve yapay zekâ sistemleri işletmenizi doğru bağlamla anlayabilsin.',text:'Mevcut görünürlüğünüzü, hedef pazarınızı ve öncelikli ürün veya hizmet grubunuzu paylaşın; en yüksek etkili başlangıç alanını birlikte belirleyelim.',cta:'Görünürlük yapımızı inceleyelim',ctaSecondary:'E-posta gönderin'}}/><section class="dynamic-seo-plans" aria-labelledby="dynamic-seo-plans-title">
  <div class="container">
    <p class="plan-eyebrow">AYLIK DİNAMİK SEO</p>
    <h2 id="dynamic-seo-plans-title">Tek seferlik ayar değil, sürekli gelişen görünürlük sistemi.</h2>
    <p class="plan-lead">Search Console sorguları, teknik sağlık, içerik fırsatları ve AI arama sinyalleri düzenli izlenir; site her ay veriye göre geliştirilir.</p>
    <div class="plan-grid">
      <article><h3>SEO Care</h3><strong>3.990 TL/ay</strong><p>Teknik SEO takibi, Search Console, sitemap/index kontrolü ve temel metadata iyileştirmeleri.</p></article>
      <article class="is-featured"><span class="plan-badge">ÖNERİLEN</span><h3>Dinamik SEO</h3><strong>5.990 TL/ay</strong><p>SEO Care + sorgu analizi, schema, iç linkleme, öncelikli sayfa optimizasyonu, GEO/AEO/AIO ve ayda 1 özgün içerik.</p></article>
      <article><h3>SEO Growth</h3><strong>7.990 TL/ay</strong><p>Dinamik SEO + ayda 2 özgün içerik, landing page geliştirme, rakip/sorgu analizi ve daha geniş optimizasyon.</p></article>
    </div>
    <p class="plan-note">Backlink satın alma paketleri dahil değildir. Yayın, dijital PR veya sektör kaynağı çalışmaları gerektiğinde ayrıca kapsamlanır.</p>
  </div>
</section>
<style>
.dynamic-seo-plans{padding:clamp(4rem,7vw,6.5rem) 0;background:#f3eee7;color:#171514}.dynamic-seo-plans .container{text-align:center}.plan-eyebrow{font-size:.72rem;letter-spacing:.14em;font-weight:800;color:#b9473e;margin:0 0 .7rem}.dynamic-seo-plans h2{max-width:980px;margin:0 auto;font-size:clamp(2rem,3.6vw,3.6rem);line-height:1.03;letter-spacing:-.04em;text-wrap:balance}.plan-lead{max-width:760px;margin:1rem auto 2.2rem;color:#655d58;line-height:1.7}.plan-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;max-width:1120px;margin:auto}.plan-grid article{position:relative;text-align:left;padding:clamp(1.5rem,2.6vw,2.2rem);border:1px solid rgba(23,21,20,.10);border-radius:22px;background:#fffaf5;box-shadow:0 18px 50px rgba(23,21,20,.06)}.plan-grid article.is-featured{border-color:rgba(185,71,62,.42);transform:translateY(-6px)}.plan-badge{display:inline-block;margin-bottom:1rem;font-size:.68rem;font-weight:800;letter-spacing:.12em;color:#b9473e}.plan-grid h3{margin:0 0 .6rem;font-size:1.35rem}.plan-grid strong{display:block;font-size:clamp(1.8rem,3vw,2.6rem);letter-spacing:-.04em;margin-bottom:1rem}.plan-grid p{margin:0;color:#655d58;line-height:1.68}.plan-note{max-width:850px;margin:1.4rem auto 0;color:#756c66;font-size:.9rem}@media(max-width:820px){.plan-grid{grid-template-columns:1fr}.plan-grid article.is-featured{transform:none}}
</style>
<Footer slot="footer" lang={lang}/></BaseLayout>
