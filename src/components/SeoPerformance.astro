---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ServicePage from './service/ServicePage.astro';
import { getPageSeo } from '../i18n/seo';
interface Props { lang: string; }
const { lang } = Astro.props;
const seo = getPageSeo('seo-performance');
const d = 'Üreticiler, toptancılar, ihracatçılar, perakende markaları ve büyüyen KOBİ’lerin Google, yanıt motorları ve yapay zekâ destekli arama sistemlerinde doğru bağlamla bulunmasını sağlayan teknik, içerik ve varlık altyapısını geliştiriyoruz.';
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="SEO, GEO, AEO ve AIO" service={{ name: 'SEO, GEO, AEO ve AIO', description: d }}>
<Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="SEO, GEO, AEO VE AIO" title="İşletmenizin yalnızca görünmesini değil, doğru biçimde anlaşılmasını sağlayın." lead={d} ctaPrimary="Görünürlük yapımızı değerlendirelim" ctaSecondary="Tüm hizmetler"
problem={{eyebrow:'KİMLER İÇİN UYGUN?',title:'Arama görünürlüğünü ticari büyüme ve marka güveniyle birlikte ele almak isteyen işletmeler için.',intro:['Arama dünyası artık yalnızca klasik Google sonuçlarından oluşmuyor. Kullanıcılar arama motorlarından, yapay zekâ destekli yanıt sistemlerinden, haritalardan, ürün sonuçlarından ve doğrudan cevap kutularından bilgi alıyor. Bu nedenle işletmenin teknik olarak erişilebilir, içerik olarak açık ve marka olarak tutarlı görünmesi gerekir.'],items:[{title:'Üreticiler ve ihracatçılar',text:'Teknik ürünlerini, üretim kabiliyetlerini, sertifikalarını ve hedef pazarlarını hem arama motorlarına hem kurumsal alıcılara doğru anlatmak isteyen işletmeler için.'},{title:'Toptancılar ve e-ticaret markaları',text:'Kategori, ürün, marka ve satın alma rehberi sayfalarıyla ticari aramalardan daha nitelikli trafik almak isteyen işletmeler için.'},{title:'Hizmet şirketleri ve büyüyen KOBİ’ler',text:'Uzmanlık alanlarını, hizmet bölgelerini, vaka çalışmalarını ve güven sinyallerini daha görünür hale getirmek isteyen işletmeler için.'}]}}
benefits={{eyebrow:'ÇÖZDÜĞÜ İŞ PROBLEMLERİ',title:'Arama görünürlüğü sorunu çoğu zaman yalnızca anahtar kelime eksikliği değildir.',lead:'Teknik engeller, yanlış sayfa yapısı, birbirini tekrar eden içerikler, zayıf marka sinyalleri ve ölçüm eksikliği birlikte çalıştığında işletme doğru sorgularda görünmez veya yanlış bağlamla değerlendirilir.',items:[{title:'İndeksleme ve tarama sorunları',text:'Arama motorları önemli sayfaları keşfedemez, gereksiz sayfaları önceliklendirir veya içerik ilişkilerini doğru anlayamaz.'},{title:'Arama niyetiyle uyumsuz içerik',text:'Sayfalar müşterinin gerçek sorularını yanıtlamak yerine genel tanıtım metinleriyle sınırlı kalır.'},{title:'Ürün ve hizmet mimarisinin zayıf olması',text:'Kategori, ürün, sektör, kullanım alanı ve hizmet sayfaları arasında anlamlı ilişki kurulmadığında konu otoritesi gelişmez.'},{title:'Marka ve varlık sinyallerinin tutarsızlığı',text:'İsim, hizmet, lokasyon, kurucu, sosyal profil ve iletişim bilgileri farklı kanallarda çelişirse güvenilirlik zayıflar.'},{title:'Yapay zekâ sistemlerinde bağlam eksikliği',text:'Açık tanımlar, soru-cevap yapıları, kaynak niteliğinde içerik ve doğrulanabilir işletme bilgileri yoksa marka yanlış veya eksik temsil edilebilir.'},{title:'Trafiğin ticari sonuca bağlanamaması',text:'Organik ziyaret, form, WhatsApp, telefon, teklif ve satış arasındaki ilişki ölçülmediğinde SEO çalışması yalnızca görünürlük raporuna dönüşür.'}]}}
included={{eyebrow:'QCT COMMERCE YAKLAŞIMI',title:'Teknik SEO, içerik mimarisi, varlık netliği ve dönüşüm birlikte çalışır.',lead:'SEO’yu sıralama takibiyle sınırlamayız. İşletmenin hangi sorulara, hangi pazarda, hangi içerik ve güven sinyalleriyle cevap vermesi gerektiğini belirler; Google ve yapay zekâ sistemlerinin anlayabileceği, müşterinin kullanabileceği bir yapı kurarız.',items:[{title:'Teknik SEO ve indekslenebilirlik',text:'Tarama, canonical, sitemap, robots, performans, mobil kullanım, yönlendirme ve indeksleme sorunları incelenir.'},{title:'Arama niyeti ve içerik haritası',text:'Ticari, bilgilendirici, karşılaştırmalı ve marka odaklı sorgular sayfa türleriyle eşleştirilir.'},{title:'GEO ve AEO içerik yapısı',text:'Net tanımlar, kısa cevaplar, derin açıklamalar, FAQ’lar ve kaynak gösterilebilir içerikler hazırlanır.'},{title:'AIO ve varlık sinyalleri',text:'Marka, kurucu, hizmet, ürün, lokasyon ve uzmanlık ilişkileri tutarlı biçimde yapılandırılır.'},{title:'Yapılandırılmış veri ve iç bağlantılar',text:'Uygun schema.org türleri ve konu ilişkisini güçlendiren doğal iç bağlantılar uygulanır.'},{title:'Dönüşüm ve performans ölçümü',text:'Organik görünürlük ile form, WhatsApp, teklif ve satış niyeti arasındaki ilişki izlenir.'}]}}
process={{eyebrow:'8 ADIMLI SÜREÇ',title:'Teknik engellerden sürdürülebilir görünürlük sistemine.',steps:[{number:'01',title:'İş ve pazar analizi',text:'Ürünleri, hizmetleri, hedef müşterileri, satış bölgelerini ve organik görünürlükten beklenen ticari sonucu netleştiririz.'},{number:'02',title:'Teknik denetim',text:'Tarama, indeksleme, hız, mobil kullanım, URL, canonical, sitemap, yönlendirme ve yapılandırılmış veri durumunu inceleriz.'},{number:'03',title:'Arama ve niyet araştırması',text:'Müşterilerin ürün, sorun, kategori, karşılaştırma ve satın alma aşamalarında kullandığı sorguları değerlendiririz.'},{number:'04',title:'İçerik ve sayfa mimarisi',text:'Ana sayfa, hizmet, kategori, ürün, sektör, lokasyon, rehber ve vaka çalışması sayfalarının görevini belirleriz.'},{number:'05',title:'Önceliklendirme planı',text:'Ticari etki, teknik gereklilik, rekabet ve uygulama maliyetine göre işleri sıralarız.'},{number:'06',title:'Teknik ve içerik uygulaması',text:'Metadata, başlıklar, içerik, iç bağlantılar, schema ve gerekli teknik düzeltmeleri uygularız.'},{number:'07',title:'Doğrulama ve ölçüm',text:'İndekslenebilirlik, schema, sayfa çıktıları, temel analitik olaylar ve arama konsolu verileri kontrol edilir.'},{number:'08',title:'İzleme ve gelişim',text:'Sorgu, sayfa, görünürlük ve dönüşüm verilerine göre yeni içerik ve iyileştirme fırsatları belirlenir.'}]}}
answers={{title:'SEO, GEO, AEO ve AIO arasındaki fark ve iş etkisi',lead:'Bu disiplinler farklı kanallara odaklansa da ortak amaç işletmenin doğru soruda, doğru bağlamla ve güvenilir bilgiyle bulunmasını sağlamaktır.',items:[{question:'SEO ne sağlar?',answer:'Sayfaların arama motorları tarafından taranmasını, anlaşılmasını ve ilgili sorgularda değerlendirilmesini destekler; teknik temel, içerik ve otorite sinyallerini kapsar.'},{question:'GEO neyi hedefler?',answer:'Üretken arama deneyimlerinde markanın ve içeriğin doğru bağlamla kullanılabilmesini destekleyen açık, kaynak niteliğinde ve konu ilişkileri güçlü içerik yapısına odaklanır.'},{question:'AEO neyi değiştirir?',answer:'Kullanıcının sorusuna doğrudan, kısa ve doğrulanabilir cevaplar sunarak yanıt kutuları, sesli arama ve cevap motorları için içeriği daha kullanılabilir hale getirir.'},{question:'AIO neden önemlidir?',answer:'Yapay zekâ sistemlerinin marka, hizmet, uzmanlık ve varlık ilişkilerini tutarlı biçimde anlamasına yardımcı olan teknik ve içerik sinyallerini güçlendirir.'},{question:'Dönüşüm odaklı SEO ne demektir?',answer:'Yalnızca trafik artışını değil, doğru kullanıcının ürün, teklif, iletişim, WhatsApp veya satın alma adımına ilerlemesini hedefleyen görünürlük yaklaşımıdır.'}]}}
relatedLinks={[{title:'B2B web tasarım',text:'Semantik, hızlı, erişilebilir ve arama sistemleri tarafından anlaşılabilir web temelini kurun.',href:'/web-tasarim/'},{title:'E-ticaret çözümleri',text:'Kategori ve ürün mimarisini arama niyeti, ürün verisi ve dönüşüm hedefiyle birlikte planlayın.',href:'/e-ticaret/'},{title:'Meta reklamları ve landing page',text:'Organik görünürlüğü ücretli kampanya verileri ve dönüşüm odaklı sayfalarla tamamlayın.',href:'/meta-reklamlari/'},{title:'E-ticaret ve dijital büyüme blogu',text:'Müşteri sorularını ayrıntılı, doğrulanabilir ve doğal iç bağlantılarla desteklenen içeriklerle yanıtlayın.',href:'/blog/'}]}
faq={{eyebrow:'SIK SORULANLAR',title:'SEO, GEO, AEO ve AIO hakkında',items:[{q:'SEO, GEO, AEO ve AIO aynı şey mi?',a:'Hayır. SEO klasik arama görünürlüğünü, GEO üretken arama deneyimlerini, AEO doğrudan yanıt sistemlerini, AIO ise yapay zekâ sistemlerinin marka ve içerik bağlamını anlamasını destekler.'},{q:'Google’da birinci sıra garantisi veriyor musunuz?',a:'Hayır. Arama sistemleri üçüncü taraf platformlardır ve sıralamalar birçok etkene bağlıdır. Teknik ve içerik altyapısını güçlendirir, ölçülebilir gelişim hedefleriz.'},{q:'Ne kadar sürede sonuç alınır?',a:'Süre teknik durum, rekabet, site geçmişi, içerik kapsamı ve uygulama hızına bağlıdır. Bazı teknik etkiler erken görülürken rekabetçi sorgular daha uzun sürebilir.'},{q:'Yeni web sitesi olmadan SEO yapılabilir mi?',a:'Evet. Mevcut altyapı uygunsa iyileştirme yapılabilir. Ancak teknik sınırlar büyümeyi engelliyorsa yeniden yapılandırma gerekebilir.'},{q:'E-ticaret siteleri için SEO yapıyor musunuz?',a:'Evet. Kategori, ürün, filtre, varyasyon, stok dışı sayfalar, ürün verisi, iç bağlantı ve ticari arama niyeti e-ticaret özelinde ele alınır.'},{q:'İçerikleri siz hazırlıyor musunuz?',a:'Kapsama göre hizmet, kategori, ürün, rehber, FAQ ve vaka çalışması içerikleri planlanabilir veya mevcut içerikler yeniden yapılandırılabilir.'},{q:'Yapay zekâ tarafından kaynak gösterilme garantisi var mı?',a:'Hayır. Üçüncü taraf yapay zekâ sistemlerinin kaynak seçimi garanti edilemez. İçeriğin açık, tutarlı, doğrulanabilir ve kaynak olmaya uygun hale gelmesini destekleriz.'},{q:'Schema kullanmak sıralamayı garanti eder mi?',a:'Hayır. Yapılandırılmış veri içeriğin anlamını açıklamaya yardımcı olur; tek başına sıralama garantisi vermez ve yalnızca sayfada gerçekten bulunan bilgiler için kullanılmalıdır.'},{q:'Yerel SEO çalışması yapıyor musunuz?',a:'İşletme lokasyonu, hizmet bölgesi, Google işletme profili ve yerel sayfa ihtiyacı gerçek operasyon ve doğrulanabilir bilgiler temelinde değerlendirilebilir.'},{q:'Çok dilli SEO yapılabilir mi?',a:'Evet. Dil ve ülke hedefleri, URL yapısı, hreflang, çeviri eşdeğerliği ve yerel arama niyeti ayrı ayrı planlanır.'},{q:'Backlink hizmeti veriyor musunuz?',a:'Kalitesiz veya yapay bağlantı paketleri uygulamıyoruz. Gerçek yayın, iş ortaklığı, sektör kaynağı ve değerli içerik temelli kazanımlar ayrıca değerlendirilebilir.'},{q:'SEO çalışmasını nasıl ölçüyorsunuz?',a:'İndeksleme, sorgu görünürlüğü, nitelikli organik trafik, önemli sayfa performansı ve form, WhatsApp veya teklif gibi ticari eylemler birlikte izlenir.'},{q:'Mevcut ajansımız veya yazılım ekibimizle çalışabilir misiniz?',a:'Evet. Teknik bulgular ve içerik planı açık görevler halinde paylaşılabilir; uygulama sorumluluğu ve doğrulama süreci başlangıçta netleştirilir.'}]}}
final={{title:'Arama motorları ve yapay zekâ sistemleri işletmenizi doğru bağlamla anlayabilsin.',text:'Mevcut görünürlüğünüzü, hedef pazarınızı ve öncelikli ürün veya hizmet grubunuzu paylaşın; en yüksek etkili başlangıç alanını birlikte belirleyelim.',cta:'Görünürlük yapımızı inceleyelim',ctaSecondary:'E-posta gönderin'}}/><Footer slot="footer" lang={lang}/></BaseLayout>