---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  platform: 'Shopify' | 'ikas';
  title: string;
  description: string;
  heading: string;
  lead: string;
  strengths: string[];
  faqItems: Array<{ q: string; a: string }>;
}
const { platform, title, description, heading, lead, strengths, faqItems } = Astro.props;
const calculatorHref = `/?platform=${platform.toLowerCase()}#fiyat-hesapla`;
const platformPlan = platform === 'ikas' ? {
  intro: 'Türkiye odaklı mağazalarda önce ürün yapısını, yerel ödeme-kargo gereksinimlerini ve mevcut operasyonu netleştiriyoruz. ikas paketinin sunduğu entegrasyonlar, işlem koşulları ve ücretler satın alma aşamasında ayrıca doğrulanır.',
  strengths: [
    'Kategori ağacı, ana sayfa ve ürün detay şablonunu markanın gerçek ürün sayısı ve varyantlarına göre düzenliyoruz.',
    'SKU, beden-renk seçenekleri, stok ve görsellerin aktarım kapsamını belirleyip örnek ürünlerle doğruluyoruz.',
    'Mobilde kategori keşfi, ürün seçimi ve teklif/satın alma çağrısını ilk ekrandan itibaren kontrol ediyoruz.',
    'URL, metadata, taranabilirlik ve ölçüm kurulumunu yayına çıkmadan önce test ediyoruz.',
  ],
  steps: [
    { title: 'ikas mağaza açma hazırlığı', text: 'Hesap ve paket seçimi, alan adı, marka varlıkları, kategori planı ve gerekli satış kanalları için kontrol listesi oluşturulur.' },
    { title: 'Ürün ve varyasyon aktarımı', text: 'Ürün adı, SKU, varyant, stok ve görsellerin kaynak formatı incelenir; geçiş varsa URL eşleştirmeleri ve yönlendirmeler ayrıca planlanır.' },
    { title: 'Ödeme, kargo ve canlı test', text: 'İşletmenin kullanabildiği ödeme ve kargo bağlantıları doğrulanır; mobil sepet, sipariş, e-posta bildirimleri ve ölçüm akışı test edilir.' },
  ],
  costNote: '9.900 TL, standart kurulum hizmetinin başlangıç bedelidir. ikas aboneliği, ücretli tema/uygulama, ürün sayısına göre veri çalışması veya özel entegrasyonlar kapsam dışı olabilir.',
} : {
  intro: 'Shopify mağaza kurulumunda öncelikle satış yapılacak ülke, para birimi, ödeme sağlayıcısı uygunluğu ve ürün operasyonlarını belirliyoruz. Uygulama ekosistemindeki seçenekleri ihtiyaç ve toplam aylık maliyet açısından değerlendiriyoruz.',
  strengths: [
    'Tema bölümleri, navigasyon, koleksiyonlar ve ürün detayları markanın alışveriş yolculuğuna göre uyarlanır.',
    'Ürün varyantları, koleksiyonlar, görseller ve filtre ihtiyacı birlikte ele alınarak kategori keşfi sadeleştirilir.',
    'Mobil ürün sayfası, sepet, ödeme yönlendirmeleri ve zorunlu bilgiler gerçek kullanıcı senaryolarıyla kontrol edilir.',
    'Temel meta alanları, koleksiyon/ürün indeksleme sinyalleri, hız ve GA4 olayları yayına çıkmadan denetlenir.',
  ],
  steps: [
    { title: 'Shopify mağaza açma hazırlığı', text: 'Alan adı, para birimi, dil, satış ülkesi ve uygun Shopify planı belirlenir; Türkiye merkezli işletmeler için ödeme sağlayıcılarının erişilebilirliği ayrıca kontrol edilir.' },
    { title: 'Tema, koleksiyon ve ürün kurulumu', text: 'Menü, koleksiyon, ürün varyantları, görsel oranları, mobil ürün kartları ve stok mantığı gerçek katalog örneği üzerinden yapılandırılır.' },
    { title: 'Entegrasyon ve yayın öncesi kontrol', text: 'Kargo, vergi, sipariş bildirimleri, yönlendirmeler, erişilebilirlik ve ölçüm test edilir; ücretli uygulamalar yalnız gerekliyse kapsama dahil edilir.' },
  ],
  costNote: '9.900 TL, standart kurulum hizmetinin başlangıç bedelidir. Shopify planı, ücretli tema/uygulamalar, ödeme komisyonları, özel entegrasyonlar ve kapsam dışı veri aktarımı ayrıca fiyatlandırılabilir.',
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout title={title} description={description} lang="tr" breadcrumbLabel={platform + ' mağaza kurulumu'}>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header slot="header" lang="tr" />
  <link rel="stylesheet" href="/styles/qct-v2.css?v=20261101-edge-elite" />
  <div class="qct-v2">
    <section class="qct-platform-hero">
      <div class="qct-shell qct-platform-hero-grid">
        <div>
          <p class="qct-eyebrow">{platform.toUpperCase()} MAĞAZA KURULUMU</p>
          <h1>{heading}</h1>
          <p class="qct-lead">{lead}</p>
          <div class="qct-hero-actions">
            <a class="qct-btn qct-btn-primary" href={calculatorHref}>9.900 TL’den fiyatını hesapla <span>→</span></a>
            <a class="qct-text-link" href="/iletisim/">Projeniz için teklif isteyin</a>
            <a class="qct-text-link" href="/fiyatlar/">Tüm fiyatları gör</a>
          </div>
        </div>
        <aside class="qct-platform-price">
          <span>Başlangıç fiyatı</span>
          <strong>9.900 TL</strong>
          <p>Standart kurulum, mobil düzen, temel teknik SEO ve yayına hazırlık.</p>
          <ul>
            <li>Mağaza temel ayarları</li>
            <li>Tema ve mobil düzen</li>
            <li>Menü / kategori yapısı</li>
            <li>Ödeme ve kargo ayarları</li>
            <li>Temel SEO & ölçüm kontrolü</li>
            <li>Yayın öncesi QA</li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="qct-platform-detail">
      <div class="qct-shell">
        <div class="qct-section-head">
          <div><p class="qct-section-label">SATIŞA HAZIR KURULUM</p><h2>Sadece mağaza açmıyoruz.<br/><em>Çalışan sistemi kuruyoruz.</em></h2></div>
          <p>{platform} mağazanızı tema kurup bırakmak yerine ürün keşfi, mobil kullanım, güven, ölçüm ve satış akışıyla birlikte ele alıyoruz.</p>
        </div>
        <div class="qct-benefit-grid">
          {strengths.map((item, index) => <article><h3>{item}</h3><p>{platformPlan.strengths[index]}</p></article>)}
        </div>
      </div>
    </section>

    <section class="qct-platform-detail qct-platform-checklist" aria-labelledby="qct-platform-checklist-title">
      <div class="qct-shell">
        <div class="qct-section-head">
          <div>
            <p class="qct-section-label">KURULUM REHBERİ</p>
            <h2 id="qct-platform-checklist-title">{platform} mağaza kurulumu nasıl ilerler?</h2>
          </div>
          <p>{platformPlan.intro}</p>
        </div>
        <div class="qct-benefit-grid">
          {platformPlan.steps.map((step) => <article><h3>{step.title}</h3><p>{step.text}</p></article>)}
        </div>
        <p class="qct-platform-checklist__cost">{platformPlan.costNote}</p>
        <nav class="qct-hero-actions" aria-label={`${platform} kurulumu için ilgili rehberler`}>
          <a class="qct-text-link" href={platform === 'ikas' ? '/blog/ikas-fiyatlari-2026-kurulum-tema-seo-maliyetleri/' : '/blog/shopify-magaza-kurma-rehberi/'}>
            {platform === 'ikas' ? 'ikas paket, kurulum ve tema maliyetleri →' : 'Shopify mağaza kurma rehberi →'}
          </a>
          <a class="qct-text-link" href="/blog/ikas-mi-shopify-mi-2026/">ikas mı Shopify mı? İki altyapıyı karşılaştırın →</a>
        </nav>
      </div>
    </section>

    <section class="qct-platform-process">
      <div class="qct-shell">
        <p class="qct-section-label">SÜREÇ</p>
        <div class="qct-offer-grid">
          <div><span>01 — Analiz</span><small>Ürün, kategori, ödeme, kargo, marka ve mevcut varlıklar.</small></div>
          <div><span>02 — Yapı</span><small>Menü, kategori, ürün şablonu, tema ve mobil deneyim.</small></div>
          <div><span>03 — Kurulum</span><small>Teknik ayarlar, gerekli entegrasyonlar ve ürün hazırlığı.</small></div>
          <div><span>04 — QA & yayın</span><small>Mobil, ödeme, kargo, SEO, analitik ve dönüşüm kontrolleri.</small></div>
        </div>
      </div>
    </section>

    <section class="qct-pricing-faq">
      <div class="qct-shell">
        <p class="qct-section-label">SIK SORULANLAR</p>
        <h2>{platform} kurulumu hakkında</h2>
        <div class="qct-faq-grid">
          {faqItems.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
        </div>
      </div>
    </section>

    <section class="qct-close">
      <div class="qct-shell qct-close-grid">
        <div><p class="qct-section-label">ŞEFFAF BAŞLANGIÇ</p><h2>{platform} mağazanızı <em>satışa hazırlayalım.</em></h2></div>
        <div class="qct-hero-actions"><a class="qct-btn qct-btn-light" href={calculatorHref}>Fiyatını hesapla <span>→</span></a><a class="qct-text-link" href="/iletisim/">Teklif talebi gönderin →</a></div>
      </div>
    </section>
  </div>
  <Footer slot="footer" lang="tr" />
</BaseLayout>
