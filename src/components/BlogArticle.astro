---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { BlogArticle } from '../data/blog';
import { getPageSeo } from '../i18n/seo';

interface Props { article: BlogArticle; }
const { article } = Astro.props;
const seo = getPageSeo(article.seoKey);
const SITE_URL = 'https://qctcommerce.com';
const canonicalUrl = new URL(`/blog/${article.slug}/`, SITE_URL).toString();
const articleId = `${canonicalUrl}#article`;
const webpageId = `${canonicalUrl}#webpage`;
const organizationId = `${SITE_URL}/#organization`;
const formatDate = (value: string) => new Intl.DateTimeFormat('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${value}T12:00:00+03:00`));
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': articleId,
  headline: article.title,
  description: seo.description,
  datePublished: article.published,
  dateModified: article.modified,
  inLanguage: 'tr-TR',
  image: new URL('/og-default.png', SITE_URL).toString(),
  author: { '@id': organizationId },
  publisher: { '@id': organizationId },
  mainEntityOfPage: { '@id': webpageId },
  about: { '@type': 'Thing', name: 'E-ticaret ve dijital satış' },
};
---
<BaseLayout title={seo.title} description={seo.description} lang="tr" breadcrumbLabel={article.title}>
  <Header slot="header" lang="tr" />
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="qct-article" aria-labelledby="qct-article-title">
    <header class="qct-article__hero">
      <div class="container qct-article__hero-inner">
        <nav class="qct-breadcrumb" aria-label="Sayfa yolu">
          <a href="/">Ana sayfa</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a><span aria-hidden="true">/</span><span aria-current="page" aria-label={`Makale: ${article.title}`}>Makale</span>
        </nav>
        <p class="qct-section__eyebrow">E-TİCARET REHBERİ</p>
        <h1 id="qct-article-title">{article.title}</h1>
        <p class="qct-article__intro">{article.intro}</p>
        <div class="qct-article__meta">
          <span>QCT Commerce</span>
          <span>Yayımlandı: <time datetime={article.published}>{formatDate(article.published)}</time></span>
          <span>Güncellendi: <time datetime={article.modified}>{formatDate(article.modified)}</time></span>
        </div>
      </div>
    </header>

    <div class="container qct-article__layout">
      <aside class="qct-article__summary" aria-labelledby="qct-summary-title">
        <h2 id="qct-summary-title">Kısa cevap</h2>
        <ul>{article.summary.map((item) => <li>{item}</li>)}</ul>
      </aside>

      <div class="qct-article__body">
        {article.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
          </section>
        ))}

        <aside class="qct-article__related" aria-labelledby="qct-related-service-title">
          <p class="qct-section__eyebrow">İLGİLİ HİZMET</p>
          <h2 id="qct-related-service-title">Bu konuyu işletmenizin altyapısına uygulayın.</h2>
          <a href={article.relatedService.href}>{article.relatedService.label}<span aria-hidden="true"> →</span></a>
        </aside>

        <nav class="qct-article__more" aria-label="Blog bağlantıları">
          <a href="/blog/">Tüm rehberler</a>
          <a href="/iletisim/">Bu konu için ilk adımı belirleyin</a>
        </nav>
      </div>
    </div>
  </article>
  <Footer slot="footer" lang="tr" />
</BaseLayout>

<style>
  .qct-article { background: var(--qct-color-background); color: var(--qct-color-text); }
  .qct-article__hero { border-bottom: 1px solid var(--qct-color-line); padding: calc(var(--qct-hero-clearance) + clamp(42px, 6vw, 78px)) 0 clamp(52px, 7vw, 88px); }
  .qct-article__hero-inner { max-width: 1040px; }
  .qct-article h1 { color: var(--qct-color-ink); font-family: var(--qct-font-sans); font-size: clamp(2.625rem, 4.4vw, 4rem); line-height: 1.05; letter-spacing: -0.04em; max-width: 20ch; margin: 0 0 1.5rem; overflow-wrap: normal; text-wrap: balance; word-break: normal; }
  .qct-article__intro { color: var(--qct-color-muted); font-size: clamp(1.05rem, 1.5vw, 1.24rem); line-height: 1.72; max-width: 800px; }
  .qct-article__meta { border-top: 1px solid var(--qct-color-line); color: var(--qct-color-muted); display: grid; font-size: 0.92rem; gap: 0.55rem 1.5rem; grid-template-columns: repeat(3, max-content); margin-top: 2rem; padding-top: 1rem; }
  .qct-article__meta span:first-child { color: var(--qct-color-ink); font-weight: 700; }
  .qct-article__layout { display: grid; gap: clamp(36px, 6vw, 90px); grid-template-columns: minmax(220px, 0.36fr) minmax(0, 0.9fr); padding-block: clamp(58px, 8vw, 104px); }
  .qct-article__summary { align-self: start; border-top: 3px solid var(--qct-color-accent); padding-top: 1.25rem; position: sticky; top: var(--qct-anchor-offset); }
  .qct-article__summary h2 { color: var(--qct-color-ink); font-family: var(--qct-font-sans); font-size: 1.2rem; margin: 0 0 1rem; }
  .qct-article__summary ul { display: grid; gap: 0.8rem; list-style: none; margin: 0; padding: 0; }
  .qct-article__summary li { color: var(--qct-color-muted); font-size: 0.96rem; line-height: 1.62; padding-left: 1.15rem; position: relative; }
  .qct-article__summary li::before { background: var(--qct-color-accent); content: ''; height: 2px; left: 0; position: absolute; top: 0.75em; width: 8px; }
  .qct-article__body { min-width: 0; }
  .qct-article__body > section { border-top: 1px solid var(--qct-color-line-strong); padding-block: clamp(28px, 4vw, 46px); }
  .qct-article__body h2 { color: var(--qct-color-ink); font-family: var(--qct-font-sans); font-size: clamp(1.55rem, 2.7vw, 2.25rem); line-height: 1.22; margin: 0 0 1.25rem; text-wrap: balance; }
  .qct-article__body p, .qct-article__body li { color: var(--qct-color-muted); font-size: 1rem; line-height: 1.78; }
  .qct-article__body p { margin: 0 0 1rem; }
  .qct-article__body ul { display: grid; gap: 0.55rem; margin: 1.25rem 0 0; padding-left: 1.25rem; }
  .qct-article__related { background: var(--qct-color-ink); margin-top: 2rem; padding: clamp(28px, 5vw, 48px); }
  .qct-article__related .qct-section__eyebrow { color: var(--qct-color-coral-light); }
  .qct-article__related h2 { color: var(--qct-color-on-dark); max-width: 20ch; }
  .qct-article__related a { color: var(--qct-color-on-dark); font-weight: 700; text-underline-offset: 0.25em; }
  .qct-article__more { border-top: 1px solid var(--qct-color-line-strong); display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 3rem; padding-top: 1.5rem; }
  .qct-article__more a { color: var(--qct-color-accent-strong); font-weight: 700; }
  .qct-article a:focus-visible { outline: 2px solid var(--qct-color-accent-strong); outline-offset: 4px; }
  @media (max-width: 760px) {
    .qct-article__layout { grid-template-columns: minmax(0, 1fr); }
    .qct-article__summary { position: static; }
    .qct-article h1 { font-size: clamp(2.375rem, 10.2vw, 2.75rem); line-height: 1.06; max-width: 18ch; }
    .qct-article__meta { grid-template-columns: minmax(0, 1fr); }
  }
</style>
