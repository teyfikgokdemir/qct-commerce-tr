<script is:inline>
(() => {
  const root = document.querySelector('[data-qct-v2]');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const form = root.querySelector('[data-price-form]');
  const service = root.querySelector('[data-service]');
  const products = root.querySelector('[data-products]');
  const addons = [...root.querySelectorAll('[data-addon]')];
  const totalNode = root.querySelector('[data-total]');
  const noteNode = root.querySelector('[data-result-note]');
  const whatsapp = root.querySelector('[data-whatsapp]');
  const progress = [...root.querySelectorAll('.qct-builder-progress span')];

  const money = new Intl.NumberFormat('tr-TR');
  const track = (name, params = {}) => {
    if (typeof window.qctTrackEvent === 'function') window.qctTrackEvent(name, params);
  };
  let pricingStarted = false;
  let lastPricingCompleteKey = '';

  function calculate() {
    const selectedService = service?.selectedOptions?.[0];
    const hasService = Boolean(service?.value);
    const base = Number(selectedService?.dataset.base || 0);
    const productPrice = Number(products?.selectedOptions?.[0]?.dataset.price || 0);
    const addonPrice = addons.reduce((sum, input) => sum + (input.checked ? Number(input.value) : 0), 0);
    const total = base + productPrice + addonPrice;
    const platform = root.querySelector('[data-platform]');
    const completed = [Boolean(service?.value), Boolean(platform?.value), Boolean(products?.value)].filter(Boolean).length;
    progress.forEach((step, index) => step.classList.toggle('is-active', index < completed));

    if (hasService && completed === 3) {
      const completeKey = [service?.value, platform?.value, products?.value, addonPrice].join('|');
      if (completeKey !== lastPricingCompleteKey) {
        track('pricing_complete', {
          service: service?.value || undefined,
          platform: platform?.value || undefined,
          product_scope: products?.value || undefined,
          pricing_value: total,
        });
        lastPricingCompleteKey = completeKey;
      }
    }

    if (totalNode) {
      const nextText = hasService ? (total > 0 ? money.format(total) + ' TL’den' : 'Kapsama göre') : 'Seçiminizi yapın';
      if (totalNode.textContent !== nextText) {
        totalNode.textContent = nextText;
        totalNode.classList.remove('is-updating');
        void totalNode.offsetWidth;
        totalNode.classList.add('is-updating');
      }
    }
    if (noteNode) noteNode.textContent = hasService
      ? 'Gösterilen tutar standart kapsam için başlangıç fiyatıdır; proje detayına göre değişebilir.'
      : 'İhtiyacınızı seçtiğinizde başlangıç fiyatı anında hesaplanır.';

    const serviceText = hasService ? (selectedService?.textContent?.trim() || 'Web projesi') : '';
    const productText = products?.value ? (products?.selectedOptions?.[0]?.textContent?.trim() || '') : '';
    const message = 'Merhaba, QCT Commerce fiyat hesaplayıcıdan geldim. ' + serviceText + (productText ? ', ' + productText : '') + '. Başlangıç fiyatı: ' + (total > 0 ? money.format(total) + ' TL’den' : 'kapsama göre') + '. Detayları görüşmek istiyorum.';
    if (whatsapp) {
      whatsapp.classList.toggle('is-disabled', !hasService);
      whatsapp.setAttribute('aria-disabled', String(!hasService));
      whatsapp.href = hasService
        ? 'https://wa.me/905456782655?text=' + encodeURIComponent(message)
        : 'https://wa.me/905456782655';
      whatsapp.dataset.analyticsService = service?.value || '';
      whatsapp.dataset.analyticsPlatform = platform?.value || '';
      whatsapp.dataset.analyticsProductScope = products?.value || '';
      whatsapp.dataset.analyticsPricingValue = total > 0 ? String(total) : '';
    }
  }

  form?.addEventListener('change', (event) => {
    const changed = event.target;
    if (changed instanceof HTMLInputElement && changed.matches('[data-addon-group="visibility"]') && changed.checked) {
      addons
        .filter((input) => input !== changed && input.dataset.addonGroup === 'visibility')
        .forEach((input) => { input.checked = false; });
    }
    if (!pricingStarted) {
      pricingStarted = true;
      track('pricing_start');
    }
    calculate();
  });
  whatsapp?.addEventListener('click', (event) => {
    if (whatsapp.getAttribute('aria-disabled') === 'true') event.preventDefault();
  });
  calculate();

  const banner = root.querySelector('[data-intro-banner]');
  const close = root.querySelector('[data-intro-close]');
  const key = 'qct-v2-intro-seen';

  try {
    if (banner && !localStorage.getItem(key)) {
      window.setTimeout(() => {
        banner.hidden = false;
        requestAnimationFrame(() => banner.classList.add('is-visible'));
        localStorage.setItem(key, '1');
        window.setTimeout(() => {
          banner.classList.remove('is-visible');
          window.setTimeout(() => { banner.hidden = true; }, 420);
        }, 3000);
      }, 450);
    }
  } catch {}

  close?.addEventListener('click', () => {
    banner?.classList.remove('is-visible');
    window.setTimeout(() => { if (banner) banner.hidden = true; }, 250);
  });
})();
</script>
