<script is:inline>
(() => {
  const root = document.querySelector('[data-qct-v2]');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const form = root.querySelector('[data-price-form]');
  const service = root.querySelector('[data-service]');
  const products = root.querySelector('[data-products]');
  const platform = root.querySelector('[data-platform]');
  const platformLabel = root.querySelector('[data-platform-label]');
  const platformHelp = root.querySelector('[data-platform-help]');
  const priceLabel = root.querySelector('[data-price-label]');
  const addonFieldset = root.querySelector('[data-addons-fieldset]');
  const marketOptions = [...root.querySelectorAll('[data-market-option]')];
  const addons = [...root.querySelectorAll('[data-addon]')];
  const totalNode = root.querySelector('[data-total]');
  const noteNode = root.querySelector('[data-result-note]');
  const whatsapp = root.querySelector('[data-whatsapp]');
  const progress = [...root.querySelectorAll('.qct-builder-progress span')];

  const money = new Intl.NumberFormat('tr-TR');
  const track = (name, params = {}) => {
    if (typeof window.qctTrackEvent === 'function') window.qctTrackEvent(name, params);
  };
  let pricingStarted = false;
  let pricingCompleted = false;

  // Only recognised platform deep links may preselect a service; the visitor still chooses product scope.
  const requestedPlatform = new URLSearchParams(window.location.search).get('platform');
  if (['ikas', 'shopify'].includes(requestedPlatform) && service && platform) {
    service.value = 'ecommerce';
    platform.value = requestedPlatform;
  }

  function calculate() {
    const selectedService = service?.selectedOptions?.[0];
    const hasService = Boolean(service?.value);
    const isMarketplace = service?.value === 'marketplace';
    const requiresQuote = isMarketplace || service?.value === 'premium-infrastructure';
    const base = Number(selectedService?.dataset.base || 0);
    marketOptions.forEach((option) => { option.hidden = !isMarketplace; option.disabled = !isMarketplace; });
    [...platform.options].filter((option) => option.value && !option.hasAttribute('data-market-option')).forEach((option) => { option.hidden = isMarketplace; option.disabled = isMarketplace; });
    if (platform.selectedOptions[0]?.disabled) platform.value = '';
    if (platformLabel) platformLabel.textContent = isMarketplace ? 'Pazaryeri' : 'Altyapı';
    if (platformHelp) platformHelp.textContent = isMarketplace ? 'Mağaza kurulacak satış kanalını seçin' : 'Kullandığınız veya tercih ettiğiniz platform';
    if (priceLabel) priceLabel.textContent = requiresQuote ? 'PROJENİZE ÖZEL TEKLİF' : 'PROJENİZİN BAŞLANGIÇ FİYATI';
    if (addonFieldset) addonFieldset.hidden = requiresQuote;
    const productOption = products?.selectedOptions?.[0];
    const productPrice = requiresQuote ? 0 : service?.value === 'ecommerce' && productOption?.dataset.ecommercePrice !== undefined ? Number(productOption.dataset.ecommercePrice || 0) : Number(productOption?.dataset.price || 0);
    const addonPrice = requiresQuote ? 0 : addons.reduce((sum, input) => sum + (input.checked ? Number(input.value) : 0), 0);
    const total = base + productPrice + addonPrice;
    const completed = [Boolean(service?.value), Boolean(platform?.value), Boolean(products?.value)].filter(Boolean).length;
    progress.forEach((step, index) => step.classList.toggle('is-active', index < completed));

    // A completed pricing journey is a once-per-page interaction, not a lead.
    // Avoid inflated GA4 counts when users tweak add-ons or revisit options.
    if (pricingStarted && !pricingCompleted && hasService && completed === 3 && !requiresQuote) {
      track('pricing_complete', {
        service: service?.value || undefined,
        platform: platform?.value || undefined,
        product_scope: products?.value || undefined,
        pricing_value: total,
      });
      pricingCompleted = true;
    }

    if (totalNode) {
      const nextText = hasService ? (requiresQuote ? 'Özel teklif' : total > 0 ? money.format(total) + ' TL’den' : 'Kapsama göre') : 'Seçiminizi yapın';
      if (totalNode.textContent !== nextText) {
        totalNode.textContent = nextText;
        totalNode.classList.remove('is-updating');
        void totalNode.offsetWidth;
        totalNode.classList.add('is-updating');
      }
    }
    if (noteNode) noteNode.textContent = hasService
      ? (isMarketplace ? 'Pazaryeri, ürün adedi ve entegrasyon ihtiyacına göre teklif hazırlanır. Platform masrafları dahil değildir.' : service?.value === 'premium-infrastructure' ? 'Altyapı, içerik, entegrasyon, dil ve sürekli optimizasyon ihtiyacına göre özel teklif hazırlanır.' : 'Gösterilen tutar standart kapsam için başlangıç fiyatıdır; proje detayına göre değişebilir.')
      : 'İhtiyacınızı seçtiğinizde başlangıç fiyatı anında hesaplanır.';

    const serviceText = hasService ? (selectedService?.textContent?.trim() || 'Web projesi') : '';
    const productText = products?.value ? (products?.selectedOptions?.[0]?.textContent?.trim() || '') : '';
    const platformText = platform?.value ? platform.selectedOptions[0].textContent.trim() : 'Henüz seçilmedi';
    const addonText = (requiresQuote ? [] : addons.filter((input) => input.checked))
      .map((input) => input.closest('label').querySelector('span').textContent.trim().replace(/\s+/g, ' '))
      .join('; ') || 'Yok';
    const message = 'Merhaba, QCT Commerce fiyat hesaplayıcıdan geldim. Hizmet: ' + serviceText
      + '. Altyapı: ' + platformText + '. Ürün kapsamı: ' + (productText || 'Henüz seçilmedi')
      + '. Ek hizmetler: ' + addonText + '. Başlangıç fiyatı: '
      + (requiresQuote ? 'özel teklif talep ediyorum' : total > 0 ? money.format(total) + ' TL’den' : 'kapsama göre') + '. Detayları görüşmek istiyorum.';
    if (whatsapp) {
      whatsapp.classList.toggle('is-disabled', !hasService);
      whatsapp.setAttribute('aria-disabled', String(!hasService));
      whatsapp.href = hasService
        ? 'https://wa.me/905456782655?text=' + encodeURIComponent(message)
        : 'https://wa.me/905456782655';
      whatsapp.dataset.analyticsService = service?.value || '';
      whatsapp.dataset.analyticsPlatform = platform?.value || '';
      whatsapp.dataset.analyticsProductScope = products?.value || '';
      whatsapp.dataset.analyticsPricingValue = !requiresQuote && total > 0 ? String(total) : '';
    }
  }

  form?.addEventListener('change', (event) => {
    if (event.target === service) {
      platform.value = '';
    }
    const changed = event.target;
    if (changed instanceof HTMLInputElement && changed.matches('[data-addon-group="visibility"]') && changed.checked) {
      addons
        .filter((input) => input !== changed && input.dataset.addonGroup === 'visibility')
        .forEach((input) => { input.checked = false; });
    }
    if (!pricingStarted) {
      pricingStarted = true;
      track('pricing_start');
    }
    calculate();
  });
  whatsapp?.addEventListener('click', (event) => {
    if (whatsapp.getAttribute('aria-disabled') === 'true') event.preventDefault();
  });
  calculate();

})();
</script>
