---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getLocalizedUrl } from '../i18n';
import { getPageSeo } from '../i18n/seo';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const url = (path: string) => getLocalizedUrl(lang, path);
const seo = getPageSeo('work', lang);

const copy = {
  en: {
    breadcrumb: 'Home',
    eyebrow: 'Selected work',
    title: 'Real businesses. Digital work built to be used.',
    lead: 'A selection of live websites and commerce systems created by QCT Studio for product, beauty, manufacturing and corporate businesses.',
    caseStudy: 'Read case study',
    website: 'Visit website',
    labels: {
      headwear: 'Multilingual e-commerce',
      misima: 'Cosmetics and B2B website',
      artman: 'Corporate supply website',
      phiaderm: 'Kozmetički e-commerce',
    },
    descriptions: {
      headwear: 'A multilingual store for performance and outdoor products, structured around clear product discovery and mobile shopping.',
      misima: 'Website strategy, design and development for a cosmetics group serving brands and international markets.',
      artman: 'A corporate website that presents an Istanbul-based supplier and its business offering with clarity.',
      phiaderm: 'A beauty storefront designed and developed to present products through a clear commerce experience.',
    },
  },
  sq: {
    breadcrumb: 'Ballina',
    eyebrow: 'Punë të përzgjedhura',
    title: 'Biznese reale. Punë digjitale e ndërtuar për t’u përdorur.',
    lead: 'Një përzgjedhje faqesh dhe sistemesh commerce aktive, krijuar nga QCT Studio për biznese produktesh, bukurie, prodhimi dhe korporative.',
    caseStudy: 'Lexoni studimin e rastit',
    website: 'Vizitoni faqen',
    labels: {
      headwear: 'E-commerce shumëgjuhësh',
      misima: 'Kozmetikë dhe faqe B2B',
      artman: 'Faqe furnizimi korporativ',
      phiaderm: 'E-commerce bukurie',
    },
    descriptions: {
      headwear: 'Dyqan shumëgjuhësh për produkte performance dhe outdoor, i strukturuar për zbulim të qartë dhe blerje në celular.',
      misima: 'Strategji, dizajn dhe zhvillim faqeje për një grup kozmetik që u shërben markave dhe tregjeve ndërkombëtare.',
      artman: 'Faqe korporative që paraqet qartë një furnizues me bazë në Stamboll dhe ofertën e tij.',
      phiaderm: 'Dyqan bukurie i dizajnuar dhe zhvilluar për t’i paraqitur produktet përmes një përvoje të qartë commerce.',
    },
  },
  mk: {
    breadcrumb: 'Дома',
    eyebrow: 'Избрани проекти',
    title: 'Вистински бизниси. Дигитални решенија создадени за употреба.',
    lead: 'Избор од активни веб-страници и e-commerce системи создадени од QCT Studio за производни, козметички, индустриски и корпоративни бизниси.',
    caseStudy: 'Прочитајте ја студијата',
    website: 'Посетете ја веб-страницата',
    labels: {
      headwear: 'Повеќејазична е-трговија',
      misima: 'Козметика и B2B веб-страница',
      artman: 'Корпоративна веб-страница',
      phiaderm: 'Козметичка е-трговија',
    },
    descriptions: {
      headwear: 'Повеќејазична продавница за performance и outdoor производи, со јасно откривање производи и мобилно купување.',
      misima: 'Стратегија, дизајн и развој на веб-страница за козметичка група што работи со брендови и меѓународни пазари.',
      artman: 'Корпоративна веб-страница што јасно го претставува снабдувачот од Истанбул и неговата понуда.',
      phiaderm: 'Beauty продавница дизајнирана и развиена за јасно претставување производи и commerce искуство.',
    },
  },
  sr: {
    breadcrumb: 'Početna',
    eyebrow: 'Izabrani projekti',
    title: 'Pravi biznisi. Digitalni rad napravljen za stvarnu upotrebu.',
    lead: 'Izbor aktivnih sajtova i e-commerce sistema koje je QCT Studio izradio za proizvodne, kozmetičke, industrijske i korporativne biznise.',
    caseStudy: 'Pročitajte studiju',
    website: 'Posetite sajt',
    labels: {
      headwear: 'Višejezični e-commerce',
      misima: 'Kozmetika i B2B sajt',
      artman: 'Korporativni sajt za snabdevanje',
      phiaderm: 'Beauty e-commerce',
    },
    descriptions: {
      headwear: 'Višejezična prodavnica za performance i outdoor proizvode, organizovana za jasno otkrivanje proizvoda i mobilnu kupovinu.',
      misima: 'Strategija, dizajn i razvoj sajta za kozmetičku grupu koja radi sa brendovima i međunarodnim tržištima.',
      artman: 'Korporativni sajt koji jasno predstavlja dobavljača iz Istanbula i njegovu poslovnu ponudu.',
      phiaderm: 'Beauty prodavnica dizajnirana i razvijena za jasno predstavljanje proizvoda i commerce iskustvo.',
    },
  },
};

const c = copy[lang as keyof typeof copy] ?? copy.en;
const projects = [
  {
    name: 'HEADWEAR',
    label: c.labels.headwear,
    description: c.descriptions.headwear,
    href: url('/work/headwear/'),
    external: 'https://www.head-wear.com/',
    featured: true,
  },
  {
    name: 'Misima Group',
    label: c.labels.misima,
    description: c.descriptions.misima,
    href: url('/work/misima/'),
    external: 'https://www.misima.com.tr/',
  },
  {
    name: 'Artman Group',
    label: c.labels.artman,
    description: c.descriptions.artman,
    href: url('/work/artman/'),
    external: 'https://artmangroup.com.tr/',
  },
  {
    name: 'Phiaderm',
    label: c.labels.phiaderm,
    description: c.descriptions.phiaderm,
    href: url('/work/phiaderm/'),
    external: 'https://www.phiaderm.com.tr/',
  },
];
---

<BaseLayout title={seo.title} description={seo.description} lang={lang} pageType="CollectionPage" breadcrumbLabel={c.eyebrow}>
  <Header slot="header" lang={lang} />

  <main class="qct-work">
    <section class="qct-work__hero">
      <div class="container">
        <p class="qct-work__breadcrumb"><a href={url('/')}>{c.breadcrumb}</a> / {c.eyebrow}</p>
        <p class="qct-work__eyebrow">{c.eyebrow}</p>
        <h1>{c.title}</h1>
        <p class="qct-work__lead">{c.lead}</p>
      </div>
    </section>

    <section class="qct-work__projects" aria-label={c.eyebrow}>
      <div class="container qct-work__grid">
        {projects.map((project, index) => (
          <article class:list={['qct-work__card', { 'qct-work__card--featured': project.featured }]}>
            <div class="qct-work__number">0{index + 1}</div>
            <p class="qct-work__label">{project.label}</p>
            <h2>{project.href ? <a href={project.href}>{project.name}</a> : project.name}</h2>
            <p class="qct-work__description">{project.description}</p>
            <div class="qct-work__links">
              {project.href && <a href={project.href}>{c.caseStudy}</a>}
              <a href={project.external} target="_blank" rel="noopener">{c.website}</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
  .qct-work { color: #17151a; background: #f4f0e8; }
  .qct-work__hero { padding: clamp(4rem, 7vw, 7rem) 0; border-bottom: 1px solid rgba(23, 21, 26, .14); }
  .qct-work__breadcrumb { margin: 0 0 3rem; font-weight: 700; }
  .qct-work__breadcrumb a { color: inherit; }
  .qct-work__eyebrow, .qct-work__label { color: #e75757; font-size: .78rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  .qct-work h1 { max-width: 900px; margin: .9rem 0 1.3rem; font-size: clamp(2.75rem, 5vw, 5.1rem); line-height: .98; letter-spacing: -.045em; }
  .qct-work__lead { max-width: 760px; margin: 0; color: #656066; font-size: clamp(1rem, 1.35vw, 1.2rem); line-height: 1.65; }
  .qct-work__projects { padding: clamp(3rem, 5vw, 4.5rem) 0; background: #17151a; }
  .qct-work__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; padding: 1px; background: rgba(248, 245, 239, .16); }
  .qct-work__card { min-height: 300px; padding: clamp(1.5rem, 2.4vw, 2.25rem); color: #f8f5ef; background: #1d1a20; }
  .qct-work__card--featured { background: #251b29; }
  .qct-work__number { margin-bottom: 2.5rem; color: rgba(248, 245, 239, .38); font-weight: 800; }
  .qct-work__card h2 { margin: .75rem 0 1rem; font-size: clamp(1.75rem, 2.5vw, 2.5rem); line-height: 1; letter-spacing: -.035em; }
  .qct-work__card h2 a { color: inherit; text-decoration: none; }
  .qct-work__description { max-width: 520px; color: rgba(248, 245, 239, .68); line-height: 1.65; }
  .qct-work__links { display: flex; flex-wrap: wrap; gap: 1.1rem; margin-top: 1.5rem; }
  .qct-work__links a { color: #f8f5ef; font-weight: 750; text-underline-offset: .25rem; }
  @media (max-width: 760px) {
    .qct-work__hero { padding: 3.5rem 0; }
    .qct-work__breadcrumb { margin-bottom: 2rem; }
    .qct-work h1 { font-size: clamp(2.35rem, 11vw, 3.15rem); }
    .qct-work__grid { grid-template-columns: 1fr; }
    .qct-work__card { min-height: auto; padding: 1.5rem; }
    .qct-work__number { margin-bottom: 2rem; }
  }
</style>
