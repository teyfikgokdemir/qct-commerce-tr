---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import LegalPage from './service/LegalPage.astro'; interface Props{lang:string} const{lang}=Astro.props;
const title='Çerez Politikası — QCT Commerce'; const description='QCT Commerce web sitesinde kullanılan zorunlu ve isteğe bağlı çerezlere ilişkin açıklamalar ve tercih seçenekleri.';
---
<BaseLayout title={title} description={description} lang={lang} breadcrumbLabel="Çerez politikası"><Header slot="header" lang={lang}/><LegalPage lang={lang} eyebrow="YASAL" title="Çerez politikası" lead="Türkiye pazarına yönelik sitenin çalışması ve isteğe bağlı kullanım analizi için çerezlerin nasıl kullanılabileceğini açıklar." lastUpdated="19 Temmuz 2026"
sections={[{id:'cerez-nedir',title:'Çerez nedir?',text:'Çerezler ve benzer tarayıcı depolama yöntemleri sitenin temel işlevlerini yürütmesine veya izin verdiğiniz tercihleri hatırlamasına yardımcı olan küçük veri parçalarıdır.'},{id:'zorunlu',title:'Zorunlu çerezler',text:'Güvenlik, temel sayfa işlevleri ve çerez tercihinizin saklanması gibi siteyi çalıştırmak için gerekli işlevlerde kullanılabilir.'},{id:'analiz',title:'Analiz çerezleri',text:'Site kullanımını ve performansını anlamaya yardımcı olan analiz araçları yalnızca açık onayınızdan sonra yüklenir.'},{id:'ucuncu-taraf',title:'Üçüncü taraf hizmetleri',text:'Barındırma veya analiz sağlayıcıları ilgili hizmet için gerekli sınırlı verileri kendi koşulları kapsamında işleyebilir.'},{id:'tercihler',title:'Tercihlerinizi yönetme',text:'Çerez banner’ındaki seçenekleri veya tarayıcı ayarlarınızı kullanabilirsiniz. Çerez ayarları düğmesiyle tercihinizi yeniden açabilirsiniz.'},{id:'iletisim',title:'İletişim',text:'Çerezlerle ilgili sorularınızı info@qctcommerce.com adresine gönderebilirsiniz.'}]}
faqTitle="Sık sorulan sorular" faqItems={[{q:'Analiz çerezleri otomatik olarak etkinleşir mi?',a:'Hayır. Analiz yalnızca izin vermeniz halinde başlar.'},{q:'İznimi reddedersem siteyi kullanabilir miyim?',a:'Evet. İsteğe bağlı analizi reddetmeniz temel site içeriğine erişimi engellemez.'},{q:'Tercihimi değiştirebilir miyim?',a:'Evet. Sayfadaki çerez ayarları düğmesiyle seçim ekranını yeniden açabilirsiniz.'}]}/><Footer slot="footer" lang={lang}/></BaseLayout>
