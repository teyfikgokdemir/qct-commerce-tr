---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import ServicePage from './service/ServicePage.astro'; import {getPageSeo} from '../i18n/seo'; interface Props{lang:string} const{lang}=Astro.props; const seo=getPageSeo('meta-ads'); const d='Meta reklamlarını, reklam vaadiyle eşleşen ve ziyaretçiyi tek bir sonraki adıma yönlendiren landing page’lerle destekliyoruz.';
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="Meta reklamları" service={{name:'Meta reklamları ve landing page',description:d}}><Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="Meta reklamları ve landing page" title="Reklam tıklamasını net bir teklif ve güçlü bir sonraki adımla karşılayın." lead={d} ctaPrimary="Kampanyanızı konuşalım" ctaSecondary="Tüm hizmetler"
problem={{eyebrow:'SORUN',title:'Doğru hedefleme, zayıf bir açılış sayfasını telafi edemez.',intro:['Reklam mesajı ile sayfa içeriği uyuşmadığında ziyaretçi aradığını bulamaz ve bütçe sonuç üretmeden tükenir.'],items:[{title:'Mesaj eşleşmez',text:'Reklam vaadi sayfada aynı açıklıkla devam etmez.'},{title:'Dikkat dağılır',text:'Genel web sitesi menüleri kampanyanın tek hedefini zayıflatır.'},{title:'Ölçüm eksik kalır',text:'Form, WhatsApp veya satın alma adımları doğru izlenmez.'}]}}
benefits={{eyebrow:'YAKLAŞIM',title:'Reklam, teklif, sayfa ve ölçüm aynı hedefe çalışır.',lead:'Kampanyayı yalnızca kreatif ve medya satın alma olarak değil, uçtan uca dönüşüm akışı olarak ele alırız.',items:[{title:'Mesaj uyumu',text:'Reklamın vaadi sayfanın ilk ekranında açıkça karşılanır.'},{title:'Tek eylem odağı',text:'Ziyaretçi form, WhatsApp veya satın alma gibi belirli bir adıma yönelir.'},{title:'Dönüşüm ölçümü',text:'Kritik eylemler kampanya optimizasyonuna veri sağlayacak şekilde izlenir.'}]}}
included={{eyebrow:'KAPSAM',title:'Kampanya çalışmasında',lead:'Kapsam hedefe ve mevcut hesaba göre belirlenir.',items:[{title:'Teklif çerçevesi',text:'Hedef kitle ve mesaj netliği.'},{title:'Landing page',text:'Mobil öncelikli dönüşüm sayfası.'},{title:'CTA akışı',text:'Form, WhatsApp veya satış adımı.'},{title:'Ölçüm planı',text:'Kritik olayların kurulumu.'},{title:'Meta kampanya yapısı',text:'Hedefe uygun reklam düzeni.'},{title:'İyileştirme',text:'Veriye göre mesaj ve sayfa testleri.'}]}}
process={{eyebrow:'SÜREÇ',title:'Kampanya hedefinden ölçüme.',steps:[{number:'01',title:'Hedef ve teklif',text:'Kitleyi, teklifi ve başarı ölçütünü netleştiririz.'},{number:'02',title:'Sayfa planı',text:'Mesajı ve dönüşüm akışını tasarlarız.'},{number:'03',title:'Kurulum',text:'Landing page, kampanya ve ölçümü hazırlarız.'},{number:'04',title:'Yayın ve izleme',text:'Verileri takip ederek iyileştirme alanlarını belirleriz.'}]}}
faq={{eyebrow:'SIK SORULANLAR',title:'Meta reklamları hakkında',items:[{q:'Yalnızca landing page yaptırabilir miyiz?',a:'Evet. Mevcut kampanyanıza uygun bağımsız bir landing page kapsamlanabilir.'},{q:'Satış garantisi veriyor musunuz?',a:'Hayır. Sonuç; teklif, fiyat, pazar, bütçe ve rekabet dahil birçok etkene bağlıdır. Çalışmamız ölçülebilir ve iyileştirilebilir bir sistem kurmaya odaklanır.'},{q:'WhatsApp kampanyaları kurulabilir mi?',a:'Evet. Reklamdan WhatsApp’a geçiş, hazır mesaj bağlamı ve ölçüm birlikte planlanabilir.'}]}}
final={{title:'Reklam bütçenizi daha tutarlı bir dönüşüm akışıyla destekleyin.',text:'Kampanya hedefinizi ve mevcut yapınızı konuşalım.',cta:'İletişime geçin',ctaSecondary:'E-posta gönderin'}}/><Footer slot="footer" lang={lang}/></BaseLayout>
