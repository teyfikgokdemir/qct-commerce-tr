---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getLocalizedUrl } from '../i18n';
import { getPageSeo } from '../i18n/seo';

interface Props { lang: string; }

const { lang } = Astro.props;
const url = (path: string) => getLocalizedUrl(lang, path);
const seo = getPageSeo('artman-case-study', lang);

const copy = {
  en: {
    breadcrumb: 'Selected Work', eyebrow: 'Corporate website case study',
    title: 'Artman Group: a clear corporate website for a broad supply portfolio.',
    lead: 'A structured website for an Istanbul-based supplier serving organizations across Türkiye with signage, print, facility and operational solutions.',
    visit: 'Visit live website', overview: 'Project overview',
    overviewTitle: 'A broad service portfolio needs a simple path to the right solution.',
    overviewText: 'Artman Group serves municipalities, education, healthcare, offices and industrial facilities. The website needed to present many different services without making the company or its offer feel fragmented.',
    typeLabel: 'Project type', type: 'Corporate and B2B website', focusLabel: 'Focus', focus: 'Service architecture and trust', statusLabel: 'Status', status: 'Live website',
    challenge: 'The challenge', challengeTitle: 'Turn operational breadth into a credible digital story.',
    challengeText: 'Signage, printing, cleaning, fire systems, packaging and access solutions belong to different buying journeys. The experience had to help visitors understand the range quickly while keeping Artman Group at the center as one reliable supplier.',
    approach: 'The approach',
    items: [
      ['Clear service architecture', 'Group related solutions into scannable categories so procurement teams can find a relevant starting point quickly.'],
      ['Corporate credibility', 'Use direct company information, service context and contact paths to support trust before an enquiry.'],
      ['Action-oriented journeys', 'Keep calls to explore services and start a conversation visible across the experience.'],
      ['Search-ready content', 'Give each major service enough descriptive context for people, search engines and AI answer systems.'],
    ],
    outcome: 'The result', outcomeTitle: 'One corporate destination for a complex supply business.',
    outcomeText: 'The live website presents Artman Group as a single solution partner, makes its service range easier to understand and creates clear routes from discovery to contact.',
    cta: 'Planning a corporate website with a complex service portfolio?', ctaLink: 'Talk to QCT Studio',
  },
  sq: {
    breadcrumb: 'Punë të përzgjedhura', eyebrow: 'Studim rasti për faqe korporative',
    title: 'Artman Group: një faqe korporative e qartë për një portofol të gjerë furnizimi.',
    lead: 'Një faqe e strukturuar për një furnizues me bazë në Stamboll që u shërben organizatave në gjithë Turqinë me tabela, printim dhe zgjidhje operative.',
    visit: 'Vizitoni faqen aktive', overview: 'Përmbledhja e projektit',
    overviewTitle: 'Një portofol i gjerë shërbimesh kërkon një rrugë të thjeshtë drejt zgjidhjes së duhur.',
    overviewText: 'Artman Group u shërben bashkive, arsimit, shëndetësisë, zyrave dhe objekteve industriale. Faqja duhej të paraqiste shumë shërbime pa e bërë ofertën të dukej e fragmentuar.',
    typeLabel: 'Lloji i projektit', type: 'Faqe korporative dhe B2B', focusLabel: 'Fokusi', focus: 'Arkitekturë shërbimesh dhe besim', statusLabel: 'Statusi', status: 'Faqe aktive',
    challenge: 'Sfida', challengeTitle: 'Shndërrimi i gjerësisë operative në një histori digjitale të besueshme.',
    challengeText: 'Tabelat, printimi, pastrimi, sistemet kundër zjarrit, ambalazhimi dhe kontrolli i hyrjes i përkasin proceseve të ndryshme blerjeje. Përvoja duhej ta bënte gamën të kuptueshme, me Artman Group në qendër si një furnizues i vetëm.',
    approach: 'Qasja',
    items: [
      ['Arkitekturë e qartë shërbimesh', 'Grupimi i zgjidhjeve në kategori të lexueshme që ekipet e prokurimit të gjejnë shpejt pikën e duhur të nisjes.'],
      ['Besueshmëri korporative', 'Informacion i drejtpërdrejtë për kompaninë, kontekst shërbimesh dhe rrugë kontakti që ndërtojnë besim.'],
      ['Rrugë të orientuara drejt veprimit', 'Thirrje të dukshme për të eksploruar shërbimet dhe për të nisur një bisedë.'],
      ['Përmbajtje e gatshme për kërkim', 'Kontekst për çdo shërbim kryesor për njerëzit, motorët e kërkimit dhe sistemet e përgjigjeve me AI.'],
    ],
    outcome: 'Rezultati', outcomeTitle: 'Një destinacion korporativ për një biznes kompleks furnizimi.',
    outcomeText: 'Faqja aktive e paraqet Artman Group si një partner të vetëm zgjidhjesh, e bën gamën e shërbimeve më të kuptueshme dhe krijon rrugë të qarta drejt kontaktit.',
    cta: 'Po planifikoni një faqe korporative me portofol kompleks?', ctaLink: 'Flisni me QCT Studio',
  },
  mk: {
    breadcrumb: 'Избрани проекти', eyebrow: 'Студија за корпоративна веб-страница',
    title: 'Artman Group: јасна корпоративна веб-страница за широко портфолио.',
    lead: 'Структурирана веб-страница за снабдувач од Истанбул што им нуди табли, печатење и оперативни решенија на организации низ Турција.',
    visit: 'Посетете ја активната веб-страница', overview: 'Преглед на проектот',
    overviewTitle: 'Широко портфолио на услуги бара едноставен пат до вистинското решение.',
    overviewText: 'Artman Group работи со општини, образование, здравство, канцеларии и индустриски објекти. Веб-страницата требаше да претстави многу услуги без понудата да изгледа фрагментирано.',
    typeLabel: 'Тип на проект', type: 'Корпоративна и B2B веб-страница', focusLabel: 'Фокус', focus: 'Архитектура на услуги и доверба', statusLabel: 'Статус', status: 'Активна веб-страница',
    challenge: 'Предизвикот', challengeTitle: 'Оперативната широчина да се претвори во уверлива дигитална приказна.',
    challengeText: 'Табли, печатење, чистење, противпожарни системи, пакување и контрола на пристап имаат различни процеси на купување. Искуството требаше брзо да го објасни опсегот и да го задржи Artman Group како еден сигурен снабдувач.',
    approach: 'Пристапот',
    items: [
      ['Јасна архитектура на услуги', 'Поврзани решенија групирани во прегледни категории за тимовите за набавка брзо да ја најдат вистинската почетна точка.'],
      ['Корпоративен кредибилитет', 'Директни информации за компанијата, контекст за услугите и јасни патеки за контакт што градат доверба.'],
      ['Патеки насочени кон акција', 'Видливи повици за истражување на услугите и започнување разговор.'],
      ['Содржина подготвена за пребарување', 'Описен контекст за главните услуги за луѓе, пребарувачи и AI системи за одговори.'],
    ],
    outcome: 'Резултатот', outcomeTitle: 'Една корпоративна дестинација за комплексен снабдувачки бизнис.',
    outcomeText: 'Активната веб-страница го претставува Artman Group како единствен партнер за решенија, го појаснува опсегот на услуги и создава јасни патеки до контакт.',
    cta: 'Планирате корпоративна веб-страница со комплексно портфолио?', ctaLink: 'Разговарајте со QCT Studio',
  },
  sr: {
    breadcrumb: 'Izabrani projekti', eyebrow: 'Studija korporativnog sajta',
    title: 'Artman Group: jasan korporativni sajt za širok portfolio nabavke.',
    lead: 'Strukturiran sajt za dobavljača iz Istanbula koji organizacijama širom Turske pruža rešenja za table, štampu, objekte i operacije.',
    visit: 'Posetite aktivni sajt', overview: 'Pregled projekta',
    overviewTitle: 'Širok portfolio usluga zahteva jednostavan put do pravog rešenja.',
    overviewText: 'Artman Group radi sa opštinama, obrazovanjem, zdravstvom, kancelarijama i industrijskim objektima. Sajt je trebalo da predstavi mnogo usluga bez utiska fragmentirane ponude.',
    typeLabel: 'Tip projekta', type: 'Korporativni i B2B sajt', focusLabel: 'Fokus', focus: 'Arhitektura usluga i poverenje', statusLabel: 'Status', status: 'Aktivan sajt',
    challenge: 'Izazov', challengeTitle: 'Pretvoriti operativnu širinu u uverljivu digitalnu priču.',
    challengeText: 'Table, štampa, čišćenje, protivpožarni sistemi, ambalaža i kontrola pristupa pripadaju različitim procesima nabavke. Iskustvo je moralo brzo da objasni ponudu i zadrži Artman Group u centru kao jednog pouzdanog dobavljača.',
    approach: 'Pristup',
    items: [
      ['Jasna arhitektura usluga', 'Povezana rešenja grupisana u pregledne kategorije kako bi timovi za nabavku brzo pronašli odgovarajuću početnu tačku.'],
      ['Korporativni kredibilitet', 'Direktne informacije o kompaniji, kontekst usluga i jasni putevi do kontakta koji podržavaju poverenje.'],
      ['Putevi usmereni na akciju', 'Vidljivi pozivi za istraživanje usluga i započinjanje razgovora.'],
      ['Sadržaj spreman za pretragu', 'Opisni kontekst za glavne usluge namenjen ljudima, pretraživačima i AI sistemima za odgovore.'],
    ],
    outcome: 'Rezultat', outcomeTitle: 'Jedna korporativna destinacija za složen posao snabdevanja.',
    outcomeText: 'Aktivan sajt predstavlja Artman Group kao jednog partnera za rešenja, čini portfolio usluga razumljivijim i stvara jasne puteve od istraživanja do kontakta.',
    cta: 'Planirate korporativni sajt sa složenim portfoliom?', ctaLink: 'Razgovarajte sa QCT Studiom',
  },
};
const c = copy[lang as keyof typeof copy] ?? copy.en;
---

<BaseLayout title={seo.title} description={seo.description} lang={lang} pageType="WebPage" breadcrumbLabel="Artman Group">
  <Header slot="header" lang={lang} />
  <main class="qct-case">
    <section class="qct-case__hero"><div class="container">
      <p class="qct-case__breadcrumb"><a href={url('/work/')}>{c.breadcrumb}</a> / Artman Group</p>
      <p class="qct-case__eyebrow">{c.eyebrow}</p><h1>{c.title}</h1><p class="qct-case__lead">{c.lead}</p>
      <a class="qct-case__button" href="https://artmangroup.com.tr/" target="_blank" rel="noopener">{c.visit}</a>
    </div></section>
    <section class="qct-case__overview"><div class="container qct-case__split">
      <div><p class="qct-case__eyebrow">{c.overview}</p><h2>{c.overviewTitle}</h2><p class="qct-case__copy">{c.overviewText}</p></div>
      <dl><div><dt>{c.typeLabel}</dt><dd>{c.type}</dd></div><div><dt>{c.focusLabel}</dt><dd>{c.focus}</dd></div><div><dt>{c.statusLabel}</dt><dd>{c.status}</dd></div></dl>
    </div></section>
    <section class="qct-case__dark"><div class="container">
      <p class="qct-case__eyebrow">{c.challenge}</p><h2>{c.challengeTitle}</h2><p class="qct-case__copy">{c.challengeText}</p>
    </div></section>
    <section class="qct-case__approach"><div class="container">
      <p class="qct-case__eyebrow">{c.approach}</p>
      <div class="qct-case__grid">{c.items.map(([title, text], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
    </div></section>
    <section class="qct-case__result"><div class="container">
      <p class="qct-case__eyebrow">{c.outcome}</p><h2>{c.outcomeTitle}</h2><p class="qct-case__copy">{c.outcomeText}</p>
    </div></section>
    <section class="qct-case__cta"><div class="container"><h2>{c.cta}</h2><a class="qct-case__button" href={url('/contact/')}>{c.ctaLink}</a></div></section>
  </main>
  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
  .qct-case{color:#17151a;background:#f4f0e8}.qct-case section{padding:clamp(4rem,7vw,7rem) 0}.qct-case__hero{border-bottom:1px solid rgba(23,21,26,.14)}.qct-case__breadcrumb{margin:0 0 3rem;font-weight:700}.qct-case__breadcrumb a{color:inherit}.qct-case__eyebrow{margin:0 0 1rem;color:#e75757;font-size:.78rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.qct-case h1{max-width:1100px;margin:0 0 1.5rem;font-size:clamp(3rem,6.4vw,5.5rem);line-height:.96;letter-spacing:-.05em}.qct-case h2{max-width:900px;margin:0 0 1.5rem;font-size:clamp(2.35rem,4.4vw,4rem);line-height:1;letter-spacing:-.04em}.qct-case__lead,.qct-case__copy{max-width:820px;color:#686268;font-size:clamp(1.05rem,1.5vw,1.25rem);line-height:1.7}.qct-case__button{display:inline-flex;margin-top:1.5rem;padding:.9rem 1.25rem;color:#17151a;background:#ef5757;border-radius:999px;font-weight:800;text-decoration:none}.qct-case__split{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,.8fr);gap:clamp(3rem,8vw,8rem)}dl{margin:0}dl div{padding:1.5rem 0;border-top:1px solid rgba(23,21,26,.16)}dt{color:#686268;font-size:.75rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}dd{margin:.65rem 0 0;font-weight:800}.qct-case__dark,.qct-case__result{color:#f8f5ef;background:#17151a}.qct-case__dark .qct-case__copy,.qct-case__result .qct-case__copy{color:rgba(248,245,239,.72)}.qct-case__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;margin-top:2.5rem;background:rgba(23,21,26,.14)}.qct-case__grid article{min-height:260px;padding:clamp(1.5rem,3vw,2.5rem);background:#f8f5ef}.qct-case__grid span{color:#e75757;font-weight:800}.qct-case__grid h3{margin:2.5rem 0 1rem;font-size:clamp(1.45rem,2vw,2rem)}.qct-case__grid p{color:#686268;line-height:1.65}.qct-case__cta{text-align:center}.qct-case__cta h2{margin-inline:auto;max-width:760px}
  @media(max-width:760px){.qct-case section{padding:3.5rem 0}.qct-case__breadcrumb{margin-bottom:2rem}.qct-case h1{font-size:clamp(2.45rem,11vw,3.35rem)}.qct-case h2{font-size:clamp(2rem,9vw,2.7rem)}.qct-case__split,.qct-case__grid{grid-template-columns:1fr}.qct-case__grid article{min-height:auto}}
</style>
