---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import ServicePage from './service/ServicePage.astro'; import { getPageSeo } from '../i18n/seo';
interface Props { lang:string; } const {lang}=Astro.props; const seo=getPageSeo('website-design'); const serviceDescription='Teklifinizi açık anlatan, güven oluşturan ve ziyaretçiyi doğru eyleme yönlendiren hızlı web siteleri tasarlıyoruz.';
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="Web tasarım" service={{name:'Web tasarım',description:serviceDescription}}><Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="Web tasarım" title="İşletmenizin değerini anlatan, satış sürecini destekleyen web siteleri." lead={serviceDescription} ctaPrimary="Projenizi konuşalım" ctaSecondary="Tüm hizmetler"
problem={{eyebrow:'SORUN',title:'İyi bir işletme, zayıf bir dijital ilk izlenim yüzünden fırsat kaybedebilir.',intro:['Ziyaretçi ne sunduğunuzu, kimler için çalıştığınızı ve sonraki adımı hızlıca anlayamazsa iletişim kurmadan ayrılır.'],items:[{title:'Teklif belirsiz kalır',text:'Hizmet ve fayda açık anlatılmadığında güven oluşmaz.'},{title:'Mobil deneyim yorucu olur',text:'Yavaş veya karmaşık sayfalar potansiyel müşteriyi uzaklaştırır.'},{title:'İçerik güncelliğini kaybeder',text:'Yönetilemeyen yapı işletmenin bugünkü gücünü yansıtamaz.'}]}}
benefits={{eyebrow:'YAKLAŞIM',title:'Tasarımın görevi yalnızca iyi görünmek değildir.',lead:'Doğru web sitesi müşterinin sorularını yanıtlar, güveni güçlendirir ve eylemi kolaylaştırır.',items:[{title:'Net konumlandırma',text:'İşletmenizin sunduğu değer ilk ekranlardan itibaren anlaşılır.'},{title:'Dönüşüm odaklı yapı',text:'İçerik ve CTA’lar gerçek müşteri yolculuğuna göre düzenlenir.'},{title:'Hız ve erişilebilirlik',text:'Farklı cihazlarda hızlı, okunabilir ve kullanılabilir deneyim.'}]}}
included={{eyebrow:'KAPSAM',title:'Web tasarım kapsamında',lead:'İhtiyaca göre şekillenen temel çalışma alanları.',items:[{title:'Bilgi mimarisi',text:'Sayfa ve içerik yapısı.'},{title:'Özgün arayüz',text:'Marka ve hedefe uygun tasarım.'},{title:'Responsive geliştirme',text:'Mobil, tablet ve masaüstü uyumu.'},{title:'Teknik SEO temeli',text:'Semantik ve taranabilir yapı.'},{title:'İçerik yönetimi',text:'Güncellenebilir sayfalar.'},{title:'Performans',text:'Hızlı yüklenen optimize yapı.'}]}}
process={{eyebrow:'SÜREÇ',title:'İşletmeyi anlayarak başlarız.',steps:[{number:'01',title:'Keşif',text:'Teklifinizi, müşterinizi ve hedefi netleştiririz.'},{number:'02',title:'İçerik ve akış',text:'Sayfaları ve karar yolculuğunu planlarız.'},{number:'03',title:'Tasarım ve geliştirme',text:'Arayüzü tasarlar, erişilebilir biçimde geliştiririz.'},{number:'04',title:'Test ve yayın',text:'Cihaz, hız ve bağlantı kontrolleriyle yayına alırız.'}]}}
faq={{eyebrow:'SIK SORULANLAR',title:'Web tasarım hakkında',items:[{q:'Mevcut web sitemiz yenilenebilir mi?',a:'Evet. Değerli içerikleri ve teknik gereksinimleri koruyarak yapıyı yeniden planlayabiliriz.'},{q:'Siteyi kendimiz güncelleyebilir miyiz?',a:'İçerik yönetimi ihtiyacını proje başında belirleyip uygun bir yönetim yapısı kurarız.'},{q:'SEO dahil mi?',a:'Taranabilirlik, semantik başlık yapısı, hız ve mobil uyum gibi teknik temeller dahildir; sürekli SEO çalışması ayrı kapsamlanır.'}]}}
final={{title:'Web siteniz işletmenizin bugünkü gücünü yansıtsın.',text:'Mevcut sitenizi ve hedeflerinizi birlikte değerlendirelim.',cta:'İletişime geçin',ctaSecondary:'E-posta gönderin'}}/><Footer slot="footer" lang={lang}/></BaseLayout>
