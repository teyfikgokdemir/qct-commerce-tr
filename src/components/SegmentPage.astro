---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

type SegmentKey = 'manufacturers' | 'exporters' | 'distributors' | 'ecommerce';

interface Props {
  lang: 'tr' | 'en';
  segment: SegmentKey;
}

const { lang, segment } = Astro.props;
const isEnglish = lang === 'en';

const content = {
  tr: {
    manufacturers: {
      title: 'Üreticiler için dijital talep sistemi',
      description: 'Üreticiler için kurumsal web, B2B e-ticaret, ürün kataloğu, teklif akışı, çok dilli yapı ve arama görünürlüğü.',
      eyebrow: 'ÜRETİCİLER İÇİN',
      lead: 'Ürün kataloğunu doğru alıcıyı teknik bilgiye ve nitelikli teklif talebine taşıyan bir satış kanalına dönüştürün.',
      pains: [['Ürünler bulunuyor ama talep gelmiyor','Teknik ürün bilgisi, kategori yapısı ve CTA akışı ticari niyetle eşleşmediğinde ziyaretçi katalogda kalır.'],['Toptan ve perakende ihtiyaçları karışıyor','Bayi, distribütör, kurumsal alıcı ve son kullanıcı için farklı bilgi ve teklif yolları gerekir.'],['İhracat için içerik yetersiz kalıyor','Çok dilli ürün anlatımı, ülkeye göre güven sinyalleri ve teklif kanalları birlikte düşünülmelidir.']],
      outcomes: [['B2B ürün mimarisi','Kategori, ürün, teknik özellik ve teklif akışının birlikte kurgulanması.'],['Nitelikli talep akışı','WhatsApp, e-posta veya form üzerinden bağlamlı teklif talebi.'],['Arama ve AI görünürlüğü','Ürün ve sektör bilgisinin Google ve yapay zekâ sistemleri tarafından daha açık anlaşılması.']],
    },
    exporters: {
      title: 'İhracatçılar için dijital talep sistemi',
      description: 'İhracatçılar için çok dilli web, hedef pazar landing page, B2B talep akışı, SEO, GEO, AEO ve dijital satış sistemleri.',
      eyebrow: 'İHRACATÇILAR İÇİN',
      lead: 'Hedef pazara göre ürün bilgisini, güven sinyallerini ve teklif akışını tek bir çok dilli satış sisteminde birleştirin.',
      pains: [['İngilizce site var ama talep yok','Genel bir çeviri, hedef pazarın satın alma sorularını ve güven beklentisini karşılamayabilir.'],['Ürün bilgisi ülkeye göre ayrışmıyor','Teknik detay, teslim modeli, minimum sipariş ve kullanım senaryoları pazara göre farklı önem taşır.'],['Lead geliyor ama niteliksiz kalıyor','Ülke, ürün, hacim ve hedef tarih gibi bilgiler ilk temasta toplanmadığında satış ekibi zaman kaybeder.']],
      outcomes: [['Pazar odaklı landing page','Ülke veya segment bazlı teklif ve içerik yapısı.'],['Çok dilli SEO altyapısı','Canonical, hreflang, yerel içerik ve teknik görünürlük temeli.'],['Nitelikli ihracat talebi','İlk mesajda temel ticari bağlamı toplayan kısa brief akışı.']],
    },
    distributors: {
      title: 'Distribütörler için B2B satış sistemi',
      description: 'Distribütör ve B2B şirketleri için ürün kataloğu, teklif akışı, bayi yapısı, WhatsApp satış ve e-ticaret sistemleri.',
      eyebrow: 'DİSTRİBÜTÖR & B2B',
      lead: 'Ürün portföyünü, bayi ilişkilerini ve teklif sürecini ölçülebilir tek bir B2B satış yapısında yönetin.',
      pains: [['Katalog büyüdükçe ürün bulmak zorlaşıyor','B2B alıcı ürün kodu, kategori, teknik özellik veya kullanım alanına göre hızlı filtreleme bekler.'],['Teklifler WhatsApp içinde kayboluyor','Bağlamsız mesajlar satış takibini zorlaştırır ve aynı sorular tekrar tekrar sorulur.'],['Bayi ve son kullanıcı aynı akışta','Farklı fiyatlama, minimum sipariş ve destek ihtiyaçları tek deneyimde karışabilir.']],
      outcomes: [['B2B katalog mimarisi','Ürün keşfini hızlandıran kategori ve teknik veri düzeni.'],['Teklif ve WhatsApp routing','Ürün bağlamını koruyan satış görüşmesi akışı.'],['Ölçülebilir talep','Hangi sayfa, ürün veya kanalın talep oluşturduğunu izleyebilecek ölçüm temeli.']],
    },
    ecommerce: {
      title: 'E-ticaret markaları için büyüme sistemi',
      description: 'Büyüyen e-ticaret markaları için Shopify, ikas, dönüşüm optimizasyonu, SEO, reklam landing page ve satış otomasyonu.',
      eyebrow: 'E-TİCARET MARKALARI',
      lead: 'Dönüşüm, platform, ölçüm ve operasyon darboğazlarını çözerek e-ticaret büyümesini daha kontrollü hale getirin.',
      pains: [['Trafik var ama dönüşüm düşük','Mobil deneyim, ürün sayfası, güven, ödeme ve teklif yapısı birlikte değerlendirilmelidir.'],['Platform operasyonu yavaşlatıyor','Tema, uygulama, ürün verisi ve entegrasyon yükü büyüdükçe maliyet ve hata oranı artabilir.'],['Reklam verisi satışla bağlanmıyor','Kampanya, landing page ve gerçek dönüşüm sinyali aynı ölçüm yapısında buluşmalıdır.']],
      outcomes: [['Dönüşüm odaklı mağaza','Ürün keşfi, sepet ve ödeme akışında gereksiz sürtünmenin azaltılması.'],['Platform uygunluğu','Shopify, ikas veya mevcut yapının ticari ihtiyaca göre değerlendirilmesi.'],['Büyüme ölçümü','Reklam, organik trafik, WhatsApp ve satış aksiyonlarının anlamlı eventlerle izlenmesi.']],
    },
  },
  en: {
    manufacturers: {
      title: 'Digital demand for manufacturers',
      description: 'B2B websites, product catalogues, enquiry flows, multilingual architecture and search visibility for manufacturers operating from Türkiye.',
      eyebrow: 'FOR MANUFACTURERS',
      lead: 'Turn product discovery, technical information and qualified enquiries into one clear digital sales path.',
      pains: [['Products are visible but enquiries stay weak','When technical content, category structure and CTAs do not match buying intent, visitors stop at the catalogue.'],['Wholesale and retail needs are mixed','Dealers, distributors, corporate buyers and end customers often need different information and conversion paths.'],['Export content lacks market context','Multilingual product content, trust signals and enquiry routes should work together.']],
      outcomes: [['B2B product architecture','Categories, product detail, technical data and enquiry paths designed as one system.'],['Qualified enquiry flow','Context-rich WhatsApp, email or form enquiries.'],['Search and AI visibility','Clearer product and company information for search engines and AI systems.']],
    },
    exporters: {
      title: 'Digital demand for exporters',
      description: 'Multilingual websites, target-market landing pages, B2B lead qualification, SEO and digital sales systems for exporters.',
      eyebrow: 'FOR EXPORTERS',
      lead: 'Align product information, trust signals and enquiry flows with each target market through one multilingual system.',
      pains: [['An English site exists but demand stays weak','Generic translation may not answer the commercial questions and trust requirements of a target market.'],['Product information is not market-specific','Technical detail, delivery model, MOQ and use cases can matter differently across markets.'],['Inbound leads are poorly qualified','If market, product, volume and timing are missing from the first contact, sales teams lose time.']],
      outcomes: [['Market-specific landing pages','Country and buyer-segment pages built around a clear commercial offer.'],['Multilingual SEO foundation','Canonical, hreflang, localised content and technical discoverability.'],['Qualified export enquiries','A short brief flow that captures useful commercial context at first contact.']],
    },
    distributors: {
      title: 'B2B sales systems for distributors',
      description: 'Product catalogues, enquiry routing, dealer journeys, WhatsApp sales and B2B commerce systems for distributors.',
      eyebrow: 'FOR DISTRIBUTORS & B2B',
      lead: 'Bring product discovery, dealer relationships and quotation workflows into one measurable B2B sales structure.',
      pains: [['Large catalogues become hard to navigate','B2B buyers often search by SKU, technical attribute, category or application.'],['Enquiries disappear inside chat threads','Unstructured messages make follow-up slower and force teams to repeat the same questions.'],['Dealer and end-customer journeys overlap','Pricing, MOQ and support requirements may need separate paths.']],
      outcomes: [['B2B catalogue architecture','Category and technical-data structures that make products easier to find.'],['Quotation and WhatsApp routing','Sales conversations that preserve product and page context.'],['Measurable demand','A tracking foundation for understanding which pages, products and channels generate enquiries.']],
    },
    ecommerce: {
      title: 'Growth systems for e-commerce brands',
      description: 'Shopify, ikas, conversion optimisation, SEO, paid-traffic landing pages and sales automation for growing e-commerce brands.',
      eyebrow: 'FOR E-COMMERCE BRANDS',
      lead: 'Fix conversion, platform, measurement and operational constraints before adding more traffic and complexity.',
      pains: [['Traffic grows but conversion stays weak','Mobile UX, product pages, trust, checkout and offer structure need to be reviewed together.'],['Platform operations become expensive','Themes, apps, product data and integrations can create growing cost and maintenance friction.'],['Ad data is disconnected from sales','Campaigns, landing pages and real conversion signals should feed one measurement model.']],
      outcomes: [['Conversion-focused storefront','Reduce avoidable friction across discovery, product, cart and checkout.'],['Platform fit','Evaluate Shopify, ikas or the current stack against the real commercial requirement.'],['Growth measurement','Track paid, organic, WhatsApp and sales actions with meaningful events.']],
    },
  },
}[lang][segment];

const contactUrl = isEnglish ? '/en/contact/' : '/iletisim/';
const servicesUrl = isEnglish ? '/en/services/' : '/hizmetler/';
const processTitle = isEnglish ? 'How we approach the first scope' : 'İlk kapsamı nasıl belirliyoruz?';
const process = isEnglish
  ? [['Commercial context','We clarify the buyer, market, offer and current sales path.'],['Constraint','We identify the highest-impact gap in discovery, conversion or operations.'],['System scope','We define the smallest practical combination of pages, platform work and measurement.'],['Execution','We implement, validate and measure before adding more complexity.']]
  : [['Ticari bağlam','Alıcıyı, pazarı, teklifi ve mevcut satış yolunu netleştiririz.'],['Darboğaz','Keşif, dönüşüm veya operasyondaki en yüksek etkili açığı belirleriz.'],['Sistem kapsamı','Gerekli sayfa, platform ve ölçüm işlerini uygulanabilir bir kapsamda toplarız.'],['Uygulama','Yeni karmaşıklık eklemeden önce uygular, doğrular ve ölçeriz.']];

const segmentFaq = isEnglish ? {
  manufacturers: [
    ['What should a manufacturer website do beyond listing products?','It should help a buyer find the right product, understand technical fit, see commercial context and move into a qualified enquiry without losing product context.'],
    ['Do manufacturers need e-commerce checkout?','Not always. For many B2B manufacturers, a structured catalogue and quotation flow can be more useful than direct checkout.'],
    ['Can the same structure support export markets?','Yes. Product architecture can stay consistent while market-specific language, trust signals, delivery context and enquiry routes are adapted by country or buyer segment.'],
  ],
  exporters: [
    ['Is translating a Turkish website enough for export demand?','Usually not. Export pages also need market-specific buying questions, delivery context, trust signals, product terminology and a clear enquiry path.'],
    ['What information should an export enquiry collect?','At minimum, target market, product or product group, expected volume, timing and a reliable contact route should be clear before sales follow-up.'],
    ['How does multilingual SEO support export visibility?','Language-specific URLs, reciprocal hreflang, clear product entities, localised copy and useful market pages help search engines and AI systems understand which content serves which audience.'],
  ],
  distributors: [
    ['What makes a B2B catalogue useful?','Buyers should be able to reach products by category, SKU, technical attribute or application and then continue into a quotation or sales conversation with context preserved.'],
    ['Should dealers and end customers use the same journey?','Only when their commercial needs are genuinely similar. MOQ, pricing, support and product information often justify separate paths.'],
    ['Can WhatsApp be part of a measurable B2B flow?','Yes. Product and page context can be carried into the conversation while click and conversion events are measured without sending personal message content to analytics.'],
  ],
  ecommerce: [
    ['What should be checked before increasing ad spend?','Mobile UX, product-page clarity, trust, checkout friction, platform limits and conversion measurement should be reviewed before buying more traffic.'],
    ['When is a platform migration justified?','Migration is useful when the current platform creates material limits in operations, conversion, integrations, internationalisation or total cost.'],
    ['How should an e-commerce growth stack be measured?','Paid traffic, organic discovery, product interactions, checkout actions and assisted channels such as WhatsApp should use a consistent event model tied to commercial outcomes.'],
  ],
}[segment] : {
  manufacturers: [
    ['Bir üretici web sitesi ürün listelemek dışında ne yapmalı?','Doğru alıcının doğru ürünü bulmasını, teknik uygunluğu anlamasını, ticari bağlamı görmesini ve ürün bağlamını kaybetmeden nitelikli talebe geçmesini sağlamalıdır.'],
    ['Üreticiler için doğrudan e-ticaret şart mı?','Her zaman değil. Birçok B2B üretici için yapılandırılmış ürün kataloğu ve teklif akışı, doğrudan ödeme adımından daha işlevsel olabilir.'],
    ['Aynı yapı ihracat pazarlarında kullanılabilir mi?','Evet. Ürün mimarisi korunurken dil, güven sinyalleri, teslim bağlamı ve teklif yolları ülke veya alıcı segmentine göre uyarlanabilir.'],
  ],
  exporters: [
    ['Türkçe siteyi çevirmek ihracat talebi için yeterli mi?','Genellikle hayır. Hedef pazarın satın alma soruları, teslim bağlamı, güven sinyalleri, ürün terminolojisi ve net teklif akışı da yerelleştirilmelidir.'],
    ['İhracat talebinde hangi bilgiler toplanmalı?','En azından hedef pazar, ürün veya ürün grubu, beklenen hacim, zamanlama ve güvenilir iletişim kanalı ilk temas sırasında netleşmelidir.'],
    ['Çok dilli SEO ihracat görünürlüğünü nasıl destekler?','Dil bazlı URL yapısı, karşılıklı hreflang, net ürün entity’leri, yerelleştirilmiş içerik ve hedef pazar sayfaları arama ve AI sistemlerinin doğru içeriği doğru kitleyle eşleştirmesine yardımcı olur.'],
  ],
  distributors: [
    ['B2B ürün kataloğunu kullanışlı yapan nedir?','Alıcı kategori, ürün kodu, teknik özellik veya kullanım alanına göre ürüne ulaşabilmeli ve ürün bağlamını kaybetmeden teklif ya da satış görüşmesine geçebilmelidir.'],
    ['Bayi ve son kullanıcı aynı akışı kullanmalı mı?','Ticari ihtiyaçları gerçekten aynıysa olabilir. Minimum sipariş, fiyatlama, destek ve ürün bilgisi farkları çoğu zaman ayrı akışları daha doğru hale getirir.'],
    ['WhatsApp ölçülebilir bir B2B satış akışının parçası olabilir mi?','Evet. Ürün ve sayfa bağlamı görüşmeye taşınabilir; tıklama ve dönüşüm sinyalleri kişisel mesaj içeriğini analytics’e göndermeden ölçülebilir.'],
  ],
  ecommerce: [
    ['Reklam bütçesini artırmadan önce ne kontrol edilmeli?','Mobil deneyim, ürün sayfası açıklığı, güven, ödeme sürtünmesi, platform sınırları ve dönüşüm ölçümü birlikte kontrol edilmelidir.'],
    ['Platform taşıma ne zaman mantıklıdır?','Mevcut platform operasyon, dönüşüm, entegrasyon, uluslararasılaşma veya toplam maliyet açısından belirgin sınırlar oluşturuyorsa taşıma değerlendirilmelidir.'],
    ['E-ticaret büyümesi nasıl ölçülmeli?','Reklam, organik keşif, ürün etkileşimleri, ödeme adımları ve WhatsApp gibi destekleyici kanallar aynı ticari hedeflere bağlanan tutarlı event modeliyle izlenmelidir.'],
  ],
}[segment];

const relatedLinks = isEnglish ? {
  manufacturers: [['E-commerce systems','/en/ecommerce/'],['Search visibility','/en/search-visibility/'],['WhatsApp sales','/en/whatsapp-sales/'],['AI automation','/en/ai-automation/']],
  exporters: [['Search visibility','/en/search-visibility/'],['Web design','/en/web-design/'],['WhatsApp sales','/en/whatsapp-sales/'],['E-commerce systems','/en/ecommerce/']],
  distributors: [['E-commerce systems','/en/ecommerce/'],['WhatsApp sales','/en/whatsapp-sales/'],['AI automation','/en/ai-automation/'],['Web design','/en/web-design/']],
  ecommerce: [['E-commerce systems','/en/ecommerce/'],['Meta ads','/en/meta-ads/'],['Search visibility','/en/search-visibility/'],['AI automation','/en/ai-automation/']],
}[segment] : {
  manufacturers: [['E-ticaret altyapısı','/e-ticaret/'],['SEO, GEO, AEO ve AIO','/seo-geo/'],['WhatsApp satış','/whatsapp-satis/'],['Yapay zekâ otomasyonları','/yapay-zeka-otomasyonlari/']],
  exporters: [['SEO, GEO, AEO ve AIO','/seo-geo/'],['Web tasarım','/web-tasarim/'],['WhatsApp satış','/whatsapp-satis/'],['E-ticaret altyapısı','/e-ticaret/']],
  distributors: [['E-ticaret altyapısı','/e-ticaret/'],['WhatsApp satış','/whatsapp-satis/'],['Yapay zekâ otomasyonları','/yapay-zeka-otomasyonlari/'],['Web tasarım','/web-tasarim/']],
  ecommerce: [['E-ticaret altyapısı','/e-ticaret/'],['Meta reklamları','/meta-reklamlari/'],['SEO, GEO, AEO ve AIO','/seo-geo/'],['Yapay zekâ otomasyonları','/yapay-zeka-otomasyonlari/']],
}[segment];

const canonicalUrl = new URL(Astro.url.pathname, 'https://qctcommerce.com').toString();
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': canonicalUrl + '#faq',
  url: canonicalUrl,
  inLanguage: isEnglish ? 'en-US' : 'tr-TR',
  mainEntity: segmentFaq.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---
<BaseLayout
  title={content.title + ' | QCT Commerce'}
  description={content.description}
  lang={lang}
  pageType="WebPage"
  breadcrumbLabel={content.eyebrow}
>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header slot="header" lang={lang} />

  <section class="qct-segment-hero">
    <div class="container">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p>{content.lead}</p>
      <div class="qct-segment-actions">
        <a class="button button--primary" href={contactUrl}>{isEnglish ? 'Discuss your current setup' : 'Mevcut yapınızı konuşalım'}</a>
        <a class="button button--secondary" href={servicesUrl}>{isEnglish ? 'Explore services' : 'Hizmetleri inceleyin'}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="qct-segment-heading">
        <p class="eyebrow">{isEnglish ? 'COMMON CONSTRAINTS' : 'SIK DARBOĞAZLAR'}</p>
        <h2>{isEnglish ? 'The problem is rarely just the website.' : 'Sorun çoğu zaman sadece web sitesi değildir.'}</h2>
      </div>
      <div class="qct-segment-grid">
        {content.pains.map(([title,text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section qct-segment-alt">
    <div class="container">
      <div class="qct-segment-heading">
        <p class="eyebrow">{isEnglish ? 'SYSTEM OUTCOMES' : 'SİSTEM ÇIKTILARI'}</p>
        <h2>{isEnglish ? 'Build the parts around one commercial objective.' : 'Parçaları tek ticari hedef etrafında birleştirin.'}</h2>
      </div>
      <div class="qct-segment-grid">
        {content.outcomes.map(([title,text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="qct-segment-heading">
        <p class="eyebrow">{isEnglish ? 'PROCESS' : 'SÜREÇ'}</p>
        <h2>{processTitle}</h2>
      </div>
      <div class="qct-segment-process">
        {process.map(([title,text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section qct-segment-faq" aria-labelledby="segment-faq-title">
    <div class="container">
      <div class="qct-segment-heading">
        <p class="eyebrow">{isEnglish ? 'DIRECT ANSWERS' : 'NET CEVAPLAR'}</p>
        <h2 id="segment-faq-title">{isEnglish ? 'Questions buyers and teams ask before the project starts.' : 'Proje başlamadan önce en sık netleştirilen sorular.'}</h2>
      </div>
      <div class="qct-segment-faq__list">
        {segmentFaq.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section qct-segment-related" aria-labelledby="segment-related-title">
    <div class="container">
      <div class="qct-segment-related__head">
        <div>
          <p class="eyebrow">{isEnglish ? 'RELATED CAPABILITIES' : 'İLGİLİ YETKİNLİKLER'}</p>
          <h2 id="segment-related-title">{isEnglish ? 'Connect the segment need to the right capability.' : 'Segment ihtiyacını doğru hizmetle eşleştirin.'}</h2>
        </div>
        <div class="qct-segment-related__links">
          {relatedLinks.map(([label, href]) => <a href={href}>{label}<span aria-hidden="true">↗</span></a>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section qct-segment-cta">
    <div class="container">
      <p class="eyebrow">{isEnglish ? 'NEXT STEP' : 'SONRAKİ ADIM'}</p>
      <h2>{isEnglish ? 'Start with the current commercial constraint.' : 'Önce mevcut ticari darboğazı netleştirelim.'}</h2>
      <p>{isEnglish ? 'Share your current site, platform, target market and priority. We will identify the most practical first scope.' : 'Mevcut sitenizi, platformunuzu, hedef pazarınızı ve önceliğinizi paylaşın. En uygulanabilir ilk kapsamı birlikte belirleyelim.'}</p>
      <a class="button button--primary" href={contactUrl}>{isEnglish ? 'Send a short project brief' : 'Kısa proje briefi gönderin'}</a>
    </div>
  </section>

  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
.qct-segment-hero { padding: clamp(5.4rem,8.5vw,7.6rem) 0 clamp(3.6rem,6vw,5rem); background: radial-gradient(circle at 50% 0,rgba(230,107,95,.09),transparent 36%),#f8f3ef; border-bottom:1px solid rgba(23,21,20,.08); }
.qct-segment-hero .container,.qct-segment-cta .container { text-align:center; max-width:960px; }
.qct-segment-hero h1 { margin:.6rem auto 1.2rem; color:#171514 !important; max-width:none; font-size:clamp(3rem,5vw,5rem); line-height:.98; letter-spacing:-.05em; text-wrap:balance; }
.qct-segment-hero p:not(.eyebrow),.qct-segment-cta p { max-width:760px; margin:0 auto; color:#665e59; font-size:clamp(1rem,1.5vw,1.18rem); line-height:1.7; }
.qct-segment-actions { display:flex; justify-content:center; gap:.75rem; flex-wrap:wrap; margin-top:2rem; }
.qct-segment-heading { max-width:760px; margin-bottom:2rem; }
.qct-segment-heading h2,.qct-segment-cta h2 { margin:.45rem 0 1rem; font-size:clamp(2rem,3.5vw,3.15rem); line-height:1.06; letter-spacing:-.032em; text-wrap:balance; }
.qct-segment-grid,.qct-segment-process { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1rem; }
