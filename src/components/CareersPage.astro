---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import ServicePage from './service/ServicePage.astro'; import {getPageSeo} from '../i18n/seo'; interface Props{lang:string} const{lang}=Astro.props; const seo=getPageSeo('careers');
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="Kariyer"><Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="Kariyer" title="QCT Commerce ile çalışmak ister misiniz?" lead="Açık bir pozisyon yayımlandığında rolün kapsamı ve başvuru koşulları bu sayfada paylaşılır. Genel iş birliği mesajlarınızı info@qctcommerce.com adresine gönderebilirsiniz." ctaPrimary="E-posta gönderin"
benefits={{eyebrow:'ÇALIŞMA İLKELERİ',title:'İyi dijital ürün; merak, sorumluluk ve açık iletişim ister.',lead:'Ekip büyüklüğü veya açık pozisyon hakkında doğrulanmamış bilgi yayımlamıyoruz.',items:[{title:'İş problemini anlama',text:'Tasarım veya geliştirmeden önce ticari bağlamı kavrama.'},{title:'Açık iletişim',text:'Kararları, riskleri ve ilerlemeyi anlaşılır biçimde paylaşma.'},{title:'Sürdürülebilir üretim',text:'Bakımı yapılabilir, erişilebilir ve performanslı işler üretme.'}]}}
included={{eyebrow:'GENEL BAŞVURU',title:'Mesajınızda neler olmalı?',lead:'İş birliği veya kariyer mesajınızı değerlendirebilmemiz için.',items:[{title:'Uzmanlık alanınız',text:'Hangi konuda değer ürettiğinizi açıklayın.'},{title:'İlgili çalışmalar',text:'Portföy veya somut çalışma örnekleri paylaşın.'},{title:'Çalışma biçiminiz',text:'Uygunluk ve iş birliği beklentinizi belirtin.'}]}}
process={{eyebrow:'DEĞERLENDİRME',title:'Başvurular role ve ihtiyaca göre değerlendirilir.',steps:[{number:'01',title:'Mesaj',text:'Kısa tanıtım ve ilgili çalışmaları gönderin.'},{number:'02',title:'İnceleme',text:'Mevcut ihtiyaçlarla uyumu değerlendirelim.'},{number:'03',title:'Görüşme',text:'Uygun bir ihtiyaç varsa sonraki adım için iletişime geçelim.'}]}}
faq={{eyebrow:'SIK SORULANLAR',title:'Kariyer hakkında',items:[{q:'Şu anda açık pozisyon var mı?',a:'Açık pozisyonlar olduğunda bu sayfada rol ve başvuru koşullarıyla birlikte yayımlanır.'},{q:'Genel başvuru gönderebilir miyim?',a:'Evet. İlgili çalışmalarınızla birlikte info@qctcommerce.com adresine yazabilirsiniz.'},{q:'Uzaktan çalışma mümkün mü?',a:'Çalışma biçimi yalnızca yayımlanan rolün doğrulanmış koşulları içinde belirtilir.'}]}}
final={{title:'Çalışmalarınızı paylaşmak ister misiniz?',text:'Kısa tanıtımınız ve ilgili örneklerle e-posta gönderebilirsiniz.',cta:'İletişim seçeneklerini inceleyin',ctaSecondary:'E-posta gönderin'}}/><Footer slot="footer" lang={lang}/></BaseLayout>
