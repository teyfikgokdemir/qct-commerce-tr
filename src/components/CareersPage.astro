---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ServicePage from './service/ServicePage.astro';
import { useTranslations } from '../i18n';
import { getPageSeo } from '../i18n/seo';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const seo = getPageSeo('careers', lang);
---
<BaseLayout title={seo.title} lang={lang} description={seo.description} breadcrumbLabel={t('Careers')}>
  <Header slot="header" lang={lang} />
  <ServicePage
    lang={lang}
    eyebrow={t('Careers')}
    title={t('A small team built for serious digital work.')}
    lead={t('QCT Studio is small by design. The work suits people who take responsibility, communicate clearly and want to build useful digital work for businesses that care about how they are seen online.')}
    ctaPrimary={t('Email Careers')}
    problem={{
      eyebrow: t('WHY WORK WITH QCT STUDIO'),
      title: t('Why the team stays small.'),
      intro: [t('A smaller team keeps decisions close to the work. It makes it easier to keep standards visible, move with care and stay close to the business problems we are solving.')],
      items: [
        { title: t('Ownership matters.'), text: t('People here are expected to take responsibility for the work in front of them.') },
        { title: t('Clear communication matters.'), text: t('The work depends on being able to explain decisions clearly and keep others informed without noise.') },
        { title: t('Long-term thinking matters.'), text: t('The work is built for businesses that expect digital work to stay useful and keep improving over time.') },
      ],
    }}
    benefits={{
      eyebrow: t('HOW WE WORK TOGETHER'),
      title: t('The work starts with the business, then the website follows.'),
      lead: t('Before design or development begins, we look at what the company sells, who buys it, how people decide and what should happen after someone visits the website.'),
      items: [
        { title: t('Understand the business'), text: t('We start with the offer, the customers and the real commercial problem the work needs to solve.') },
        { title: t('Work in writing'), text: t('Clear written updates keep the work visible and make decisions easier to follow later.') },
        { title: t('Keep it practical'), text: t('The work should stay useful, maintainable and sensible for the business after launch.') },
      ],
    }}
    included={{
      eyebrow: t('WHAT WE LOOK FOR'),
      title: t('Curiosity and judgment matter more than titles.'),
      lead: t('We value people who pay attention, learn quickly and keep the standard high when the work is routine.'),
      items: [
        { title: t('Curiosity'), text: t('Useful questions matter more than pretending to know everything from the start.') },
        { title: t('Consistency'), text: t('Good work keeps its shape over time, even when the project is moving quickly.') },
        { title: t('Judgment'), text: t('Knowing what matters and what can wait is part of the job.') },
        { title: t('Written updates'), text: t('Communication stays visible and easy to revisit.') },
        { title: t('Focused time'), text: t('People are expected to protect their attention and use it well.') },
        { title: t('No noise'), text: t('The work benefits from clear requests, clear answers and fewer unnecessary loops.') },
      ],
    }}
    process={{
      eyebrow: t('APPLICATION PROCESS'),
      title: t('A simple application process.'),
      steps: [
        { number: t('01'), title: t('Send a note'), text: t('Tell us who you are, what kind of work you do and why the role feels relevant.') },
        { number: t('02'), title: t('Share relevant work'), text: t('Include a portfolio, examples or a short explanation of the work you are proud of.') },
        { number: t('03'), title: t('Talk through the fit'), text: t('We discuss the kind of work involved, the way communication works and the practical expectations.') },
        { number: t('04'), title: t('Decide next steps'), text: t('If the fit is right, we decide whether the next step is a project, a conversation or a future collaboration.') },
      ],
    }}
    faq={{
      eyebrow: t('FAQ'),
      title: t('Questions we hear most often.'),
      items: [
        { q: t('Do I need to live in one place to work here?'), a: t('No. We work remotely and care more about communication and reliability than location.') },
        { q: t('Do you only look for people with agency experience?'), a: t('No. Real project experience, good judgment and solid habits matter more than the label on the previous job.') },
        { q: t('What kind of people fit well here?'), a: t('People who take responsibility, solve problems without waiting to be pushed and keep their standards high.') },
        { q: t('How much direction should I expect?'), a: t('Enough to understand the goal and the context, then space to think and do the work properly.') },
        { q: t('Is this full-time only?'), a: t('Not necessarily. The right fit matters more than the label, as long as the work and communication stay dependable.') },
      ],
    }}
    final={{
      eyebrow: t('READY WHEN YOU ARE'),
      title: t('If this feels like the kind of work you want to do, send a note.'),
      text: t('Tell us what you have done, how you like to work and why the fit feels right.'),
      cta: t('Email Careers'),
    }}
  />
  <Footer slot="footer" lang={lang} />
</BaseLayout>
