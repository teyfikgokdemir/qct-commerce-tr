---
interface Props { lang: string; }
const { lang } = Astro.props;
const isEnglish = lang === 'en';
const isGeorgian = lang === 'ka';

const mobileCopy = isGeorgian ? {
  tagline: 'ვებსაიტი, e-commerce და ციფრული ხილვადობა ერთ სივრცეში.',
  services: 'სერვისები',
  company: 'კომპანია',
  legal: 'იურიდიული',
  talk: 'მოდით ვისაუბროთ თქვენს პროექტზე',
  title: 'იდეა ერთად გადავაქციოთ რეალურ ციფრულ სისტემად.',
  text: 'მოგვწერეთ WhatsApp-ზე და საჭიროება მოკლედ დავაზუსტოთ.',
  whatsapp: 'WhatsApp-ზე დაწყება',
  top: 'ზემოთ',
  rights: 'ყველა უფლება დაცულია.'
} : isEnglish ? {
  tagline: 'One place for websites, e-commerce and digital visibility.',
  services: 'Services',
  company: 'Company',
  legal: 'Legal',
  talk: 'LET’S TALK ABOUT YOUR PROJECT',
  title: 'Turn the idea into a digital system that can actually be used.',
  text: 'Message us on WhatsApp and we will clarify the right starting scope.',
  whatsapp: 'Start on WhatsApp',
  top: 'Back to top',
  rights: 'All rights reserved.'
} : {
  tagline: 'Web sitesi, e-ticaret ve dijital görünürlük için tek merkez.',
  services: 'Hizmetler',
  company: 'Kurumsal',
  legal: 'Yasal',
  talk: 'PROJENİZİ KONUŞALIM',
  title: 'Fikrinizi birlikte gerçeğe dönüştürelim.',
  text: 'İhtiyacınızı WhatsApp’tan paylaşın; doğru başlangıç kapsamını birlikte netleştirelim.',
  whatsapp: 'WhatsApp’tan Başla',
  top: 'Yukarı çık',
  rights: 'Tüm hakları saklıdır.'
};

const serviceLinks = isGeorgian ? [
  ['ციფრული კომერცია','/ka/georgia/#system'],
  ['B2B გაყიდვების სისტემები','/ka/georgia/#system'],
  ['მრავალენოვანი ვებსაიტები','/ka/georgia/#system'],
  ['SEO, GEO, AEO და AIO','/ka/georgia/#system'],
] : isEnglish ? [
  ['E-commerce systems','/en/ecommerce/'],
  ['Shopify setup','/en/shopify-store-setup/'],
  ['ikas setup','/en/ikas-store-setup/'],
  ['Web design','/en/web-design/'],
  ['WhatsApp sales','/en/whatsapp-sales/'],
  ['SEO, GEO, AEO and AIO','/en/search-visibility/'],
  ['Meta ads','/en/meta-ads/'],
  ['AI automation','/en/ai-automation/'],
] : [
  ['E-ticaret altyapısı','/e-ticaret/'],
  ['Web tasarım','/web-tasarim/'],
  ['WhatsApp satış sistemleri','/whatsapp-satis/'],
  ['SEO, GEO, AEO ve AIO','/seo-geo/'],
];

const companyLinks = isGeorgian ? [
  ['საქართველო','/ka/georgia/'],
  ['International','/en/'],
  ['Türkiye','/'],
] : isEnglish ? [
  ['About QCT Commerce','/en/about/'],
  ['Services','/en/services/'],
  ['Selected work','/en/work/'],
  ['Pricing','/en/pricing/'],
  ['Blog','/en/blog/'],
  ['How we work','/en/how-we-work/'],
  ['Contact','/en/contact/'],
] : [
  ['Hakkımızda','/hakkimizda/'],
  ['Çalışmalar','/calismalar/'],
  ['Blog','/blog/'],
  ['Fiyatlar','/fiyatlar/'],
  ['İletişim','/iletisim/'],
];

const legalLinks = isGeorgian ? [
  ['Privacy policy','/gizlilik-politikasi/'],
  ['Cookie policy','/cerez-politikasi/'],
] : isEnglish ? [
  ['Privacy policy','/gizlilik-politikasi/'],
  ['Terms of use','/kullanim-kosullari/'],
  ['Cookie policy','/cerez-politikasi/'],
] : [
  ['Gizlilik politikası','/gizlilik-politikasi/'],
  ['KVKK aydınlatma metni','/kvkk/'],
  ['Kullanım koşulları','/kullanim-kosullari/'],
  ['Çerez politikası','/cerez-politikasi/'],
];
---
<footer id="colophon" class="site-footer">
  <div class="site-footer__marquee" aria-hidden="true">
    <div class="site-footer__marquee-track">
      <span>QCT COMMERCE</span><span>QCT COMMERCE</span><span>QCT COMMERCE</span><span>QCT COMMERCE</span>
    </div>
  </div>

  <div class="site-footer__inner container site-footer__desktop">
    <div class="site-footer__columns">
      <div class="site-footer__group site-footer__brand">
        <h2>QCT Commerce</h2>
        <p>{isGeorgian ? 'ციფრული კომერციისა და საერთაშორისო გაყიდვების სისტემები მზარდი კომპანიებისთვის.' : isEnglish ? 'Digital commerce and international sales systems for growing companies.' : 'Web, e-ticaret ve dijital görünürlük için uygulama ortağınız.'}</p>
        <p class="site-footer__brand-relationship">{isGeorgian ? 'QCT ekosisteminin bir parçasıdır.' : isEnglish ? 'Part of the wider QCT ecosystem.' : 'QCT ekosisteminin web ve dijital ticaret odaklı yapısıdır.'}</p>
      </div>

      {isGeorgian ? (
        <>
          <nav class="site-footer__group site-footer__nav" aria-label="გადაწყვეტილებები"><h2>გადაწყვეტილებები</h2><a href="/ka/georgia/#system">ციფრული კომერცია</a><a href="/ka/georgia/#system">B2B გაყიდვების სისტემები</a><a href="/ka/georgia/#system">მრავალენოვანი ვებსაიტები</a><a href="/ka/georgia/#system">SEO, GEO, AEO და AIO</a><a href="/ka/georgia/#system">AI და გაყიდვების ავტომატიზაცია</a></nav>
          <nav class="site-footer__group site-footer__company" aria-label="ბაზრები"><h2>ბაზრები</h2><a href="/ka/georgia/">საქართველო</a><a href="/en/">საერთაშორისო</a><a href="/">თურქეთი</a></nav>
          <div class="site-footer__group site-footer__markets"><h2>კონტაქტი</h2><p><a href="mailto:info@qctcommerce.com">info@qctcommerce.com</a></p><p><a href="https://wa.me/905456782655" target="_blank" rel="noopener noreferrer">WhatsApp: +90 545 678 26 55</a></p><p>თურქეთი · საერთაშორისო</p></div>
        </>
      ) : isEnglish ? (
        <>
          <nav class="site-footer__group site-footer__nav" aria-label="Solutions">
            <h2>Solutions</h2>
            <a href="/en/ecommerce/">E-commerce systems</a>
            <a href="/en/web-design/">B2B web design</a>
            <a href="/en/search-visibility/">SEO, GEO, AEO and AIO</a>
            <a href="/en/ai-automation/">AI and sales automation</a>
          </nav>
          <nav class="site-footer__group site-footer__company" aria-label="Company and markets">
            <h2>Explore</h2>
            <a href="/en/about/">About QCT Commerce</a>
            <a href="/en/work/">Selected work</a>
            <a href="/en/how-we-work/">How we work</a>
            <a href="/en/contact/">Contact</a>
            <a href="/en/georgia/">Georgia</a>
            <a href="/en/">International</a>
            <a href="/">Türkiye</a>
          </nav>
          <div class="site-footer__group site-footer__markets"><h2>Contact</h2><p><a href="mailto:info@qctcommerce.com">info@qctcommerce.com</a></p><p><a href="https://wa.me/905456782655" target="_blank" rel="noopener noreferrer">WhatsApp: +90 545 678 26 55</a></p><p>Türkiye · International</p></div>
        </>
      ) : (
        <>
          <nav class="site-footer__group site-footer__nav" aria-label="Hizmetler"><h2>Hizmetler</h2><a href="/e-ticaret/">E-ticaret altyapısı</a><a href="/web-tasarim/">Web tasarım</a><a href="/whatsapp-satis/">WhatsApp satış sistemleri</a><a href="/seo-geo/">SEO, GEO, AEO ve AIO</a><a href="/meta-reklamlari/">Meta reklamları</a><a href="/yapay-zeka-otomasyonlari/">Yapay zekâ otomasyonları</a></nav>
          <nav class="site-footer__group site-footer__company" aria-label="Kurumsal"><h2>Kurumsal</h2><a href="/hakkimizda/">Hakkımızda</a><a href="/hizmetler/">Hizmetler</a><a href="/calismalar/">Çalışmalar</a><a href="/blog/">Blog</a><a href="/kariyer/">Kariyer</a><a href="/iletisim/">İletişim</a><a href="/gizlilik-politikasi/">Gizlilik politikası</a><a href="/kvkk/">KVKK aydınlatma metni</a><a href="/kullanim-kosullari/">Kullanım koşulları</a><a href="/cerez-politikasi/">Çerez politikası</a></nav>
          <div class="site-footer__group site-footer__markets"><h2>İletişim</h2><p><a href="mailto:info@qctcommerce.com">info@qctcommerce.com</a></p><p><a href="https://wa.me/905456782655" target="_blank" rel="noopener noreferrer">WhatsApp: +90 545 678 26 55</a></p><p>Türkiye</p></div>
        </>
      )}
    </div>
    <div class="site-footer__bottom"><div class="site-footer__copyright"><p>&copy; 2026 QCT Commerce</p></div></div>
  </div>

  <div class="site-footer__mobile" aria-label={isEnglish ? 'Footer' : 'Alt bilgi'}>
    <div class="site-footer__mobile-brand">
      <span class="site-footer__mobile-mark"></span>
      <strong>QCT COMMERCE</strong>
      <p>{mobileCopy.tagline}</p>
    </div>

    <div class="site-footer__accordions">
      <details open>
        <summary>
          <span class="site-footer__round-icon" aria-hidden="true"><i></i></span>
          <strong>{mobileCopy.services}</strong>
          <span class="site-footer__chevron" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <div class="site-footer__accordion-body">
          {serviceLinks.map(([label, href]) => <a href={href}><span>{label}</span><span aria-hidden="true">›</span></a>)}
        </div>
      </details>

      <details>
        <summary>
          <span class="site-footer__round-icon" aria-hidden="true"><i></i></span>
          <strong>{mobileCopy.company}</strong>
          <span class="site-footer__chevron" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <div class="site-footer__accordion-body">
          {companyLinks.map(([label, href]) => <a href={href}><span>{label}</span><span aria-hidden="true">›</span></a>)}
        </div>
      </details>

      <details>
        <summary>
          <span class="site-footer__round-icon" aria-hidden="true"><i></i></span>
          <strong>{mobileCopy.legal}</strong>
          <span class="site-footer__chevron" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <div class="site-footer__accordion-body">
          {legalLinks.map(([label, href]) => <a href={href}><span>{label}</span><span aria-hidden="true">›</span></a>)}
        </div>
      </details>
    </div>

    <section class="site-footer__cta" aria-label={mobileCopy.talk}>
      <div>
        <p class="site-footer__cta-eyebrow">{mobileCopy.talk}</p>
        <h2>{mobileCopy.title}</h2>
        <p>{mobileCopy.text}</p>
      </div>
      <div class="site-footer__cta-actions">
        <a class="site-footer__whatsapp" href="https://wa.me/905456782655" target="_blank" rel="noopener noreferrer">
          <span aria-hidden="true">◉</span>
          <strong>{mobileCopy.whatsapp}</strong>
          <span aria-hidden="true">→</span>
        </a>

      </div>
    </section>

    <div class="site-footer__mobile-bottom">
      <p>&copy; 2026 QCT Commerce. {mobileCopy.rights}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { position: relative; overflow: hidden; isolation: isolate; }
  .site-footer__inner { position: relative; z-index: 1; padding-top: clamp(3.9rem, 5.4vw, 5rem); }
  .site-footer__mobile { display: none; }
  .site-footer__marquee {
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    height: clamp(3.9rem, 5.4vw, 5rem);
    display: flex;
    align-items: center;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .site-footer__marquee-track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: clamp(1.5rem, 3vw, 3.5rem);
    animation: qctCommerceMarquee 26s linear infinite;
    will-change: transform;
  }
  .site-footer__marquee span {
    color: transparent;
    background: linear-gradient(90deg, #c8ff3d 0%, #dffb64 26%, #ff8b78 62%, #e66b5f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 24px rgba(230, 107, 95, .08);
    font-size: clamp(2.2rem, 5.2vw, 4.7rem);
    font-weight: 800;
    line-height: .84;
    letter-spacing: -.045em;
    white-space: nowrap;
  }
  @keyframes qctCommerceMarquee { to { transform: translateX(calc(-25% - .75rem)); } }

  @media (max-width:760px) {
    .site-footer {
      background:
        radial-gradient(circle at 88% 72%, rgba(200,255,61,.08), transparent 24%),
        radial-gradient(circle at 10% 8%, rgba(255,123,103,.08), transparent 28%),
        #171412;
      color:#f7f1e9;
      overflow:visible;
    }

    .site-footer__desktop,
    .site-footer__marquee { display:none; }

    .site-footer__mobile {
      display:block;
      padding:38px 18px calc(22px + env(safe-area-inset-bottom,0px));
    }

    .site-footer__mobile-brand {
      padding:0 6px 24px;
      border-bottom:1px solid rgba(255,255,255,.10);
    }

    .site-footer__mobile-mark {
      display:block;
      width:4px;
      height:32px;
      border-radius:999px;
      background:linear-gradient(180deg,#ff7b67,#c8ff3d);
      margin-bottom:14px;
    }

    .site-footer__mobile-brand strong {
      display:block;
      color:#f7f1e9;
      font-size:1.02rem;
      letter-spacing:.16em;
      font-weight:900;
    }

    .site-footer__mobile-brand p {
      margin:10px 0 0;
      color:rgba(247,241,233,.64);
      font-size:.9rem;
      line-height:1.55;
      max-width:32ch;
    }

    .site-footer__accordions details {
      border-bottom:1px solid rgba(255,255,255,.10);
    }

    .site-footer__accordions summary {
      list-style:none;
      display:grid;
      grid-template-columns:42px 1fr auto;
      align-items:center;
      gap:12px;
      min-height:74px;
      cursor:pointer;
    }

    .site-footer__accordions summary::-webkit-details-marker { display:none; }

    .site-footer__round-icon {
      position:relative;
      width:38px;
      height:38px;
      display:grid;
      place-items:center;
      border:1px solid rgba(255,123,103,.24);
      border-radius:50%;
      background:linear-gradient(145deg,rgba(255,123,103,.07),rgba(255,255,255,.01));
      box-shadow:inset 0 1px 0 rgba(255,255,255,.025);
    }

    .site-footer__round-icon::before {
      content:"";
      position:absolute;
      inset:6px;
      border:1px solid rgba(255,123,103,.10);
      border-radius:50%;
    }

    .site-footer__round-icon i {
      width:7px;
      height:7px;
      border-radius:2px;
      background:#ff634f;
      box-shadow:0 0 14px rgba(255,99,79,.28);
      transform:rotate(45deg);
    }

    .site-footer__accordions summary strong {
      color:#f7f1e9;
      font-size:1rem;
      font-weight:800;
      letter-spacing:-.01em;
    }

    .site-footer__chevron {
      position:relative;
      width:30px;
      height:30px;
      display:grid;
      place-items:center;
      border:1px solid rgba(255,99,79,.22);
      border-radius:50%;
      background:linear-gradient(145deg,rgba(255,99,79,.08),rgba(255,255,255,.015));
      box-shadow:inset 0 1px 0 rgba(255,255,255,.035);
      transition:transform .24s cubic-bezier(.2,.7,.2,1),border-color .2s ease,background .2s ease;
    }

    .site-footer__chevron i {
      position:absolute;
      top:14px;
      width:7px;
      height:1.5px;
      border-radius:999px;
      background:#ff634f;
      box-shadow:0 0 10px rgba(255,99,79,.22);
    }

    .site-footer__chevron i:first-child { left:8px; transform:rotate(42deg); }
    .site-footer__chevron i:last-child { right:8px; transform:rotate(-42deg); }

    .site-footer__accordions summary:active .site-footer__chevron {
      border-color:rgba(200,255,61,.32);
      background:rgba(200,255,61,.05);
    }

    .site-footer__accordions details[open] .site-footer__chevron {
      transform:rotate(180deg);
      border-color:rgba(255,99,79,.34);
    }

    .site-footer__accordion-body {
      padding:0 4px 16px 54px;
      display:grid;
      gap:2px;
    }

    .site-footer__accordion-body a {
      min-height:42px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
      color:rgba(247,241,233,.78);
      text-decoration:none;
      font-size:.88rem;
      border-bottom:1px solid rgba(255,255,255,.045);
    }

    .site-footer__accordion-body a span:last-child {
      color:#c8ff3d;
      font-size:1.05rem;
    }

    .site-footer__cta {
      position:relative;
      overflow:hidden;
      margin-top:26px;
      padding:24px 20px 20px;
      border:1px solid rgba(255,123,103,.44);
      border-radius:24px;
      background:
        linear-gradient(145deg,rgba(255,123,103,.12),rgba(255,255,255,.02) 54%,rgba(200,255,61,.06)),
        #1d1917;
      box-shadow:0 24px 60px rgba(0,0,0,.24), inset 0 1px 0 rgba(255,255,255,.04);
    }

    .site-footer__cta::after {
      content:"";
      position:absolute;
      width:110px;
      height:110px;
      right:-38px;
      top:-38px;
      border-radius:50%;
      background:radial-gradient(circle,rgba(200,255,61,.14),transparent 68%);
      pointer-events:none;
    }

    .site-footer__cta-eyebrow {
      margin:0 0 12px;
      color:#ff8b78!important;
      font-size:.62rem!important;
      letter-spacing:.18em;
      font-weight:900;
    }

    .site-footer__cta h2 {
      margin:0;
      color:#fffaf5;
      font-size:clamp(1.65rem,7.5vw,2.2rem);
      line-height:1.02;
      letter-spacing:-.04em;
      max-width:11ch;
    }

    .site-footer__cta>div>p:last-child {
      margin:14px 0 0;
      color:rgba(247,241,233,.62);
      font-size:.86rem;
      line-height:1.55;
      max-width:31ch;
    }

    .site-footer__cta-actions {
      display:block;
      margin-top:20px;
    }

    .site-footer__whatsapp {
      min-height:52px;
      display:grid;
      grid-template-columns:auto 1fr auto;
      align-items:center;
      gap:10px;
      padding:0 15px;
      border-radius:999px;
      background:linear-gradient(90deg,#ff7b67 0%,#ff8b78 58%,#c8ff3d 135%);
      color:#171412;
      text-decoration:none;
      box-shadow:0 12px 28px rgba(255,123,103,.16);
    }

    .site-footer__whatsapp strong {
      font-size:.88rem;
      font-weight:900;
    }

    .site-footer__whatsapp span:last-child { font-size:1rem; }


    .site-footer__mobile-bottom {
      display:flex;
      align-items:center;
      justify-content:center;
      margin-top:24px;
      padding:18px 4px 0;
      border-top:1px solid rgba(255,255,255,.10);
      text-align:center;
    }

    .site-footer__mobile-bottom p {
      width:100%;
      margin:0;
      color:rgba(247,241,233,.45);
      font-size:.68rem;
      line-height:1.4;
      text-align:center;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__marquee-track { animation:none; transform:translateX(-8%); }
    .site-footer__chevron { transition:none; }
  }
</style>