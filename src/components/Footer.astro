---
interface Props { lang: string; }
const { lang } = Astro.props;
const isEnglish = lang === 'en';
const isGeorgian = lang === 'ka';
---
<footer id="colophon" class="site-footer">
  <div class="site-footer__watermark" aria-hidden="true">QCT COMMERCE</div>
  <div class="site-footer__inner container">
    <div class="site-footer__columns">
      <div class="site-footer__group site-footer__brand">
        <h2>QCT Commerce</h2>
        <p>{isGeorgian ? 'ციფრული კომერციისა და საერთაშორისო გაყიდვების სისტემები მზარდი კომპანიებისთვის.' : isEnglish ? 'Digital commerce and international sales systems for growing companies.' : 'Türkiye’de e-ticaret ve dijital büyüme ortağınız.'}</p>
        <p class="site-footer__brand-relationship">{isGeorgian ? 'QCT Studio-ს ქსელის ნაწილი.' : isEnglish ? 'Part of the QCT Studio network.' : 'QCT Studio ağı içinde Türkiye’ye odaklanır.'}</p>
      </div>

      {isGeorgian ? (
        <>
          <nav class="site-footer__group site-footer__nav" aria-label="გადაწყვეტილებები"><h2>გადაწყვეტილებები</h2><a href="/ka/georgia/#system">ციფრული კომერცია</a><a href="/ka/georgia/#system">B2B გაყიდვების სისტემები</a><a href="/ka/georgia/#system">მრავალენოვანი ვებსაიტები</a><a href="/ka/georgia/#system">SEO, GEO, AEO და AIO</a><a href="/ka/georgia/#system">AI და გაყიდვების ავტომატიზაცია</a></nav>
          <nav class="site-footer__group site-footer__company" aria-label="ბაზრები"><h2>ბაზრები</h2><a href="/ka/georgia/">საქართველო</a><a href="/en/">საერთაშორისო</a><a href="/">თურქეთი</a></nav>
          <div class="site-footer__group site-footer__markets"><h2>კონტაქტი</h2><p><a href="mailto:info@qctcommerce.com">info@qctcommerce.com</a></p><p><a href="tel:+905433856656">+90 543 385 66 56</a></p><p>თურქეთი · საერთაშორისო</p></div>
        </>
      ) : isEnglish ? (
        <>
          <nav class="site-footer__group site-footer__nav" aria-label="Solutions">
            <h2>Solutions</h2>
            <a href="/en/ecommerce/">E-commerce systems</a>
            <a href="/en/web-design/">B2B web design</a>
            <a href="/en/search-visibility/">SEO, GEO, AEO and AIO</a>
            <a href="/en/ai-automation/">AI and sales automation</a>
          </nav>
          <nav class="site-footer__group site-footer__company" aria-label="Company and markets">
            <h2>Explore</h2>
            <a href="/en/about/">About QCT Commerce</a>
            <a href="/en/work/">Selected work</a>
            <a href="/en/how-we-work/">How we work</a>
            <a href="/en/contact/">Contact</a>
            <a href="/en/georgia/">Georgia</a>
            <a href="/en/">International</a>
            <a href="/">Türkiye</a>
          </nav>
          <div class="site-footer__group site-footer__markets"><h2>Contact</h2><p><a href="mailto:info@qctcommerce.com">info@qctcommerce.com</a></p><p><a href="tel:+905433856656">+90 543 385 66 56</a></p><p>Türkiye · International</p></div>
        </>
      ) : (
        <>
          <nav class="site-footer__group site-footer__nav" aria-label="Hizmetler"><h2>Hizmetler</h2><a href="/e-ticaret/">E-ticaret altyapısı</a><a href="/web-tasarim/">Web tasarım</a><a href="/whatsapp-satis/">WhatsApp satış sistemleri</a><a href="/seo-geo/">SEO, GEO, AEO ve AIO</a><a href="/meta-reklamlari/">Meta reklamları</a><a href="/yapay-zeka-otomasyonlari/">Yapay zekâ otomasyonları</a></nav>
          <nav class="site-footer__group site-footer__company" aria-label="Kurumsal"><h2>Kurumsal</h2><a href="/hakkimizda/">Hakkımızda</a><a href="/hizmetler/">Hizmetler</a><a href="/calismalar/">Çalışmalar</a><a href="/blog/">Blog</a><a href="/kariyer/">Kariyer</a><a href="/iletisim/">İletişim</a><a href="/gizlilik-politikasi/">Gizlilik politikası</a><a href="/kvkk/">KVKK aydınlatma metni</a><a href="/kullanim-kosullari/">Kullanım koşulları</a><a href="/cerez-politikasi/">Çerez politikası</a></nav>
          <div class="site-footer__group site-footer__markets"><h2>İletişim</h2><p><a href="mailto:info@qctcommerce.com">info@qctcommerce.com</a></p><p><a href="tel:+905433856656">+90 543 385 66 56</a></p><p>Türkiye</p></div>
        </>
      )}
    </div>
    <div class="site-footer__bottom"><div class="site-footer__copyright"><p>&copy; 2026 QCT Commerce</p></div></div>
  </div>
</footer>

<style>
  .site-footer { position: relative; overflow: hidden; isolation: isolate; }
  .site-footer__inner { position: relative; z-index: 1; padding-top: clamp(8.5rem, 14vw, 13rem); }
  .site-footer__watermark {
    position: absolute;
    top: 1.35rem;
    left: 50%;
    z-index: 0;
    font-size: clamp(5.2rem, 13vw, 12.5rem);
    font-weight: 800;
    line-height: .82;
    letter-spacing: -.065em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(230, 107, 95, .075);
    text-shadow: 0 0 42px rgba(230, 107, 95, .045);
    transform: translateX(-52%);
    animation: qctCommerceFooterDrift 34s ease-in-out infinite alternate;
    pointer-events: none;
    user-select: none;
  }
  @keyframes qctCommerceFooterDrift { from { transform: translateX(-53%); } to { transform: translateX(-47%); } }
  @media (max-width: 760px) {
    .site-footer__inner { padding-top: clamp(6.5rem, 25vw, 9rem); }
    .site-footer__watermark { top: 1.4rem; font-size: clamp(3.8rem, 20vw, 6.8rem); animation: none; transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) { .site-footer__watermark { animation: none; transform: translateX(-50%); } }
</style>