---
interface Props { lang: string; }
const { lang } = Astro.props;
const isEnglish = lang === 'en';
const isAzerbaijani = lang === 'az';
const homeHref = isAzerbaijani ? '/az/' : isEnglish ? '/en/' : '/';
const homeLabel = isAzerbaijani ? 'QCT Commerce — ana səhifə' : isEnglish ? 'QCT Commerce — home' : 'QCT Commerce — ana sayfa';

const mobileCopy = isAzerbaijani ? {
  tagline: 'Veb sayt, e-ticarət və rəqəmsal görünürlük üçün vahid tərəfdaş.',
  services: 'Xidmətlər',
  company: 'Şirkət',
  legal: 'Hüquqi',
  talk: 'LAYİHƏNİZİ MÜZAKİRƏ EDƏK',
  title: 'İdeyanızı işləyən rəqəmsal sistemə çevirək.',
  text: 'WhatsApp-da ehtiyacınızı yazın; uyğun başlanğıc çərçivəsini birlikdə müəyyənləşdirək.',
  whatsapp: 'WhatsApp-da başlayın',
  top: 'Yuxarı',
  rights: 'Bütün hüquqlar qorunur.'
} : isEnglish ? {
  tagline: 'One place for websites, e-commerce and digital visibility.',
  services: 'Services',
  company: 'Company',
  legal: 'Legal',
  talk: 'LET’S TALK ABOUT YOUR PROJECT',
  title: 'Turn the idea into a digital system that can actually be used.',
  text: 'Message us on WhatsApp and we will clarify the right starting scope.',
  whatsapp: 'Start on WhatsApp',
  top: 'Back to top',
  rights: 'All rights reserved.'
} : {
  tagline: 'Web sitesi, e-ticaret ve dijital görünürlük için tek merkez.',
  services: 'Hizmetler',
  company: 'Kurumsal',
  legal: 'Yasal',
  talk: 'PROJENİZİ KONUŞALIM',
  title: 'Fikrinizi birlikte gerçeğe dönüştürelim.',
  text: 'İhtiyacınızı WhatsApp’tan paylaşın; doğru başlangıç kapsamını birlikte netleştirelim.',
  whatsapp: 'WhatsApp’tan Başla',
  top: 'Yukarı çık',
  rights: 'Tüm hakları saklıdır.'
};

const serviceLinks = isAzerbaijani ? [
  ['Veb dizayn','/az/veb-dizayn/'],
  ['E-ticarət','/az/e-ticaret/'],
  ['SEO, GEO, AEO və AIO','/az/seo-geo/'],
  ['WhatsApp satış sistemləri','/az/whatsapp-satis/'],
  ['Meta reklamları','/az/meta-reklamlari/'],
  ['AI avtomatlaşdırma','/az/ai-avtomatlasdirma/'],
] : isEnglish ? [
  ['E-commerce systems','/en/ecommerce/'],
  ['Shopify setup','/en/shopify-store-setup/'],
  ['ikas setup','/en/ikas-store-setup/'],
  ['Web design','/en/web-design/'],
  ['WhatsApp sales','/en/whatsapp-sales/'],
  ['SEO, GEO, AEO and AIO','/en/search-visibility/'],
  ['Meta ads','/en/meta-ads/'],
  ['AI automation','/en/ai-automation/'],
] : [
  ['E-ticaret altyapısı','/e-ticaret/'],
  ['Web tasarım','/web-tasarim/'],
  ['WhatsApp satış sistemleri','/whatsapp-satis/'],
  ['SEO, GEO, AEO ve AIO','/seo-geo/'],
  ['Meta reklamları','/meta-reklamlari/'],
  ['Yapay zekâ otomasyonları','/yapay-zeka-otomasyonlari/'],
];

const companyLinks = isAzerbaijani ? [
  ['Haqqımızda','/az/haqqimizda/'],
  ['İşlərimiz','/az/isler/'],
  ['Xidmətlər','/az/xidmetler/'],
  ['Qiymətlər','/az/qiymetler/'],
  ['Necə işləyirik','/az/nece-isleyirik/'],
  ['Rəqəmsal audit','/az/reqemsal-audit/'],
  ['Bloq','/az/bloq/'],
  ['Karyera','/az/karyera/'],
  ['Əlaqə','/az/elaqe/'],
] : isEnglish ? [
  ['About QCT Commerce','/en/about/'],
  ['Work','/en/work/'],
  ['Services','/en/services/'],
  ['Manufacturers','/en/manufacturers/'],
  ['Exporters','/en/exporters/'],
  ['Distributors & B2B','/en/distributors-b2b/'],
  ['E-commerce brands','/en/ecommerce-brands/'],
  ['Pricing','/en/pricing/'],
  ['Blog','/en/blog/'],
  ['Careers','/en/careers/'],
  ['How we work','/en/how-we-work/'],
  ['Contact','/en/contact/'],
] : [
  ['Hakkımızda','/hakkimizda/'],
  ['Çalışmalar','/calismalar/'],
  ['Üreticiler','/ureticiler/'],
  ['İhracatçılar','/ihracatcilar/'],
  ['Distribütör & B2B','/distributor-b2b/'],
  ['E-ticaret markaları','/e-ticaret-markalari/'],
  ['Blog','/blog/'],
  ['Nasıl çalışıyoruz','/nasil-calisiyoruz/'],
  ['İletişim','/iletisim/'],
];

const resourceLinks = [['Hizmetler','/hizmetler/'], ['Dijital audit','/audit/'], ['Fiyatlar','/fiyatlar/'], ['Rehberler','/rehberler/'], ['Ücretsiz araçlar','/tr/araclar/']];

const legalLinks = isAzerbaijani ? [
  ['Məxfilik siyasəti','/az/mexfilik/'],
  ['KVKK məlumatlandırması','/az/kvkk/'],
  ['İstifadə şərtləri','/az/istifade-sertleri/'],
  ['Kuki siyasəti','/az/kuki-siyaseti/'],
] : isEnglish ? [
  ['Privacy policy','/en/privacy-policy/'],
  ['KVKK notice','/en/kvkk/'],
  ['Terms of use','/en/terms/'],
  ['Cookie policy','/en/cookie-policy/'],
] : [
  ['Gizlilik politikası','/gizlilik-politikasi/'],
  ['KVKK aydınlatma metni','/kvkk/'],
  ['Kullanım koşulları','/kullanim-kosullari/'],
  ['Çerez politikası','/cerez-politikasi/'],
];
const marqueePhrases = isAzerbaijani
  ? ['VEB DİZAYN', 'E-TİCARƏT', 'RƏQƏMSAL GÖRÜNÜRLÜK', 'AI AVTOMATLAŞDIRMA']
  : isEnglish
    ? ['WEB DESIGN', 'E-COMMERCE', 'SEARCH VISIBILITY', 'AI AUTOMATION']
    : ['WEB TASARIM', 'E-TİCARET', 'DİJİTAL GÖRÜNÜRLÜK', 'YAPAY ZEKÂ OTOMASYONU'];

const audienceLinks = isAzerbaijani ? [
  ['İstehsalçılar', '/az/istehsalcilar/'],
  ['İxracatçılar', '/az/ixracatcilar/'],
  ['Distribütor & B2B', '/az/distributor-b2b/'],
  ['E-ticarət brendləri', '/az/e-ticaret-brendleri/'],
] : isEnglish ? [
  ['Manufacturers', '/en/manufacturers/'],
  ['Exporters', '/en/exporters/'],
  ['Distributors & B2B', '/en/distributors-b2b/'],
  ['E-commerce brands', '/en/ecommerce-brands/'],
] : [
  ['Üreticiler', '/ureticiler/'],
  ['İhracatçılar', '/ihracatcilar/'],
  ['Distribütör & B2B', '/distributor-b2b/'],
  ['E-ticaret markaları', '/e-ticaret-markalari/'],
];
const editorialCompanyLinks = isAzerbaijani ? [
  ['Haqqımızda', '/az/haqqimizda/'],
  ['İşlərimiz', '/az/isler/'],
  ['Necə işləyirik', '/az/nece-isleyirik/'],
  ['Qiymətlər', '/az/qiymetler/'],
  ['Bloq', '/az/bloq/'],
  ['Əlaqə', '/az/elaqe/'],
] : isEnglish ? [
  ['About', '/en/about/'],
  ['Work', '/en/work/'],
  ['How we work', '/en/how-we-work/'],
  ['Pricing', '/en/pricing/'],
  ['Blog', '/en/blog/'],
  ['Careers', '/en/careers/'],
  ['Contact', '/en/contact/'],
] : [
  ['Hakkımızda', '/hakkimizda/'],
  ['Çalışmalar', '/calismalar/'],
  ['Nasıl çalışıyoruz', '/nasil-calisiyoruz/'],
  ['Fiyatlar', '/fiyatlar/'],
  ['Blog', '/blog/'],
  ['Kariyer', '/kariyer/'],
  ['İletişim', '/iletisim/'],
];
const azLocationLinks = [
  ['Bütün lokasiyalar', '/az/lokasiya/'],
  ['Bakı', '/az/lokasiya/baki/'],
  ['Gəncə', '/az/lokasiya/gence/'],
  ['Sumqayıt', '/az/lokasiya/sumqayit/'],
  ['Naxçıvan', '/az/lokasiya/naxcivan/'],
  ['Mingəçevir', '/az/lokasiya/mingecevir/'],
  ['Lənkəran', '/az/lokasiya/lenkeran/'],
];
const editorial = isAzerbaijani ? {
  eyebrow: 'VEB · E-TİCARƏT · RƏQƏMSAL GÖRÜNÜRLÜK',
  title: 'Rəqəmsal işinizi bir yerdən inkişaf etdirin.',
  lead: 'Veb saytlar, e-ticarət və axtarış görünürlüğü üçün işinizə uyğun həllər hazırlayırıq.',
  tag: 'VEBSAYT · E-TİCARƏT · SEO · AVTOMATLAŞDIRMA',
  badge: 'LAYİHƏNİZ ÜÇÜN BİRBAŞA ƏLAQƏ',
  cardTitle: 'Növbəti rəqəmsal layihənizi birlikdə planlaşdıraq.',
  cardText: 'Ehtiyacınızı bildirin; uyğun iş həcmini və ilk addımları dəqiqləşdirək.',
  action: 'Layihənizi paylaşın',
  services: 'Xidmətlər', audiences: 'Kimlər üçün', company: 'Şirkət', contact: 'Əlaqə',
  resources: 'Lokasiyalar', email: 'E-POÇT', whatsapp: 'WHATSAPP', region: 'TÜRKİYƏ',
  rights: 'Bütün hüquqlar qorunur.',
} : isEnglish ? {
  eyebrow: 'WEB · E-COMMERCE · DIGITAL VISIBILITY',
  title: 'Build a stronger digital presence in one place.',
  lead: 'Websites, e-commerce and search visibility solutions shaped around your business needs.',
  tag: 'WEB · E-COMMERCE · SEO · AUTOMATION',
  badge: 'DIRECT PROJECT DESK',
  cardTitle: 'Plan your next digital project with us.',
  cardText: 'Tell us what you need so we can define a practical scope and the next steps.',
  action: 'Discuss your project',
  services: 'Services', audiences: 'Who we help', company: 'Company', contact: 'Contact',
  resources: 'Resources', email: 'EMAIL', whatsapp: 'WHATSAPP', region: 'TÜRKİYE',
  rights: 'All rights reserved.',
} : {
  eyebrow: 'WEB · E-TİCARET · DİJİTAL GÖRÜNÜRLÜK',
  title: 'Dijital işinizi tek noktadan büyütün.',
  lead: 'Web sitesi, e-ticaret ve arama görünürlüğü çözümlerini işletmenizin ihtiyaçlarına göre geliştiriyoruz.',
  tag: 'WEB · E-TİCARET · SEO · OTOMASYON',
  badge: 'PROJENİZ İÇİN DOĞRUDAN İLETİŞİM',
  cardTitle: 'Bir sonraki dijital projenizi birlikte planlayalım.',
  cardText: 'İhtiyacınızı paylaşın; uygun kapsamı ve başlangıç adımlarını netleştirelim.',
  action: 'Proje detaylarını paylaşın',
  services: 'Hizmetler', audiences: 'Kimler için', company: 'Kurumsal', contact: 'İletişim',
  resources: 'Kaynaklar ve araçlar', email: 'E-POSTA', whatsapp: 'WHATSAPP', region: 'TÜRKİYE',
  rights: 'Tüm hakları saklıdır.',
};
const contactHref = isAzerbaijani ? '/az/elaqe/' : isEnglish ? '/en/contact/' : '/iletisim/';

---
<footer id="colophon" class="site-footer site-footer--editorial">
  <div class="qcte-marquee" aria-hidden="true">
    <div class="qcte-marquee__track">
      <div class="qcte-marquee__group">
        {marqueePhrases.map((phrase) => <span>{phrase}</span>)}
      </div>
      <div class="qcte-marquee__group" aria-hidden="true">
        {marqueePhrases.map((phrase) => <span>{phrase}</span>)}
      </div>
    </div>
  </div>

  <div class="container qcte-editorial">
    <div class="qcte-editorial__lead">
      <div class="qcte-brand">
        <a href={homeHref} class="qcte-logo" aria-label={homeLabel}>
          <img src="/images/qct-commerce-primary-dark.webp" width="940" height="490" alt="QCT Commerce" loading="lazy" decoding="async" />
        </a>
        <p class="qcte-eyebrow">{editorial.eyebrow}</p>
        <h2 class="qcte-brand__title">{editorial.title}</h2>
        <p class="qcte-brand__text">{editorial.lead}</p>
        <div class="qcte-status"><span class="qcte-status__dot" aria-hidden="true"></span>{editorial.tag}</div>
      </div>

      <aside class="qcte-desk">
        <p class="qcte-desk__badge">{editorial.badge}</p>
        <h3 class="qcte-desk__title">{editorial.cardTitle}</h3>
        <p class="qcte-desk__text">{editorial.cardText}</p>
        <a class="qcte-desk__button" href={contactHref}>
          <span>{editorial.action}</span><span aria-hidden="true">↗</span>
        </a>
      </aside>
    </div>

    <div class="qcte-rule" aria-hidden="true"></div>

    <div class="qcte-grid">
      <nav class="qcte-col" aria-label={editorial.services}>
        <h3 class="qcte-col__label">{editorial.services}</h3>
        {serviceLinks.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
      <nav class="qcte-col" aria-label={editorial.audiences}>
        <h3 class="qcte-col__label">{editorial.audiences}</h3>
        {audienceLinks.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
      <nav class="qcte-col" aria-label={editorial.company}>
        <h3 class="qcte-col__label">{editorial.company}</h3>
        {editorialCompanyLinks.map(([label, href]) => <a href={href}>{label}</a>)}
        {(!isEnglish || isAzerbaijani) && (
          <div class="qcte-col__extra">
            <h4 class="qcte-col__label">{editorial.resources}</h4>
            {(isAzerbaijani ? azLocationLinks : resourceLinks).map(([label, href]) => <a href={href}>{label}</a>)}
          </div>
        )}
      </nav>
      <div class="qcte-col qcte-contact">
        <h3 class="qcte-col__label">{editorial.contact}</h3>
        <a class="qcte-contact__card" href="mailto:info@qctcommerce.com">
          <span class="qcte-contact__type">{editorial.email}</span>
          <span class="qcte-contact__value">info@qctcommerce.com</span>
        </a>
        <a class="qcte-contact__card" href="https://wa.me/905456782655" target="_blank" rel="noopener noreferrer">
          <span class="qcte-contact__type">{editorial.whatsapp}</span>
          <span class="qcte-contact__value">+90 545 678 26 55</span>
        </a>
        <span class="qcte-contact__location">{editorial.region}</span>
      </div>
    </div>

    <div class="qcte-bottom">
      <div class="qcte-bottom__brand">
        <span>&copy; 2026 QCT Commerce</span><span aria-hidden="true">·</span><span>{editorial.rights}</span>
      </div>
      <nav class="qcte-bottom__legal" aria-label={isAzerbaijani ? 'Hüquqi' : isEnglish ? 'Legal' : 'Yasal'}>
        {legalLinks.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
    </div>
  </div>

  {(!isEnglish && !isAzerbaijani) && (
<nav class="site-footer__locations" aria-label="Bölgeler" style="display:none;">
  <a href="/lokasyon/istanbul/">İstanbul</a>
  <a href="/lokasyon/ankara/">Ankara</a>
  <a href="/lokasyon/izmir/">İzmir</a>
  <a href="/lokasyon/bursa/">Bursa</a>
  <a href="/lokasyon/antalya/">Antalya</a>
  <a href="/lokasyon/gaziantep/">Gaziantep</a>
  <a href="/lokasyon/kocaeli/">Kocaeli</a>
  <a href="/lokasyon/adana/">Adana</a>
  <a href="/lokasyon/kayseri/">Kayseri</a>
  <a href="/lokasyon/konya/">Konya</a>
  <a href="/lokasyon/denizli/">Denizli</a>
  <a href="/lokasyon/mersin/">Mersin</a>
  <a href="/lokasyon/eskisehir/">Eskişehir</a>
  <a href="/lokasyon/samsun/">Samsun</a>
  <a href="/lokasyon/sakarya/">Sakarya</a>
  <a href="/lokasyon/almanya/">Almanya</a>
  <a href="/lokasyon/ingiltere/">İngiltere</a>
  <a href="/lokasyon/azerbaycan/">Azerbaycan</a>
  <a href="/lokasyon/dubai/">Dubai</a>
</nav>
  )}
  {isEnglish && (
<nav class="site-footer__locations" aria-label="Locations" style="display:none;">
  <a href="/en/location/istanbul/">Istanbul</a>
  <a href="/en/location/ankara/">Ankara</a>
  <a href="/en/location/izmir/">Izmir</a>
  <a href="/en/location/bursa/">Bursa</a>
  <a href="/en/location/antalya/">Antalya</a>
  <a href="/en/location/gaziantep/">Gaziantep</a>
  <a href="/en/location/kocaeli/">Kocaeli</a>
  <a href="/en/location/adana/">Adana</a>
  <a href="/en/location/kayseri/">Kayseri</a>
  <a href="/en/location/konya/">Konya</a>
  <a href="/en/location/denizli/">Denizli</a>
  <a href="/en/location/mersin/">Mersin</a>
  <a href="/en/location/eskisehir/">Eskisehir</a>
  <a href="/en/location/samsun/">Samsun</a>
  <a href="/en/location/sakarya/">Sakarya</a>
  <a href="/en/location/germany/">Germany</a>
  <a href="/en/location/uk/">United Kingdom</a>
  <a href="/en/location/azerbaijan/">Azerbaijan</a>
  <a href="/en/location/dubai/">Dubai</a>
</nav>
  )}
</footer>

<style>
  .site-footer--editorial {
    background: #080d17 !important;
    color: #f2f7ff;
    border-top: 1px solid rgba(157, 207, 255, .12);
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .site-footer--editorial::before {
    display: block;
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 55% 200px at 50% 0, rgba(44, 132, 236, .12), transparent 80%),
      radial-gradient(circle at 13% 25%, rgba(30, 110, 220, .07), transparent 30%);
  }
  .qcte-marquee {
    position: relative;
    height: clamp(3.4rem, 5.2vw, 4.8rem);
    display: flex;
    align-items: center;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    border-bottom: 1px solid rgba(157, 207, 255, .12);
    background: rgba(255,255,255,.012);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent);
  }
  .qcte-marquee__track { display: flex; width: max-content; animation: qcte-scroll 40s linear infinite; }
  .qcte-marquee__group {
    display: flex; align-items: center; flex: 0 0 auto;
    gap: clamp(1.8rem, 3vw, 3rem); padding-right: clamp(1.8rem, 3vw, 3rem);
  }
  .qcte-marquee__group span {
    display: block;
    font-size: clamp(1.8rem, 3.8vw, 3.15rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -.04em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(109, 184, 255, .58);
    opacity: .88;
  }
  @keyframes qcte-scroll { to { transform: translateX(-50%); } }
  .qcte-editorial {
    position: relative;
    z-index: 1;
    padding-top: clamp(3.1rem, 5vw, 5rem);
    padding-bottom: 2rem;
  }
  .qcte-editorial__lead {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(300px, .92fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }
  .qcte-brand { min-width: 0; }
  .qcte-logo { display: inline-flex; align-items: center; margin-bottom: 1.2rem; }
  .qcte-logo img { width: 178px; height: auto; max-width: 100%; display: block; }
  .qcte-eyebrow, .qcte-desk__badge, .qcte-col__label, .qcte-contact__type {
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-weight: 750; text-transform: uppercase; letter-spacing: .11em;
  }
  .qcte-eyebrow {
    margin: 0 0 .65rem !important; font-size: .68rem !important;
    line-height: 1.5; color: #6dbeff !important;
  }
  .qcte-brand__title {
    margin: 0 0 .85rem !important;
    max-width: 660px;
    font-size: clamp(1.65rem, 2.65vw, 2.4rem) !important;
    line-height: 1.14; letter-spacing: -.04em;
    font-weight: 780;
    text-transform: none !important;
    color: #fff !important;
  }
  .qcte-brand__text {
    max-width: 540px;
    margin: 0 0 1.25rem !important;
    font-size: clamp(.93rem, 1.1vw, 1rem) !important;
    line-height: 1.68; color: rgba(229,239,252,.70) !important;
  }
  .qcte-status {
    width: fit-content; max-width: 100%;
    display: inline-flex; align-items: center; flex-wrap: wrap; gap: .55rem;
    padding: .55rem .85rem; border: 1px solid rgba(85,170,255,.22);
    border-radius: 999px; background: rgba(31,110,221,.08);
    color: #c6e7ff;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: .67rem; font-weight: 700; line-height: 1.4;
    letter-spacing: .05em;
  }
  .qcte-status__dot {
    width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%;
    background: #38cfff; box-shadow: 0 0 12px rgba(56,207,255,.6);
  }
  .qcte-desk {
    position: relative;
    padding: clamp(1.45rem, 2.6vw, 2.25rem);
    border: 1px solid rgba(134,190,245,.17);
    border-radius: 18px;
    background: linear-gradient(135deg,rgba(255,255,255,.055),rgba(255,255,255,.015));
    box-shadow: 0 24px 58px rgba(0,0,0,.2);
    overflow: hidden;
  }
  .qcte-desk::before {
    content: ""; height: 2px; position: absolute; inset: 0 0 auto;
    background: linear-gradient(90deg, transparent, #2289ef, #40d7ff, transparent);
  }
  .qcte-desk__badge {
    margin: 0 0 .85rem !important; font-size: .67rem !important;
    color: #6dbeff !important;
  }
