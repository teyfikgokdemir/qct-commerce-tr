---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ServicePage from './service/ServicePage.astro';
import { getPageSeo } from '../i18n/seo';
interface Props { lang: string; }
const { lang } = Astro.props;
const seo = getPageSeo('ai-automation');
const d = 'Üreticiler, toptancılar, ihracatçılar, perakende markaları ve büyüyen KOBİ’ler için tekrarlayan işleri azaltan, veri ve müşteri taleplerini düzenleyen, kritik kararları insan kontrolünde bırakan yapay zekâ otomasyonları kuruyoruz.';
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="Yapay zekâ otomasyonları" service={{ name: 'Yapay zekâ otomasyonları', description: d }}>
<Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="YAPAY ZEKÂ OTOMASYONLARI" title="Ekibinizin zamanını tekrarlayan işlerden karar ve büyüme gerektiren işlere taşıyın." lead={d} ctaPrimary="Otomasyon fırsatımızı değerlendirelim" ctaSecondary="Tüm hizmetler"
problem={{eyebrow:'KİMLER İÇİN UYGUN?',title:'Aynı bilgiyi tekrar tekrar işleyen, talepleri elle ayıran veya ekipler arasında sürekli veri aktaran işletmeler için.',intro:['Yapay zekâ otomasyonu her işi makineye bırakmak değildir. En yüksek değer; kuralları açık, sık tekrarlanan, hata ve gecikme üreten adımların kontrollü biçimde düzenlenmesinden gelir. Kritik karar, fiyat, onay ve müşteri ilişkisi gereken noktalarda insan sorumluluğu korunur.'],items:[{title:'Üreticiler ve ihracatçılar',text:'Teklif talepleri, ürün soruları, teknik dokümanlar, bayi veya ihracat başvuruları arasında bilgi ayıran ekipler için.'},{title:'Toptancılar ve e-ticaret işletmeleri',text:'Sipariş, stok, ürün verisi, müşteri soruları, içerik ve kanal güncellemelerinde tekrar eden manuel iş yükü bulunan işletmeler için.'},{title:'Hizmet şirketleri ve büyüyen KOBİ’ler',text:'Form, e-posta, WhatsApp, toplantı notu ve görev aktarımını ortak bir iş akışında düzenlemek isteyen ekipler için.'}]}}
benefits={{eyebrow:'ÇÖZDÜĞÜ İŞ PROBLEMLERİ',title:'Operasyon büyürken manuel işlerin aynı biçimde devam etmesi maliyet, gecikme ve hata üretir.',lead:'Sorun çoğu zaman ekiplerin yetersizliği değil; bilginin dağınık, kuralların belirsiz ve tekrar eden adımların görünmez olmasıdır.',items:[{title:'Bilginin farklı kanallarda kalması',text:'Formlar, e-postalar, WhatsApp mesajları, dosyalar ve tablolar ortak bir kayıt veya görev akışında birleşmez.'},{title:'Tekrarlayan kopyalama ve veri girişi',text:'Ekip aynı müşteri, ürün veya sipariş bilgisini birden fazla sisteme elle taşır.'},{title:'Talep sınıflandırma gecikmesi',text:'Satış, destek, teklif, ihracat ve bayi talepleri doğru sorumluya geç ulaşır.'},{title:'Uzun içerikten eylem çıkarılamaması',text:'Toplantı, görüşme, doküman veya müşteri yazışmaları özetlenmediğinde karar ve görevler kaybolur.'},{title:'Kişiye bağlı süreçler',text:'İş akışı çalışanların hafızasında kaldığında izin, yoğunluk veya ekip değişiminde süreç kesilir.'},{title:'Kontrolsüz yapay zekâ riski',text:'Doğrulama, sınır ve insan onayı olmadan çalışan sistemler yanlış bilgi, gizlilik ve müşteri güveni riski yaratır.'}]}}
included={{eyebrow:'QCT COMMERCE YAKLAŞIMI',title:'Önce süreci sadeleştirir, sonra yalnızca uygun adımları otomatikleştiririz.',lead:'Bir araç satın alıp her yere bağlamak yerine, mevcut iş akışını, veri kaynaklarını, karar noktalarını ve hata maliyetini inceleriz. Küçük bir pilotla başlar, sonuç doğrulanmadan kritik süreci genişletmeyiz.',items:[{title:'Süreç ve darboğaz analizi',text:'Manuel adımlar, tekrarlar, beklemeler, sorumlular ve karar noktaları görünür hale getirilir.'},{title:'Talep sınıflandırma ve yönlendirme',text:'Gelen mesaj veya formlar konu, öncelik, dil, ürün ve müşteri tipine göre düzenlenir.'},{title:'Özetleme ve görev çıkarma',text:'Toplantı, e-posta, görüşme veya dokümandan kontrollü özet, karar ve görev taslakları üretilir.'},{title:'Veri işleme ve kayıt',text:'Açık kurallı veri temizleme, biçimlendirme, eşleştirme ve sistemler arası aktarım adımları planlanır.'},{title:'İnsan onayı ve hata senaryoları',text:'Kritik noktalar onaya bağlanır; belirsiz veya riskli durumlarda otomasyon durur ve ekip devreye girer.'},{title:'İzleme, kayıt ve iyileştirme',text:'Akışın ne yaptığı, nerede hata verdiği ve ne kadar zaman kazandırdığı ölçülebilir hale getirilir.'}]}}
process={{eyebrow:'8 ADIMLI SÜREÇ',title:'Darboğaz analizinden kontrollü devreye almaya.',steps:[{number:'01',title:'Süreç seçimi',text:'En çok zaman alan, sık tekrarlanan ve ticari etkisi yüksek iş akışını belirleriz.'},{number:'02',title:'Mevcut durum haritası',text:'Girdileri, kullanılan araçları, ekip rollerini, kararları, beklemeleri ve hata noktalarını çıkarırız.'},{number:'03',title:'Veri ve risk analizi',text:'Kişisel veri, ticari sır, erişim, doğruluk, yasal yükümlülük ve hata maliyetini değerlendiririz.'},{number:'04',title:'Otomasyon sınırları',text:'Hangi adımın kuralla, hangisinin yapay zekâyla, hangisinin insan onayıyla ilerleyeceğini netleştiririz.'},{number:'05',title:'Pilot tasarım',text:'En küçük anlamlı kapsamı, başarı ölçütünü, hata senaryolarını ve geri dönüş yöntemini planlarız.'},{number:'06',title:'Kurulum ve entegrasyon',text:'Uygun araçları mevcut sistemlere bağlar, veri akışını ve kayıt yapısını geliştiririz.'},{number:'07',title:'Gerçek veriyle test',text:'Kontrollü örneklerle doğruluk, güvenlik, süre kazancı, yanlış yönlendirme ve insan devirlerini test ederiz.'},{number:'08',title:'Devreye alma ve izleme',text:'Ekip kullanımını netleştirir, performansı izler ve yalnızca doğrulanan akışları kademeli biçimde genişletiriz.'}]}}
answers={{title:'Temel yetkinlikler ve işletmeye etkileri',lead:'Doğru otomasyon daha fazla araç değil; daha az tekrar, daha görünür süreç ve daha kontrollü karar akışı üretir.',items:[{question:'Talep sınıflandırma ne sağlar?',answer:'Satış, destek, teklif, bayi veya ihracat taleplerinin konu ve önceliğe göre ayrılmasını; doğru ekibe daha hızlı ulaşmasını sağlar.'},{question:'Özetleme ve görev çıkarma neyi değiştirir?',answer:'Uzun görüşme ve dokümanlardan karar, risk ve sonraki adımların daha hızlı görünmesini sağlar; nihai doğrulama ekipte kalır.'},{question:'Sistem entegrasyonu iş yükünü nasıl azaltır?',answer:'Aynı verinin e-posta, tablo, CRM veya görev aracına tekrar tekrar elle girilmesini azaltabilir.'},{question:'İnsan onayı neden önemlidir?',answer:'Fiyat, sözleşme, müşteri taahhüdü, yüksek riskli karar ve belirsiz durumlarda yanlış işlemi önleyen kontrol katmanı oluşturur.'},{question:'Otomasyonun başarısı nasıl ölçülür?',answer:'Kazanılan süre, azalan manuel adım, yönlendirme doğruluğu, hata oranı, yanıt süresi ve kullanıcı geri bildirimi birlikte değerlendirilir.'}]}}
relatedLinks={[{title:'WhatsApp satış sistemleri',text:'Mesajlardan gelen talepleri bağlamlı sınıflandırma ve ekip yönlendirmesiyle düzenleyin.',href:'/whatsapp-satis/'},{title:'E-ticaret çözümleri',text:'Ürün, sipariş, stok ve müşteri süreçlerinde otomasyona uygun adımları belirleyin.',href:'/e-ticaret/'},{title:'B2B web tasarım',text:'Formları, veri girişlerini ve müşteri yolculuğunu otomasyona uygun bir dijital temel üzerinde kurun.',href:'/web-tasarim/'},{title:'İletişim',text:'En çok zaman alan manuel süreci ve kullanılan araçları paylaşın.',href:'/iletisim/'}]}
faq={{eyebrow:'SIK SORULANLAR',title:'Yapay zekâ otomasyonları hakkında',items:[{q:'Her iş süreci otomasyona uygun mu?',a:'Hayır. Kuralları belirsiz, verisi yetersiz, hata maliyeti yüksek veya uzman değerlendirmesi gerektiren süreçlerde otomasyon sınırlı tutulmalıdır.'},{q:'Yapay zekâ kendi başına karar verir mi?',a:'Kritik iş kararlarında insan onayı, güvenlik sınırları ve durdurma mekanizmaları korunur. Amaç sorumluluğu makineye bırakmak değildir.'},{q:'Hangi süreçlerle başlanması daha doğru olur?',a:'Sık tekrarlanan, girdisi ve çıktısı açık, düşük riskli ve zaman maliyeti ölçülebilen süreçler pilot için daha uygundur.'},{q:'Mevcut araçlarımızla çalışabilir mi?',a:'Entegrasyon; mevcut araçların API, güvenlik, erişim ve veri koşullarına göre değerlendirilir. Her sistemin bağlanması mümkün veya mantıklı olmayabilir.'},{q:'CRM bağlantıları otomasyon kapsamına alınabilir mi?',a:'CRM’in teknik olanakları uygunsa form, e-posta veya mesajlardan gelen verilerin kontrollü biçimde kaydı ve yönlendirilmesi planlanabilir.'},{q:'WhatsApp mesajları otomatik işlenebilir mi?',a:'Kullanılan hesap, entegrasyon ve izin koşulları uygunsa sınıflandırma, özetleme ve ekip yönlendirmesi değerlendirilebilir; müşteri taahhütleri ekip kontrolünde kalır.'},{q:'Otomasyon çalışanların yerini alır mı?',a:'Hedef, tekrarlayan iş yükünü azaltıp ekibin karar, ilişki ve uzmanlık gerektiren işlere zaman ayırmasını sağlamaktır. Organizasyon kararları işletmeye aittir.'},{q:'Verilerimiz güvende olur mu?',a:'Veri minimizasyonu, erişim yetkisi, üçüncü taraf sağlayıcılar, saklama süresi ve hassas veri kullanımı proje öncesinde değerlendirilir; sıfır risk vaadi verilemez.'},{q:'KVKK açısından nelere dikkat edilir?',a:'İşlenen verinin amacı, hukuki dayanağı, bilgilendirme, erişim, saklama ve üçüncü taraf aktarımı işletmenin hukuk danışmanlığıyla birlikte değerlendirilmelidir.'},{q:'Kurulum ne kadar sürer?',a:'Süre sürecin karmaşıklığına, sistem sayısına, veri kalitesine ve test ihtiyacına bağlıdır. Küçük pilotlar daha hızlı doğrulanabilir.'},{q:'Başarı garantisi veriyor musunuz?',a:'Belirli bir sonuç garantisi verilemez. Pilot için ölçülebilir başarı kriterleri tanımlanır ve gerçek kullanım verisiyle değerlendirme yapılır.'},{q:'Hata olduğunda ne olur?',a:'Akışın durması, insan onayına geçmesi, kayıt oluşturması veya önceki adıma dönmesi gibi hata senaryoları süreç riskine göre tasarlanır.'},{q:'Otomasyon sonradan geliştirilebilir mi?',a:'Evet. Pilot doğrulandıktan sonra yeni veri kaynakları, ekipler veya adımlar kademeli biçimde eklenebilir; kontrolsüz genişleme yapılmaz.'}]}}
final={{title:'En çok zaman alan tekrarlayan süreci kontrollü, ölçülebilir ve insan denetimli bir otomasyon akışına dönüştürün.',text:'Mevcut süreci, kullanılan araçları ve en sık yaşanan gecikmeyi paylaşın; otomasyona gerçekten uygun başlangıç noktasını birlikte belirleyelim.',cta:'Otomasyon fırsatımızı inceleyelim',ctaSecondary:'E-posta gönderin'}}/><Footer slot="footer" lang={lang}/></BaseLayout>
