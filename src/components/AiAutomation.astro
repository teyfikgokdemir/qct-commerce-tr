---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import ServicePage from './service/ServicePage.astro'; import {getPageSeo} from '../i18n/seo'; interface Props{lang:string} const{lang}=Astro.props; const seo=getPageSeo('ai-automation'); const d='Tekrarlayan işleri azaltan, veri ve müşteri taleplerini düzenleyen, kritik kararları ekip kontrolünde bırakan yapay zekâ otomasyonları kuruyoruz.';
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="Yapay zekâ otomasyonları" service={{name:'Yapay zekâ otomasyonları',description:d}}><Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="Yapay zekâ otomasyonları" title="Ekibinizin zamanını tekrarlayan işlerden değer üreten işlere taşıyın." lead={d} ctaPrimary="Sürecinizi konuşalım" ctaSecondary="Tüm hizmetler"
problem={{eyebrow:'SORUN',title:'Dağınık veri ve manuel aktarım büyüdükçe operasyon yavaşlar.',intro:['Talep toplama, sınıflandırma, veri girişi ve ekip devri gibi işler tekrarlandığında hata riski ve yanıt süresi artar.'],items:[{title:'Bilgi farklı yerlerde kalır',text:'Formlar, e-postalar ve mesajlar ortak bir akışta birleşmez.'},{title:'Ekip aynı işi tekrarlar',text:'Kopyalama, özetleme ve yönlendirme zaman kaybettirir.'},{title:'Kontrolsüz otomasyon risk yaratır',text:'Kritik kararların bağlamsız biçimde otomatikleştirilmesi güveni zedeler.'}]}}
benefits={{eyebrow:'YAKLAŞIM',title:'Önce süreç, sonra otomasyon.',lead:'Her işi otomatikleştirmek yerine, tekrarlanan ve kuralları açık adımları seçeriz.',items:[{title:'İnsan kontrollü yapı',text:'Onay ve önemli karar noktaları ekipte kalır.'},{title:'Düzenli veri akışı',text:'Bilgi doğru biçimde toplanır, sınıflandırılır ve aktarılır.'},{title:'İzlenebilir süreç',text:'Otomasyonun ne yaptığı ve nerede durduğu açık olur.'}]}}
included={{eyebrow:'KAPSAM',title:'Otomasyon çalışma alanları',lead:'Yalnızca işletmenizin gerçek sürecine uyan parçalar uygulanır.',items:[{title:'Talep sınıflandırma',text:'Gelen talepleri konu ve önceliğe göre ayırma.'},{title:'Ekip yönlendirme',text:'Doğru kişiye veya sisteme devir.'},{title:'Veri işleme',text:'Tekrarlayan veri düzenleme adımları.'},{title:'Özetleme',text:'Uzun içerik ve görüşmelerden eylem çıkarma.'},{title:'Bildirim',text:'Kritik durumlarda ekip uyarıları.'},{title:'Kayıt ve izleme',text:'Akışların görünür tutulması.'}]}}
process={{eyebrow:'SÜREÇ',title:'Kontrollü ve aşamalı kurulum.',steps:[{number:'01',title:'Süreç haritası',text:'Manuel adımları ve karar noktalarını çıkarırız.'},{number:'02',title:'Risk ve değer analizi',text:'Otomasyona uygun adımları seçeriz.'},{number:'03',title:'Pilot kurulum',text:'Küçük kapsamda geliştirip gerçek veriyle test ederiz.'},{number:'04',title:'Devreye alma',text:'İzleme ve hata senaryolarıyla kontrollü kullanıma açarız.'}]}}
faq={{eyebrow:'SIK SORULANLAR',title:'Yapay zekâ otomasyonu hakkında',items:[{q:'Her süreç otomasyona uygun mu?',a:'Hayır. Karar kuralları belirsiz, riskli veya insan değerlendirmesi gerektiren süreçlerde otomasyon sınırlı tutulmalıdır.'},{q:'Mevcut araçlarımızla çalışabilir mi?',a:'Entegrasyon olanağı mevcut sistemlerin API ve güvenlik koşullarına göre değerlendirilir.'},{q:'Yapay zekâ kendi başına karar verir mi?',a:'Kritik iş kararlarında insan kontrolünü koruyan onay ve sınır mekanizmaları tasarlarız.'}]}}
final={{title:'Tekrarlayan işlerinizi kontrollü bir otomasyon akışına dönüştürün.',text:'En çok zaman alan süreci birlikte değerlendirelim.',cta:'İletişime geçin',ctaSecondary:'E-posta gönderin'}}/><Footer slot="footer" lang={lang}/></BaseLayout>
