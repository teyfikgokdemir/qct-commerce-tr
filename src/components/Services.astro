---
interface Props {
  lang: string;
}

const services = [
	{
		href: '/web-tasarim/', kicker: 'Web tasarım', title: 'Güven veren web siteleri', text: 'Teklifinizi açık anlatan, hızlı ve dönüşüm odaklı kurumsal deneyimler.',
	},
	{
		href: '/e-ticaret/', kicker: 'E-ticaret altyapısı', title: 'Satın almayı kolaylaştıran mağazalar', text: 'Ürün keşfi, mobil alışveriş, ödeme ve yönetim süreçleri birlikte planlanır.',
	},
	{
		href: '/whatsapp-satis/', kicker: 'WhatsApp satış sistemleri', title: 'Mesajdan satışa düzenli akış', text: 'Reklam, ürün ve müşteri sorularını takip edilebilir WhatsApp görüşmelerine bağlayın.',
	},
	{
		href: '/seo-geo/', kicker: 'SEO, GEO, AEO ve AIO', title: 'Arama ve yanıt sistemlerinde görünürlük', text: 'Google ve yapay zekâ destekli keşif kanalları için teknik ve anlamsal altyapı.',
	},
	{
		href: '/meta-reklamlari/', kicker: 'Meta reklamları', title: 'Dönüşüm odaklı kampanya sayfaları', text: 'Reklam vaadiyle eşleşen, dikkati dağıtmadan müşteriyi sonraki adıma taşıyan sayfalar.',
	},
	{
		href: '/yapay-zeka-otomasyonlari/', kicker: 'Yapay zekâ otomasyonları', title: 'Tekrarlayan işi azaltan akışlar', text: 'Talep yönlendirme, veri işleme ve ekip devri gibi süreçlerde kontrollü otomasyon.',
	},
];
---
<section id="services" class="qct-section qct-services" aria-labelledby="qct-services-title">
	<div class="container">
		<div class="qct-section__header qct-section__header--split">
			<div>
				<p class="qct-section__eyebrow">HİZMETLER</p>
				<h2 id="qct-services-title" class="qct-section__title">
					E-ticaret ve dijital büyüme için birbirini tamamlayan çözümler.
				</h2>
			</div>
			<p class="qct-section__lead">
				Her hizmet, müşteri yolculuğundaki belirli bir sorunu çözer; birlikte çalıştığında daha güçlü bir satış sistemi oluşturur.
			</p>
		</div>

		<div class="qct-services__grid">
			{services.map((service, index) => (
				<a class="qct-service-card" href={service.href} data-qct-reveal>
					<span class="qct-service-card__content">
						<span class="qct-service-card__top">
							<span class="qct-service-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<span class="qct-service-card__kicker">{service.kicker}</span>
						</span>

						<span class="qct-service-card__body">
							<span class="qct-service-card__title">{service.title}</span>
							<span class="qct-service-card__text">{service.text}</span>
						</span>
					</span>

					<span class="qct-service-card__cta">İnceleyin</span>
				</a>
			))}
		</div>
	</div>
</section>
