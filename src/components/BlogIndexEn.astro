---
import BaseLayout from '../layouts/BaseLayout.astro';import Header from './Header.astro';import Footer from './Footer.astro';import {articlesEn} from '../data/blog-en';
---
<BaseLayout title="E-commerce, Web & AI Visibility Guides | QCT Commerce" description="English guides for businesses in Türkiye covering websites, e-commerce, Shopify, ikas, SEO, GEO, AEO, AI search, mobile conversion and WhatsApp sales." lang="en" pageType="CollectionPage" breadcrumbLabel="Blog"><Header slot="header" lang="en"/><section class="qct-blog-hero"><div class="container"><nav class="qct-breadcrumb"><a href="/en/">Home</a><span>/</span><span>Blog</span></nav><p class="qct-section__eyebrow">KNOWLEDGE CENTRE</p><h1>E-commerce and digital growth guides for Türkiye</h1><p>Practical English-language guidance for founders, teams and international residents operating in Türkiye, with the same topic coverage as our Turkish content.</p></div></section><section class="qct-blog-list"><div class="container"><div class="qct-blog-list__grid">{articlesEn.map(a=><article><h2><a href={`/en/blog/${a.slug}/`}>{a.title}</a></h2><p>{a.description}</p><a href={`/en/blog/${a.slug}/`}>Read guide →</a></article>)}</div></div></section><Footer slot="footer" lang="en"/></BaseLayout>
<style>.qct-blog-hero{padding:calc(var(--qct-hero-clearance) + 40px) 0 56px;border-bottom:1px solid var(--qct-color-line)}.qct-blog-hero h1{font-size:clamp(2.7rem,5vw,4.7rem);max-width:18ch}.qct-blog-hero p{max-width:780px;line-height:1.7}.qct-blog-list{padding:48px 0 90px}.qct-blog-list article{padding:30px 0;border-bottom:1px solid var(--qct-color-line)}.qct-blog-list h2{font-size:clamp(1.5rem,3vw,2.3rem);max-width:30ch}.qct-blog-list p{max-width:760px;color:var(--qct-color-muted);line-height:1.7}.qct-blog-list a{color:var(--qct-color-accent-strong);font-weight:700}</style>