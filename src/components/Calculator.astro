---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

const { kind } = Astro.props as { kind: 'marketplace' | 'website' | 'ecommerce' };

const copy = kind === 'marketplace'
  ? {
      title: 'Pazaryeri Komisyon Hesaplayıcı',
      description: 'Pazaryeri satışınızda komisyon, kargo, reklam, operasyon ve kendi e-ticaret sitenizle yıllık maliyet farkını adil verilerle hesaplayın.',
      label: 'Kanal maliyetini ve net kârlılığı şeffaf verilerinizle görün.'
    }
  : kind === 'website'
    ? {
        title: 'Web Sitesi Fiyat Hesaplayıcı',
        description: 'Site kapsamına göre kesin fiyat yerine anlamlı bir tahmini proje yatırım aralığı ve doğru hizmet yönlendirmesi alın.',
        label: 'Kapsamı seçin, tahmini yatırım aralığını görün.'
      }
    : {
        title: 'E-Ticaret Maliyet Hesaplayıcı',
        description: 'Pazaryeri, hazır altyapı, WooCommerce ve özel e-ticareti ilk kurulum, aylık altyapı, reklam ve komisyon giderleriyle şeffafça karşılaştırın.',
        label: 'Tüm satış modellerini aynı varsayımlarla kıyaslayın.'
      };

const breadcrumbs = [
  { name: 'Ana sayfa', url: '/' },
  { name: 'Araçlar', url: '/tr/araclar/' },
  {
    name: copy.title,
    url: `/tr/araclar/${kind === 'marketplace' ? 'pazaryeri-komisyon-hesaplama' : kind === 'website' ? 'web-sitesi-fiyat-hesaplama' : 'e-ticaret-maliyet-hesaplama'}/`
  }
];

const webOptions = [
  { label: 'Çok dil altyapısı', desc: 'İngilizce / ek diller, URL yapısı ve hreflang' },
  { label: 'İleri düzey e-ticaret / B2B', desc: 'Özel fiyatlandırma, bayi portalı veya ERP' },
  { label: 'Özel ödeme & POS entegrasyonu', desc: 'Banka sanal POS veya özel gateway' },
  { label: 'Rezervasyon & randevu sistemi', desc: 'Takvim, zaman aralığı ve bildirimler' },
  { label: 'CRM & veri entegrasyonu', desc: 'HubSpot, Zoho veya özel müşteri akışı' },
  { label: 'WhatsApp satış akışları', desc: 'Doğrudan sipariş ve bağlamlı mesajlaşma' },
  { label: 'Özel UI/UX tasarım sprinti', desc: 'Sıfırdan Figma tasarım ve özel mikroyapı' },
  { label: 'SEO Care (Teknik SEO)', desc: 'Arama motoru indeks ve metadata optimizasyonu' },
  { label: 'GEO, AEO & AI görünürlüğü', desc: 'ChatGPT, Perplexity ve Google AI uyumu' },
  { label: 'Blog & içerik altyapısı', desc: 'Dinamik makale ve rehber içerik sistemi' }
];
---

<BaseLayout title={`${copy.title} | QCT Commerce`} description={copy.description} lang="tr" breadcrumbs={breadcrumbs}>
  <Header slot="header" lang="tr" />

  <main class="calc">
    <header class="calc__hero container">
      <span class="calc__hero-tag">ÜCRETSİZ HESAPLAMA ARACI</span>
      <h1>{copy.title}</h1>
      <p class="calc__hero-desc">{copy.label}</p>
    </header>

    <section class="container calc__shell" data-calculator={kind}>
      {kind === 'marketplace' && (
        <>
          <div class="calc__form">
            <h2>Pazaryeri Satış Verileri</h2>
            <label>
              <span>Ürün satış fiyatı (TL · KDV Dahil)</span>
              <input name="price" type="number" value="1000" min="0" step="1" />
            </label>
            <label>
              <span>Ürün maliyeti (TL · KDV Hariç)</span>
              <input name="cost" type="number" value="400" min="0" step="1" />
            </label>
            <label>
              <span>KDV oranı (%)</span>
              <input name="vat" type="number" value="20" min="0" max="100" />
            </label>
            <label>
              <span>Pazaryeri komisyon oranı (%)</span>
              <input name="commission" type="number" value="18" min="0" step="0.5" />
            </label>
            <label>
              <span>Pazaryeri kargo kesintisi (TL)</span>
              <input name="shipping" type="number" value="65" min="0" step="1" />
            </label>
            <label>
              <span>Pazaryeri reklamı / sipariş (TL)</span>
              <input name="ads" type="number" value="45" min="0" step="1" />
            </label>
            <label>
              <span>Paketleme & operasyon / sipariş (TL)</span>
              <input name="operations" type="number" value="25" min="0" step="1" />
            </label>
            <label>
              <span>Aylık satış hacmi (adet)</span>
              <input name="volume" type="number" value="200" min="1" step="1" />
            </label>

            <hr />

            <h2>Kendi E-Ticaret Siteniz</h2>
            <label>
              <span>Ödeme altyapısı komisyonu (%)</span>
              <input name="payment" type="number" value="3.5" min="0" step="0.1" />
              <small class="calc__hint">PayTR, iyzico, Stripe vb. ortalama işlem komisyonu.</small>
            </label>
            <label>
              <span>Kendi sitenizde kargo gideri / sipariş (TL)</span>
              <input name="ownShipping" type="number" value="65" min="0" step="1" />
              <small class="calc__hint">Mağaza karşılıyorsa yazın; alıcıya yansıtıyorsanız 0 girin.</small>
            </label>
            <label>
              <span>Aylık site & altyapı gideri (TL)</span>
              <input name="site" type="number" value="3000" min="0" step="100" />
              <small class="calc__hint">Shopify / ikas aboneliği, hosting, alan adı ve eklentiler.</small>
            </label>
            <label>
              <span>Tahmini reklam maliyeti / sipariş (TL)</span>
              <input name="ownAds" type="number" value="55" min="0" step="1" />
              <small class="calc__hint">Meta Ads, Google Ads vb. edinme maliyeti payı.</small>
            </label>
          </div>

          <div class="calc__results">
            <span class="calc__results-badge">CANLI KARŞILAŞTIRMA</span>
            <h2>Sipariş Başına ve Yıllık Net Tablo</h2>
            <div class="calc__cards">
              <article class="calc__card">
                <div class="calc__card-header">
                  <span>PAZARYERİ KANALI</span>
                  <small>Trendyol / Hepsiburada / Amazon</small>
                </div>
                <dl>
                  <div><dt>Komisyon kesintisi</dt><dd data-out="commission">—</dd></div>
                  <div><dt>Kargo, reklam & operasyon</dt><dd data-out="marketLogistics">—</dd></div>
                  <div><dt>Toplam kanal kesintisi</dt><dd data-out="deduction" class="text-danger">—</dd></div>
                  <div><dt>Net kâr / sipariş</dt><dd data-out="marketProfit" class="text-bold">—</dd></div>
                  <div><dt>Net kâr marjı</dt><dd data-out="marketMargin">—</dd></div>
                  <div class="calc__dl-highlight"><dt>Yıllık toplam kanal gideri</dt><dd data-out="marketAnnual">—</dd></div>
                </dl>
              </article>

              <article class="calc__card calc__card--accent">
                <div class="calc__card-header">
                  <span>KENDİ E-TİCARET SİTENİZ</span>
                  <small>Bağımsız Doğrudan Satış</small>
                </div>
                <dl>
                  <div><dt>Ödeme komisyonu</dt><dd data-out="ownPayment">—</dd></div>
                  <div><dt>Kargo, reklam & operasyon</dt><dd data-out="ownLogistics">—</dd></div>
                  <div><dt>Site altyapı payı / ürün</dt><dd data-out="ownSitePerOrder">—</dd></div>
                  <div><dt>Toplam kesinti / sipariş</dt><dd data-out="ownCost" class="text-primary">—</dd></div>
                  <div><dt>Net kâr / sipariş</dt><dd data-out="ownProfit" class="text-success text-bold">—</dd></div>
                  <div><dt>Net kâr marjı</dt><dd data-out="ownMargin">—</dd></div>
                  <div class="calc__dl-highlight"><dt>Yıllık toplam kanal gideri</dt><dd data-out="ownAnnual">—</dd></div>
                </dl>
                <div class="calc__saving-box">
                  <small>Kendi sitenizle yıllık tahmini tasarruf:</small>
                  <strong data-out="saving">—</strong>
                </div>
              </article>
            </div>

            <p class="calc__note">
              ✓ <strong>Şeffaf Kapsam Notu:</strong> Hesaplamada KDV matrahı tüketici nihai fiyatından yasal formülle düşülür. Kargo maliyeti her iki tarafta eşit karşılaştırılmıştır. İade oranları, kategoriye özel stopaj ve dönemsel kampanyalar nihai sözleşmede değerlendirilir.
            </p>

            <aside class="calc__aside">
              <div>
                <h3>Pazaryeri komisyonlarına bağımlı kalmayın.</h3>
                <p>Kendi müşteri kitlenizi oluşturup marka değerinizi büyütmek için uygulanabilir geçiş planını birlikte hazırlayalım.</p>
              </div>
              <a href="/iletisim/" class="calc__cta">E-Ticaret Projesi Planlayın →</a>
            </aside>
          </div>
        </>
      )}

      {kind === 'website' && (
        <>
          <div class="calc__form">
            <h2>Proje Kapsamını Seçin</h2>
            <label>
              <span>Site tipi</span>
              <select name="siteType">
                <option value="base">Kurumsal Web Sitesi (Temel Altyapı)</option>
                <option value="commerce">E-Ticaret Sitesi (Shopify / ikas / Woo)</option>
                <option value="custom">Özel Platform & B2B Portalı</option>
              </select>
            </label>
            <label>
              <span>Tahmini sayfa sayısı</span>
              <input name="pages" type="number" value="6" min="1" max="100" />
              <small class="calc__hint">Başlangıç paketinde 5 sayfa dahildir; üzeri sayfa başı +700 TL olarak hesaplanır.</small>
            </label>
            <label>
              <span>Ürün sayısı (e-ticaret için)</span>
              <input name="products" type="number" value="0" min="0" max="1000" />
              <small class="calc__hint">Başlangıç paketinde 10 ürün girişi dahildir; üzeri ürün başı +100 TL standart giriştir.</small>
            </label>

            <hr />

            <h2>Gereksinimler & Ek Modüller</h2>
            <div class="calc__checks">
              {webOptions.map((opt, i) => (
                <label class="check">
                  <input name={`opt${i}`} type="checkbox" />
                  <span class="check__text">
                    <strong>{opt.label}</strong>
                    <small>{opt.desc}</small>
                  </span>
                </label>
              ))}
            </div>
          </div>

          <div class="calc__results">
            <span class="calc__results-badge">PROJE YATIRIM TAHMİNİ</span>
            <h2>Tahmini Proje Bütçe Aralığınız</h2>
            <div class="calc__range-box">
              <strong class="calc__range" data-out="range">—</strong>
              <small>Standart kapsam ve seçilen modüller dahil yaklaşık yatırım aralığıdır.</small>
            </div>
            <p class="calc__message" data-out="websiteMessage">Seçimleriniz başlangıç kapsamını gösterir.</p>

            <div class="calc__scope-notice">
              <h4>Kapsam Standartlarımız</h4>
              <ul>
                <li>Tüm projelerde responsive mobil uyum, kurumsal renk kodlaması ve SSL güvenlik altyapısı dahildir.</li>
                <li>Teklif aşamasında sayfa içerikleri, API entegrasyonları ve teslim tarihleri sözleşmeli olarak netleştirilir.</li>
              </ul>
            </div>

            <aside class="calc__aside">
              <div>
                <h3>Projenizi net bir kapsam ve süreyle başlatalım.</h3>
                <p>İhtiyaçlarınızı paylaşın; 24 saat içinde işe özel şeffaf teslimat planı ve sabit teklif sunalım.</p>
              </div>
              <a href="/iletisim/" class="calc__cta">Web Projesi Başlatın →</a>
            </aside>
          </div>
        </>
      )}

      {kind === 'ecommerce' && (
        <>
          <div class="calc__form">
            <h2>İş Modeli Varsayımları</h2>
            <label>
              <span>Aylık satış hacmi (adet)</span>
              <input name="volume" type="number" value="200" min="1" />
            </label>
            <label>
              <span>Ortalama sepet tutarı (TL)</span>
              <input name="basket" type="number" value="1000" min="10" />
            </label>
            <label>
              <span>İlk kurulum ve tasarım bütçesi (TL)</span>
              <input name="setup" type="number" value="60000" min="5000" />
              <small class="calc__hint">Altyapıya göre orantısal ilk yatırım bütçesi.</small>
            </label>
            <label>
              <span>Aylık reklam bütçesi (TL)</span>
              <input name="ads" type="number" value="15000" min="0" />
              <small class="calc__hint">Tüm kanallarda ortak pazarlama ve müşteri edinme bütçesi.</small>
            </label>
            <label>
              <span>Pazaryeri komisyon oranı (%)</span>
              <input name="commission" type="number" value="18" min="0" max="50" step="0.5" />
            </label>
          </div>

          <div class="calc__results">
            <span class="calc__results-badge">12 AYLIK MALİYET ANALİZİ</span>
            <h2>4 Satış Modelinin Yıllık Toplam Kıyası</h2>

            <div class="calc__table-wrapper">
              <table class="calc__table">
                <thead>
                  <tr>
                    <th>Model</th>
                    <th>İlk Kurulum</th>
                    <th>Aylık Altyapı</th>
                    <th>Aylık Reklam</th>
                    <th>İşlem / Komisyon</th>
                    <th>12 Aylık Toplam</th>
                  </tr>
                </thead>
                <tbody>
                  {[
                    { name: 'Pazaryeri', note: 'Komisyon bazlı, sıfır başlangıç' },
                    { name: 'Hazır Altyapı (ikas/Shopify)', note: 'Hızlı kurulum, düşük bakım' },
                    { name: 'WooCommerce / Açık Kaynak', note: 'Esnek, sunucu ve eklenti bakımı' },
                    { name: 'Özel E-Ticaret / Headless', note: 'Tam bağımsız kurumsal mimari' }
                  ].map((row, i) => (
                    <tr>
                      <td class="calc__table-name">
                        <strong>{row.name}</strong>
                        <small>{row.note}</small>
                      </td>
                      <td><span data-out={`set${i}`}>—</span></td>
                      <td><span data-out={`infra${i}`}>—</span></td>
                      <td><span data-out={`ads${i}`}>—</span></td>
                      <td><span data-out={`fee${i}`}>—</span></td>
                      <td class="calc__table-total"><strong data-out={`total${i}`}>—</strong></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <!-- Mobile Card Layout for E-Commerce Models -->
            <div class="calc__mobile-cards">
              {[
                { name: 'Pazaryeri', tag: 'Sıfır Kurulum, Yüksek Komisyon' },
                { name: 'Hazır Altyapı (Shopify / ikas)', tag: 'Düşük Bakım, En Çok Tercih Edilen' },
                { name: 'WooCommerce', tag: 'Açık Kaynak, Eklenti Yönetimi' },
                { name: 'Özel E-Ticaret', tag: 'Kurumsal Ölçek' }
              ].map((row, i) => (
                <div class="calc__m-card">
                  <div class="calc__m-card-header">
                    <strong>{row.name}</strong>
                    <small>{row.tag}</small>
                  </div>
                  <div class="calc__m-grid">
                    <div><small>İlk Kurulum</small><span data-out={`m_set${i}`}>—</span></div>
                    <div><small>Aylık Altyapı</small><span data-out={`m_infra${i}`}>—</span></div>
                    <div><small>Aylık Reklam</small><span data-out={`m_ads${i}`}>—</span></div>
                    <div><small>İşlem/Komisyon</small><span data-out={`m_fee${i}`}>—</span></div>
                  </div>
                  <div class="calc__m-total">
                    <span>12 Aylık Toplam:</span>
                    <strong data-out={`m_total${i}`}>—</strong>
                  </div>
                </div>
              ))}
            </div>

            <p class="calc__note">
              ✓ <strong>Matematik Tutarlılığı:</strong> Tablodaki yıllık toplam formülü: <em>İlk Kurulum + 12 × (Aylık Altyapı + Aylık Reklam + İşlem/Komisyon)</em> şeklinde her sütunun açık toplamından oluşur. Hiçbir gizli gider veya tutarsızlık barındırmaz.
            </p>

            <aside class="calc__aside">
              <div>
                <h3>Doğru e-ticaret altyapısını birlikte seçelim.</h3>
                <p>Ürün sayınız, operasyon hacminiz ve bütçenize göre en verimli altyapıyı netleştirelim.</p>
              </div>
              <a href="/iletisim/" class="calc__cta">E-Ticaret Danışmanlığı Alın →</a>
            </aside>
          </div>
        </>
      )}
    </section>

    <nav class="container calc__nav" aria-label="Hesaplama sonuçlarını yorumlayın">
      <a href={kind === 'website' ? '/rehberler/2026-web-sitesi-fiyatlari/' : kind === 'marketplace' ? '/rehberler/pazaryeri-komisyonlari-gercekten-ne-kadara-mal-oluyor/' : '/rehberler/kendi-e-ticaret-sitesi-pazaryeri-maliyet-karsilastirmasi/'}>
        Sonucun kapsamını rehberde inceleyin →
      </a>
      <a href={kind === 'website' ? '/web-tasarim/' : '/e-ticaret/'}>
        İlgili QCT Commerce hizmetini keşfedin →
      </a>
    </nav>
  </main>

  <Footer slot="footer" lang="tr" />
</BaseLayout>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-calculator]');
    if (!root) return;
    const type = root.dataset.calculator;

    const n = (name) => {
      const el = root.querySelector(`[name="${name}"]`);
      const val = Number(el?.value);
      return Number.isFinite(val) ? Math.max(0, Math.min(val, 1e12)) : 0;
    };

    const money = (v) => new Intl.NumberFormat('tr-TR', {
      style: 'currency',
      currency: 'TRY',
      maximumFractionDigits: 0
    }).format(Number.isFinite(v) ? Math.round(v) : 0);

    const put = (key, value) => {
      const els = root.querySelectorAll(`[data-out="${key}"]`);
      els.forEach((e) => { e.textContent = value; });
    };

    const update = () => {
      if (type === 'marketplace') {
        const price = n('price');
        const cost = n('cost');
        const vatRate = n('vat') / 100;
        const comRate = n('commission') / 100;
        const ship = n('shipping');
        const ads = n('ads');
        const ops = n('operations');
        const vol = n('volume');

        const payRate = n('payment') / 100;
        const ownShip = n('ownShipping');
        const site = n('site');
        const ownAds = n('ownAds');

        // Yasal KDV matrah hesabı (KDV Dahil fiyattan)
        const netRevenue = vatRate > 0 ? price / (1 + vatRate) : price;
        const vatAmount = price - netRevenue;

        // Pazaryeri kesintileri
        const com = price * comRate;
        const marketLogistics = ship + ads + ops;
        const deduction = com + marketLogistics;
        const marketProfit = netRevenue - cost - deduction;
        const marketMargin = price > 0 ? (marketProfit / price) * 100 : 0;
        const marketAnnual = deduction * vol * 12;

        // Kendi siteniz kesintileri
        const ownPayment = price * payRate;
        const ownLogistics = ownShip + ownAds + ops;
        const ownSitePerOrder = vol > 0 ? site / vol : 0;
        const ownCost = ownPayment + ownLogistics + ownSitePerOrder;
        const ownProfit = netRevenue - cost - ownCost;
        const ownMargin = price > 0 ? (ownProfit / price) * 100 : 0;
        const ownAnnual = (ownPayment + ownShip + ownAds + ops) * vol * 12 + site * 12;

        const saving = marketAnnual - ownAnnual;

        put('commission', money(com));
        put('marketLogistics', money(marketLogistics));
        put('deduction', money(deduction));
        put('marketProfit', money(marketProfit));
        put('marketMargin', `%${marketMargin.toFixed(1)}`);
        put('marketAnnual', money(marketAnnual));

        put('ownPayment', money(ownPayment));
        put('ownLogistics', money(ownLogistics));
        put('ownSitePerOrder', money(ownSitePerOrder));
        put('ownCost', money(ownCost));
        put('ownProfit', money(ownProfit));
        put('ownMargin', `%${ownMargin.toFixed(1)}`);
        put('ownAnnual', money(ownAnnual));
        put('saving', money(saving));
      } else if (type === 'website') {
        const siteType = root.querySelector('[name="siteType"]')?.value || 'base';
        const base = { base: 8900, commerce: 9900, custom: 25000 }[siteType] || 8900;
        let total = base;

        // Ek sayfa ve ürün maliyetleri
        const pages = n('pages');
        const products = n('products');
        total += Math.max(0, pages - 5) * 700;
        total += Math.max(0, products - 10) * 100;

        // Ek modül maliyetleri
        const optionCosts = [6000, 5000, 2500, 2500, 3500, 1000, 5000, 3900, 3900, 2500];
        root.querySelectorAll('.check input:checked').forEach((input) => {
          const idx = Number(input.name.replace('opt', ''));
          total += optionCosts[idx] || 0;
        });

        const minRange = Math.max(base, Math.round(total * 0.95));
        const maxRange = Math.round(total * 1.10);
        put('range', `${money(minRange)} – ${money(maxRange)}`);

        const msg = total >= 35000
          ? 'Seçimleriniz kurumsal B2B veya özel entegrasyonlar içeriyor; kesin teslim takvimi ve aşamalar keşif toplantısında netleştirilir.'
          : total >= 20000
            ? 'Seçimleriniz standart yapının ötesinde ek modüller içeriyor; detaylı teklif sayfa ve entegrasyon şemasıyla hazırlanır.'
            : 'Seçimleriniz standart başlangıç paketlerimizi yansıtır; net teklif içerik ve teslimat ayrıntılarıyla hazırlanır.';
        put('websiteMessage', msg);
      } else if (type === 'ecommerce') {
        const vol = n('volume');
        const basket = n('basket');
        const setup = n('setup');
        const ads = n('ads');
        const comRate = n('commission') / 100;

        // 4 Model: [Kurulum çarpanı, Aylık Altyapı, Komisyon Oranı]
        const models = [
          [0, 0, comRate],
          [setup * 0.45, 4500, 0.035],
          [setup * 0.75, 6500, 0.030],
          [setup, 11000, 0.025]
        ];

        models.forEach(([s, m, f], i) => {
          const fee = basket * vol * f;
          const total = s + (m + ads + fee) * 12;

          put(`set${i}`, money(s));
          put(`infra${i}`, money(m));
          put(`ads${i}`, money(ads));
          put(`fee${i}`, money(fee));
          put(`total${i}`, money(total));

          // Mobile mirrors
          put(`m_set${i}`, money(s));
          put(`m_infra${i}`, money(m));
          put(`m_ads${i}`, money(ads));
          put(`m_fee${i}`, money(fee));
          put(`m_total${i}`, money(total));
        });
      }
    };

    root.addEventListener('input', update);
    root.addEventListener('change', update);
    update();
  })();
</script>

