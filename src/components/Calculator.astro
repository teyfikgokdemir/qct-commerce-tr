---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro';
const { kind } = Astro.props as { kind: 'marketplace'|'website'|'ecommerce' };
const copy = kind === 'marketplace' ? { title:'Pazaryeri Komisyon Hesaplayıcı', description:'Pazaryeri satışınızda komisyon, operasyon, kâr ve kendi e-ticaret sitenizle yıllık maliyet farkını hesaplayın.', label:'Pazaryeri maliyetini gerçek verinizle görün.' } : kind === 'website' ? { title:'Web Sitesi Fiyat Hesaplayıcı', description:'Site kapsamına göre kesin fiyat yerine anlamlı bir tahmini proje aralığı ve doğru hizmet yönlendirmesi alın.', label:'Kapsamı seçin, tahmini aralığı görün.' } : { title:'E-Ticaret Maliyet Hesaplayıcı', description:'Pazaryeri, hazır altyapı, WooCommerce ve özel e-ticaret sitesini ilk kurulum, aylık gider ve yıllık toplam maliyetle karşılaştırın.', label:'Kanal maliyetini aynı varsayımlarla karşılaştırın.' };
const breadcrumbs=[{name:'Ana sayfa',url:'/'},{name:'Araçlar',url:'/tr/araclar/'},{name:copy.title,url:`/tr/araclar/${kind==='marketplace'?'pazaryeri-komisyon-hesaplama':kind==='website'?'web-sitesi-fiyat-hesaplama':'e-ticaret-maliyet-hesaplama'}/`}];
---
<BaseLayout title={`${copy.title} | QCT Commerce`} description={copy.description} lang="tr" breadcrumbs={breadcrumbs}><Header slot="header" lang="tr"/><main class="calc"><header class="calc__hero container"><p>ÜCRETSİZ ARAÇ</p><h1>{copy.title}</h1><div>{copy.label}</div></header><section class="container calc__shell" data-calculator={kind}>
{kind === 'marketplace' && <><div class="calc__form"><h2>Pazaryeri satış verileri</h2><label>Ürün satış fiyatı (TL)<input name="price" type="number" value="1000" min="0" /></label><label>Ürün maliyeti (TL)<input name="cost" type="number" value="400" min="0" /></label><label>KDV oranı (%)<input name="vat" type="number" value="20" min="0" /></label><label>Pazaryeri komisyon oranı (%)<input name="commission" type="number" value="18" min="0" /></label><label>Kargo maliyeti (TL)<input name="shipping" type="number" value="65" min="0" /></label><label>Reklam maliyeti / ürün (TL)<input name="ads" type="number" value="45" min="0" /></label><label>Diğer operasyon maliyeti / ürün (TL)<input name="operations" type="number" value="25" min="0" /></label><label>Aylık satış adedi<input name="volume" type="number" value="200" min="0" /></label><hr/><h2>Kendi e-ticaret siteniz</h2><label>Ödeme altyapısı komisyonu (%)<input name="payment" type="number" value="3.5" min="0" /></label><label>Aylık site maliyeti (TL)<input name="site" type="number" value="3000" min="0" /></label><label>Tahmini reklam maliyeti / ürün (TL)<input name="ownAds" type="number" value="55" min="0" /></label></div><div class="calc__results"><p>CANLI SONUÇ</p><h2>Satış başına ve yıllık maliyet</h2><div class="calc__cards"><article><span>PAZARYERİ</span><dl><div><dt>Komisyon</dt><dd data-out="commission">—</dd></div><div><dt>Toplam kesinti</dt><dd data-out="deduction">—</dd></div><div><dt>Net kâr</dt><dd data-out="marketProfit">—</dd></div><div><dt>Kâr marjı</dt><dd data-out="marketMargin">—</dd></div><div><dt>Yıllık toplam maliyet</dt><dd data-out="marketAnnual">—</dd></div></dl></article><article><span>KENDİ SİTENİZ</span><dl><div><dt>İşlem başı maliyet</dt><dd data-out="ownCost">—</dd></div><div><dt>Net kâr</dt><dd data-out="ownProfit">—</dd></div><div><dt>Kâr marjı</dt><dd data-out="ownMargin">—</dd></div><div><dt>Yıllık toplam maliyet</dt><dd data-out="ownAnnual">—</dd></div><div><dt>Tahmini fark</dt><dd data-out="saving">—</dd></div></dl></article></div><p class="calc__note">Sonuçlar tahmini hesaplamadır; KDV uygulaması, iade, kampanya, kategori oranı ve sözleşme koşulları farklılık gösterebilir.</p><aside>Satış hacminiz büyüdükçe pazaryeri komisyonları önemli bir maliyet kalemine dönüşebilir. Kendi e-ticaret altyapınızın size ne kazandırabileceğini birlikte hesaplayalım.<a href="/iletisim/">E-Ticaret Projesi Oluştur</a></aside></div></>}
{kind === 'website' && <><div class="calc__form"><h2>Proje kapsamı</h2><label>Site tipi<select name="siteType"><option value="base">Kurumsal web sitesi</option><option value="commerce">E-ticaret sitesi</option><option value="custom">Özel platform</option></select></label><label>Sayfa sayısı<input name="pages" type="number" value="8" min="1" /></label><label>Ürün sayısı (varsa)<input name="products" type="number" value="0" min="0" /></label>{['Çok dil','E-ticaret','Ödeme sistemi','Rezervasyon sistemi','CRM entegrasyonu','WhatsApp','Özel tasarım','SEO','GEO / AEO / AIO','Blog'].map((label,i)=><label class="check"><input name={`opt${i}`} type="checkbox"/> {label}</label>)}</div><div class="calc__results"><p>TAHMİNİ ARALIK</p><h2>Proje yatırım aralığınız</h2><strong class="calc__range" data-out="range">—</strong><p data-out="websiteMessage">Seçimleriniz değiştikçe aralık güncellenir.</p><aside>Bu araç kesin teklif vermez. Mevcut içerik, entegrasyon, veri taşıma ve yayın gereksinimleri keşif aşamasında netleştirilir.<a href="/iletisim/">Web Projesi Oluştur</a></aside></div></>}
{kind === 'ecommerce' && <><div class="calc__form"><h2>Ortak varsayımlar</h2><label>Aylık satış adedi<input name="volume" type="number" value="200" min="0" /></label><label>Ortalama sepet tutarı (TL)<input name="basket" type="number" value="1000" min="0" /></label><label>İlk kurulum bütçesi (TL)<input name="setup" type="number" value="60000" min="0" /></label><label>Aylık reklam bütçesi (TL)<input name="ads" type="number" value="15000" min="0" /></label><label>Pazaryeri komisyonu (%)<input name="commission" type="number" value="18" min="0" /></label></div><div class="calc__results"><p>12 AYLIK KIYAS</p><h2>Yaklaşık toplam maliyet</h2><div class="calc__table"><div><b>Model</b><b>İlk kurulum</b><b>Aylık gider</b><b>İşlem/komisyon</b><b>Yıllık toplam</b></div>{['Pazaryeri','Hazır altyapı','WooCommerce','Özel e-ticaret'].map((name,i)=><div><strong>{name}</strong><span data-out={`set${i}`}>—</span><span data-out={`monthly${i}`}>—</span><span data-out={`fee${i}`}>—</span><b data-out={`total${i}`}>—</b></div>)}</div><p class="calc__note">Model maliyetleri örnek varsayımlardır; sağlayıcı paketleri, uygulamalar, geliştirme kapsamı ve ödeme anlaşmalarıyla doğrulanmalıdır.</p><aside>Karar yalnız en düşük maliyet değildir. Operasyon, esneklik, teknik sahiplik ve büyüme hedefi birlikte değerlendirilmelidir.<a href="/iletisim/">E-Ticaret Projesi Oluştur</a></aside></div></>}
</section></main><Footer slot="footer" lang="tr"/></BaseLayout>
<script is:inline>
  (()=>{const root=document.querySelector('[data-calculator]');if(!root)return;const type=root.dataset.calculator;const n=(name)=>{const value=Number(root.querySelector(`[name="${name}"]`)?.value);return Number.isFinite(value)?Math.max(0,Math.min(value,1e12)):0};const money=(v)=>new Intl.NumberFormat('tr-TR',{style:'currency',currency:'TRY',maximumFractionDigits:0}).format(Number.isFinite(v)?v:0);const put=(key,value)=>{const e=root.querySelector(`[data-out="${key}"]`);if(e)e.textContent=value};
  const update=()=>{if(type==='marketplace'){const price=n('price'),cost=n('cost'),vat=n('vat')/100,com=price*n('commission')/100,ship=n('shipping'),ads=n('ads'),ops=n('operations'),vol=n('volume'), pay=price*n('payment')/100,site=n('site'),ownAds=n('ownAds');const deduction=com+ship+ads+ops, marketProfit=price-(price*vat)-cost-deduction, ownCost=pay+ownAds+ops+(vol?site/vol:0),ownProfit=price-(price*vat)-cost-ownCost,marketAnnual=deduction*vol*12,ownAnnual=(pay+ownAds+ops)*vol*12+site*12;put('commission',money(com));put('deduction',money(deduction));put('marketProfit',money(marketProfit));put('marketMargin',`${(price?marketProfit/price*100:0).toFixed(1)}%`);put('marketAnnual',money(marketAnnual));put('ownCost',money(ownCost));put('ownProfit',money(ownProfit));put('ownMargin',`${(price?ownProfit/price*100:0).toFixed(1)}%`);put('ownAnnual',money(ownAnnual));put('saving',money(marketAnnual-ownAnnual));}else if(type==='website'){let total={base:8900,commerce:9900,custom:25000}[root.querySelector('[name="siteType"]').value];total+=Math.max(0,n('pages')-5)*700+Math.max(0,n('products')-10)*100;const optionCosts=[6000,5000,2500,2500,3500,1000,5000,3900,3900,2500];root.querySelectorAll('.check input:checked').forEach((input)=>{total+=optionCosts[Number(input.name.replace('opt',''))]||0;});put('range',`${money(total*.9)} – ${money(total*1.1)}`);put('websiteMessage',total>=25000?'Seçimleriniz özel kapsam veya ileri entegrasyon gerektiriyor; net kapsam keşifte belirlenir.':'Seçimleriniz başlangıç kapsamını gösterir; net teklif sayfa, içerik ve entegrasyon ayrıntılarıyla hazırlanır.');}else{const v=n('volume'),b=n('basket'),setup=n('setup'),ads=n('ads'),c=n('commission')/100;const rows=[[0,0,c],[setup*.45,4500,.035],[setup*.75,6500,.03],[setup,11000,.025]];rows.forEach(([s,m,f],i)=>{const fee=b*v*f;const total=s+(m+ads)*12+fee*12;put(`set${i}`,money(s));put(`monthly${i}`,money(m));put(`fee${i}`,money(fee));put(`total${i}`,money(total));});}};root.addEventListener('input',update);root.addEventListener('change',update);update();})();
</script>
<style>.calc{background:var(--qct-color-background)}.calc__hero{padding:calc(var(--qct-hero-clearance) + 60px) 20px 64px;text-align:center;border-bottom:1px solid var(--qct-color-line)}.calc__hero p,.calc__results>p{color:var(--qct-color-accent-strong);font-size:.75rem;font-weight:800;letter-spacing:.14em}.calc h1,.calc h2{color:var(--qct-color-ink);letter-spacing:-.05em;text-wrap:balance}.calc h1{font-size:clamp(2.35rem,5vw,4.3rem);line-height:1.03;margin:.5rem auto 1rem;max-width:19ch}.calc__hero div{color:var(--qct-color-muted);line-height:1.7}.calc__shell{display:grid;grid-template-columns:minmax(280px,.75fr) minmax(0,1.15fr);gap:clamp(25px,5vw,70px);padding-block:clamp(45px,6vw,82px)}.calc__form{border:1px solid var(--qct-color-line-strong);padding:24px;align-self:start}.calc__form h2{font-size:1.35rem;margin:0 0 1.3rem}.calc label{color:var(--qct-color-ink);display:grid;font-size:.86rem;font-weight:700;gap:.45rem;margin:.85rem 0}.calc input,.calc select{background:#fff;border:1px solid #cfc7bf;border-radius:0;color:#171412;font:inherit;min-height:44px;padding:.6rem}.calc .check{display:block;font-weight:500}.calc .check input{min-height:0;margin-right:.45rem}.calc hr{border:0;border-top:1px solid var(--qct-color-line);margin:1.6rem 0}.calc__results{min-width:0}.calc__results h2{font-size:clamp(1.75rem,3.5vw,2.7rem);margin:.35rem 0 1.7rem}.calc__cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.calc__cards article{border:1px solid var(--qct-color-line-strong);padding:19px}.calc__cards article>span{color:var(--qct-color-accent-strong);font-size:.7rem;font-weight:800;letter-spacing:.12em}.calc dl{margin:1rem 0 0}.calc dl div{border-top:1px solid var(--qct-color-line);display:flex;justify-content:space-between;gap:10px;padding:.8rem 0}.calc dt{color:var(--qct-color-muted);font-size:.86rem}.calc dd{color:var(--qct-color-ink);font-weight:800;margin:0;text-align:right}.calc__note{color:var(--qct-color-muted);font-size:.85rem;line-height:1.5}.calc aside{background:#171412;color:#fffaf5;line-height:1.65;margin-top:1.8rem;padding:24px}.calc aside a{background:var(--qct-color-accent);color:#171412;display:block;font-weight:800;margin-top:1rem;padding:.85rem;text-align:center;text-decoration:none}.calc__range{color:var(--qct-color-ink);display:block;font-size:clamp(2rem,5vw,3.5rem);letter-spacing:-.06em;margin-bottom:1rem}.calc__table{border:1px solid var(--qct-color-line-strong);max-width:100%;overflow:auto}.calc__table>div{display:grid;grid-template-columns:1.25fr repeat(4,minmax(100px,1fr));gap:10px;min-width:660px;padding:14px;border-bottom:1px solid var(--qct-color-line)}.calc__table>div:first-child{background:#171412;color:#fffaf5;font-size:.78rem}.calc__table span{color:var(--qct-color-muted);font-size:.9rem}@media(max-width:800px){.calc__shell{grid-template-columns:1fr}.calc__cards{grid-template-columns:1fr}} </style>
