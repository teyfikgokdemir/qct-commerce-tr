---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import ServicePage from './service/ServicePage.astro'; import {getPageSeo} from '../i18n/seo'; interface Props{lang:string} const{lang}=Astro.props; const seo=getPageSeo('contact');
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} pageType="ContactPage" breadcrumbLabel="İletişim" includeServiceCardStyles><Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="İletişim" title="Dijital büyüme hedefinizi ve öncelikli sorununuzu konuşalım." lead="İşletmenizi, mevcut web sitesi veya mağazanızı ve çözmek istediğiniz darboğazı kısaca paylaşın. Uygun bir sonraki adımı birlikte netleştirelim." ctaPrimary="E-posta gönderin" ctaPrimaryHref="mailto:info@qctcommerce.com"
benefits={{eyebrow:'İLETİŞİM BİLGİLERİ',title:'QCT Commerce’a ulaşın',lead:'Türkiye’deki e-ticaret ve dijital büyüme projeleri için.',items:[{title:'E-posta',text:'info@qctcommerce.com'},{title:'Telefon ve WhatsApp',text:'+90 543 385 66 56'},{title:'Pazar',text:'Türkiye'}]}}
included={{eyebrow:'İLK MESAJ',title:'Kısa bir proje özeti yeterli.',lead:'Aşağıdaki bilgiler ihtiyacı daha hızlı anlamamıza yardımcı olur.',items:[{title:'İşletme',text:'Ne sattığınız ve kime sattığınız.'},{title:'Mevcut yapı',text:'Varsa web sitesi veya mağaza adresi.'},{title:'Öncelikli sorun',text:'Satış, görünürlük, reklam veya operasyon darboğazı.'},{title:'Hedef',text:'Proje sonunda neyin değişmesini beklediğiniz.'}]}}
process={{eyebrow:'SONRAKİ ADIM',title:'İlk iletişim nasıl ilerler?',steps:[{number:'01',title:'Mesajınızı inceleriz',text:'İşletme ve ihtiyaç hakkında temel bağlamı değerlendiririz.'},{number:'02',title:'Eksik bilgiyi netleştiririz',text:'Gerekirse kısa sorularla kapsamı belirginleştiririz.'},{number:'03',title:'Uygun yaklaşımı paylaşırız',text:'Öncelikli çözüm alanı ve sonraki görüşme için dönüş yaparız.'}]}}
faq={{eyebrow:'SIK SORULANLAR',title:'İletişim hakkında',items:[{q:'Detaylı brief hazırlamak zorunda mıyız?',a:'Hayır. İşletme, mevcut durum ve öncelikli sorunu anlatan kısa bir mesaj yeterlidir.'},{q:'WhatsApp üzerinden ulaşabilir miyiz?',a:'Evet. +90 543 385 66 56 numarasına WhatsApp üzerinden yazabilirsiniz.'},{q:'Sosyal medya hesabınız var mı?',a:'Bu sitede doğrulanmış bir sosyal medya hesabı yayımlanmamaktadır.'}]}}
final={{title:'Öncelikli ihtiyacınızı paylaşmaya hazır mısınız?',text:'info@qctcommerce.com adresine yazın veya WhatsApp üzerinden ulaşın.',cta:'WhatsApp’tan yazın',ctaHref:'https://wa.me/905433856656',ctaSecondary:'E-posta gönderin'}}/><Footer slot="footer" lang={lang}/></BaseLayout>
