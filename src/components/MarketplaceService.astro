---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
interface Props { market: 'all' | 'tr' | 'us'; }
const { market } = Astro.props;
const us = market === 'us';
const tr = market === 'tr';
const title = us ? 'Amazon Amerika Mağaza Açma ve Kurulum Danışmanlığı | QCT Commerce' : tr ? 'Amazon Türkiye Mağaza Açma ve Kurulum Danışmanlığı | QCT Commerce' : 'Pazaryeri Mağaza Kurulumu ve Entegrasyon | QCT Commerce';
const heading = us ? 'Amazon Amerika Kurulumu' : tr ? 'Amazon Türkiye Kurulumu' : 'Pazaryeri Mağaza Kurulumu';
const lead = us
  ? 'Amazon.com üzerinden ABD pazarına açılmak isteyen markalar için hesap başvurusu, ürün listeleme ve FBA/FBM operasyon hazırlığını tek plan altında ele alıyoruz.'
  : tr ? 'Amazon.com.tr üzerinden satışa başlamak için satıcı hesabı hazırlığı, ürün kataloğu, marka sunumu ve operasyon adımlarını planlıyoruz.'
  : 'Trendyol, Hepsiburada, Amazon Türkiye, Amazon Amerika, n11 ve Etsy için mağaza kurulumunu; ürün, entegrasyon ve operasyon ihtiyaçlarınıza göre tasarlıyoruz.';
const steps = us
  ? [['Pazar uygunluğu','Ürün kategorisi, ABD ürün mevzuatı, ithalat, vergi ve lojistik gereklilikleri değerlendirilir.'],['Satıcı hesabı','Amazon.com kayıt sürecinde şirket ve kimlik belgeleri hazırlanır; kabul kararı Amazon’a aittir.'],['Katalog ve lojistik','Ürün sayfaları, görseller, varyasyonlar ve FBA veya FBM modeli yapılandırılır.'],['Yayına hazırlık','Listeleme, maliyet, stok ve sipariş akışı kontrol listesiyle gözden geçirilir.']]
  : tr ? [['Ön değerlendirme','Ürün grubu, şirket bilgileri ve kategori koşulları belirlenir.'],['Hesap hazırlığı','Satıcı hesabı başvurusu ve mağaza profilinin kurulumu desteklenir.'],['Ürün kataloğu','Başlık, görsel, varyasyon ve kategori eşleşmeleri düzenlenir.'],['Operasyon kontrolü','Stok, fiyat, teslimat ve sipariş süreçleri yayından önce gözden geçirilir.']]
  : [['Kanal seçimi','Hedef müşteri, kategori ve komisyon yapısına göre uygun kanallar belirlenir.'],['Mağaza kurulumu','Başvuru evrakları, mağaza profili ve katalog düzeni hazırlanır.'],['Entegrasyon planı','Birden fazla kanalda ürün, stok, fiyat ve sipariş akışı tasarlanır.'],['Satışa hazırlık','Operasyon sorumlulukları ve yayına geçiş kontrol listesi netleştirilir.']];
const details = us ? {
  eyebrow: 'AMAZON.COM / ABD',
  title: 'ABD pazarına hazırlık',
  intro: 'Amazon Amerika yalnızca ürünleri İngilizceye çevirmekten ibaret değildir. Kategori koşullarını, maliyetleri ve sipariş karşılamayı satışa başlamadan önce netleştirmek gerekir.',
  items: [
    ['Ürün ve kategori uygunluğu', 'Ürünün ABD pazarındaki kategori kısıtları, etiketleme, güvenlik ve mevzuat gereklilikleri kontrol listesiyle değerlendirilir. Gerekli uzman görüşleri ayrıca alınır.'],
    ['Listeleme ve katalog', 'Ürün başlıkları, açıklamalar, varyasyon aileleri, temel arama terimleri, görseller ve gerekli ürün tanımlayıcıları pazarın diliyle hazırlanır.'],
    ['FBA / FBM maliyet modeli', 'Depolama, sipariş karşılama, iade, uluslararası taşıma ve olası gümrük giderleri ürün kârlılığından ayrı düşünülmez.'],
    ['Marka ve hesap güveni', 'Hesap yetkileri, belge tutarlılığı, marka sahipliği ve varsa Brand Registry uygunluğu başvuru öncesinde değerlendirilir.'],
    ['Operasyon devri', 'Stok takibi, fiyat güncellemesi, sipariş mesajları ve performans göstergeleri için uygulanabilir bir yönetim akışı belirlenir.'],
    ['Büyüme hazırlığı', 'Organik ürün görünürlüğü ile reklam, kupon ve kampanya harcamaları ayrıştırılır; reklam bütçesi kurulum hizmetinin içinde varsayılmaz.'],
  ],
} : tr ? {
  eyebrow: 'AMAZON.COM.TR / TÜRKİYE',
  title: 'Satışa hazır mağaza',
  intro: 'İyi bir kurulum, hesap açılmasından ürünün müşteriye teslimine kadar uzanır. Katalog kalitesi ve operasyon tutarlılığı birlikte ele alınır.',
  items: [
    ['Satıcı hesabı ve belgeler', 'Başvuru bilgileri, şirket ve iletişim belgeleri, ödeme ve fatura süreçleri ile hesap erişimleri düzenli biçimde hazırlanır.'],
    ['Kategori ve ürün eşleştirme', 'Ürünün mevcut katalogda bulunup bulunmadığı, varyasyonları, barkodları ve kategori özellikleri kontrol edilir.'],
    ['Ürün sunumu', 'Başlıklar, maddeler, açıklamalar ve fotoğraflar alıcı sorularına net cevap verecek biçimde yapılandırılır.'],
    ['Fiyat ve kârlılık', 'Kategori komisyonları, gönderim, iade, paketleme ve varsa reklam giderleri hizmet ücretinden ayrı ele alınır.'],
    ['Stok ve sipariş düzeni', 'Mevcut e-ticaret sitesiyle stok eşitleme ihtiyacı ve sipariş yönetimi için uygun araçlar değerlendirilir.'],
    ['Yayına geçiş kontrolü', 'Ürün görünürlüğü, teslimat bilgileri, mağaza profili ve operasyon sorumlulukları kontrol edilerek eksikler listelenir.'],
  ],
} : {
  eyebrow: 'PAZARYERİ STRATEJİSİ',
  title: 'Çok kanallı satış düzeni',
  intro: 'Her platform aynı ürün için aynı müşteriyi veya aynı maliyet yapısını sunmaz. Kanal seçimi, katalog ve operasyon gerçeklerine dayanmalı.',
  items: [
    ['Platform uygunluğu', 'Trendyol, Hepsiburada, n11, Amazon Türkiye, Amazon Amerika ve Etsy için ürün kategorisi, hedef pazar ve satıcı şartları ayrı incelenir.'],
    ['Merkezi ürün kataloğu', 'Ürün adı, açıklama, görsel, varyasyon, barkod ve kategori bilgileri tutarlı bir kaynaktan yönetilebilecek biçimde tasarlanır.'],
    ['Stok senkronizasyonu', 'Birden çok kanalda aynı ürünün satılması halinde stok güncellemeleri ve aşırı satış riskine karşı süreç planlanır.'],
    ['Fiyat ve komisyon', 'Kanal bazında komisyon, kargo, iade ve kampanya maliyeti hesaba katılarak fiyatlandırma yöntemi belirlenir.'],
    ['Sipariş ve entegrasyon', 'ERP, muhasebe, e-ticaret sitesi ve pazaryerleri arasındaki veri alışverişi teknik erişim koşullarına göre tasarlanır.'],
    ['Yönetim ve raporlama', 'Satış kanallarının sorumluları, günlük sipariş kontrolü, iptal/iade süreçleri ve takip edilecek göstergeler tanımlanır.'],
  ],
};
const channelLogos = [
  { name: 'Trendyol', src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Trendyol_logo.svg' },
  { name: 'Hepsiburada', src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/Hepsiburada_logo_official.svg' },
  { name: 'Amazon', src: 'https://upload.wikimedia.org/wikipedia/commons/a/a9/Amazon_logo.svg' },
  { name: 'n11', src: 'https://commons.wikimedia.org/wiki/Special:Redirect/file/N11_Logo_2025.svg' },
];
const related = [
  ['/amazon-turkiye-magaza-kurulumu/','Amazon Türkiye','Türkiye pazarında satıcı hesabı ve katalog hazırlığı.'],
  ['/amazon-amerika-magaza-kurulumu/','Amazon Amerika','ABD pazarı, FBA/FBM ve uluslararası satış hazırlığı.'],
  ['/pazaryeri-kurulumu/','Tüm pazaryerleri','Trendyol, Hepsiburada, n11, Etsy ve entegrasyonlar.'],
].filter(([href]) => href !== Astro.url.pathname);
const faq = us ? [
  ['Amazon Amerika için ABD şirketi şart mı?','ABD şirketi her başvuru için otomatik zorunluluk değildir. Uygunluk, güncel satıcı kayıt koşulları ve işletmenin hukuki/vergi durumuna göre doğrulanır.'],
  ['FBA ile FBM arasındaki fark nedir?','FBA modelinde Amazon lojistik hizmetleri kullanılır; FBM modelinde sipariş karşılama satıcı tarafından yönetilir. Ücretler, iadeler ve ürün uygunluğu modele göre değişir.'],
  ['Amazon komisyonları hizmet fiyatına dahil mi?','Hayır. Amazon satıcı aboneliği, kategori komisyonu, lojistik, depolama, vergi ve diğer üçüncü taraf giderler ayrıca değerlendirilir.'],
] : tr ? [
  ['Amazon Türkiye satıcı hesabı hemen açılır mı?','Hesap başvurusu için gereken bilgiler hazırlanır. Doğrulama, kategori kabulü ve aktivasyon süreleri Amazon’un değerlendirmesine bağlıdır.'],
  ['Ürün girişleri dahil mi?','Ürün sayısı, varyasyonlar ve içerik kalitesi proje kapsamına göre ayrıca tekliflendirilir.'],
  ['Amazon komisyonları kurulum ücretine dahil mi?','Hayır. Amazon’un kendi ücretleri ve satış komisyonları QCT Commerce hizmet bedelinden ayrıdır.'],
] : [
  ['Hangi pazaryerleriyle çalışıyorsunuz?','Trendyol, Hepsiburada, Amazon Türkiye, Amazon.com, n11 ve uygun ürün kategorileri için Etsy başvuru ve katalog süreçleri değerlendirilebilir.'],
  ['Birden fazla mağazanın stoku birlikte yönetilir mi?','Evet; uygun entegrasyon araçları veya API’ler üzerinden ürün, stok, fiyat ve sipariş senkronizasyonu proje kapsamında tasarlanabilir.'],
  ['Kurulum ücreti sabit mi?','Hayır. Pazar, mağaza sayısı, ürün adedi, entegrasyonlar ve uluslararası operasyon ihtiyaçlarına göre yazılı teklif hazırlanır.'],
];
const contact = '/iletisim/';
const breadcrumbName = us ? 'Amazon Amerika Mağaza Kurulumu' : tr ? 'Amazon Türkiye Mağaza Kurulumu' : 'Pazaryeri Mağaza Kurulumu';
const breadcrumbs = [{name:'Ana sayfa',url:'/'},{name:'Hizmetler',url:'/hizmetler/'},{name:breadcrumbName,url:Astro.url.pathname}];
---
<BaseLayout title={title} description={lead} lang="tr" includeServiceCardStyles breadcrumbs={breadcrumbs}>
  <Header slot="header" lang="tr"/>
  <main class="marketplace">
    <section class="marketplace-hero container">
      
      <h1>{heading}</h1>
      <p class="marketplace-lead">{lead}</p>
      <div class="marketplace-actions"><a class="marketplace-primary" href={contact}>Pazaryeri teklifinizi hazırlayalım <span aria-hidden="true">↗</span></a><a class="marketplace-secondary" href="/e-ticaret/">E-ticaret çözümleri</a></div>
      <p class="marketplace-note">Satıcı onayı ve satış performansı garanti edilmez. Platform ücretleri teklifimizden ayrıdır.</p>
      <div class="marketplace-channels" aria-label="Pazaryeri logoları">
        <p class="marketplace-eyebrow">PAZARYERİ KANALLARI</p>
        <div class="marketplace-channel-viewport" role="group" aria-label="Pazaryeri markaları">
          <div class="marketplace-channel-track">
            {[0, 1].map((repeat) => <div class="marketplace-channel-set" aria-hidden={repeat === 1 ? 'true' : undefined}>
              {channelLogos.map((item) => <div class="marketplace-channel" title={item.name}><img src={item.src} alt={repeat === 1 ? '' : item.name + ' logosu'} loading="lazy" decoding="async" /><span>{item.name}</span></div>)}
              {<div class="marketplace-channel marketplace-channel--text"><strong>Etsy</strong><span>Etsy</span></div>}
            </div>)}
          </div>
        </div>
        <p class="marketplace-channel-disclaimer">Platform adları ve logoları ilgili marka sahiplerine aittir. QCT Commerce, bu platformların resmi temsilcisi değildir.</p>
      </div>
    </section>
    <section class="marketplace-section container" aria-labelledby="scope-heading">
      <div class="marketplace-intro"><p class="marketplace-eyebrow">YAKLAŞIMIMIZ</p><h2 id="scope-heading">Kurulumdan satışa</h2><p>Mağaza açmak yalnızca ilk adımdır. Ürün yapısını, operasyonu ve hedef pazarı birlikte ele alıyor; gereksiz entegrasyon ve belirsiz maliyetlerden kaçınıyoruz.</p></div>
      <div class="marketplace-grid">{steps.map(([name,description]) => <article class="marketplace-card"><h3>{name}</h3><p>{description}</p></article>)}</div>
    </section>
    <section class="marketplace-section marketplace-detail container" aria-labelledby="detail-heading">
      <div class="marketplace-intro"><p class="marketplace-eyebrow">{details.eyebrow}</p><h2 id="detail-heading">{details.title}</h2><p>{details.intro}</p></div>
      <div class="marketplace-grid marketplace-detail-grid">{details.items.map(([name,description]) => <article class="marketplace-card"><h3>{name}</h3><p>{description}</p></article>)}</div>
    </section>
    <section class="marketplace-section marketplace-alt" aria-labelledby="options-heading"><div class="container"><div class="marketplace-intro"><p class="marketplace-eyebrow">İLGİLİ HİZMETLER</p><h2 id="options-heading">Doğru pazarı seçin</h2></div><div class="marketplace-grid marketplace-links">{related.map(([href,name,description]) => <a class="marketplace-card marketplace-link" href={href}><h3>{name} <span aria-hidden="true">↗</span></h3><p>{description}</p></a>)}</div></div></section>
    <section class="marketplace-section container" aria-labelledby="faq-heading"><div class="marketplace-intro"><p class="marketplace-eyebrow">SIK SORULANLAR</p><h2 id="faq-heading">Merak edilenler</h2></div><div class="marketplace-faq">{faq.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></section>
    <section class="marketplace-bottom container"><div><p class="marketplace-eyebrow">SONRAKİ ADIM</p><h2>Satış planınızı netleştirelim</h2><p>Ürün kategoriniz, hedef pazarınız ve yaklaşık ürün adedinizle iletişime geçin. Kapsamı ve hizmet ücretini ayrı, şeffaf bir teklif olarak hazırlayalım.</p></div><a class="marketplace-primary" href={contact}>Teklif görüşmesi <span aria-hidden="true">↗</span></a></section>
  </main>
  <Footer slot="footer" lang="tr"/>
</BaseLayout>
<style>
.marketplace{color:var(--text-primary,#182029)}.marketplace-hero{padding-top:clamp(8rem,11vw,10rem);padding-bottom:clamp(4rem,8vw,7rem);max-width:1100px}.marketplace-eyebrow{letter-spacing:.2em;text-transform:uppercase;font-size:.73rem;font-weight:700;color:var(--color-accent,#ba9461);margin:0 0 1.25rem}.marketplace-hero h1{font-size:clamp(2.1rem,5.5vw,4.5rem);line-height:1.08;letter-spacing:-.045em;max-width:100%;margin:0 0 1.5rem;text-wrap:balance}.marketplace-channels{margin-top:3rem;padding-top:2rem;border-top:1px solid rgba(126,135,143,.2)}.marketplace-channels .marketplace-eyebrow{margin-bottom:1rem}.marketplace-channel-viewport{width:100%;overflow:hidden;mask-image:linear-gradient(to right,transparent,#000 5%,#000 95%,transparent)}.marketplace-channel-track{display:flex;align-items:center;width:max-content;animation:marketplace-marquee 28s linear infinite;will-change:transform}.marketplace-channel-set{display:flex;align-items:center;gap:clamp(1.5rem,5vw,3.5rem);padding-right:clamp(1.5rem,5vw,3.5rem);flex:none}.marketplace-channel{display:flex;flex:none;align-items:center;justify-content:center;min-width:135px;height:64px;padding:0 .35rem;background:none;border:0}.marketplace-channel img{display:block;height:38px;width:auto;max-width:132px;object-fit:contain}.marketplace-channel img[alt*="n11"]{height:32px}.marketplace-channel>span{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.marketplace-channel--text strong{font-family:Georgia,serif;color:#f1641e;font-size:1.65rem}.marketplace-channel-viewport:hover .marketplace-channel-track,.marketplace-channel-viewport:focus-within .marketplace-channel-track{animation-play-state:paused}.marketplace-channel-viewport--single{mask-image:none}.marketplace-channel-viewport--single .marketplace-channel-track{width:100%;animation:none}.marketplace-channel-viewport--single .marketplace-channel-set{width:100%;justify-content:center}.marketplace-channel-viewport--single .marketplace-channel-set[aria-hidden="true"]{display:none}@keyframes marketplace-marquee{to{transform:translateX(-50%)}}@media(prefers-reduced-motion:reduce){.marketplace-channel-viewport{overflow-x:auto;mask-image:none}.marketplace-channel-track{animation:none}}.marketplace-channel-disclaimer{margin:1rem 0 0;font-size:.76rem;line-height:1.65;opacity:.6}.marketplace-lead{font-size:clamp(1.05rem,1.6vw,1.3rem);line-height:1.75;max-width:760px;opacity:.82}.marketplace-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1.1rem;margin-top:2.25rem}.marketplace-primary,.marketplace-secondary{display:inline-flex;justify-content:center;align-items:center;gap:1rem;padding:1rem 1.45rem;border-radius:8px;font-weight:650;text-decoration:none;transition:transform .2s ease,opacity .2s ease}.marketplace-primary{background:#14252f;color:#fff}.marketplace-secondary{border:1px solid currentColor;color:inherit}.marketplace-primary:hover,.marketplace-secondary:hover{transform:translateY(-2px)}.marketplace-note{font-size:.85rem;opacity:.65;margin-top:1.4rem}.marketplace-section{padding-top:clamp(3.5rem,7vw,6rem);padding-bottom:clamp(3.5rem,7vw,6rem)}.marketplace-alt{background:rgba(140,143,145,.06)}.marketplace-intro{max-width:750px;margin-bottom:2.5rem}.marketplace-intro h2,.marketplace-bottom h2{font-size:clamp(1.8rem,3vw,2.9rem);letter-spacing:-.035em;line-height:1.15;margin:0 0 1rem}.marketplace-intro>p:last-child,.marketplace-bottom p:last-child{line-height:1.8;opacity:.75}.marketplace-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.marketplace-card{border:1px solid rgba(126,135,143,.2);border-radius:12px;padding:1.8rem 1.45rem;background:rgba(255,255,255,.025);min-width:0}.marketplace-card h3{font-size:1.12rem;line-height:1.35;margin:0 0 .75rem}.marketplace-card p{font-size:.94rem;line-height:1.7;opacity:.76;margin:0}.marketplace-links{grid-template-columns:repeat(2,minmax(0,1fr))}.marketplace-detail-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.marketplace-link{display:block;text-decoration:none;color:inherit}.marketplace-link h3{margin-top:0;display:flex;justify-content:space-between}.marketplace-link:hover{border-color:#aa8967}.marketplace-faq{max-width:900px}.marketplace-faq details{border-bottom:1px solid rgba(126,135,143,.25);padding:1.2rem 0}.marketplace-faq summary{cursor:pointer;font-weight:650;line-height:1.5}.marketplace-faq details p{line-height:1.75;opacity:.78;max-width:790px}.marketplace-bottom{padding-top:4rem;padding-bottom:5rem;display:flex;justify-content:space-between;gap:2rem;align-items:center}.marketplace-bottom>div{max-width:710px}@media(max-width:850px){.marketplace-grid,.marketplace-detail-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.marketplace-hero{padding-top:7.5rem}.marketplace-grid,.marketplace-links,.marketplace-detail-grid{grid-template-columns:1fr}.marketplace-card h3{margin-top:1.2rem}.marketplace-bottom{flex-direction:column;align-items:flex-start}.marketplace-primary{width:auto}}@media(prefers-reduced-motion:reduce){.marketplace-primary,.marketplace-secondary{transition:none}}
</style>