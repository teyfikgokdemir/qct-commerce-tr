---
interface Props {
  lang?: string;
  currentPath?: string;
  isHome?: boolean;
}

const { lang = 'tr', currentPath = '', isHome = false } = Astro.props;

const edgePaths = [
  '/yeni-nesil-web-altyapisi/',
  '/en/next-generation-web-foundation/',
  '/az/yeni-nesil-veb-infrastrukturu/',
];

const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const isEdgePage = edgePaths.includes(normalizedPath);
const shouldRender = !isHome && !isEdgePage;

const copyMap: Record<string, { badge: string; title: string; subtitle: string; cta: string; close: string; href: string }> = {
  tr: {
    badge: '2026 LANSMAN',
    title: 'QCT EDGE Altyapı',
    subtitle: '3 Ay Ücretsiz Dinamik SEO hediyesiyle yayında.',
    cta: 'İncele',
    close: 'Bildirimi kapat',
    href: '/yeni-nesil-web-altyapisi/',
  },
  en: {
    badge: '2026 LAUNCH',
    title: 'QCT EDGE Foundation',
    subtitle: 'Now live with 3 months free Dynamic SEO.',
    cta: 'Explore',
    close: 'Close notification',
    href: '/en/next-generation-web-foundation/',
  },
  az: {
    badge: '2026 TƏQDİMAT',
    title: 'QCT EDGE İnfrastruktur',
    subtitle: '3 Ay Pulsuz Dinamik SEO hədiyyəsi ilə yayında.',
    cta: 'Bax',
    close: 'Bildirişi bağla',
    href: '/az/yeni-nesil-veb-infrastrukturu/',
  },
};

const c = copyMap[lang] || copyMap.tr;
---

{shouldRender && (
  <aside
    id="qct-edge-toast"
    class="qct-edge-toast"
    role="status"
    aria-live="polite"
    aria-label={c.title}
    data-edge-toast
    hidden
  >
    <div class="qct-edge-toast-content">
      <div class="qct-edge-toast-header">
        <span class="qct-edge-toast-badge">
          <span class="qct-edge-toast-dot" aria-hidden="true"></span>
          {c.badge}
        </span>
        <button
          type="button"
          class="qct-edge-toast-close"
          aria-label={c.close}
          title={c.close}
          data-edge-toast-close
        >
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
            <path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <a href={c.href} class="qct-edge-toast-link" data-edge-toast-link>
        <div class="qct-edge-toast-body">
          <strong class="qct-edge-toast-title">{c.title}</strong>
          <span class="qct-edge-toast-desc">{c.subtitle}</span>
        </div>
        <span class="qct-edge-toast-cta">
          {c.cta}
          <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" focusable="false">
            <path d="M5 12h14m-6-6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>

    <div class="qct-edge-toast-progress" aria-hidden="true">
      <div class="qct-edge-toast-bar" data-edge-toast-bar></div>
    </div>
  </aside>
)}

<script is:inline>
  (() => {
    const toast = document.querySelector('[data-edge-toast]');
    if (!toast) return;

    // Check if previously dismissed in this browser session
    try {
      if (sessionStorage.getItem('qct_edge_toast_seen') === '1') {
        return;
      }
    } catch (_) {
      // sessionStorage might fail in privacy-restricted environments
    }

    const closeBtn = toast.querySelector('[data-edge-toast-close]');
    const links = toast.querySelectorAll('[data-edge-toast-link]');
    const bar = toast.querySelector('[data-edge-toast-bar]');

    let dismissTimer = null;
    let isDismissed = false;
    const DURATION_MS = 4800;

    const dismiss = () => {
      if (isDismissed) return;
      isDismissed = true;
      try {
        sessionStorage.setItem('qct_edge_toast_seen', '1');
      } catch (_) {}

      toast.classList.remove('is-visible');
      toast.classList.add('is-hiding');
      setTimeout(() => {
        toast.hidden = true;
      }, 350);
    };

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      dismiss();
    });

    links.forEach((link) => {
      link.addEventListener('click', () => {
        try {
          sessionStorage.setItem('qct_edge_toast_seen', '1');
        } catch (_) {}
      });
    });

    // Pause on hover so the user can comfortably read or click
    let startTime = 0;
    let remainingTime = DURATION_MS;

    const startTimer = () => {
      startTime = Date.now();
      dismissTimer = setTimeout(dismiss, remainingTime);
      if (bar) bar.style.animationPlayState = 'running';
    };

    const pauseTimer = () => {
      if (dismissTimer) {
        clearTimeout(dismissTimer);
        dismissTimer = null;
      }
      remainingTime -= Date.now() - startTime;
      if (remainingTime < 500) remainingTime = 500;
      if (bar) bar.style.animationPlayState = 'paused';
    };

    toast.addEventListener('mouseenter', pauseTimer);
    toast.addEventListener('mouseleave', () => {
      if (!isDismissed) startTimer();
    });

    // Reveal gently after a 1.6s delay
    setTimeout(() => {
      if (isDismissed) return;
      toast.hidden = false;
      // Force reflow for smooth CSS transition
      void toast.offsetHeight;
      toast.classList.add('is-visible');
      startTimer();
    }, 1600);
  })();
</script>

<style is:global>
  .qct-edge-toast {
    position: fixed;
    top: 84px;
    right: 24px;
    z-index: 998;
    width: 350px;
    max-width: calc(100vw - 32px);
    background: rgba(8, 14, 26, 0.98);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(59, 130, 246, 0.38);
    border-radius: 14px;
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.05), 0 0 24px rgba(37, 99, 235, 0.2);
    color: #ffffff;
    overflow: hidden;
    opacity: 0;
    transform: translateY(-12px) scale(0.98);
    transition: opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1), transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .qct-edge-toast.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .qct-edge-toast.is-hiding {
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .qct-edge-toast-content {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .qct-edge-toast-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .qct-edge-toast-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #93c5fd;
    background: rgba(37, 99, 235, 0.22);
    border: 1px solid rgba(96, 165, 250, 0.35);
    padding: 2px 8px;
    border-radius: 999px;
    line-height: 1.3;
  }

  .qct-edge-toast-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 6px #38bdf8;
    display: inline-block;
  }

  .qct-edge-toast-close {
    background: transparent;
    border: none;
    color: #94a3b8;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .qct-edge-toast-close:hover,
  .qct-edge-toast-close:focus-visible {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
    outline: none;
  }

  .qct-edge-toast-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    padding: 2px 0;
    transition: opacity 0.15s ease;
  }

  .qct-edge-toast-link:hover {
    opacity: 0.95;
  }

  .qct-edge-toast-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .qct-edge-toast-title {
    font-size: 13px;
    font-weight: 600;
    color: #f8fafc;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .qct-edge-toast-desc {
    font-size: 11.5px;
    color: #94a3b8;
    line-height: 1.35;
  }

  .qct-edge-toast-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: linear-gradient(135deg, #002fa7 0%, #1d4ed8 100%);
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 7px;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgba(0, 47, 167, 0.35);
    flex-shrink: 0;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .qct-edge-toast-link:hover .qct-edge-toast-cta {
    transform: translateX(1px);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.5);
  }

  .qct-edge-toast-progress {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .qct-edge-toast-bar {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #2563eb, #38bdf8);
    transform-origin: left;
    animation: qctToastProgress 4.8s linear forwards;
  }

  @keyframes qctToastProgress {
    0% {
      transform: scaleX(1);
    }
    100% {
      transform: scaleX(0);
    }
  }

  @media (max-width: 768px) {
    .qct-edge-toast {
      top: 68px;
      left: 12px;
      right: 12px;
      width: auto;
      max-width: 420px;
      margin: 0 auto;
      border-radius: 12px;
    }

    .qct-edge-toast-content {
      padding: 10px 12px;
      gap: 6px;
    }

    .qct-edge-toast-title {
      font-size: 12.5px;
    }

    .qct-edge-toast-desc {
      font-size: 11px;
    }

    .qct-edge-toast-cta {
      padding: 5px 10px;
      font-size: 10.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qct-edge-toast {
      transition: opacity 0.1s linear;
      transform: none !important;
    }
    .qct-edge-toast-bar {
      animation: none !important;
      display: none;
    }
  }
</style>
