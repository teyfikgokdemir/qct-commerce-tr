---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import ServicePage from './service/ServicePage.astro'; import {getPageSeo} from '../i18n/seo'; interface Props{lang:string} const{lang}=Astro.props; const seo=getPageSeo('services');
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} pageType="CollectionPage" breadcrumbLabel="Hizmetler"><Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="Hizmetler" title="E-ticaret ve ölçülebilir dijital büyüme için bütünleşik çözümler." lead="İşletmenizin ihtiyacına göre tek bir darboğaza odaklanabilir veya web, satış, görünürlük, reklam ve otomasyon katmanlarını birlikte planlayabiliriz." ctaPrimary="İhtiyacınızı konuşalım"
benefits={{eyebrow:'ODAK',title:'Tek tek araçlardan önce müşteri yolculuğunu ele alırız.',lead:'Hedef, daha fazla teknoloji eklemek değil; mevcut parçaları satış sürecine hizmet eden bir düzende çalıştırmaktır.',items:[{title:'E-ticaret altyapısı',text:'Ürün keşfi, mobil alışveriş, ödeme ve yönetim akışı.'},{title:'Web tasarım',text:'Teklifi açık anlatan, hızlı ve güven veren sayfalar.'},{title:'WhatsApp satış sistemleri',text:'Reklam ve ürün ilgisini düzenli görüşmelere bağlayan akışlar.'}]}}
included={{eyebrow:'ÇÖZÜMLER',title:'Dijital büyüme sisteminin parçaları',lead:'Her hizmet ayrı kapsamlanabilir; ihtiyaç olduğunda ortak ölçüm ve içerik mimarisiyle birbirine bağlanır.',items:[{title:'E-ticaret altyapısı',text:'Satın alma ve operasyon süreçleri.',href:'/e-ticaret/'},{title:'Web tasarım',text:'Konumlandırma ve dönüşüm odaklı deneyim.',href:'/web-tasarim/'},{title:'WhatsApp satış',text:'Bağlamlı mesajlaşma ve takip.',href:'/whatsapp-satis/'},{title:'SEO, GEO, AEO ve AIO',text:'Arama ve yapay zekâ görünürlüğü.',href:'/seo-geo/'},{title:'Meta reklamları',text:'Kampanya ve landing page akışı.',href:'/meta-reklamlari/'},{title:'Yapay zekâ otomasyonları',text:'Kontrollü operasyon otomasyonu.',href:'/yapay-zeka-otomasyonlari/'}]}}
process={{eyebrow:'BAŞLANGIÇ',title:'Doğru hizmeti nasıl belirliyoruz?',steps:[{number:'01',title:'Hedef',text:'Satış, talep, görünürlük veya operasyon hedefini netleştiririz.'},{number:'02',title:'Darboğaz',text:'Müşteri yolculuğundaki temel kaybı belirleriz.'},{number:'03',title:'Kapsam',text:'Etkisi yüksek, uygulanabilir çalışma paketini çıkarırız.'},{number:'04',title:'Ölçüm',text:'Başarıyı hangi sinyallerle izleyeceğimizi belirleriz.'}]}}
faq={{eyebrow:'SIK SORULANLAR',title:'Hizmetler hakkında',items:[{q:'Tüm hizmetleri birlikte almak zorunda mıyız?',a:'Hayır. En önemli darboğazdan başlayıp ihtiyaca göre ilerleyebiliriz.'},{q:'Mevcut sistemlerimiz korunabilir mi?',a:'Teknik uygunluk ve maliyet açısından mantıklı olan sistemleri korumayı değerlendiririz.'},{q:'Hangi işletmelerle çalışıyorsunuz?',a:'Türkiye’de e-ticaret ve dijital büyüme hedefi olan KOBİ, üretici, perakendeci ve markalarla çalışıyoruz.'}]}}
final={{title:'İlk çözülmesi gereken dijital büyüme sorununu birlikte belirleyelim.',text:'Mevcut altyapınızı ve hedefinizi kısaca paylaşın.',cta:'Öncelikli ihtiyacınızı belirleyelim'}}/><Footer slot="footer" lang={lang}/></BaseLayout>
