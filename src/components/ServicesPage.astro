---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ServicePage from './service/ServicePage.astro';
import { useTranslations, getLocalizedUrl } from '../i18n';
import { getPageSeo } from '../i18n/seo';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const seo = getPageSeo('services', lang);

const serviceLinks = [
  { title: t('Website Design'), text: t('Premium websites that help customers understand and trust your business.'), cta: t('Explore Website Design'), href: getLocalizedUrl(lang, '/website-design/') },
  { title: t('E-commerce'), text: t('Online stores designed for clear product discovery, mobile shopping and easier management.'), cta: t('Explore E-commerce'), href: getLocalizedUrl(lang, '/e-commerce/') },
  { title: t('WhatsApp Commerce'), text: t('Clearer paths from website, ads and product interest into WhatsApp conversations.'), cta: t('Explore WhatsApp Commerce'), href: getLocalizedUrl(lang, '/whatsapp-commerce/') },
  { title: t('SEO & GEO Performance'), text: t('Search visibility for both traditional search engines and AI-based answer engines.'), cta: t('Explore SEO & GEO Performance'), href: getLocalizedUrl(lang, '/seo-performance/') },
  { title: t('Meta Ads Landing Pages'), text: t('Landing pages built to convert traffic coming from Meta advertising campaigns.'), cta: t('Explore Meta Ads Landing Pages'), href: getLocalizedUrl(lang, '/meta-ads-landing-pages/') },
  { title: t('AI Automation'), text: t('Practical workflows for lead routing, enquiries, handoffs and repetitive administration.'), cta: t('Explore AI Automation'), href: getLocalizedUrl(lang, '/ai-automation/') },
];
---
<BaseLayout title={seo.title} lang={lang} description={seo.description} pageType="CollectionPage" breadcrumbLabel={t('Services')}>
  <Header slot="header" lang={lang} />
  <ServicePage
    lang={lang}
    eyebrow={t('Services')}
    title={t('Website, e-commerce and digital growth services for Balkan businesses.')}
    lead={t('QCT Studio provides website design, e-commerce, WhatsApp Commerce, SEO and GEO, Meta Ads landing pages, and practical AI automation for established businesses in Albania and North Macedonia. Services can also be combined for broader Balkan projects when the market and customer journey require it.')}
    ctaPrimary={t('Start Your Project')}
    ctaSecondary={t('View Our Work')}
    problem={{
      eyebrow: t('WHO IT IS FOR'),
      title: t('Built for businesses that already have something worth showing.'),
      intro: [t('QCT Studio is not built for empty promises or quick visual tricks. We work best with businesses that have real services, real products and a serious intention to improve their online presence.')],
      items: [
        { title: t('Established service businesses'), text: '' },
        { title: t('Product and retail companies'), text: '' },
        { title: t('Local and regional businesses preparing for growth'), text: '' },
      ],
    }}
    benefits={{
      eyebrow: t('SERVICES'),
      title: t('Choose the right starting point for your business.'),
      lead: t('Each service can stand alone, but they work best when the customer journey is planned as one connected system.'),
      items: serviceLinks.map(({ title, text }) => ({ title, text })),
    }}
    included={{
      eyebrow: '',
      title: t('A connected system, not separate pieces.'),
      lead: '',
      items: [],
    }}
    process={{
      eyebrow: t('PROCESS'),
      title: t('A clear process before any design decision.'),
      steps: [
        { number: '01', title: t('Understand the business'), text: t('We review your services, customers, current website and commercial goals.') },
        { number: '02', title: t('Choose the right path'), text: t('We identify which service should come first and what will create the most practical value.') },
        { number: '03', title: t('Build the system'), text: t('We design and develop the pages, flows and structures needed for a stronger digital presence.') },
        { number: '04', title: t('Improve over time'), text: t('After launch, we review performance and identify what should be refined next.') },
      ],
    }}
    faq={{
      eyebrow: t('FAQ'),
      title: t('Questions we hear most often.'),
      items: [
        { q: t('Which service should I start with?'), a: t('Start with the point where customers lose clarity or momentum: discovery, the website, checkout, campaign landing pages or follow-up. QCT Studio can review the current journey and identify the first practical priority.') },
        { q: t('Can services be combined?'), a: t('Yes. Most strong results come from combining website, search, landing page and enquiry flow improvements.') },
        { q: t('Do I need a new website first?'), a: t('Not always. Sometimes an existing website can be improved before a full redesign is needed.') },
        { q: t('Do you work with small businesses?'), a: t('Yes, when the business is serious about improving its online presence and has a clear offer.') },
        { q: t('Can we start with one service?'), a: t('Yes. You can begin with one priority and expand later.') },
      ],
    }}
    final={{
      eyebrow: t('READY WHEN YOU ARE'),
      title: t('Start with the part of your digital presence that matters most.'),
      text: t("We'll help you identify the improvement that will create the greatest impact for your business today."),
      cta: t("Let's Talk"),
    }}
  />

  <section class="qct-services-links">
    <div class="container">
      <div class="qct-svc-grid">
        {serviceLinks.map((s) => (
          <a class="qct-svc-card qct-svc-card--link" href={s.href}>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <span>{s.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
.qct-services-links {
  padding-block: 5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}
.qct-svc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}
.qct-svc-card--link {
  padding: 1.75rem 1.5rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.02);
  text-decoration: none;
  color: var(--qct-color-text, #17151a);
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  transition: border-color 0.2s ease, transform 0.2s ease;
}
.qct-svc-card--link:hover {
  border-color: var(--qct-color-accent, #e75757);
  transform: translateY(-2px);
}
.qct-svc-card--link h3 {
  font-size: 1.1rem;
}
.qct-svc-card--link p {
  opacity: 0.85;
  font-size: 0.95rem;
  line-height: 1.5;
  flex-grow: 1;
}
.qct-svc-card--link span {
  color: var(--qct-color-accent, #e75757);
  font-weight: 600;
  font-size: 0.9rem;
}
</style>
