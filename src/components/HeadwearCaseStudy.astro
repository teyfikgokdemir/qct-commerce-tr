    typeLabel: 'Lloji i projektit',
    typeValue: 'E-commerce shumëgjuhësh',
    marketLabel: 'Fokusi',
    marketValue: 'Produkte performance dhe outdoor',
    statusLabel: 'Statusi',
    statusValue: 'Faqe aktive',
