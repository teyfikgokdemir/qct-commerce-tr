---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getLocalizedUrl } from '../i18n';
import { getPageSeo } from '../i18n/seo';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const url = (path: string) => getLocalizedUrl(lang, path);
const seo = getPageSeo('headwear-case-study', lang);

const copy = {
  en: {
    breadcrumb: 'Selected Work',
    eyebrow: 'E-commerce case study',
    title: 'HEADWEAR: a multilingual store for performance and outdoor products.',
    lead: 'A live e-commerce project shaped around a focused product range, multilingual browsing and a clear path from product discovery to purchase.',
    visit: 'Visit the live store',
    overview: 'Project overview',
    overviewTitle: 'A specialist product catalogue needs a shopping experience that stays clear.',
    overviewText: 'HEADWEAR sells neck gaiters, bandanas and performance accessories for sport, outdoor activity and everyday use. The digital experience needs to explain product purpose quickly, support multiple languages and remain easy to use on smaller screens.',
    typeLabel: 'Project type',
    typeValue: 'Multilingual e-commerce',
    marketLabel: 'Focus',
    marketValue: 'Performance and outdoor products',
    statusLabel: 'Status',
    statusValue: 'Live website',
    challenge: 'The challenge',
    challengeTitle: 'Make a focused range easy to understand across markets.',
    challengeText: 'Product-led businesses need more than attractive imagery. Visitors must be able to understand what a product is for, compare options and continue toward checkout without unnecessary friction.',
    approach: 'Our approach',
    approachTitle: 'Build the store around how customers browse and decide.',
    items: [
      ['Product clarity', 'Collection and product pages create a direct route from interest to relevant product information.'],
      ['Multilingual structure', 'Language-specific routes help customers browse the store in the version that fits them.'],
      ['Mobile shopping', 'The interface keeps products, actions and the next step readable on phones and larger screens.'],
      ['Search foundations', 'Crawlable product and collection pages give search systems a clear structure to understand.'],
    ],
    scope: 'Project scope',
    scopeTitle: 'Connected e-commerce foundations.',
    scopeItems: ['Store structure', 'Collection and product templates', 'Multilingual navigation', 'Mobile purchase journey', 'Technical search foundations', 'Ongoing storefront refinement'],
    evidence: 'What this work demonstrates',
    evidenceTitle: 'A real store is stronger evidence than a promise.',
    evidenceText: 'HEADWEAR shows how QCT Studio approaches a live commerce system: start with the products, organise the path clearly and make the experience usable across languages and devices.',
    cta: 'Planning an e-commerce project?',
    ctaText: 'Tell us what you sell, which markets you serve and what needs to improve. We will help identify the most practical starting point.',
    contact: 'Start a project',
  },
  sq: {
    breadcrumb: 'Punë të përzgjedhura',
    eyebrow: 'Studim rasti për e-commerce',
    title: 'HEADWEAR: dyqan shumëgjuhësh për produkte performance dhe outdoor.',
    lead: 'Një projekt aktiv e-commerce, i ndërtuar rreth një game të fokusuar produktesh, shfletimit shumëgjuhësh dhe një rruge të qartë nga zbulimi te blerja.',
    visit: 'Vizitoni dyqanin live',
    overview: 'Përmbledhja e projektit',
    overviewTitle: 'Një katalog i specializuar ka nevojë për një përvojë blerjeje që mbetet e qartë.',
