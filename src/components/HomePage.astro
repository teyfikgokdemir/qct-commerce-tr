---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QctCommerceV2 from '../components/QctCommerceV2.astro';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const seo = {
  title: 'Web & E-Ticaret Projelerinde Net Fiyat | QCT Commerce',
  description: 'Shopify, ikas, WooCommerce, WordPress, Ticimax ve IdeaSoft projeleri için şeffaf başlangıç fiyatları, canlı fiyat hesaplama ve satışa hazır teslim.',
};
const alternates = [
  { lang: 'tr-TR', href: '/' },
  { lang: 'en', href: '/en/' },
];
const faqItems = [
  { q: 'Fiyat hesaplayıcıdaki tutar kesin fiyat mı?', a: 'Standart kapsamlar için gösterilen tutar tahmini başlangıç bedelidir. Özel entegrasyon, yoğun varyant yapısı veya standart dışı geliştirme varsa kapsam netleştirilerek ayrıca belirtilir.' },
  { q: 'Hangi platformlarda çalışıyorsunuz?', a: 'Shopify, ikas, WooCommerce, WordPress, Ticimax ve IdeaSoft başta olmak üzere yaygın web ve e-ticaret altyapılarında kurulum, yenileme ve taşıma hizmeti veriyoruz.' },
  { q: 'Mevcut sitemi tamamen değiştirmeden yenileyebilir misiniz?', a: 'Evet. Mevcut altyapının korunabilir bölümlerini ayırır, mobil deneyim, tasarım, hız ve dönüşüm noktalarını önceliklendirerek yenileme planı çıkarırız.' },
  { q: 'Ürün ekleme hizmeti ayrıca alınabilir mi?', a: 'Evet. Ürün ekleme hizmeti ürün adedine göre kademeli fiyatlanır ve tek başına veya mağaza kurulum paketine ek olarak alınabilir.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://qctcommerce.com/#faq',
  url: 'https://qctcommerce.com/',
  inLanguage: 'tr-TR',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout title={seo.title} description={seo.description} image="/og-commerce-1200x630.jpg" imageWidth={1200} imageHeight={630} lang={lang} isHome={true} includeWorkStyles={false} alternates={alternates}>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header slot="header" lang={lang} />
  <link rel="stylesheet" href="/styles/qct-v2.css?v=20260921-1" />
  <QctCommerceV2 />
  <Footer slot="footer" lang={lang} />
</BaseLayout>
