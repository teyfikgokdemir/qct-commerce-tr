---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Services from '../components/Services.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Process from '../components/Process.astro';
import FinalCta from '../components/FinalCta.astro';
import Contact from '../components/Contact.astro';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const seo = {
  title: 'E-Ticaret, SEO ve Dijital Büyüme | QCT Commerce Türkiye',
  description: 'QCT Commerce; e-ticaret, web tasarım, SEO/GEO/AEO/AIO, WhatsApp satış ve yapay zekâ otomasyonlarını ölçülebilir dijital büyüme sistemine dönüştürür.',
};
const alternates = [
  { lang: 'tr-TR', href: '/' },
  { lang: 'en', href: '/en/' },
];
const faqItems = [
  { q: 'Hangi hizmetle başlamalıyız?', a: 'İlk adım, mevcut dijital yapınızda satış sürecini en çok zorlayan noktayı belirlemektir. İhtiyaç tek bir hizmetle çözülebiliyorsa kapsamı o alanda tutar; birden fazla katman birbirini etkiliyorsa öncelikli sırayı birlikte çıkarırız.' },
  { q: 'Mevcut web sitemiz veya mağazamız geliştirilebilir mi?', a: 'Evet. Yeni bir yapı kurmadan önce mevcut sitenin veya mağazanın teknik altyapısını, kullanıcı akışını, içeriklerini ve ölçüm düzenini değerlendirir; korunabilecek ve geliştirilmesi gereken alanları ayırırız.' },
  { q: 'Yalnızca tek bir hizmet için çalışabilir miyiz?', a: 'Evet. İhtiyaç netse e-ticaret altyapısı, web tasarım, WhatsApp satış sistemi, arama görünürlüğü, Meta reklamları veya otomasyon gibi tek bir çalışma alanıyla ilerlenebilir.' },
  { q: 'İlk görüşmede neleri değerlendiriyorsunuz?', a: 'İş modelinizi, mevcut web sitesi veya mağazanızı, satış kanallarınızı, öncelikli sorunu ve ekip kapasitenizi konuşuruz. Amaç, çözüm önermeden önce mevcut durumu ve hedefi aynı çerçevede görmektir.' },
  { q: 'Çalışma kapsamı nasıl belirleniyor?', a: 'Kapsam; çözülmesi gereken problem, mevcut altyapı, gerekli içerik ve entegrasyonlar ile işletmenin uygulama önceliklerine göre belirlenir. Başlangıç adımı ve sonraki geliştirmeler birbirinden ayrılarak netleştirilir.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://qctcommerce.com/#faq',
  url: 'https://qctcommerce.com/',
  inLanguage: 'tr-TR',
  isPartOf: { '@id': 'https://qctcommerce.com/#webpage' },
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout title={seo.title} description={seo.description} image="/og-default.png" imageWidth={1200} imageHeight={630} lang={lang} isHome={true} includeWorkStyles={true} alternates={alternates}>
<script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<Header slot="header" lang={lang} />
<Hero lang={lang} />
<Problem lang={lang} />
<Services lang={lang} />
<SelectedWork />
<Process lang={lang} />
<FinalCta lang={lang} />
<Contact lang={lang} faqItems={faqItems} />
<Footer slot="footer" lang={lang} />
</BaseLayout>