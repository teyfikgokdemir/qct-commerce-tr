---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QctCommerceV2 from '../components/QctCommerceV2.astro';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const seo = {
  title: 'Web, E-Ticaret, SEO, GEO, AEO & AIO | QCT Commerce',
  description: 'Yeni web ve e-ticaret projeleri, mevcut site analizi, yenileme, hız optimizasyonu, SEO, GEO, AEO, AIO, ürün yönetimi ve platform taşıma hizmetleri. Şeffaf fiyatlarla tek merkez.',
};
const alternates = [
  { lang: 'tr-TR', href: '/' },
  { lang: 'en', href: '/en/' },
];
const faqItems = [
  { q: 'Google’da nasıl çıkarım?', a: 'Sitenin taranabilir ve indekslenebilir olması, doğru hizmet ve ürün sayfaları, arama niyetine uygun içerik, teknik SEO, iç bağlantılar, yapılandırılmış veri ve güven sinyallerinin birlikte çalışması gerekir.' },
  { q: 'ChatGPT’de firmam nasıl görünür?', a: 'Tek bir ayar veya garanti yoktur. Marka ve hizmet bilgilerinin açık, doğrulanabilir ve tutarlı olması; özgün içerik, güçlü entity sinyalleri, kaynak niteliğinde sayfalar ve teknik erişilebilirlik önemlidir.' },
  { q: 'SEO yaptırmak istiyorum. Nereden başlamalıyım?', a: 'İlk adım mevcut sitenin teknik durumunu, görünmek istediğiniz sorguları ve ticari hedefinizi belirlemektir. Analiz sonrası teknik SEO, içerik, hız ve sayfa mimarisi çalışmalarından gerçekten gerekenler seçilir.' },
  { q: 'Web sitem neden Google’da çıkmıyor?', a: 'İndeksleme sorunları, zayıf içerik, yanlış sayfa yapısı, düşük teknik kalite, yetersiz iç bağlantı, yeni alan adı veya yüksek rekabet neden olabilir. Search Console ve teknik yapı birlikte kontrol edilmelidir.' },
  { q: 'Fiyat hesaplayıcıdaki tutar kesin fiyat mı?', a: 'Hayır. Gösterilen tutarlar standart kapsam için başlangıç fiyatıdır. Özel entegrasyon, yoğun varyant yapısı veya standart dışı geliştirme varsa kapsam ayrıca netleştirilir.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://qctcommerce.com/#faq',
  url: 'https://qctcommerce.com/',
  inLanguage: 'tr-TR',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout title={seo.title} description={seo.description} image="/og-commerce-1200x630.jpg" imageWidth={1200} imageHeight={630} lang={lang} isHome={true} includeWorkStyles={false} alternates={alternates}>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header slot="header" lang={lang} />
  <link rel="stylesheet" href="/styles/qct-v2.css?v=20260921-4" />
  <QctCommerceV2 />
  <Footer slot="footer" lang={lang} />
</BaseLayout>
