---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import Services from '../components/Services.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Process from '../components/Process.astro';
import FinalCta from '../components/FinalCta.astro';
import Contact from '../components/Contact.astro';
import { getPageSeo } from '../i18n/seo';

interface Props {
  lang: string;
}
const { lang } = Astro.props;

const seo = getPageSeo('home');
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} isHome={true} includeWorkStyles={true}>
<Header slot="header" lang={lang} />
<Hero lang={lang} />
<Problem lang={lang} />
<Services lang={lang} />
<SelectedWork />
<Process lang={lang} />
<FinalCta lang={lang} />
<Contact lang={lang} />
<Footer slot="footer" lang={lang} />
</BaseLayout>
