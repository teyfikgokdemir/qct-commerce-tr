---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ServicePage from './service/ServicePage.astro';
import { useTranslations } from '../i18n';
import { getPageSeo } from '../i18n/seo';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const seo = getPageSeo('whatsapp-commerce', lang);
---
<BaseLayout title={seo.title} lang={lang} description={seo.description} breadcrumbLabel={t('WhatsApp Commerce')} service={{ name: t('WhatsApp Commerce'), description: t('Many customers prefer to ask questions before they buy. We help businesses connect their website, ads and product pages with a clearer WhatsApp journey, making enquiries easier to answer and conversations easier to turn into customers.') }}>
  <Header slot="header" lang={lang} />
  <ServicePage
    lang={lang}
    eyebrow={t('WhatsApp Commerce')}
    title={t('Turn WhatsApp enquiries into a clearer sales process.')}
    lead={t('Many customers prefer to ask questions before they buy. We help businesses connect their website, ads and product pages with a clearer WhatsApp journey, making enquiries easier to answer and conversations easier to turn into customers.')}
    ctaPrimary={t('Start Your Project')}
    ctaSecondary={t('View Our Work')}
    problem={{
      eyebrow: t('PROBLEM'),
      title: t('WhatsApp can bring leads, but it can also create confusion.'),
      intro: [t('When every customer conversation starts in a different place, important details get lost.')],
      items: [
        { title: t('Product questions repeat every day.'), text: t('Customers ask about prices, availability, delivery and details that should already be easy to find.') },
        { title: t('Good leads can be missed.'), text: t('Messages arrive while teams are busy, and promising enquiries can disappear inside long chat lists.') },
        { title: t('The buying path feels unclear.'), text: t('If customers move from ads to website to WhatsApp without structure, the conversation takes longer than it should.') },
      ],
    }}
    benefits={{
      eyebrow: t('BENEFITS'),
      title: t('A better WhatsApp flow makes conversations easier to manage.'),
      lead: t('The goal is not to replace personal communication. The goal is to support it with a clearer path before and after the message.'),
      items: [
        { title: t('Clear entry points'), text: t('Website pages, product sections and ads can guide customers into the right conversation from the start.') },
        { title: t('Better prepared enquiries'), text: t('Customers arrive with more context, making it easier for your team to answer and move the conversation forward.') },
        { title: t('Less friction before contact'), text: t('Clear information and direct WhatsApp actions help people ask the right question at the right moment.') },
      ],
    }}
    included={{
      eyebrow: t('WHAT YOU GET'),
      title: t("What's included"),
      lead: t('Every WhatsApp Commerce setup is planned around clarity, response flow and practical business use.'),
      items: [
        { title: t('WhatsApp-ready website paths'), text: t('Key pages and calls to action prepared to send customers into the right conversation.') },
        { title: t('Product enquiry structure'), text: t('Product and service sections organised so customers ask with better context.') },
        { title: t('Click-to-chat actions'), text: t('Clear WhatsApp buttons placed where customers are most likely to need help.') },
        { title: t('Ad-to-WhatsApp flow'), text: t('Landing pages and campaign paths prepared for smoother message-based enquiries.') },
        { title: t('Conversation support content'), text: t('Helpful page content that reduces repeated questions before the chat begins.') },
        { title: t('Mobile-first experience'), text: t('A smooth journey for customers moving from phone browsing to WhatsApp messaging.') },
      ],
    }}
    process={{
      eyebrow: t('PROCESS'),
      title: t('A practical process from first click to conversation.'),
      steps: [
        { number: '01', title: t('Understand the enquiry flow'), text: t('We review where customers currently ask questions and where leads are being lost.') },
        { number: '02', title: t('Plan the customer path'), text: t('We map how people move from ads, website pages and product sections into WhatsApp.') },
        { number: '03', title: t('Build the experience'), text: t('We prepare the pages, buttons and message paths that make contact easier.') },
        { number: '04', title: t('Launch and improve'), text: t('After launch, we review the flow and identify what should be refined next.') },
      ],
    }}
    faq={{
      eyebrow: t('FAQ'),
      title: t('Questions we hear most often.'),
      items: [
        { q: t('Is WhatsApp Commerce only for online stores?'), a: t('No. It can support product businesses, service companies, clinics, showrooms and any business that receives customer questions through WhatsApp.') },
        { q: t('Do customers need to install anything new?'), a: t('No. Customers use WhatsApp as they normally would.') },
        { q: t('Can this work with ads?'), a: `${t('Yes.')} ${t('We can prepare landing pages and click-to-WhatsApp paths for campaigns.')}` },
        { q: t('Will it replace our team?'), a: t('No. The goal is to make conversations clearer, not remove the human side of customer communication.') },
        { q: t('Can this connect with a website?'), a: `${t('Yes.')} ${t('The best results usually come when the website, product information and WhatsApp actions are planned together.')}` },
      ],
    }}
    final={{
      eyebrow: t('READY WHEN YOU ARE'),
      title: t('Make WhatsApp easier for customers and your team.'),
      text: t('If customers already contact you through WhatsApp, we can help make that journey clearer, faster and easier to manage.'),
      cta: t("Let's Talk"),
    }}
  />
  <Footer slot="footer" lang={lang} />
</BaseLayout>
