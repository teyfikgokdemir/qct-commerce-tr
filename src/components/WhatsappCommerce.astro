---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ServicePage from './service/ServicePage.astro';
import { getPageSeo } from '../i18n/seo';
interface Props { lang: string; }
const { lang } = Astro.props;
const seo = getPageSeo('whatsapp-commerce');
const d = 'Üreticiler, toptancılar, ihracatçılar, perakende markaları ve büyüyen KOBİ’ler için web sitesi, ürün sayfası ve reklamdan başlayan müşteri taleplerini bağlamlı, ölçülebilir ve ekip kontrolündeki WhatsApp satış akışlarına dönüştürüyoruz.';
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="B2B WhatsApp satış sistemleri" service={{ name: 'B2B WhatsApp satış sistemleri', description: d }}>
<Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="B2B WHATSAPP SATIŞ SİSTEMLERİ" title="WhatsApp mesajlarını dağınık konuşmalardan yönetilebilir bir satış sürecine dönüştürün." lead={d} ctaPrimary="WhatsApp satış akışımızı değerlendirelim" ctaSecondary="Tüm hizmetler"
problem={{eyebrow:'KİMLER İÇİN UYGUN?',title:'Müşterisi satın almadan önce soru soran, teklif isteyen veya insan desteğine ihtiyaç duyan işletmeler için.',intro:['WhatsApp özellikle Türkiye’de güçlü bir iletişim kanalıdır; fakat mesaj sayısının artması tek başına satış sistemi kurulduğu anlamına gelmez. Talebin kaynağı, konusu, sorumlusu ve sonraki adımı görünmüyorsa ekip daha fazla çalışırken fırsatlar yine kaybolabilir.'],items:[{title:'Üreticiler ve ihracatçılar',text:'Ürün, teknik özellik, numune, fiyat, distribütörlük veya ihracat talebi alan; mesajları doğru satış sorumlusuna yönlendirmek isteyen işletmeler için.'},{title:'Toptancılar ve distribütörler',text:'Stok, koli, minimum sipariş, bayi fiyatı ve teslimat sorularını tekrar tekrar yanıtlayan ekipler için.'},{title:'Perakende ve büyüyen markalar',text:'Reklam, ürün sayfası ve kampanyalardan gelen yoğun mesajları daha hızlı yanıtlamak ve satış sonucunu izlemek isteyen markalar için.'}]}}
benefits={{eyebrow:'ÇÖZDÜĞÜ İŞ PROBLEMLERİ',title:'Mesaj çokluğu değil, bağlam ve takip eksikliği satış kaybettirir.',lead:'Müşteri hangi ürün veya kampanyadan geldiğini tekrar anlatmak zorunda kalıyorsa, görüşmeler kişisel telefonlarda kalıyorsa veya ekip kimin ilgileneceğini bilmiyorsa WhatsApp operasyonu büyümeyi yavaşlatır.',items:[{title:'Talep kaynağının kaybolması',text:'Mesajın hangi ürün, reklam, sayfa veya ülkeden geldiği bilinmediğinde doğru yanıt gecikir.'},{title:'Tekrarlayan manuel yanıtlar',text:'Fiyat, teslimat, stok, teknik bilgi ve minimum sipariş gibi sorular ekibin zamanını tekrar tekrar tüketir.'},{title:'Yanlış kişiye yönlendirme',text:'Satış, destek, ihracat ve bayi talepleri aynı hatta toplandığında müşterinin çözüm süresi uzar.'},{title:'Takip edilmeyen görüşmeler',text:'Teklif gönderildikten sonra kimin, ne zaman ve hangi bilgiyle geri döneceği net değilse sıcak fırsatlar soğur.'},{title:'Ölçülemeyen kanal performansı',text:'WhatsApp tıklaması ile gerçek görüşme, teklif ve satış arasındaki ilişki kurulamaz.'},{title:'Kontrolsüz otomasyon',text:'Bağlamı anlamadan verilen otomatik cevaplar müşteriyi hızlandırmak yerine güven kaybı yaratabilir.'}]}}
included={{eyebrow:'QCT COMMERCE YAKLAŞIMI',title:'Amacımız otomatik mesaj yığını kurmak değil; doğru talebi doğru bilgi ve doğru kişiye taşımaktır.',lead:'Web sitesi, reklam, ürün verisi, hazır mesaj, ekip yönlendirmesi ve ölçüm yapısını birlikte ele alırız. İnsan kontrolünü korur, yalnızca kuralları açık ve tekrar eden adımları otomatikleştiririz.',items:[{title:'Bağlamlı WhatsApp bağlantıları',text:'Ürün, kategori, kampanya, dil veya talep türü hazır mesaja güvenli biçimde taşınır.'},{title:'Talep sınıflandırma',text:'Satış, teklif, numune, bayi, ihracat, destek ve teslimat gibi konu başlıkları ayrıştırılır.'},{title:'Ekip yönlendirme kuralları',text:'Talep bölge, ürün grubu, dil, müşteri tipi veya önceliğe göre doğru kişiye devredilir.'},{title:'Hazır yanıt ve bilgi akışları',text:'Sık sorular için tutarlı cevaplar, kataloglar, ürün bağlantıları ve gerekli belgeler kolay erişilebilir hale getirilir.'},{title:'Takip ve hatırlatma sistemi',text:'Teklif sonrası geri dönüş, eksik bilgi ve bekleyen görüşmeler için kontrollü takip adımları planlanır.'},{title:'Dönüşüm ölçümü',text:'Web, reklam ve WhatsApp tıklamaları izinli analitik yapısında izlenerek hangi kaynağın nitelikli talep ürettiği değerlendirilir.'}]}}
process={{eyebrow:'8 ADIMLI SÜREÇ',title:'Mevcut mesajlaşma düzeninden ölçülebilir satış akışına.',steps:[{number:'01',title:'Talep kaynaklarını çıkarma',text:'Web sitesi, reklam, sosyal medya, ürün sayfası, telefon ve mevcut WhatsApp hatlarından gelen talepleri belirleriz.'},{number:'02',title:'Müşteri sorularını analiz etme',text:'Tekrarlayan soruları, eksik bilgileri, yanıt gecikmelerini ve en sık kaybolan fırsatları inceleriz.'},{number:'03',title:'Ekip ve sorumluluk haritası',text:'Satış, destek, ihracat, bayi ve operasyon rollerini; devir ve onay noktalarını netleştiririz.'},{number:'04',title:'Mesaj ve yönlendirme tasarımı',text:'Hazır mesajları, konu seçimlerini, ürün bağlamını ve doğru kişiye yönlendirme kurallarını planlarız.'},{number:'05',title:'Web ve reklam bağlantıları',text:'CTA’ları, ürün sayfalarını, landing page’leri ve kampanya bağlantılarını ilgili WhatsApp akışlarına bağlarız.'},{number:'06',title:'Ölçüm ve kayıt altyapısı',text:'Tıklama, kaynak, talep türü ve mümkün olan takip adımlarını KVKK ve izin koşulları gözetilerek yapılandırırız.'},{number:'07',title:'Gerçek senaryo testleri',text:'Farklı ürün, cihaz, dil, ekip ve yoğunluk senaryolarında mesaj bağlamını ve yönlendirmeyi doğrularız.'},{number:'08',title:'Ekip kullanımı ve iyileştirme',text:'Kullanım kurallarını netleştirir, ilk veriler ve ekip geri bildirimleriyle darboğazları iyileştiririz.'}]}}
answers={{title:'Temel yetkinlikler ve işletmeye etkileri',lead:'Düzenli bir WhatsApp satış sistemi, müşterinin daha hızlı anlaşılmasını ve ekibin daha az tekrar ederek daha iyi takip yapmasını sağlar.',items:[{question:'Bağlamlı başlangıç ne sağlar?',answer:'Müşteri hangi ürün, kampanya veya taleple geldiğini yeniden anlatmadan görüşmeye başlar; ekip daha kısa sürede doğru yanıt verebilir.'},{question:'Yönlendirme kuralları iş yükünü nasıl etkiler?',answer:'Her mesajın tek bir kişiye düşmesi yerine konu, dil, bölge veya müşteri tipine göre doğru sorumluya gitmesini sağlar.'},{question:'Hazır yanıtlar otomatik bot anlamına mı gelir?',answer:'Hayır. Hazır yanıt, ekibin tutarlı ve hızlı bilgi paylaşmasına yardım eder. Kritik satış konuşmaları ve kararlar insan kontrolünde kalır.'},{question:'Ölçüm neyi gösterir?',answer:'Hangi sayfa, ürün veya reklamın WhatsApp talebi ürettiğini ve hangi akışların daha nitelikli görüşmeye dönüştüğünü görmeye yardımcı olur.'},{question:'Takip sistemi ticari sonucu nasıl destekler?',answer:'Teklif sonrası unutulan görüşmeleri, eksik bilgi bekleyen müşterileri ve geri dönüş zamanı yaklaşan fırsatları görünür hale getirir.'}]}}
relatedLinks={[{title:'E-ticaret çözümleri',text:'Ürün ilgisini sepet, sipariş veya teklif akışıyla tamamlayın.',href:'/e-ticaret/'},{title:'Meta reklamları ve landing page',text:'Reklamdan WhatsApp’a geçen talebin kampanya bağlamını koruyun.',href:'/meta-reklamlari/'},{title:'Yapay zekâ otomasyonları',text:'Talep sınıflandırma, özetleme ve ekip devri gibi tekrar eden adımları kontrollü biçimde geliştirin.',href:'/yapay-zeka-otomasyonlari/'},{title:'Web tasarım',text:'Ziyaretçiyi doğru ürün, bilgi ve iletişim akışına yönlendiren web temelini kurun.',href:'/web-tasarim/'}]}
faq={{eyebrow:'SIK SORULANLAR',title:'B2B WhatsApp satış sistemleri hakkında',items:[{q:'Mevcut WhatsApp numaramızı kullanabilir miyiz?',a:'Mevcut hesap türü, ekip kullanımı, entegrasyon ihtiyacı ve platform koşulları incelenerek uygun kullanım şekli belirlenir.'},{q:'WhatsApp Business yeterli olur mu?',a:'Küçük ekiplerde temel kullanım için yeterli olabilir. Çoklu ekip, yönlendirme, kayıt veya entegrasyon ihtiyacında farklı bir yapı gerekebilir.'},{q:'Her mesaj otomatik yanıtlanır mı?',a:'Hayır. Yalnızca açık kurallı ve düşük riskli adımlar otomatikleştirilir; önemli satış ve müşteri kararları ekip kontrolünde kalır.'},{q:'Reklamlardan WhatsApp’a yönlendirme yapabilir miyiz?',a:'Evet. Reklam, landing page, ürün veya kampanya bağlamı hazır mesaja taşınabilir ve uygun ölçüm olayları kurulabilir.'},{q:'Ürün bazlı hazır mesaj oluşturulabilir mi?',a:'Evet. Ürün adı, kodu, sayfa bağlantısı veya talep türü mesaja eklenerek müşterinin hangi ürünle ilgilendiği korunabilir.'},{q:'Birden fazla satış temsilcisine yönlendirme yapılabilir mi?',a:'Kullanılan araçların izin verdiği ölçüde bölge, ürün, dil, çalışma saati veya konuya göre yönlendirme kuralları tasarlanabilir.'},{q:'WhatsApp üzerinden teklif süreci kurulabilir mi?',a:'Teklif talebinde gerekli bilgilerin toplanması, doğru kişiye aktarılması ve takip adımları planlanabilir; teklif onayı ekip tarafından yürütülür.'},{q:'CRM entegrasyonu yapılabilir mi?',a:'Mevcut CRM’in API, güvenlik ve veri modeli uygunsa talep ve görüşme bilgilerinin aktarımı değerlendirilebilir.'},{q:'WhatsApp satış sistemi KVKK açısından uygun mu?',a:'Veri minimizasyonu, açık bilgilendirme, gerekli izinler, saklama süresi ve kullanılan üçüncü taraf araçların koşulları proje kapsamında değerlendirilmelidir.'},{q:'Müşterilere toplu mesaj gönderiyor musunuz?',a:'İzinsiz veya platform kurallarına aykırı toplu mesajlaşma kurmuyoruz. İletişim izinleri ve WhatsApp politikaları gözetilir.'},{q:'Sistem satış garantisi verir mi?',a:'Hayır. Sistem yanıt hızını, bağlamı ve takibi iyileştirir; sonuç teklif, fiyat, ekip performansı ve pazar koşullarına da bağlıdır.'},{q:'Kurulumdan sonra ekip eğitimi veriliyor mu?',a:'Kapsama göre ekip rollerini, hazır yanıt kullanımını, devir kurallarını ve takip adımlarını anlatan kısa operasyon rehberi hazırlanabilir.'},{q:'Web sitesi olmadan kurulabilir mi?',a:'Bazı akışlar kurulabilir; ancak ürün, teklif ve kaynak bağlamını düzenli taşımak için web sitesi veya landing page güçlü bir temel sağlar.'}]}}
final={{title:'WhatsApp’ı yalnızca mesaj alınan bir kanal olmaktan çıkarıp yönetilebilir bir satış akışına dönüştürün.',text:'Mevcut mesaj düzeninizi, ekip yapınızı ve en sık kaybolan fırsatı paylaşın; uygun başlangıç kapsamını birlikte belirleyelim.',cta:'WhatsApp satış akışımızı inceleyelim',ctaSecondary:'E-posta gönderin'}}/><Footer slot="footer" lang={lang}/></BaseLayout>