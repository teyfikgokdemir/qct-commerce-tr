---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import ServicePage from './service/ServicePage.astro'; import {getPageSeo} from '../i18n/seo'; interface Props{lang:string} const{lang}=Astro.props; const seo=getPageSeo('whatsapp-commerce'); const d='Web sitesi, ürün sayfaları ve reklamları düzenli WhatsApp satış görüşmelerine bağlayan sistemler kuruyoruz.';
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="WhatsApp satış sistemleri" service={{name:'WhatsApp satış sistemleri',description:d}}><Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="WhatsApp satış sistemleri" title="Müşteri mesajlarını takip edilebilir bir satış akışına dönüştürün." lead={d} ctaPrimary="Satış akışınızı konuşalım" ctaSecondary="Tüm hizmetler"
problem={{eyebrow:'SORUN',title:'Mesaj çok, bağlam az olduğunda satış fırsatları kaybolur.',intro:['Müşterinin hangi ürün veya kampanyadan geldiği bilinmediğinde yanıtlar yavaşlar ve takip zorlaşır.'],items:[{title:'Kaynak belirsizliği',text:'Mesajın hangi ürün, sayfa veya reklamdan geldiği kaybolur.'},{title:'Tekrarlayan sorular',text:'Ekip aynı bilgileri tekrar tekrar elle paylaşır.'},{title:'Takip kopukluğu',text:'Görüşmelerin sonraki adımı ve sorumlusu netleşmez.'}]}}
benefits={{eyebrow:'ÇÖZÜM',title:'Doğru bağlamla başlayan daha düzenli görüşmeler.',lead:'Amaç otomatik mesaj yığını oluşturmak değil, müşteriyi doğru bilgi ve doğru kişiye taşımaktır.',items:[{title:'Bağlamlı başlangıç',text:'Ürün veya kampanya bilgisi mesaja eklenir.'},{title:'Hızlı yönlendirme',text:'Sık sorular ve ekip devirleri için açık akışlar kurulur.'},{title:'Ölçülebilir temas',text:'WhatsApp tıklamaları ve kritik adımlar izlenebilir.'}]}}
included={{eyebrow:'KAPSAM',title:'WhatsApp satış sistemi kapsamında',lead:'İşletmenizin satış düzenine göre yapılandırılır.',items:[{title:'Tıklama akışları',text:'Sayfa ve reklamdan WhatsApp’a geçiş.'},{title:'Hazır mesaj bağlamı',text:'Ürün ve talep bilgisinin taşınması.'},{title:'Yönlendirme kuralları',text:'Doğru ekip veya sürece devir.'},{title:'Takip senaryoları',text:'Görüşme sonrası adımlar.'},{title:'Ölçüm',text:'Tıklama ve dönüşüm olayları.'},{title:'Operasyon rehberi',text:'Ekibin kullanacağı net akış.'}]}}
process={{eyebrow:'SÜREÇ',title:'Mesajlaşmayı satış sürecine bağlarız.',steps:[{number:'01',title:'Akış analizi',text:'Müşteri sorularını ve ekip düzenini inceleriz.'},{number:'02',title:'Senaryo tasarımı',text:'Kaynak, mesaj ve yönlendirme adımlarını planlarız.'},{number:'03',title:'Kurulum',text:'Bağlantıları, mesajları ve ölçümü uygularız.'},{number:'04',title:'Test',text:'Gerçek kullanım senaryolarıyla akışı doğrularız.'}]}}
answers={{title:'WhatsApp satış sistemi nasıl değerlendirilir?',lead:'WhatsApp satış sistemi, mesaj sayısını artırmaktan çok talebin kaynağını ve sonraki adımını görünür kılmayı amaçlar.',items:[{question:'WhatsApp satış sistemi nedir?',answer:'Web sitesi, ürün veya reklamdan başlayan görüşmeyi hazır bağlam, ekip yönlendirmesi ve takip adımlarıyla düzenleyen mesajlaşma akışıdır.'},{question:'Kimler için uygundur?',answer:'Müşterileri satın alma öncesinde soru soran, teklif isteyen veya ekip desteğine ihtiyaç duyan işletmeler için uygundur.'},{question:'Ne zaman gerekir?',answer:'Mesaj kaynağı kaybolduğunda, yanıtlar tekrara düştüğünde veya görüşmelerin sorumlusu ve sonucu izlenemediğinde gerekir.'},{question:'Nasıl ilerler?',answer:'Talep kaynakları ve ekip rolleri çıkarılır; mesaj bağlamı, yönlendirme, ölçüm ve insan kontrolünde takip senaryoları kurulur.'}]}}
relatedLinks={[{title:'E-ticaret altyapısı',text:'Ürün ilgisini düzenli satın alma akışına bağlayın.',href:'/e-ticaret/'},{title:'Meta reklamları',text:'Reklamdan başlayan WhatsApp görüşmesinin bağlamını koruyun.',href:'/meta-reklamlari/'},{title:'Yapay zekâ otomasyonları',text:'Tekrarlayan sınıflandırma ve ekip devri adımlarını değerlendirin.',href:'/yapay-zeka-otomasyonlari/'}]}
faq={{eyebrow:'SIK SORULANLAR',title:'WhatsApp satış hakkında',items:[{q:'Mevcut WhatsApp numaramızı kullanabilir miyiz?',a:'Uygunluk, mevcut hesap yapısı ve ihtiyaç duyulan entegrasyonlara göre değerlendirilir.'},{q:'Her mesaj otomatik mi yanıtlanır?',a:'Hayır. Otomasyon yalnızca gerekli noktalarda kullanılır; önemli kararlar ve görüşmeler ekip kontrolünde kalır.'},{q:'Reklamlardan WhatsApp’a yönlendirme yapılabilir mi?',a:'Evet. Kampanya, landing page ve hazır mesaj bağlamı birlikte planlanabilir.'}]}}
final={{title:'WhatsApp görüşmelerinizi daha düzenli bir satış kanalına dönüştürün.',text:'Mevcut akışınızı ve ekip ihtiyaçlarınızı konuşalım.',cta:'İletişime geçin',ctaSecondary:'E-posta gönderin'}}/><Footer slot="footer" lang={lang}/></BaseLayout>
