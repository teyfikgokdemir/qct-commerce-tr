---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import LegalPage from './service/LegalPage.astro'; interface Props{lang:string} const{lang}=Astro.props;
const title='Gizlilik Politikası — QCT Commerce'; const description='QCT Commerce web sitesi üzerinden iletilen kişisel verilerin nasıl ele alındığını açıklayan gizlilik politikası.';
---
<BaseLayout title={title} description={description} lang={lang} breadcrumbLabel="Gizlilik politikası"><Header slot="header" lang={lang}/><LegalPage lang={lang} eyebrow="YASAL" title="Gizlilik politikası" lead="Türkiye pazarına yönelik web sitesi ziyaretleri ve iletişim talepleri kapsamında alınabilecek bilgilerin kullanımını açıklar." lastUpdated="19 Temmuz 2026"
sections={[{id:'alinabilecek-bilgiler',title:'Alınabilecek bilgiler',text:'E-posta veya WhatsApp ile gönderdiğiniz iletişim bilgileri, proje talebi ayrıntıları ve analiz çerezlerine izin vermeniz halinde temel site kullanım bilgileri işlenebilir.'},{id:'kullanim-amaci',title:'Kullanım amacı',text:'Bilgiler taleplere yanıt vermek, proje ihtiyacını anlamak, iletişimi sürdürmek, güvenliği sağlamak ve izin verilen analiz verileriyle siteyi geliştirmek için kullanılabilir.'},{id:'paylasim',title:'Hizmet sağlayıcılar',text:'Barındırma, e-posta, analiz veya iletişim hizmeti sağlayıcıları yalnızca ilgili hizmeti sunmak için gereken sınırlı verileri işleyebilir.'},{id:'saklama',title:'Saklama ve güvenlik',text:'İletişim kayıtları talebin takibi, proje süreci veya olağan yasal yükümlülükler için gerekli olduğu sürece tutulur; makul teknik ve idari önlemler uygulanır.'},{id:'haklar',title:'Haklarınız',text:'Uygulanabilir mevzuat kapsamında kişisel verileriniz hakkında bilgi, düzeltme veya silme talebinde bulunabilirsiniz.'},{id:'iletisim',title:'İletişim',text:'Gizlilikle ilgili sorularınızı info@qctcommerce.com adresine gönderebilirsiniz.'}]}
faqTitle="Sık sorulan sorular" faqItems={[{q:'İletişim bilgileri pazarlama amacıyla kullanılır mı?',a:'Talep bilgileriniz, açık izniniz olmadan ilgisiz pazarlama çalışmaları için kullanılmaz.'},{q:'Analiz çerezleri zorunlu mu?',a:'Hayır. İsteğe bağlı analiz yalnızca çerez banner’ında izin vermeniz halinde etkinleşir.'},{q:'Verilerimle ilgili nasıl talepte bulunabilirim?',a:'info@qctcommerce.com adresine e-posta gönderebilirsiniz.'}]}/><Footer slot="footer" lang={lang}/></BaseLayout>
