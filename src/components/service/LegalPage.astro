---
import { useTranslations, getHomeUrl } from '../../i18n';

interface Section {
  id: string;
  title: string;
  text: string;
}
interface Faq {
  q: string;
  a: string;
}
interface Props {
  lang: string;
  eyebrow: string;
  title: string;
  lead: string;
  lastUpdated: string;
  sections: Section[];
  faqTitle: string;
  faqItems: Faq[];
}

const { lang, eyebrow, title, lead, lastUpdated, sections, faqTitle, faqItems } = Astro.props;
const t = useTranslations(lang);
const homeUrl = getHomeUrl(lang);
---
<section class="qct-legal-hero">
  <div class="container">
    <nav class="qct-breadcrumb" aria-label="Breadcrumb">
      <a href={homeUrl}>{t('Home')}</a>
      <span aria-hidden="true">/</span>
      <span>{title}</span>
    </nav>
    <p class="qct-section__eyebrow">{eyebrow}</p>
    <h1 class="qct-legal-hero__title">{title}</h1>
    <p class="qct-section__lead">{lead}</p>
    <div class="qct-legal-meta">
      <span>{t('Last updated:')} {lastUpdated}</span>
    </div>
  </div>
</section>

<section class="qct-legal-body">
  <div class="container qct-legal-layout">
    <aside class="qct-legal-toc" aria-labelledby="qct-legal-toc-title">
      <h2 id="qct-legal-toc-title">{t('On this page')}</h2>
      <nav>
        {sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
        <a href="#faq">{faqTitle}</a>
      </nav>
    </aside>

    <article class="qct-legal-content">
      {sections.map((s) => (
        <section id={s.id} class="qct-legal-card">
          <h2>{s.title}</h2>
          <p>{s.text}</p>
        </section>
      ))}

      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      })} />

      <section id="faq" class="qct-legal-card">
        <h2>{faqTitle}</h2>
        <div class="qct-legal-faq">
          {faqItems.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    </article>
  </div>
</section>

<style>
.qct-legal-hero,
.qct-legal-body,
.qct-legal-hero *,
.qct-legal-body * {
  color: var(--qct-color-text, #17151a) !important;
}
.qct-legal-hero .qct-section__lead,
.qct-legal-card p,
.qct-legal-toc a {
  color: var(--qct-color-muted, #686268) !important;
}
.qct-legal-hero .qct-section__eyebrow,
.qct-breadcrumb a:hover,
.qct-legal-toc a:hover {
  color: var(--qct-color-accent, #e75757) !important;
}
.qct-breadcrumb {
  display: flex;
  gap: 0.5rem;
  font-size: 0.85rem;
  opacity: 0.85;
  margin-bottom: 1.5rem;
}
.qct-breadcrumb a {
  color: var(--qct-color-text, #17151a);
  text-decoration: none;
}
.qct-breadcrumb a:hover {
  color: var(--qct-color-accent, #e75757);
}
.qct-legal-hero {
  padding-block: var(--qct-hero-clearance, 6rem) 3rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.qct-legal-hero__title {
  font-size: clamp(2rem, 4vw, 2.75rem);
  line-height: 1.15;
  margin: 0.75rem 0 1.25rem;
}
.qct-section__eyebrow {
  color: var(--qct-color-accent, #e75757);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 0.75rem;
}
.qct-section__lead {
  opacity: 0.85;
  line-height: 1.6;
  max-width: 680px;
}
.qct-legal-meta {
  margin-top: 1.5rem;
  font-size: 0.85rem;
  opacity: 0.85;
}
.qct-legal-body {
  padding-block: 4rem;
}
.qct-legal-layout {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 3rem;
  align-items: start;
}
.qct-legal-toc {
  position: sticky;
  top: 2rem;
}
.qct-legal-toc h2 {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  opacity: 0.85;
  margin-bottom: 1rem;
}
.qct-legal-toc nav {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.qct-legal-toc a {
  color: var(--qct-color-text, #17151a);
  opacity: 0.85;
  text-decoration: none;
  font-size: 0.92rem;
}
.qct-legal-toc a:hover {
  color: var(--qct-color-accent, #e75757);
  opacity: 1;
}
.qct-legal-content {
  max-width: 760px;
}
.qct-legal-card {
  padding-block: 2rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.qct-legal-card:first-child {
  padding-top: 0;
}
.qct-legal-card h2 {
  font-size: 1.35rem;
  margin-bottom: 0.75rem;
}
.qct-legal-card p {
  opacity: 0.9;
  line-height: 1.65;
}
.qct-legal-faq {
  margin-top: 1rem;
}
.qct-legal-faq details {
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-block: 0.85rem;
}
.qct-legal-faq summary {
  cursor: pointer;
  font-weight: 600;
}
.qct-legal-faq p {
  opacity: 0.85;
  margin-top: 0.5rem;
  font-size: 0.92rem;
  line-height: 1.5;
}
@media (max-width: 820px) {
  .qct-legal-layout {
    grid-template-columns: 1fr;
  }
  .qct-legal-toc {
    position: static;
  }
}
</style>
