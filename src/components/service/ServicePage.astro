---
interface Item {
  title: string;
  text: string;
  href?: string;
}
interface Step {
  number: string;
  title: string;
  text: string;
}
interface Faq {
  q: string;
  a: string;
}
interface BrandRelationship {
  title: string;
  text: string;
  linkLabel: string;
  linkHref: string;
}
interface Props {
  lang: string;
  eyebrow: string;
  title: string;
  lead: string;
  ctaPrimary: string;
  ctaPrimaryHref?: string;
  ctaSecondary?: string;
  brandRelationship?: BrandRelationship;
  problem?: {
    eyebrow: string;
    title: string;
    intro: string[];
    items: Item[];
  };
  benefits: {
    eyebrow: string;
    title: string;
    lead: string;
    items: Item[];
  };
  included: {
    eyebrow: string;
    title: string;
    lead: string;
    items: Item[];
  };
  process: {
    eyebrow: string;
    title: string;
    steps: Step[];
  };
  answers?: {
    title: string;
    lead: string;
    items: { question: string; answer: string }[];
  };
  relatedLinks?: { title: string; text: string; href: string }[];
  faq: {
    eyebrow: string;
    title: string;
    items: Faq[];
  };
  final: {
    eyebrow?: string;
    title: string;
    text: string;
    cta: string;
    ctaHref?: string;
    ctaSecondary?: string;
  };
}

const {
  lang,
  eyebrow,
  title,
  lead,
  ctaPrimary,
  ctaPrimaryHref,
  ctaSecondary,
  brandRelationship,
  problem,
  benefits,
  included,
  process,
  answers,
  relatedLinks,
  faq,
  final,
} = Astro.props;

const homeUrl = '/';
const contactUrl = '/iletisim/';
const canonicalUrl = new URL(Astro.url.pathname, 'https://qctcommerce.com').toString();
const webpageId = `${canonicalUrl}#webpage`;
const faqId = `${canonicalUrl}#faq`;
---
<section class="qct-svc-hero">
  <div class="container">
    <nav class="qct-breadcrumb" aria-label="Sayfa yolu">
      <a href={homeUrl}>Ana sayfa</a>
      <span aria-hidden="true">/</span>
      <span>{eyebrow}</span>
    </nav>
    <p class="qct-section__eyebrow">{eyebrow}</p>
    <h1 class="qct-svc-hero__title">{title}</h1>
    <p class="qct-svc-hero__lead">{lead}</p>
    <div class="qct-svc-hero__actions">
      <a class="qct-btn qct-btn--primary" href={ctaPrimaryHref ?? contactUrl}>{ctaPrimary}</a>
      {ctaSecondary && <a class="qct-btn qct-btn--secondary" href="/hizmetler/">{ctaSecondary}</a>}
    </div>
  </div>
</section>

{brandRelationship && (
  <section class="qct-svc-brand" aria-labelledby="qct-brand-relationship-title">
    <div class="container qct-svc-brand__inner">
      <p class="qct-section__eyebrow">MARKA İLİŞKİSİ</p>
      <div class="qct-svc-brand__content">
        <h2 id="qct-brand-relationship-title">{brandRelationship.title}</h2>
        <div>
          <p>{brandRelationship.text}</p>
          <a href={brandRelationship.linkHref} rel="external noopener noreferrer">
            <span>{brandRelationship.linkLabel}</span>
            <span aria-hidden="true">↗</span>
            <span class="screen-reader-text"> (harici bağlantı)</span>
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<slot name="after-brand" />

{problem && (
  <section class="qct-section qct-svc-section">
    <div class="container">
      <div class="qct-section__header">
        <p class="qct-section__eyebrow">{problem.eyebrow}</p>
        <h2 class="qct-section__title">{problem.title}</h2>
        {problem.intro.map((p) => <p class="qct-section__lead">{p}</p>)}
      </div>
      <div class="qct-svc-grid">
        {problem.items.map((item) => (
          <article class="qct-svc-card">
            <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<section class="qct-section qct-svc-section">
  <div class="container">
    <div class="qct-section__header">
      {benefits.eyebrow && <p class="qct-section__eyebrow">{benefits.eyebrow}</p>}
      <h2 class="qct-section__title">{benefits.title}</h2>
      {benefits.lead && <p class="qct-section__lead">{benefits.lead}</p>}
    </div>
    {benefits.items.length > 0 && (
      <div class="qct-svc-grid">
        {benefits.items.map((item) => (
          <article class="qct-svc-card">
            <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<section class="qct-section qct-svc-section qct-svc-section--alt">
  <div class="container">
    <div class="qct-section__header">
      {included.eyebrow && <p class="qct-section__eyebrow">{included.eyebrow}</p>}
      <h2 class="qct-section__title">{included.title}</h2>
      {included.lead && <p class="qct-section__lead">{included.lead}</p>}
    </div>
    {included.items.length > 0 && (
      <div class="qct-svc-grid">
        {included.items.map((item) => (
          <article class="qct-svc-card">
            <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<section class="qct-section qct-svc-section">
  <div class="container">
    <div class="qct-section__header">
      {process.eyebrow && <p class="qct-section__eyebrow">{process.eyebrow}</p>}
      <h2 class="qct-section__title">{process.title}</h2>
    </div>
    <div class="qct-svc-timeline">
      {process.steps.map((step) => (
        <article class="qct-svc-step">
          <div class="qct-svc-step__heading">
            <span class="qct-svc-step__number">{step.number}</span>
            <h3>{step.title}</h3>
          </div>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{answers && (
  <section class="qct-section qct-svc-answers" aria-labelledby="qct-service-answers-title">
    <div class="container">
      <div class="qct-section__header">
        <p class="qct-section__eyebrow">KISA CEVAPLAR</p>
        <h2 id="qct-service-answers-title" class="qct-section__title">{answers.title}</h2>
        <p class="qct-section__lead">{answers.lead}</p>
      </div>
      <dl>
        {answers.items.map((item) => (
          <div><dt>{item.question}</dt><dd>{item.answer}</dd></div>
        ))}
      </dl>
    </div>
  </section>
)}

{relatedLinks && relatedLinks.length > 0 && (
  <section class="qct-section qct-svc-related" aria-labelledby="qct-related-title">
    <div class="container">
      <div class="qct-section__header">
        <p class="qct-section__eyebrow">İLGİLİ KONULAR</p>
        <h2 id="qct-related-title" class="qct-section__title">Bir sonraki adımı bağlamıyla inceleyin.</h2>
      </div>
      <div class="qct-svc-related__grid">
        {relatedLinks.map((item) => (
          <article><h3><a href={item.href}>{item.title}</a></h3><p>{item.text}</p></article>
        ))}
      </div>
    </div>
  </section>
)}

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': faqId,
  url: canonicalUrl,
  inLanguage: 'tr-TR',
  isPartOf: { '@id': webpageId },
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
})} />

<section class="qct-section qct-svc-section qct-svc-section--alt">
  <div class="container">
    <div class="qct-section__header">
      {faq.eyebrow && <p class="qct-section__eyebrow">{faq.eyebrow}</p>}
      <h2 class="qct-section__title">{faq.title}</h2>
    </div>
    <div class="qct-svc-faq">
      {faq.items.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="qct-section qct-svc-final">
  <div class="container qct-svc-final__panel">
    {final.eyebrow && <p class="qct-section__eyebrow">{final.eyebrow}</p>}
    <h2 class="qct-section__title">{final.title}</h2>
    <p class="qct-section__lead">{final.text}</p>
    <div class="qct-svc-hero__actions">
      <a class="qct-btn qct-btn--primary" href={final.ctaHref ?? contactUrl}>{final.cta}</a>
      {final.ctaSecondary && <a class="qct-btn qct-btn--secondary" href="mailto:info@qctcommerce.com">{final.ctaSecondary}</a>}
    </div>
  </div>
</section>

<style>
.qct-svc-hero,
.qct-svc-section,
.qct-svc-hero *,
.qct-svc-section * {
  color: var(--qct-color-text, #17151a) !important;
}
.qct-svc-hero .qct-section__lead,
.qct-svc-section .qct-section__lead,
.qct-svc-card p,
.qct-svc-step p,
.qct-svc-faq p {
  color: var(--qct-color-muted, #686268) !important;
}
.qct-svc-hero .qct-section__eyebrow,
.qct-svc-section .qct-section__eyebrow {
  color: var(--qct-color-accent-strong, #b9473e) !important;
}
.qct-breadcrumb { display: flex; gap: .5rem; font-size: .85rem; margin-bottom: 1.5rem; }
.qct-breadcrumb a { color: var(--qct-color-text, #17151a); text-decoration: none; }
.qct-breadcrumb a:hover { color: var(--qct-color-accent-strong, #b9473e); }
.qct-svc-hero { padding-block: var(--qct-hero-clearance, 6rem) 3rem; border-bottom: 1px solid rgba(23, 21, 26, .08); }
.qct-svc-hero__title { font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.15; max-width: 820px; margin: .75rem 0 1.25rem; }
.qct-svc-hero__lead { color: var(--qct-color-muted, #686268); font-size: 1.1rem; line-height: 1.6; max-width: 680px; margin-bottom: 2rem; }
.qct-svc-hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
.qct-section__eyebrow { color: var(--qct-color-accent-strong, #b9473e); font-size: .85rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; margin-bottom: .75rem; }
.qct-section__title { font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.2; margin-bottom: 1rem; }
.qct-section__lead { line-height: 1.6; max-width: 720px; }
.qct-section__header { max-width: 720px; margin-bottom: clamp(2.25rem, 5vw, 3.5rem); }
.qct-svc-section { padding-block: var(--qct-home-section-space, 5rem); }
.qct-svc-section--alt { background: linear-gradient(180deg, rgba(239, 230, 225, .52), rgba(248, 243, 239, .3)); border-block: 1px solid rgba(23, 21, 26, .07); }

.qct-svc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
  gap: clamp(1rem, 2.5vw, 1.75rem);
  align-items: stretch;
}
.qct-svc-card,
.qct-svc-step,
.qct-svc-answers dl > div,
.qct-svc-related__grid article {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border: 1px solid rgba(73, 53, 49, .12);
  border-radius: clamp(18px, 2vw, 24px);
  background: linear-gradient(145deg, rgba(255,255,255,.96), rgba(250,246,243,.9));
  box-shadow: 0 18px 50px rgba(58, 37, 32, .07), 0 2px 8px rgba(58, 37, 32, .04);
  transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
}
.qct-svc-card::before,
.qct-svc-step::before,
.qct-svc-answers dl > div::before,
.qct-svc-related__grid article::before {
  content: '';
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, var(--qct-color-accent, #e66b5f), rgba(230,107,95,.12));
  z-index: -1;
}
.qct-svc-card:hover,
.qct-svc-step:hover,
.qct-svc-answers dl > div:hover,
.qct-svc-related__grid article:hover {
  transform: translateY(-5px);
  border-color: rgba(185, 71, 62, .28);
  box-shadow: 0 26px 60px rgba(58, 37, 32, .11), 0 6px 16px rgba(58, 37, 32, .06);
}
.qct-svc-card { min-height: 220px; padding: clamp(1.6rem, 3vw, 2.2rem); }
.qct-svc-card h3 { font-size: clamp(1.08rem, 1.8vw, 1.22rem); line-height: 1.35; margin: 0 0 .8rem; }
.qct-svc-card h3 a,
.qct-svc-related__grid a { color: var(--qct-color-ink, #211c1d); text-decoration-color: rgba(185,71,62,.45); text-underline-offset: .22em; }
.qct-svc-card h3 a:hover,
.qct-svc-related__grid a:hover { color: var(--qct-color-accent-strong, #b9473e); }
.qct-svc-card p { font-size: 1rem; line-height: 1.7; margin: 0; }

.qct-svc-timeline { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
.qct-svc-step { display: flex; flex-direction: column; min-width: 0; min-height: 260px; padding: clamp(1.5rem, 2.8vw, 2rem); }
.qct-svc-step__heading { display: grid; gap: 1rem; min-width: 0; }
.qct-svc-step__number { display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border: 1px solid rgba(185,71,62,.2); border-radius: 14px; background: rgba(230,107,95,.1); color: var(--qct-color-accent-strong, #b9473e); font-size: 1rem; font-weight: 800; }
.qct-svc-step h3 { font-size: 1.12rem; line-height: 1.35; margin: 0; }
.qct-svc-step p { font-size: 1rem; line-height: 1.65; margin: .9rem 0 0; }

.qct-svc-answers,
.qct-svc-related { padding-block: var(--qct-home-section-space, 5rem); background: var(--qct-color-background, #f8f3ef); }
.qct-svc-answers dl,
.qct-svc-related__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 1.75rem); margin: 0; }
.qct-svc-answers dl > div { min-width: 0; padding: clamp(1.6rem, 3vw, 2.25rem); }
.qct-svc-answers dt { color: var(--qct-color-ink, #211c1d); font-size: 1.08rem; font-weight: 750; line-height: 1.4; }
.qct-svc-answers dd { color: var(--qct-color-muted, #625457); font-size: 1rem; line-height: 1.7; margin: .8rem 0 0; }
.qct-svc-related { background: linear-gradient(180deg, var(--qct-color-surface, #efe6e1), var(--qct-color-background, #f8f3ef)); }
.qct-svc-related__grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
.qct-svc-related__grid article { min-width: 0; min-height: 190px; padding: clamp(1.5rem, 3vw, 2.1rem); }
.qct-svc-related__grid h3 { font-size: 1.1rem; line-height: 1.35; margin: 0 0 .7rem; }
.qct-svc-related__grid p { color: var(--qct-color-muted, #625457); font-size: 1rem; line-height: 1.65; margin: 0; }

.qct-svc-brand { background: var(--qct-color-surface, #efe6e1); border-bottom: 1px solid var(--qct-color-line, #d9cbc5); padding-block: clamp(3rem, 7vw, 5.5rem); }
.qct-svc-brand__content { border-top: 1px solid var(--qct-color-line-strong, #bfaea7); display: grid; gap: clamp(1.5rem, 4vw, 4rem); grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); padding-top: clamp(1.5rem, 3vw, 2.25rem); }
.qct-svc-brand__content h2 { color: var(--qct-color-ink, #211c1d); font-family: var(--qct-font-sans, sans-serif); font-size: clamp(1.65rem, 3vw, 2.6rem); line-height: 1.2; margin: 0; max-width: 21ch; }
.qct-svc-brand__content p { color: var(--qct-color-muted, #625457); font-size: 1rem; line-height: 1.7; margin: 0 0 1.25rem; }
.qct-svc-brand__content a { align-items: center; color: var(--qct-color-accent-strong, #b9473e); display: inline-flex; font-weight: 700; gap: .5rem; text-underline-offset: .25em; }
.qct-svc-brand__content a:focus-visible { outline: 2px solid var(--qct-color-accent-strong, #b9473e); outline-offset: 4px; }

.qct-svc-faq { border-top: 1px solid var(--qct-color-line-strong, #bfaea7); max-width: 780px; }
.qct-svc-faq details { border-bottom: 1px solid var(--qct-color-line, #ded2cc); padding: 0; }
.qct-svc-faq details summary { align-items: center; color: var(--qct-color-ink, #211c1d) !important; cursor: pointer; display: flex; font-size: 1.05rem; font-weight: 700; gap: 1rem; justify-content: space-between; line-height: 1.4; list-style: none; min-height: 64px; padding: 1rem 0; }
.qct-svc-faq details summary::-webkit-details-marker { display: none; }
.qct-svc-faq details summary::after { align-items: center; border: 1px solid var(--qct-color-line-strong, #bfaea7); color: var(--qct-color-accent-strong, #b9473e); content: '+'; display: inline-flex; flex: 0 0 28px; font-size: 1.25rem; font-weight: 500; height: 28px; justify-content: center; line-height: 1; width: 28px; }
.qct-svc-faq details[open] summary::after { content: '−'; }
.qct-svc-faq details summary:focus-visible { outline: 2px solid var(--qct-color-accent-strong, #b9473e); outline-offset: 4px; }
.qct-svc-faq p { font-size: 1rem; line-height: 1.65; margin: 0; max-width: 68ch; padding: 0 3.5rem 1.25rem 0; }

.qct-svc-final { border-top: 1px solid rgba(23,21,26,.08); }
.qct-svc-final__panel { text-align: center; max-width: 700px; margin: 0 auto; padding: 3rem 2rem; border: 1px solid rgba(23,21,26,.1); border-radius: 20px; background: rgba(255,255,255,.55); }
.qct-svc-final__panel .qct-section__lead { margin: 0 auto 2rem; }
.qct-svc-final .qct-svc-hero__actions { justify-content: center; }
.qct-btn { padding: .75rem 1.75rem; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: .95rem; }
.qct-btn--primary { background: var(--qct-color-accent, #e66b5f); color: #0d0d0d; }
.qct-btn--secondary { border: 1px solid rgba(23,21,26,.2); color: var(--qct-color-text, #17151a); }

@media (max-width: 900px) {
  .qct-svc-timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 640px) {
  .qct-svc-timeline,
  .qct-svc-answers dl,
  .qct-svc-related__grid { grid-template-columns: minmax(0, 1fr); }
  .qct-svc-brand__content { grid-template-columns: minmax(0, 1fr); }
  .qct-svc-card,
  .qct-svc-step,
  .qct-svc-related__grid article { min-height: auto; }
  .qct-svc-faq details summary { font-size: 1rem; gap: .75rem; min-height: 60px; }
  .qct-svc-faq p { padding-right: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .qct-svc-card,
  .qct-svc-step,
  .qct-svc-answers dl > div,
  .qct-svc-related__grid article,
  .qct-svc-faq details,
  .qct-svc-faq details summary,
  .qct-svc-faq details summary::after { transition: none; }
  .qct-svc-card:hover,
  .qct-svc-step:hover,
  .qct-svc-answers dl > div:hover,
  .qct-svc-related__grid article:hover { transform: none; }
}
</style>