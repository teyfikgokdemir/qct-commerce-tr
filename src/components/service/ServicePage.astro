---
import { useTranslations, getHomeUrl, getLocalizedUrl } from '../../i18n';

interface Item {
  title: string;
  text: string;
}
interface Step {
  number: string;
  title: string;
  text: string;
}
interface Faq {
  q: string;
  a: string;
}
interface Props {
  lang: string;
  eyebrow: string;
  title: string;
  lead: string;
  ctaPrimary: string;
  ctaSecondary?: string;
  problem?: {
    eyebrow: string;
    title: string;
    intro: string[];
    items: Item[];
  };
  benefits: {
    eyebrow: string;
    title: string;
    lead: string;
    items: Item[];
  };
  included: {
    eyebrow: string;
    title: string;
    lead: string;
    items: Item[];
  };
  process: {
    eyebrow: string;
    title: string;
    steps: Step[];
  };
  faq: {
    eyebrow: string;
    title: string;
    items: Faq[];
  };
  final: {
    eyebrow?: string;
    title: string;
    text: string;
    cta: string;
    ctaSecondary?: string;
  };
}

const {
  lang,
  eyebrow,
  title,
  lead,
  ctaPrimary,
  ctaSecondary,
  problem,
  benefits,
  included,
  process,
  faq,
  final,
} = Astro.props;

const t = useTranslations(lang);
const homeUrl = getHomeUrl(lang);
const contactUrl = `${homeUrl}#contact`;
const workUrl = `${homeUrl}#work`;
---
<section class="qct-svc-hero">
  <div class="container">
    <nav class="qct-breadcrumb" aria-label="Breadcrumb">
      <a href={homeUrl}>{t('Home')}</a>
      <span aria-hidden="true">/</span>
      <span>{eyebrow}</span>
    </nav>
    <p class="qct-section__eyebrow">{eyebrow}</p>
    <h1 class="qct-svc-hero__title">{title}</h1>
    <p class="qct-svc-hero__lead">{lead}</p>
    <div class="qct-svc-hero__actions">
      <a class="qct-btn qct-btn--primary" href={contactUrl}>{ctaPrimary}</a>
      {ctaSecondary && <a class="qct-btn qct-btn--secondary" href={workUrl}>{ctaSecondary}</a>}
    </div>
  </div>
</section>

{problem && (
  <section class="qct-section qct-svc-section">
    <div class="container">
      <div class="qct-section__header">
        <p class="qct-section__eyebrow">{problem.eyebrow}</p>
        <h2 class="qct-section__title">{problem.title}</h2>
        {problem.intro.map((p) => <p class="qct-section__lead">{p}</p>)}
      </div>
      <div class="qct-svc-grid">
        {problem.items.map((item) => (
          <article class="qct-svc-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<section class="qct-section qct-svc-section">
  <div class="container">
    <div class="qct-section__header">
      {benefits.eyebrow && <p class="qct-section__eyebrow">{benefits.eyebrow}</p>}
      <h2 class="qct-section__title">{benefits.title}</h2>
      {benefits.lead && <p class="qct-section__lead">{benefits.lead}</p>}
    </div>
    {benefits.items.length > 0 && (
      <div class="qct-svc-grid">
        {benefits.items.map((item) => (
          <article class="qct-svc-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<section class="qct-section qct-svc-section qct-svc-section--alt">
  <div class="container">
    <div class="qct-section__header">
      {included.eyebrow && <p class="qct-section__eyebrow">{included.eyebrow}</p>}
      <h2 class="qct-section__title">{included.title}</h2>
      {included.lead && <p class="qct-section__lead">{included.lead}</p>}
    </div>
    {included.items.length > 0 && (
      <div class="qct-svc-grid">
        {included.items.map((item) => (
          <article class="qct-svc-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<section class="qct-section qct-svc-section">
  <div class="container">
    <div class="qct-section__header">
      {process.eyebrow && <p class="qct-section__eyebrow">{process.eyebrow}</p>}
      <h2 class="qct-section__title">{process.title}</h2>
    </div>
    <div class="qct-svc-timeline">
      {process.steps.map((step) => (
        <article class="qct-svc-step">
          <span class="qct-svc-step__number">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
})} />

<section class="qct-section qct-svc-section qct-svc-section--alt">
  <div class="container">
    <div class="qct-section__header">
      {faq.eyebrow && <p class="qct-section__eyebrow">{faq.eyebrow}</p>}
      <h2 class="qct-section__title">{faq.title}</h2>
    </div>
    <div class="qct-svc-faq">
      {faq.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="qct-section qct-svc-final">
  <div class="container qct-svc-final__panel">
    {final.eyebrow && <p class="qct-section__eyebrow">{final.eyebrow}</p>}
    <h2 class="qct-section__title">{final.title}</h2>
    <p class="qct-section__lead">{final.text}</p>
    <div class="qct-svc-hero__actions">
      <a class="qct-btn qct-btn--primary" href={contactUrl}>{final.cta}</a>
      {final.ctaSecondary && <a class="qct-btn qct-btn--secondary" href={`mailto:info@qctstudio.com`}>{final.ctaSecondary}</a>}
    </div>
  </div>
</section>

<style>
.qct-svc-hero,
.qct-svc-section,
.qct-svc-hero *,
.qct-svc-section * {
  color: var(--qct-color-text, #17151a) !important;
}
.qct-svc-hero .qct-section__lead,
.qct-svc-section .qct-section__lead,
.qct-svc-card p,
.qct-svc-step p,
.qct-svc-faq p {
  color: var(--qct-color-muted, #686268) !important;
}
.qct-svc-hero .qct-section__eyebrow,
.qct-svc-section .qct-section__eyebrow {
  color: var(--qct-color-accent, #e75757) !important;
}
.qct-breadcrumb {
  display: flex;
  gap: 0.5rem;
  font-size: 0.85rem;
  opacity: 0.85;
  margin-bottom: 1.5rem;
}
.qct-breadcrumb a {
  color: var(--qct-color-text, #17151a);
  text-decoration: none;
}
.qct-breadcrumb a:hover {
  color: var(--qct-color-accent, #e75757);
}
.qct-svc-hero {
  padding-block: var(--qct-hero-clearance, 6rem) 3rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
.qct-svc-hero__title {
  font-size: clamp(2rem, 4.5vw, 3rem);
  line-height: 1.15;
  max-width: 820px;
  margin: 0.75rem 0 1.25rem;
}
.qct-svc-hero__lead {
  color: var(--qct-color-muted, #686268);
  font-size: 1.1rem;
  opacity: 0.95;
  line-height: 1.6;
  max-width: 680px;
  margin-bottom: 2rem;
}
.qct-svc-hero__actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}
.qct-section__eyebrow {
  color: var(--qct-color-accent, #e75757);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 0.75rem;
}
.qct-section__title {
  font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  line-height: 1.2;
  margin-bottom: 1rem;
}
.qct-section__lead {
  opacity: 0.85;
  line-height: 1.6;
  max-width: 720px;
}
.qct-svc-section {
  padding-block: var(--qct-home-section-space, 5rem);
}
.qct-svc-section--alt {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.015);
}
.qct-section__header {
  max-width: 720px;
  margin-bottom: 3rem;
}
.qct-svc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 1.5rem;
}
.qct-svc-card {
  padding: 1.75rem 1.5rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.02);
}
.qct-svc-card h3 {
  font-size: 1.1rem;
  margin-bottom: 0.5rem;
}
.qct-svc-card p {
  opacity: 0.85;
  font-size: 0.95rem;
  line-height: 1.5;
}
.qct-svc-timeline {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
}
.qct-svc-step {
  padding: 1.75rem 1.5rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.02);
}
.qct-svc-step__number {
  display: block;
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--qct-color-accent, #e75757);
  margin-bottom: 0.75rem;
}
.qct-svc-step h3 {
  font-size: 1.1rem;
  margin-bottom: 0.5rem;
}
.qct-svc-step p {
  opacity: 0.85;
  font-size: 0.92rem;
  line-height: 1.5;
}
.qct-svc-faq {
  max-width: 780px;
}
.qct-svc-faq details {
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  padding-block: 0.85rem;
}
.qct-svc-faq summary {
  cursor: pointer;
  font-weight: 600;
}
.qct-svc-faq p {
  opacity: 0.85;
  margin-top: 0.5rem;
  font-size: 0.92rem;
  line-height: 1.5;
}
.qct-svc-final {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}
.qct-svc-final__panel {
  text-align: center;
  max-width: 700px;
  margin: 0 auto;
  padding: 3rem 2rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.03);
}
.qct-svc-final__panel .qct-section__lead {
  margin: 0 auto 2rem;
}
.qct-svc-final .qct-svc-hero__actions {
  justify-content: center;
}
.qct-btn {
  padding: 0.75rem 1.75rem;
  border-radius: 999px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.95rem;
}
.qct-btn--primary {
  background: var(--qct-color-accent, #e75757);
  color: #0d0d0d;
}
.qct-btn--secondary {
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: var(--qct-color-text, #17151a);
}
</style>
