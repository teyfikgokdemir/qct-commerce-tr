---
interface Item {
  title: string;
  text: string;
  href?: string;
}
interface Step {
  number: string;
  title: string;
  text: string;
}
interface Faq {
  q: string;
  a: string;
}
interface BrandRelationship {
  title: string;
  text: string;
  linkLabel: string;
  linkHref: string;
}
interface Props {
  lang: string;
  eyebrow: string;
  title: string;
  lead: string;
  ctaPrimary: string;
  ctaPrimaryHref?: string;
  ctaSecondary?: string;
  brandRelationship?: BrandRelationship;
  problem?: {
    eyebrow: string;
    title: string;
    intro: string[];
    items: Item[];
  };
  benefits: {
    eyebrow: string;
    title: string;
    lead: string;
    items: Item[];
  };
  included: {
    eyebrow: string;
    title: string;
    lead: string;
    items: Item[];
  };
  process: {
    eyebrow: string;
    title: string;
    steps: Step[];
  };
  answers?: {
    title: string;
    lead: string;
    items: { question: string; answer: string }[];
  };
  relatedLinks?: { title: string; text: string; href: string }[];
  faq: {
    eyebrow: string;
    title: string;
    items: Faq[];
  };
  final: {
    eyebrow?: string;
    title: string;
    text: string;
    cta: string;
    ctaHref?: string;
    ctaSecondary?: string;
  };
}

const {
  lang,
  eyebrow,
  title,
  lead,
  ctaPrimary,
  ctaPrimaryHref,
  ctaSecondary,
  brandRelationship,
  problem,
  benefits,
  included,
  process,
  answers,
  relatedLinks,
  faq,
  final,
} = Astro.props;

const homeUrl = '/';
const contactUrl = '/iletisim/';
const canonicalUrl = new URL(Astro.url.pathname, 'https://qctcommerce.com').toString();
const webpageId = `${canonicalUrl}#webpage`;
const faqId = `${canonicalUrl}#faq`;
---
<section class="qct-svc-hero">
  <div class="container">
    <div class="qct-svc-hero__kicker">
      <span class="qct-svc-hero__kicker-dot" aria-hidden="true"></span>
      <span>{eyebrow}</span>
    </div>
    <h1 class="qct-svc-hero__title">{title}</h1>
    <p class="qct-svc-hero__lead">{lead}</p>
    <div class="qct-svc-hero__actions">
      <a class="qct-btn qct-btn--primary" href={ctaPrimaryHref ?? contactUrl}>{ctaPrimary}</a>
      {ctaSecondary && <a class="qct-btn qct-btn--secondary" href="/hizmetler/">{ctaSecondary}</a>}
    </div>
  </div>
</section>

{brandRelationship && (
  <section class="qct-svc-brand" aria-labelledby="qct-brand-relationship-title">
    <div class="container qct-svc-brand__inner">
      <p class="qct-section__eyebrow">MARKA İLİŞKİSİ</p>
      <div class="qct-svc-brand__content">
        <h2 id="qct-brand-relationship-title">{brandRelationship.title}</h2>
        <div>
          <p>{brandRelationship.text}</p>
          <a href={brandRelationship.linkHref} rel="external noopener noreferrer">
            <span>{brandRelationship.linkLabel}</span>
            <span aria-hidden="true">↗</span>
            <span class="screen-reader-text"> (harici bağlantı)</span>
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<slot name="after-brand" />

{problem && (
  <section class="qct-section qct-svc-section">
    <div class="container">
      <div class="qct-section__header">
        <p class="qct-section__eyebrow">{problem.eyebrow}</p>
        <h2 class="qct-section__title">{problem.title}</h2>
        {problem.intro.map((p) => <p class="qct-section__lead">{p}</p>)}
      </div>
      <div class="qct-svc-grid">
        {problem.items.map((item) => (
          item.href ? (
            <a href={item.href} class="qct-svc-card qct-svc-card--link">
              <div class="qct-svc-card__top">
                <h3>{item.title}</h3>
                <span class="qct-svc-card__arrow" aria-hidden="true">→</span>
              </div>
              <p>{item.text}</p>
            </a>
          ) : (
            <article class="qct-svc-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          )
        ))}
      </div>
    </div>
  </section>
)}

<section class="qct-section qct-svc-section">
  <div class="container">
    <div class="qct-section__header">
      {benefits.eyebrow && <p class="qct-section__eyebrow">{benefits.eyebrow}</p>}
      <h2 class="qct-section__title">{benefits.title}</h2>
      {benefits.lead && <p class="qct-section__lead">{benefits.lead}</p>}
    </div>
    {benefits.items.length > 0 && (
      <div class="qct-svc-grid">
        {benefits.items.map((item) => (
          item.href ? (
            <a href={item.href} class="qct-svc-card qct-svc-card--link">
              <div class="qct-svc-card__top">
                <h3>{item.title}</h3>
                <span class="qct-svc-card__arrow" aria-hidden="true">→</span>
              </div>
              <p>{item.text}</p>
            </a>
          ) : (
            <article class="qct-svc-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          )
        ))}
      </div>
    )}
  </div>
</section>

<section class="qct-section qct-svc-section qct-svc-section--alt">
  <div class="container">
    <div class="qct-section__header">
      {included.eyebrow && <p class="qct-section__eyebrow">{included.eyebrow}</p>}
      <h2 class="qct-section__title">{included.title}</h2>
      {included.lead && <p class="qct-section__lead">{included.lead}</p>}
    </div>
    {included.items.length > 0 && (
      <div class="qct-svc-grid">
        {included.items.map((item) => (
          item.href ? (
            <a href={item.href} class="qct-svc-card qct-svc-card--link">
              <div class="qct-svc-card__top">
                <h3>{item.title}</h3>
                <span class="qct-svc-card__arrow" aria-hidden="true">→</span>
              </div>
              <p>{item.text}</p>
            </a>
          ) : (
            <article class="qct-svc-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          )
        ))}
      </div>
    )}
  </div>
</section>

<section class="qct-section qct-svc-section">
  <div class="container">
    <div class="qct-section__header">
      {process.eyebrow && <p class="qct-section__eyebrow">{process.eyebrow}</p>}
      <h2 class="qct-section__title">{process.title}</h2>
    </div>
    <div class="qct-svc-timeline">
      {process.steps.map((step) => (
        <article class="qct-svc-step">
          <div class="qct-svc-step__heading">
            <h3>{step.title}</h3>
          </div>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

{answers && (
  <section class="qct-section qct-svc-answers" aria-labelledby="qct-service-answers-title">
    <div class="container">
      <div class="qct-section__header">
        <p class="qct-section__eyebrow">KISA CEVAPLAR</p>
        <h2 id="qct-service-answers-title" class="qct-section__title">{answers.title}</h2>
        <p class="qct-section__lead">{answers.lead}</p>
      </div>
      <dl>
        {answers.items.map((item) => (
          <div><dt>{item.question}</dt><dd>{item.answer}</dd></div>
        ))}
      </dl>
    </div>
  </section>
)}

{relatedLinks && relatedLinks.length > 0 && (
  <section class="qct-section qct-svc-related" aria-labelledby="qct-related-title">
    <div class="container">
      <div class="qct-section__header">
        <p class="qct-section__eyebrow">İLGİLİ KONULAR</p>
        <h2 id="qct-related-title" class="qct-section__title">Bir sonraki adımı bağlamıyla inceleyin.</h2>
      </div>
      <div class="qct-svc-related__grid">
        {relatedLinks.map((item) => (
          <a href={item.href} class="qct-svc-card qct-svc-card--link qct-svc-related__card">
            <div class="qct-svc-card__top">
              <h3>{item.title}</h3>
              <span class="qct-svc-card__arrow" aria-hidden="true">→</span>
            </div>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': faqId,
  url: canonicalUrl,
  inLanguage: 'tr-TR',
  isPartOf: { '@id': webpageId },
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
})} />

<section class="qct-section qct-svc-section qct-svc-section--alt">
  <div class="container">
    <div class="qct-section__header">
      {faq.eyebrow && <p class="qct-section__eyebrow">{faq.eyebrow}</p>}
      <h2 class="qct-section__title">{faq.title}</h2>
    </div>
    <div class="qct-svc-faq">
      {faq.items.map((item, index) => (
        <details open={index === 0}>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="qct-section qct-svc-final">
  <div class="container">
    <div class="qct-svc-final__panel">
      {final.eyebrow && (
        <div class="qct-svc-final__badge">
          <span class="qct-svc-final__badge-dot" aria-hidden="true"></span>
          <span>{final.eyebrow}</span>
        </div>
      )}
      <h2 class="qct-svc-final__title">{final.title}</h2>
      <p class="qct-svc-final__lead">{final.text}</p>
      <div class="qct-svc-final__actions">
        <a class="qct-btn qct-btn--primary qct-svc-final__btn-primary" href={final.ctaHref ?? contactUrl}>
          <span>{final.cta}</span>
          <svg class="qct-btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        {final.ctaSecondary && (
          <a class="qct-btn qct-btn--secondary qct-svc-final__btn-secondary" href="mailto:info@qctcommerce.com">
            <span>{final.ctaSecondary}</span>
            <svg class="qct-btn-mail" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </a>
        )}
      </div>
      <div class="qct-svc-final__perks" aria-label="Hizmet standartları">
        <div class="qct-svc-final__perk">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>{lang === 'en' ? 'Senior Engineering & Architecture' : lang === 'az' ? 'Təcrübəli Mühəndis Heyəti' : 'Kıdemli Mühendislik Desteği'}</span>
        </div>
        <div class="qct-svc-final__perk-dot" aria-hidden="true">·</div>
        <div class="qct-svc-final__perk">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>{lang === 'en' ? 'Transparent Scope & Pricing' : lang === 'az' ? 'Şəffaf Şərtlər və Qiymət' : 'Şeffaf Kapsam ve Fiyat'}</span>
        </div>
        <div class="qct-svc-final__perk-dot" aria-hidden="true">·</div>
        <div class="qct-svc-final__perk">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>{lang === 'en' ? '24h Initial Response' : lang === 'az' ? '24 Saat Ərzində Qayıdış' : '24 Saatte Kapsam Dönüşü'}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.qct-svc-hero,
.qct-svc-section {
  color: var(--qct-color-text, #0f172a);
}
.qct-svc-hero .qct-section__lead,
.qct-svc-section .qct-section__lead,
.qct-svc-card p,
.qct-svc-step p,
.qct-svc-faq p {
  color: var(--qct-color-muted, #686268) !important;
}
.qct-svc-hero .qct-section__eyebrow,
.qct-svc-section .qct-section__eyebrow {
  color: #002fa7 !important;
}
.qct-breadcrumb { display: flex; gap: .5rem; font-size: .82rem; margin-bottom: 1.25rem; align-self: flex-start; opacity: .72; }
.qct-breadcrumb a { color: var(--qct-color-text, #17151a); text-decoration: none; }
.qct-breadcrumb a:hover { color: #002fa7; }
.qct-svc-hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding-block: clamp(3rem, 5vw, 4.5rem) clamp(2.6rem, 4vw, 3.75rem);
  border-bottom: 1px solid rgba(23, 21, 26, .08);
  background:
    radial-gradient(circle at 50% 18%, rgba(0,47,167,.06), transparent 34%),
    linear-gradient(180deg, rgba(255,255,255,.22), rgba(248,243,239,.08));
}
.qct-svc-hero::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: min(760px, 72vw);
  height: 1px;
  transform: translateX(-50%);
  background: linear-gradient(90deg, transparent, rgba(0,47,167,.35), transparent);
  z-index: -1;
}
.qct-svc-hero .container {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.qct-svc-hero .qct-section__eyebrow {
  margin-bottom: .9rem;
  letter-spacing: .14em;
}
.qct-svc-hero__title {
  font-size: clamp(2rem, 3.2vw, 3.1rem);
  line-height: 1.15;
  letter-spacing: -.035em;
  font-weight: 750;
  max-width: 32ch;
  margin: .2rem auto 1.25rem;
  text-wrap: balance;
  overflow-wrap: break-word;
}
.qct-svc-hero__lead {
  color: var(--qct-color-muted, #686268);
  font-size: clamp(1rem, 1.35vw, 1.18rem);
  line-height: 1.55;
  max-width: 1080px;
  margin: 0 auto 2rem;
}
.qct-svc-hero__actions {
  display: flex;
  gap: .8rem;
  flex-wrap: wrap;
  justify-content: center;
}
.qct-svc-hero > .container > *:not(.qct-breadcrumb) {
  opacity: 0;
  transform: translateY(14px);
  animation: qct-svc-hero-in .58s cubic-bezier(.2,.7,.2,1) forwards;
}
.qct-svc-hero > .container > .qct-section__eyebrow { animation-delay: .04s; }
.qct-svc-hero > .container > .qct-svc-hero__title { animation-delay: .10s; }
.qct-svc-hero > .container > .qct-svc-hero__lead { animation-delay: .16s; }
.qct-svc-hero > .container > .qct-svc-hero__actions { animation-delay: .22s; }
@keyframes qct-svc-hero-in {
  to { opacity: 1; transform: translateY(0); }
}
.qct-section__eyebrow { color: var(--qct-color-accent-strong, #b9473e); font-size: .85rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; margin-bottom: .75rem; }
.qct-section__title { font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.2; margin-bottom: 1rem; }
.qct-section__lead { line-height: 1.58; max-width: 900px; }
.qct-section__header {
  max-width: 1100px;
  margin: 0 auto clamp(1.75rem, 3vw, 2.5rem);
  text-align: center;
}
.qct-section__header .qct-section__lead { margin-inline: auto; }
.qct-svc-section { padding-block: clamp(3rem, 5vw, 4.25rem); }
.qct-svc-section--alt {
  background: #f8fafc;
  border-block: 1px solid rgba(15, 23, 42, 0.06);
}

.qct-svc-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(1.15rem, 2.5vw, 1.85rem);
  align-items: stretch;
}
.qct-svc-grid:has(> :nth-child(3):last-child) {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.qct-svc-card,
.qct-svc-step,
.qct-svc-answers dl > div,
.qct-svc-related__grid article,
.qct-svc-related__card {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-radius: 20px;
  background: #ffffff;
  box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04), 0 2px 6px rgba(15, 23, 42, 0.02);
  transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  color: inherit;
  text-decoration: none;
}

.qct-svc-card::before,
.qct-svc-step::before,
.qct-svc-answers dl > div::before,
.qct-svc-related__grid article::before,
.qct-svc-related__card::before {
  content: '';
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(90deg, #002fa7, #3b82f6);
  opacity: 0;
  transition: opacity .25s ease;
  z-index: 1;
}

.qct-svc-card:hover,
.qct-svc-step:hover,
.qct-svc-answers dl > div:hover,
.qct-svc-related__grid article:hover,
.qct-svc-related__card:hover {
  transform: translateY(-4px);
  border-color: rgba(0, 47, 167, 0.28);
  box-shadow: 0 20px 40px -10px rgba(0, 47, 167, 0.12), 0 0 0 1px rgba(0, 47, 167, 0.08);
}

.qct-svc-card:hover::before,
.qct-svc-step:hover::before,
.qct-svc-answers dl > div:hover::before,
.qct-svc-related__grid article:hover::before,
.qct-svc-related__card:hover::before {
  opacity: 1;
}

.qct-svc-card,
.qct-svc-related__card {
  min-height: 0;
  padding: clamp(1.6rem, 2.5vw, 2.2rem);
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  text-align: left;
}

.qct-svc-card--link {
  cursor: pointer;
}

.qct-svc-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin: 0 0 .65rem;
  width: 100%;
}

.qct-svc-card__top h3 {
  margin: 0;
}

.qct-svc-card__arrow {
  display: inline-grid;
  place-items: center;
  width: 2rem;
  height: 2rem;
  flex: 0 0 2rem;
  border-radius: 999px;
  background: rgba(0, 47, 167, 0.06);
  color: #002fa7;
  font-size: 1.15rem;
  font-weight: 700;
  line-height: 1;
  transition: transform .25s ease, background-color .25s ease, color .25s ease;
}

.qct-svc-card--link:hover .qct-svc-card__arrow,
.qct-svc-related__card:hover .qct-svc-card__arrow {
  transform: translateX(4px);
  background: #002fa7;
  color: #ffffff;
}

.qct-svc-card h3,
.qct-svc-related__card h3 {
  color: #0f172a;
  font-size: clamp(1.15rem, 1.4vw, 1.25rem);
  font-weight: 750;
  letter-spacing: -0.02em;
  line-height: 1.3;
  margin: 0 0 .65rem;
  transition: color 180ms ease;
}

.qct-svc-card--link:hover h3,
.qct-svc-related__card:hover h3 {
  color: #002fa7;
}

.qct-svc-card p,
.qct-svc-related__card p {
  color: #475569;
  font-size: .95rem;
  line-height: 1.65;
  margin: 0;
  max-width: none;
}

.qct-svc-timeline {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: clamp(1rem, 2vw, 1.5rem);
}

.qct-svc-step {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-width: 0;
  min-height: 0;
  padding: clamp(1.5rem, 2.5vw, 2rem);
  text-align: left;
}

.qct-svc-step__heading {
  display: grid;
  gap: 1rem;
  min-width: 0;
}

.qct-svc-step__number {
  display: grid;
  place-items: center;
  width: 2.8rem;
  height: 2.8rem;
  border: 1px solid rgba(0, 47, 167, 0.2);
  border-radius: 12px;
  background: rgba(0, 47, 167, 0.06);
  color: #002fa7;
  font-size: 1rem;
  font-weight: 800;
}

.qct-svc-step h3 {
  color: #0f172a;
  font-size: 1.15rem;
  font-weight: 750;
  letter-spacing: -0.02em;
  line-height: 1.35;
  margin: 0;
}

.qct-svc-step p {
  color: #475569;
  font-size: .95rem;
  line-height: 1.62;
  margin: .65rem 0 0;
  max-width: none;
}

.qct-svc-answers,
.qct-svc-related {
  padding-block: clamp(3.5rem, 5vw, 5rem);
  background: #fafafc;
}

.qct-svc-answers dl,
.qct-svc-related__grid {
  display: grid;
