---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const services=[
 {value:'landing',label:'Landing / kampaniya səhifəsi',base:390},
 {value:'corporate',label:'Korporativ veb sayt',base:690},
 {value:'multilingual',label:'Çoxdilli korporativ sayt',base:1090},
 {value:'ecommerce',label:'E-ticarət saytı',base:1290},
 {value:'visibility',label:'SEO + GEO + AEO + AIO',base:290},
 {value:'audit',label:'Texniki SEO + AI görünürlük auditi',base:190},
 {value:'whatsapp',label:'WhatsApp satış sistemi',base:190},
 {value:'automation',label:'AI / CRM avtomatlaşdırma',base:390}
];
const faq=[
 {q:'Azərbaycanda korporativ veb saytın qiyməti nə qədərdir?',a:'QCT Commerce-də standart korporativ veb sayt layihələri 690 AZN-dən başlayır. Çoxdilli və xüsusi inteqrasiyalı layihələr ayrıca hesablanır.'},
 {q:'E-ticarət saytı neçədən başlayır?',a:'Standart e-ticarət layihələri 1.290 AZN-dən başlayır. Məhsul sayı, platforma, ödəniş, çatdırılma və inteqrasiyalar qiymətə təsir edir.'},
 {q:'SEO, GEO, AEO və AIO nədir?',a:'SEO axtarış sistemləri, GEO generativ cavab sistemləri, AEO cavab mühərrikləri, AIO isə AI əsaslı görünürlük üçün texniki və məzmun siqnallarını birlikdə gücləndirir.'}
];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(i=>({'@type':'Question',name:i.q,acceptedAnswer:{'@type':'Answer',text:i.a}}))};
---
<BaseLayout title="Azərbaycanda Veb Sayt, E-ticarət, SEO, GEO, AEO & AIO | QCT Commerce" description="Azərbaycan şirkətləri üçün korporativ veb sayt, e-ticarət, SEO, GEO, AEO, AIO, WhatsApp satış və AI avtomatlaşdırma xidmətləri. Şəffaf AZN qiymətləri." lang="az" isHome={true} areaServed={['Azerbaijan','Türkiye']}>
<script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<Header slot="header" lang="az" />
<link rel="stylesheet" href="/styles/qct-v2.css?v=20260924-4" />
<div class="qct-v2" data-qct-az>
<section class="qct-hero" aria-labelledby="az-hero-title"><div class="qct-shell qct-hero-grid">
<div class="qct-hero-copy"><p class="qct-eyebrow">AZƏRBAYCAN ÜÇÜN RƏQƏMSAL TİCARƏT SİSTEMLƏRİ</p><h1 id="az-hero-title">Rəqəmsal böyümə üçün <em>vahid sistem.</em></h1><p class="qct-lead">Veb sayt, e-ticarət, SEO, GEO, AEO, AIO, analitika və satış avtomatlaşdırmasını ayrı-ayrı xidmətlər kimi deyil, eyni kommersiya sisteminin hissələri kimi qururuq.</p><div class="qct-hero-actions"><a class="qct-btn qct-btn-primary" href="/az/elaqe/">Layihəyə başlayın <span>→</span></a><a class="qct-text-link" href="#qiymet-hesabla">Qiyməti hesablayın</a></div><div class="qct-proof-line"><span>Şəffaf AZN qiymətləri</span><span>Yerli dildə xidmət</span><span>Axtarış + AI görünürlüyü</span></div></div>
<aside class="qct-calculator" id="qiymet-hesabla" aria-labelledby="az-calc-title"><div class="qct-calculator-head"><div><div class="qct-builder-status"><span class="qct-live-dot"></span> CANLI LAYİHƏ HESABLAYICISI</div><h2 id="az-calc-title">Layihənizi seçin</h2><p class="qct-builder-sub">Seçim etdikcə başlanğıc qiyməti dərhal görün.</p></div><div class="qct-builder-progress" aria-hidden="true"><span class="is-active"></span><span></span><span></span></div></div>
<form data-az-price-form><label class="qct-field"><span><b>Layihə növü</b><small>Nə hazırlatmaq istəyirsiniz?</small></span><select name="service" data-az-service><option value="" data-base="0" selected disabled>Xidməti seçin</option>{services.map(s=><option value={s.value} data-base={s.base}>{s.label}</option>)}</select></label>
<label class="qct-field"><span><b>Platforma</b><small>İstifadə etdiyiniz və ya seçdiyiniz sistem</small></span><select data-az-platform><option value="" selected disabled>Platformanı seçin</option><option>Shopify</option><option>WooCommerce</option><option>WordPress</option><option>ikas</option><option value="custom">Xüsusi / mövcud sistem</option><option value="unknown">Hələ qərar verməmişəm</option></select></label>
<label class="qct-field"><span><b>Əlavə dil</b><small>Çoxdilli struktur lazımdır?</small></span><select data-az-language><option value="" selected disabled>Dil ehtiyacını seçin</option><option value="0" data-price="0">Yalnız Azərbaycan dili</option><option value="190" data-price="190">+ 1 əlavə dil</option><option value="350" data-price="350">+ 2 əlavə dil</option></select></label>
<fieldset><legend>Layihəni gücləndirin <small>Ehtiyac olanları əlavə edin</small></legend><div class="qct-addon-grid"><label class="qct-check"><input type="checkbox" value="290" data-az-addon /><span>SEO + GEO + AEO + AIO <small>+290 AZN</small></span></label><label class="qct-check"><input type="checkbox" value="190" data-az-addon /><span>GA4 + Search Console <small>+190 AZN</small></span></label><label class="qct-check"><input type="checkbox" value="190" data-az-addon /><span>WhatsApp satış axını <small>+190 AZN</small></span></label><label class="qct-check"><input type="checkbox" value="290" data-az-addon /><span>Sürət optimallaşdırması <small>+290 AZN</small></span></label></div></fieldset>
<div class="qct-price-result" aria-live="polite"><div><span class="qct-price-label">LAYİHƏNİN BAŞLANĞIC QİYMƏTİ</span><strong data-az-total>Seçiminizi edin</strong><small data-az-note>Standart əhatə üçün başlanğıc qiymətidir.</small><small class="qct-external-cost-note">Platforma/lisenziya, ödəniş komissiyası, reklam büdcəsi və üçüncü tərəf xərcləri daxil deyil.</small></div><a class="qct-btn qct-btn-primary qct-result-btn is-disabled" data-az-whatsapp aria-disabled="true" href="https://wa.me/905456782655" target="_blank" rel="noopener">Ətraflı danışaq <span>→</span></a></div></form></aside>
</div></section>
<section class="qct-pathways" id="heller"><div class="qct-shell"><div class="qct-section-head"><div><p class="qct-section-label">XİDMƏTLƏR</p><h2>Sayt qururuq.<br/><em>Satış sistemini də.</em></h2></div><p>Azərbaycan şirkətləri üçün lokal dil, düzgün texniki baza və ölçülə bilən kommersiya axını qururuq.</p></div><div class="qct-pathway-grid"><article><span class="qct-pathway-label">VEB & E-TİCARƏT</span><h3>Yeni rəqəmsal platforma</h3><p>Korporativ sayt, e-ticarət və çoxdilli struktur.</p><ul><li><a href="/az/veb-dizayn/">Veb dizayn</a></li><li><a href="/az/e-ticaret/">E-ticarət</a></li><li><a href="/az/shopify-magaza-qurulmasi/">Shopify</a></li></ul></article><article><span class="qct-pathway-label">GÖRÜNÜRLÜK & SATIŞ</span><h3>Tapılmaq və tələb yaratmaq</h3><p>Axtarış və AI görünürlüyünü satış axını ilə birləşdiririk.</p><ul><li><a href="/az/seo-geo/">SEO, GEO, AEO, AIO</a></li><li><a href="/az/whatsapp-satis/">WhatsApp satış</a></li><li><a href="/az/ai-avtomatlaşdırma/">AI avtomatlaşdırma</a></li></ul></article></div></div></section>
<section class="qct-benefits" id="kimler-ucun"><div class="qct-shell qct-benefit-grid"><article><h3>İstehsalçılar</h3><p>Məhsul, sertifikat, kataloq və B2B tələb axını.</p></article><article><h3>İxracatçılar</h3><p>Çoxdilli təqdimat və yeni bazarlarda görünürlük.</p></article><article><h3>Distribütorlar</h3><p>Partnyor, diler və təklif sorğularını strukturlaşdırın.</p></article><article><h3>E-ticarət brendləri</h3><p>Mobil dönüşüm, məhsul axını və ölçülə bilən satış.</p></article></div></section>
<section class="qct-search-faq" id="faq"><div class="qct-shell"><div class="qct-section-head"><div><p class="qct-section-label">TEZ-TEZ VERİLƏN SUALLAR</p><h2>Qiymət və görünürlük.<br/><em>Aydın cavablar.</em></h2></div></div><div class="qct-faq-grid">{faq.map(i=><details><summary>{i.q}</summary><p>{i.a}</p></details>)}</div></div></section>
<section class="qct-close"><div class="qct-shell qct-close-grid"><div><p class="qct-section-label">BAŞLAMAĞA HAZIRSINIZ?</p><h2>Layihənizin <em>real başlanğıcını</em> müəyyənləşdirək.</h2></div><a class="qct-btn qct-btn-light" href="#qiymet-hesabla">Qiyməti hesablayın <span>→</span></a></div></section>
</div>
<Footer slot="footer" lang="az" />
<script is:inline>
(()=>{const root=document.querySelector('[data-qct-az]');if(!root)return;const form=root.querySelector('[data-az-price-form]'),service=root.querySelector('[data-az-service]'),platform=root.querySelector('[data-az-platform]'),language=root.querySelector('[data-az-language]'),addons=[...root.querySelectorAll('[data-az-addon]')],total=root.querySelector('[data-az-total]'),note=root.querySelector('[data-az-note]'),wa=root.querySelector('[data-az-whatsapp]'),progress=[...root.querySelectorAll('.qct-builder-progress span')];const money=new Intl.NumberFormat('az-AZ');function calc(){const selected=service?.selectedOptions?.[0];const has=!!service?.value;const base=Number(selected?.dataset.base||0);const langPrice=Number(language?.selectedOptions?.[0]?.dataset.price||0);const addon=addons.reduce((s,i)=>s+(i.checked?Number(i.value):0),0);const value=base+langPrice+addon;const completed=[!!service?.value,!!platform?.value,!!language?.value].filter(Boolean).length;progress.forEach((s,i)=>s.classList.toggle('is-active',i<completed));if(total)total.textContent=has?(value?money.format(value)+' AZN-dən':'Əhatəyə görə'):'Seçiminizi edin';if(note)note.textContent=has?'Göstərilən məbləğ standart əhatə üçün başlanğıc qiymətidir; layihə detalına görə dəyişə bilər.':'Standart əhatə üçün başlanğıc qiymətidir.';if(wa){wa.classList.toggle('is-disabled',!has);wa.setAttribute('aria-disabled',String(!has));const msg='Salam QCT Commerce, AZ qiymət hesablayıcısından gəlirəm. '+(selected?.textContent?.trim()||'Layihə')+'. Başlanğıc qiymət: '+(value?money.format(value)+' AZN-dən':'əhatəyə görə')+'. Detalları müzakirə etmək istəyirəm.';wa.href=has?'https://wa.me/905456782655?text='+encodeURIComponent(msg):'https://wa.me/905456782655';}}form?.addEventListener('change',calc);wa?.addEventListener('click',e=>{if(wa.getAttribute('aria-disabled')==='true')e.preventDefault();});calc();})();
</script>
</BaseLayout>
