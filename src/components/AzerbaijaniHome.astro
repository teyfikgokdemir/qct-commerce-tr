---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
const services=[
 {value:'landing',label:'Landing / kampaniya səhifəsi',base:390},
 {value:'corporate',label:'Korporativ veb sayt',base:690},
 {value:'personal',label:'Şəxsi / portfel saytı',base:490},
 {value:'multilingual',label:'Çoxdilli korporativ sayt',base:1190},
 {value:'ecommerce',label:'E-ticarət qurulması',base:1190},
 {value:'refresh',label:'Mövcud saytın yenilənməsi',base:390},
 {value:'audit',label:'Sayt analizi və inkişaf planı',base:150},
 {value:'migration',label:'Platforma köçürülməsi',base:690},
 {value:'visibility',label:'Dinamik SEO · SEO + GEO + AEO + AIO',base:290},
 {value:'whatsapp',label:'WhatsApp satış axını',base:190},
 {value:'automation',label:'Sadə AI avtomatlaşdırması',base:490}
];

const platforms=[
 {name:'Shopify',href:'/az/shopify-magaza-qurulmasi/',type:'Platforma'},
 {name:'ikas',href:'/az/ikas-magaza-qurulmasi/',type:'Platforma'},
 {name:'WooCommerce',href:'/az/e-ticaret/',type:'Platforma'},
 {name:'WordPress',href:'/az/veb-dizayn/',type:'Veb'},
 {name:'PayTR',href:'/az/e-ticaret/',type:'Ödəniş'},
 {name:'iyzico',href:'/az/e-ticaret/',type:'Ödəniş'},
 {name:'Google Merchant Center',href:'/az/seo-geo/',type:'Böyümə'},
 {name:'Meta',href:'/az/meta-reklamlari/',type:'Reklam'},
 {name:'WhatsApp',href:'/az/whatsapp-satis/',type:'Satış'}
];
const faq=[
 {q:'Azərbaycanda korporativ veb saytın qiyməti nə qədərdir?',a:'QCT Commerce-də standart korporativ veb sayt layihələri 690 AZN-dən başlayır. Çoxdilli və xüsusi inteqrasiyalı layihələr ayrıca hesablanır.'},
 {q:'E-ticarət saytı neçədən başlayır?',a:'Standart e-ticarət layihələri 1.190 AZN-dən başlayır. Məhsul sayı, platforma, ödəniş, çatdırılma və inteqrasiyalar qiymətə təsir edir.'},
 {q:'SEO, GEO, AEO və AIO nədir?',a:'SEO axtarış sistemləri, GEO generativ cavab sistemləri, AEO cavab mühərrikləri, AIO isə AI əsaslı görünürlük üçün texniki və məzmun siqnallarını birlikdə gücləndirir.'}
];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(i=>({'@type':'Question',name:i.q,acceptedAnswer:{'@type':'Answer',text:i.a}}))};
---
<BaseLayout title="Azərbaycanda Veb Sayt, E-ticarət, SEO, GEO, AEO & AIO | QCT Commerce" description="Azərbaycan şirkətləri üçün korporativ veb sayt, e-ticarət, SEO, GEO, AEO, AIO, WhatsApp satış və AI avtomatlaşdırma xidmətləri. Şəffaf AZN qiymətləri." lang="az" isHome={true} areaServed={['Azerbaijan','Türkiye']}>
<script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<Header slot="header" lang="az" />
<link rel="stylesheet" href="/styles/qct-v2.css?v=20260928-7" />
<div class="qct-v2" data-qct-az>
<div class="qct-intro-overlay" data-intro-banner hidden>
  <div class="qct-intro-card" role="dialog" aria-modal="false" aria-label="QCT Commerce yeniliyi">
    <button type="button" class="qct-intro-close" aria-label="Elanı bağlayın" data-intro-close>×</button>
    <div class="qct-intro-brand">QCT Commerce</div>
    <p class="qct-intro-kicker">VEB SAYT QİYMƏTLƏRİ · ŞƏFFAF BAŞLANĞIC</p>
    <h2>Layihənizin başlanğıc qiymətini 60 saniyədə görün.</h2>
    <p>Korporativ sayt, e-ticarət, yenilənmə və görünürlük işləri üçün ilkin əhatəni dərhal hesablayın.</p>
    <div class="qct-intro-line"></div>
    <span class="qct-intro-foot">Başlanğıc qiymətlər · Aydın əhatə · Sürətli təklif</span>
  </div>
</div>
<style is:inline>
[data-qct-az] .qct-hero-copy > *,
[data-qct-az] .qct-calculator{opacity:1!important;transform:none!important;animation:none!important}
[data-qct-az] .qct-hero h1{color:var(--qct-ink)!important;-webkit-text-fill-color:var(--qct-ink)!important}
[data-qct-az] .qct-hero h1 em{color:var(--qct-accent)!important;-webkit-text-fill-color:var(--qct-accent)!important}
[data-qct-az] .qct-hero .qct-eyebrow{color:var(--qct-muted)!important}
[data-qct-az] .qct-hero .qct-lead{color:#4f4b45!important}
[data-qct-az] .qct-close-grid{grid-template-columns:1fr!important;text-align:center!important;justify-items:center!important;align-items:center!important;gap:26px!important}
[data-qct-az] .qct-close-grid>div{display:grid;justify-items:center}
[data-qct-az] .qct-close h2{max-width:1050px!important;margin-inline:auto!important;text-wrap:balance}
[data-qct-az] .qct-close .qct-section-label{text-align:center}
[data-qct-az] .qct-close .qct-btn{justify-self:center}
@media(max-width:760px){[data-qct-az] .qct-close h2{font-size:clamp(2.3rem,11vw,3.5rem)!important}}
</style>
<section class="qct-hero" aria-labelledby="az-hero-title"><div class="qct-shell qct-hero-grid">
<div class="qct-hero-copy"><p class="qct-eyebrow">AZƏRBAYCAN ÜÇÜN RƏQƏMSAL TİCARƏT SİSTEMLƏRİ</p><h1 id="az-hero-title">Rəqəmsal böyümə üçün <em>vahid sistem.</em></h1><p class="qct-lead">Veb sayt, e-ticarət, SEO, GEO, AEO, AIO, analitika və satış avtomatlaşdırmasını ayrı-ayrı xidmətlər kimi deyil, eyni kommersiya sisteminin hissələri kimi qururuq.</p><div class="qct-hero-actions"><a class="qct-btn qct-btn-primary" href="/az/elaqe/">Layihəyə başlayın <span>→</span></a><a class="qct-text-link" href="#qiymet-hesabla">Qiyməti hesablayın</a></div><div class="qct-proof-line"><span>Şəffaf AZN qiymətləri</span><span>Yerli dildə xidmət</span><span>Axtarış + AI görünürlüyü</span></div></div>
<aside class="qct-calculator" id="qiymet-hesabla" aria-labelledby="az-calc-title"><div class="qct-calculator-head"><div><div class="qct-builder-status"><span class="qct-live-dot"></span> CANLI LAYİHƏ HESABLAYICISI</div><h2 id="az-calc-title">Layihənizi seçin</h2><p class="qct-builder-sub">Seçim etdikcə başlanğıc qiyməti dərhal görün.</p></div><div class="qct-builder-progress" aria-hidden="true"><span class="is-active"></span><span></span><span></span></div></div>
<form data-az-price-form><label class="qct-field"><span><b>Layihə növü</b><small>Nə hazırlatmaq istəyirsiniz?</small></span><select name="service" data-az-service><option value="" data-base="0" selected disabled>Xidməti seçin</option>{services.map(s=><option value={s.value} data-base={s.base}>{s.label}</option>)}</select></label>
<label class="qct-field"><span><b>Platforma</b><small>İstifadə etdiyiniz və ya seçdiyiniz sistem</small></span><select data-az-platform><option value="" selected disabled>Platformanı seçin</option><option>Shopify</option><option>WooCommerce</option><option>WordPress</option><option>ikas</option><option value="custom">Xüsusi / mövcud sistem</option><option value="unknown">Hələ qərar verməmişəm</option></select></label>
<label class="qct-field"><span><b>Məhsul əhatəsi</b><small>E-ticarət seçmisinizsə neçə məhsul?</small></span><select data-az-products><option value="" selected disabled>Məhsul əhatəsini seçin</option><option value="0" data-price="0">Məhsul girişi lazım deyil</option><option value="10" data-price="150" data-ecommerce-price="0">1–10 məhsul — e-ticarət paketinə daxildir</option><option value="more" data-price="0" data-quote="true">10-dan çox — ayrıca təklif</option></select></label>
<label class="qct-field"><span><b>Əlavə dil</b><small>Çoxdilli struktur lazımdır?</small></span><select data-az-language><option value="" selected disabled>Dil ehtiyacını seçin</option><option value="0" data-price="0">Yalnız Azərbaycan dili</option><option value="190" data-price="190">+ 1 əlavə dil</option><option value="350" data-price="350">+ 2 əlavə dil</option></select></label>
<fieldset><legend>Layihəni gücləndirin <small>Ehtiyac olanları əlavə edin</small></legend><div class="qct-addon-grid"><label class="qct-check"><input type="checkbox" value="390" data-az-addon /><span>SEO Care aylıq başlanğıc <small>+290 AZN</small></span></label><label class="qct-check"><input type="checkbox" value="100" data-az-addon /><span>GA4 + Search Console <small>+100 AZN</small></span></label><label class="qct-check"><input type="checkbox" value="190" data-az-addon /><span>WhatsApp satış axını <small>+190 AZN</small></span></label><label class="qct-check"><input type="checkbox" value="190" data-az-addon /><span>Sürət optimallaşdırması <small>+190 AZN</small></span></label></div></fieldset>
<div class="qct-price-result" aria-live="polite"><div><span class="qct-price-label">LAYİHƏNİN BAŞLANĞIC QİYMƏTİ</span><strong data-az-total>Seçiminizi edin</strong><small data-az-note>Standart əhatə üçün başlanğıc qiymətidir.</small><small class="qct-external-cost-note">Platforma/lisenziya, ödəniş komissiyası, reklam büdcəsi və üçüncü tərəf xərcləri daxil deyil.</small></div><a class="qct-btn qct-btn-primary qct-result-btn is-disabled" data-az-whatsapp aria-disabled="true" href="https://wa.me/905456782655" target="_blank" rel="noopener">Ətraflı danışaq <span>→</span></a></div></form></aside>
</div>
<div class="qct-shell qct-brand-film" aria-label="QCT Commerce brend videosu">
  <div class="qct-brand-film__frame">
    <video data-qct-brand-film autoplay muted loop playsinline preload="metadata" poster="/images/qct-commerce-2026/qct-commerce-hero.webp" aria-label="QCT Commerce brend videosu">
      <source src="/videos/qct-commerce-brand-film.mp4" type="video/mp4" />
      Brauzeriniz video elementini dəstəkləmir.
    </video>
  </div>
</div>
</section>
<section class="qct-platforms qct-ecosystem" aria-label="Dəstəklənən platformalar və inteqrasiyalar">
  <div class="qct-shell qct-ecosystem-head"><p class="qct-section-label">PLATFORMALAR & İNTEQRASİYALAR</p><span>Qurulumdan satışa, vahid ekosistem.</span></div>
  <div class="qct-marquee" data-marquee><div class="qct-marquee-track">
    <div class="qct-marquee-group">{platforms.map(p=><a class="qct-marquee-item" href={p.href}><small>{p.type}</small><strong>{p.name}</strong></a>)}</div>
    <div class="qct-marquee-group" aria-hidden="true">{platforms.map(p=><a class="qct-marquee-item" href={p.href} tabindex="-1"><small>{p.type}</small><strong>{p.name}</strong></a>)}</div>
  </div></div>
</section>
<section class="qct-pathways" id="heller"><div class="qct-shell"><div class="qct-section-head"><div><p class="qct-section-label">XİDMƏTLƏR</p><h2>Sayt qururuq.<br/><em>Satış sistemini də.</em></h2></div><p>Azərbaycan şirkətləri üçün lokal dil, düzgün texniki baza və ölçülə bilən kommersiya axını qururuq.</p></div><div class="qct-pathway-grid"><article><span class="qct-pathway-label">VEB & E-TİCARƏT</span><h3>Yeni rəqəmsal platforma</h3><p>Korporativ sayt, e-ticarət və çoxdilli struktur.</p><ul><li><a href="/az/veb-dizayn/">Veb dizayn</a></li><li><a href="/az/e-ticaret/">E-ticarət</a></li><li><a href="/az/shopify-magaza-qurulmasi/">Shopify</a></li><li><a href="/az/ikas-magaza-qurulmasi/">ikas</a></li></ul></article><article><span class="qct-pathway-label">GÖRÜNÜRLÜK & SATIŞ</span><h3>Tapılmaq və tələb yaratmaq</h3><p>Axtarış və AI görünürlüyünü satış axını ilə birləşdiririk.</p><ul><li><a href="/az/seo-geo/">SEO, GEO, AEO, AIO</a></li><li><a href="/az/meta-reklamlari/">Meta reklamları</a></li><li><a href="/az/whatsapp-satis/">WhatsApp satış</a></li><li><a href="/az/ai-avtomatlasdirma/">AI avtomatlaşdırma</a></li></ul></article></div></div></section>
<section class="qct-benefits" id="kimler-ucun"><div class="qct-shell qct-benefit-grid"><article><h3>İstehsalçılar</h3><p>Məhsul, sertifikat, kataloq və B2B tələb axını.</p></article><article><h3>İxracatçılar</h3><p>Çoxdilli təqdimat və yeni bazarlarda görünürlük.</p></article><article><h3>Distribütorlar</h3><p>Partnyor, diler və təklif sorğularını strukturlaşdırın.</p></article><article><h3>E-ticarət brendləri</h3><p>Mobil dönüşüm, məhsul axını və ölçülə bilən satış.</p></article></div></section>
<section class="qct-image-story" aria-labelledby="az-image-story-title">
  <div class="qct-shell">
    <div class="qct-section-head qct-image-story__head"><div><p class="qct-section-label">SİSTEMİN DAXİLİNDƏ</p><h2 id="az-image-story-title">Dizayn, data və əməliyyat.<br/><em>Eyni kommersiya axınında.</em></h2></div><p>Yaxşı görünən interfeys təkbaşına kifayət deyil. Dönüşüm, ölçüm, əməliyyat və platforma arxitekturasını eyni müştəri yolunda birləşdiririk.</p></div>
    <div class="qct-image-story__grid">
      <figure class="is-wide"><img src="/images/qct-commerce-2026/qct-commerce-analytics-growth.webp" width="1376" height="768" alt="E-ticarət satış və böyümə analitikası" loading="lazy" decoding="async" /><figcaption><b>Ölçüm</b><span>Satış, dönüşüm və müştəri yolunu görünən edin.</span></figcaption></figure>
      <figure><img src="/images/qct-commerce-2026/qct-commerce-cro-conversion.webp" width="1376" height="768" alt="Dönüşüm üçün optimallaşdırılan e-ticarət məhsul səhifəsi" loading="lazy" decoding="async" /><figcaption><b>Dönüşüm</b><span>Qərar nöqtəsində sürtünməni azaldın.</span></figcaption></figure>
      <figure><img src="/images/qct-commerce-2026/qct-commerce-operations-fulfillment.webp" width="1376" height="768" alt="E-ticarət sifariş və fulfillment əməliyyatı" loading="lazy" decoding="async" /><figcaption><b>Əməliyyat</b><span>Rəqəmsal sifarişi real iş axınına bağlayın.</span></figcaption></figure>
      <figure class="is-wide"><img src="/images/qct-commerce-2026/qct-commerce-platform-migration.webp" width="1376" height="768" alt="E-ticarət platforma miqrasiyası" loading="lazy" decoding="async" /><figcaption><b>Platforma transformasiyası</b><span>Məhsul, məzmun və görünürlüyü nəzarətlə daşıyın.</span></figcaption></figure>
    </div>
  </div>
</section>
<section class="qct-offers">
  <div class="qct-shell">
    <div class="qct-section-head"><div><p class="qct-section-label">SÜRƏTLİ BAŞLANĞIC</p><h2>Ehtiyacı seçin.<br/><em>Qiyməti əvvəlcədən görün.</em></h2></div><p>Standart xidmətləri açıq başlanğıc qiymətləri və aydın əhatə ilə təqdim edirik.</p></div>
    <div class="qct-offer-grid">
      <a href="#qiymet-hesabla"><span>Sayt yenilənməsi</span><div class="qct-offer-price"><strong>390 AZN</strong><small>Bazar giriş qiyməti</small></div><small>5 prioritet səhifəyə qədər vizual, mobil və əsas texniki yenilənmə · normal 490 AZN-dən</small></a>
      <a href="#qiymet-hesabla"><span>Korporativ veb</span><div class="qct-offer-price"><strong>690 AZN</strong><small>Bazar giriş qiyməti</small></div><small>5 əsas səhifəyə qədər · normal 890 AZN-dən</small></a>
      <a href="#qiymet-hesabla"><span>E-ticarət qurulması</span><div class="qct-offer-price"><strong>1.190 AZN</strong><small>Bazar giriş qiyməti</small></div><small>10 məhsula qədər standart giriş daxildir · normal 1.490 AZN-dən</small></a>
      <a href="#qiymet-hesabla"><span>SEO + GEO + AEO + AIO</span><div class="qct-offer-price"><strong>390 AZN</strong><small>İlkin iş</small></div><small>5 prioritet səhifəyə qədər texniki və məzmun görünürlük işi</small></a>
      <a href="#qiymet-hesabla"><span>Sayt analizi</span><div class="qct-offer-price"><strong>150 AZN</strong><small>Bazar giriş qiyməti</small></div><small>Texniki, mobil, sürət, SEO və dönüşüm auditi · normal 190 AZN</small></a>
      <a href="#qiymet-hesabla"><span>Platforma köçürülməsi</span><div class="qct-offer-price"><strong>690 AZN-dən</strong><small>Başlanğıc qiyməti</small></div><small>25 məhsula və ya 10 məzmun səhifəsinə qədər əsas miqrasiya · normal 890 AZN-dən</small></a>
    </div>
  </div>
</section>
<section class="qct-search-faq" id="faq"><div class="qct-shell"><div class="qct-section-head"><div><p class="qct-section-label">TEZ-TEZ VERİLƏN SUALLAR</p><h2>Qiymət və görünürlük.<br/><em>Aydın cavablar.</em></h2></div></div><div class="qct-faq-grid">{faq.map(i=><details><summary>{i.q}</summary><p>{i.a}</p></details>)}</div></div></section>
<section class="qct-close"><div class="qct-shell qct-close-grid"><div><p class="qct-section-label">BAŞLAMAĞA HAZIRSINIZ?</p><h2>Layihənizin <em>real başlanğıcını</em> müəyyənləşdirək.</h2></div><a class="qct-btn qct-btn-light" href="#qiymet-hesabla">Qiyməti hesablayın <span>→</span></a></div></section>
</div>
<Footer slot="footer" lang="az" />
<script is:inline>
(()=>{const root=document.querySelector('[data-qct-az]');if(!root)return;const form=root.querySelector('[data-az-price-form]'),service=root.querySelector('[data-az-service]'),platform=root.querySelector('[data-az-platform]'),products=root.querySelector('[data-az-products]'),language=root.querySelector('[data-az-language]'),addons=[...root.querySelectorAll('[data-az-addon]')],total=root.querySelector('[data-az-total]'),note=root.querySelector('[data-az-note]'),wa=root.querySelector('[data-az-whatsapp]'),progress=[...root.querySelectorAll('.qct-builder-progress span')];const money=new Intl.NumberFormat('az-AZ');function calc(){const selected=service?.selectedOptions?.[0];const has=!!service?.value;const base=Number(selected?.dataset.base||0);const productOption=products?.selectedOptions?.[0];const needsQuote=productOption?.dataset.quote==='true';const productPrice=service?.value==='ecommerce'&&productOption?.dataset.ecommercePrice!==undefined?Number(productOption.dataset.ecommercePrice||0):Number(productOption?.dataset.price||0);const rawLangPrice=Number(language?.selectedOptions?.[0]?.dataset.price||0);const langPrice=service?.value==='multilingual'?(rawLangPrice===190?0:rawLangPrice===350?190:0):rawLangPrice;const addon=addons.reduce((s,i)=>s+(i.checked?Number(i.value):0),0);const value=base+productPrice+langPrice+addon;const completed=[!!service?.value,!!platform?.value,!!products?.value,!!language?.value].filter(Boolean).length;progress.forEach((s,i)=>s.classList.toggle('is-active',i<completed));if(total)total.textContent=has?(needsQuote?'Əhatəyə görə təklif':(value?money.format(value)+' AZN-dən':'Əhatəyə görə')):'Seçiminizi edin';if(note)note.textContent=has?'Göstərilən məbləğ standart əhatə üçün başlanğıc qiymətidir; layihə detalına görə dəyişə bilər.':'Standart əhatə üçün başlanğıc qiymətidir.';if(wa){wa.classList.toggle('is-disabled',!has);wa.setAttribute('aria-disabled',String(!has));const productText=products?.value?(products?.selectedOptions?.[0]?.textContent?.trim()||''):'';const msg='Salam QCT Commerce, AZ qiymət hesablayıcısından gəlirəm. '+(selected?.textContent?.trim()||'Layihə')+(productText?', '+productText:'')+'. Başlanğıc qiymət: '+(needsQuote?'əhatəyə görə təklif':(value?money.format(value)+' AZN-dən':'əhatəyə görə'))+'. Detalları müzakirə etmək istəyirəm.';wa.href=has?'https://wa.me/905456782655?text='+encodeURIComponent(msg):'https://wa.me/905456782655';}}form?.addEventListener('change',calc);wa?.addEventListener('click',e=>{if(wa.getAttribute('aria-disabled')==='true')e.preventDefault();});calc();const banner=root.querySelector('[data-intro-banner]'),close=root.querySelector('[data-intro-close]'),key='qct-az-intro-seen';try{if(banner&&!localStorage.getItem(key)){window.setTimeout(()=>{banner.hidden=false;requestAnimationFrame(()=>banner.classList.add('is-visible'));localStorage.setItem(key,'1');window.setTimeout(()=>{banner.classList.remove('is-visible');window.setTimeout(()=>{banner.hidden=true;},420);},3000);},450);}}catch{}close?.addEventListener('click',()=>{banner?.classList.remove('is-visible');window.setTimeout(()=>{if(banner)banner.hidden=true;},250);});})();
</script>
</BaseLayout>
