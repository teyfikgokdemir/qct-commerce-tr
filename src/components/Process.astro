---
interface Props {
  lang: string;
}

const steps = [
	{ number: '01', title: 'Analiz', text: 'İş modelinizi, hedef müşteriyi, mevcut altyapıyı ve satıştaki darboğazları inceleriz.' },
	{ number: '02', title: 'Planlama', text: 'Öncelikleri, müşteri yolculuğunu, içerik yapısını ve ölçüm planını netleştiririz.' },
	{ number: '03', title: 'Tasarım', text: 'Karar vermeyi kolaylaştıran, mobil öncelikli ve marka uyumlu deneyimi tasarlarız.' },
	{ number: '04', title: 'Geliştirme', text: 'Hızlı, erişilebilir ve farklı ekranlarda tutarlı çalışan sistemi kurarız.' },
	{ number: '05', title: 'Yayın ve geliştirme', text: 'Testlerden sonra yayına alır, ölçüm verileriyle sonraki iyileştirmeleri belirleriz.' },
];
---
<section id="process" class="qct-section qct-process" aria-labelledby="qct-process-title">
	<div class="container">
		<div class="qct-section__header qct-section__header--split">
			<div>
				<p class="qct-section__eyebrow">ÇALIŞMA SÜRECİ</p>
				<h2 id="qct-process-title" class="qct-section__title">İlk analizden yayına kadar net ve izlenebilir bir süreç.</h2>
			</div>
			<p class="qct-section__lead">
				Her aşamada ne yaptığımızı, sıradaki adımı ve kararların ticari gerekçesini açıkça paylaşıyoruz.
			</p>
		</div>

		<div class="qct-process__timeline" data-process-timeline>
			{steps.map((step) => (
				<article class="qct-process-card" data-process-step data-qct-reveal>
					<div class="qct-process-card__marker">
						<span class="qct-process-card__number">{step.number}</span>
					</div>
					<div class="qct-process-card__content">
						<h3>{step.title}</h3>
						<p set:html={step.text.replace(/\n/g, '<br />')} />
					</div>
				</article>
			))}
		</div>

		<p class="qct-section__lead">
			Gereksiz karmaşa yok; hedefe, sorumluluğa ve ölçüme dayalı bir çalışma düzeni var.
		</p>
	</div>
</section>
