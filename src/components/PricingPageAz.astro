---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

const faq=[
 {q:'Bazar giriş qiyməti nə deməkdir?',a:'Azərbaycan bazarı üçün məhdud başlanğıc qiymətidir. Uyğunluq və kontenjan layihə təklifi zamanı təsdiqlənir; normal siyahı qiyməti ayrıca göstərilir.'},
 {q:'Korporativ veb sayt paketinə nə daxildir?',a:'690 AZN bazar giriş qiymətinə 5 əsas səhifəyə qədər, bir dil, mobil uyğunluq, əlaqə/WhatsApp axını və əsas texniki SEO daxildir. Xüsusi dizayn, mətn istehsalı və əlavə funksiya ayrıca hesablanır.'},
 {q:'E-ticarət paketinə neçə məhsul daxildir?',a:'1.190 AZN bazar giriş paketinə məlumat və şəkillər hazır təqdim olunarsa 10 məhsula qədər standart məhsul girişi daxildir. Daha çox məhsul, mürəkkəb variantlar, təsvir yazılması və şəkil redaktəsi ayrıca qiymətləndirilir.'},
 {q:'Çoxdilli sayt qiymətinə tərcümə daxildirmi?',a:'Xeyr. 1.190 AZN bazar giriş qiyməti 2 dil üçün texniki dil infrastrukturu, ayrıca URL və hreflang quruluşunu əhatə edir. Peşəkar tərcümə və lokalizasiya ayrıca hesablanır.'},
 {q:'Dinamik SEO aylıq xidmətdirmi?',a:'Bəli. SEO Care 290 AZN/ay, Dinamik SEO 390 AZN/ay və SEO Growth 590 AZN/ay olaraq təqdim olunur. Görünürlük və sıralama zəmanəti verilmir.'}
];
const schema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(i=>({'@type':'Question',name:i.q,acceptedAnswer:{'@type':'Answer',text:i.a}}))};
---
<BaseLayout title="Azərbaycanda Veb Sayt və E-ticarət Qiymətləri 2026 | QCT" description="Azərbaycan bazar giriş qiymətləri: landing 390 AZN, korporativ sayt 690 AZN, çoxdilli sayt 1.190 AZN, e-ticarət 1.190 AZN. Normal qiymət və dəqiq əhatə açıq göstərilir." lang="az" breadcrumbLabel="Qiymətlər">
<script slot="schema" type="application/ld+json" set:html={JSON.stringify(schema)} />
<Header slot="header" lang="az" />
<link rel="stylesheet" href="/styles/qct-v2.css?v=20261101-edge-elite" />
<div class="qct-v2">
<section class="qct-pricing-hero"><div class="qct-shell">
  <p class="qct-eyebrow">ŞƏFFAF VƏ DƏQİQ İNVESTİSİYA · 2026</p>
  <h1>Əlçatan başlanğıc.<br/><em>Aydın normal qiymət.</em></h1>
  <p class="qct-lead">Gözlənilməz əlavə xərclər olmadan, biznes məqsədlərinizə və büdcənizə uyğun rəqəmsal infrastrukturu seçin. Şəffaf qiymətləndirmə, aydın təhvil sərhədləri və daimi peşəkar dəstək.</p>

  <!-- Elite 3-Tier Spotlight Matrix -->
  <div class="qct-pricing-spotlight">
    <!-- Card 1: Korporativ Veb -->
    <article class="qct-pricing-card">
      <div class="qct-pricing-card__head">
        <span class="qct-pricing-card__label">KORPORATİV BAŞLANĞIC</span>
        <h3>Korporativ Veb Sayt</h3>
        <p class="qct-pricing-card__desc">Brendiniz üçün nüfuzlu, sürətli və mobil yönümlü rəqəmsal vitrin.</p>
      </div>
      <div class="qct-pricing-card__price">
        <strong>690 AZN</strong>
        <small>Bazar giriş qiyməti · Normal qiymət 890 AZN-dən</small>
      </div>
      <ul class="qct-pricing-card__list">
        <li><i>✓</i> <span><strong>5 Əsas Səhifə:</strong> Ana səhifə, haqqımızda, xidmətlər və əlaqə</span></li>
        <li><i>✓</i> <span><strong>Mobil və Sürət Uyğunluğu:</strong> Smartfon və planşetlərdə axıcı təcrübə</span></li>
        <li><i>✓</i> <span><strong>Əlaqə və WhatsApp Axını:</strong> Birbaşa müştəri müraciət butonları</span></li>
        <li><i>✓</i> <span><strong>Əsas Texniki SEO:</strong> Axtarış sistemlərində ilkin indeksləmə</span></li>
      </ul>
      <a class="qct-pricing-card__btn" href="/az/#qiymet-hesabla">Paketi Fərdiləşdirin <span>→</span></a>
    </article>

    <!-- Card 2: QCT EDGE (Featured) -->
    <article class="qct-pricing-card qct-pricing-card--featured">
      <span class="qct-pricing-card__badge">★ 2026 LANSMAN ÜSTÜNLÜYÜ</span>
      <div class="qct-pricing-card__head">
        <span class="qct-pricing-card__label">YENİ NƏSİL İNFRASTRUKTUR</span>
        <h3>QCT EDGE Start</h3>
        <p class="qct-pricing-card__desc">Astro 7 və Cloudflare üzərində ultra sürətli arxitektura, 3 ay Dinamik SEO hədiyyəsi ilə.</p>
      </div>
      <div class="qct-pricing-card__price">
        <strong>1.490 AZN</strong>
        <small>Lansman başlanğıc qiyməti</small>
      </div>
      <ul class="qct-pricing-card__list">
        <li><i>✓</i> <span><strong>3 Ay Dinamik SEO Hədiyyə:</strong> Aylıq 390 AZN dəyərində davamlı inkişaf</span></li>
        <li><i>✓</i> <span><strong>Ultra Sürətli Bulud Sistemi:</strong> Səhifələrin dərhal açılmasını təmin edən kod</span></li>
        <li><i>✓</i> <span><strong>Google və AI Görünürlüyü:</strong> ChatGPT, Perplexity və Google tam uyğunluğu</span></li>
        <li><i>✓</i> <span><strong>Sıfır Texniki Stress:</strong> Əlavə plagin riskləri olmayan etibarlı infrastruktur</span></li>
      </ul>
      <a class="qct-pricing-card__btn qct-pricing-card__btn--highlight" href="/az/yeni-nesil-veb-infrastrukturu/">QCT EDGE-i Kəşf Edin <span>→</span></a>
    </article>

    <!-- Card 3: E-Ticarət Mağazası -->
    <article class="qct-pricing-card">
      <div class="qct-pricing-card__head">
        <span class="qct-pricing-card__label">ONLAYN SATIŞ VƏ MAĞAZA</span>
        <h3>E-Ticarət Başlanğıc</h3>
        <p class="qct-pricing-card__desc">Shopify, WooCommerce və ya ikas ilə 10 məhsul daxil satışa hazır mağaza.</p>
      </div>
      <div class="qct-pricing-card__price">
        <strong>1.190 AZN</strong>
        <small>Bazar giriş qiyməti · Normal qiymət 1.490 AZN-dən</small>
      </div>
      <ul class="qct-pricing-card__list">
        <li><i>✓</i> <span><strong>10 Məhsul Girişi Daxil:</strong> Kateqoriya, qiymət və variantların qurulması</span></li>
        <li><i>✓</i> <span><strong>Ödəniş və Çatdırılma:</strong> Onlayn ödəniş və çatdırılma modullarının inteqrasiyası</span></li>
        <li><i>✓</i> <span><strong>Dönüşüm Yönümlü Səbət:</strong> Mobildə sürətli və rahat sifariş prosesi</span></li>
        <li><i>✓</i> <span><strong>Platforma Çevikliyi:</strong> Shopify və ya WooCommerce seçim imkanı</span></li>
      </ul>
      <a class="qct-pricing-card__btn" href="/az/#qiymet-hesabla">Mağaza Qiymətini Hesabla <span>→</span></a>
    </article>
  </div>

  <div class="qct-pricing-hero-notes">
    <div class="qct-pricing-disclaimer"><strong>Dəqiq Əhatə:</strong> Başlanğıc qiymətləri standartlaşdırılmış giriş paketləri üçündür. Xüsusi inteqrasiyalar, çoxdillilik və böyük məhsul bazaları ayrıca hesablanır.</div>
    <div class="qct-pricing-disclaimer"><strong>Xarici Xərclər:</strong> Platforma abunəlikləri, xarici hostinq, domen və reklam büdcələri xidmət haqqına daxil deyil. Bütün şərtlər yazılı müqavilədə göstərilir.</div>
  </div>

  <div class="qct-hero-actions"><a class="qct-btn qct-btn-primary" href="/az/#qiymet-hesabla">Canlı hesablayın <span>→</span></a><a class="qct-text-link" href="/az/elaqe/">Ətraflı təklif alın</a></div>
</div></section>

<section class="qct-pricing-list"><div class="qct-shell">
  <div class="qct-price-category"><div><p class="qct-section-label">SAYT & E-TİCARƏT</p><h2>Layihə başına qiymətlər</h2></div><div class="qct-price-rows">
    <article><span>Landing / kampaniya səhifəsi</span><strong>390 AZN</strong><small>Bazar giriş qiyməti · normal 490 AZN-dən</small><p>1 səhifə, mobil uyğunluq, form/WhatsApp, əsas texniki SEO və 2 reviziya turu.</p></article>
    <article><span>Korporativ veb sayt</span><strong>690 AZN</strong><small>Bazar giriş qiyməti · normal 890 AZN-dən</small><p>5 əsas səhifəyə qədər, 1 dil, mobil uyğunluq, əlaqə axını və əsas texniki SEO. Mətn istehsalı ayrıca.</p></article>
    <article><span>Şəxsi / portfel saytı</span><strong>490 AZN</strong><small>Bazar giriş qiyməti · normal 590 AZN-dən</small><p>4 əsas səhifəyə qədər, mobil quruluş və standart əlaqə axını.</p></article>
    <article><span>Çoxdilli korporativ sayt</span><strong>1.190 AZN</strong><small>Bazar giriş qiyməti · normal 1.490 AZN-dən</small><p>5 əsas səhifə, 2 dil üçün texniki dil infrastrukturu, ayrıca URL və hreflang. Peşəkar tərcümə/lokalizasiya ayrıca.</p></article>
    <article><span>E-ticarət qurulması</span><strong>1.190 AZN</strong><small>Bazar giriş qiyməti · normal 1.490 AZN-dən</small><p>Əsas mağaza qurulması, kateqoriya/menyu, ödəniş-kargo hazırlığı və məlumatlar hazırdırsa <strong>10 məhsula qədər standart giriş daxil.</strong></p></article>
    <article><span>E-ticarət — geniş əhatə</span><strong>Təklif</strong><small>Normal qiymət 1.990 AZN-dən</small><p>Çox məhsul, xüsusi dizayn, B2B qiymətləndirmə, ERP/CRM, xüsusi checkout və əlavə inteqrasiyalar.</p></article>
    <article><span>Mövcud saytın yenilənməsi</span><strong>390 AZN</strong><small>Bazar giriş qiyməti · normal 490 AZN-dən</small><p>5 prioritet səhifəyə qədər vizual/mobil düzəliş və əsas texniki yoxlama. Tam yenidən dizayn ayrıca.</p></article>
    <article><span>Sayt analizi və inkişaf planı</span><strong>150 AZN</strong><small>Bazar giriş qiyməti · normal 190 AZN</small><p>Texniki, mobil, sürət, SEO və dönüşüm yoxlaması; prioritet fəaliyyət siyahısı. Kod tətbiqi daxil deyil.</p></article>
    <article><span>Platforma köçürülməsi</span><strong>690 AZN-dən</strong><small>Normal qiymət 890 AZN-dən</small><p>25 məhsula və ya 10 məzmun səhifəsinə qədər əsas köçürmə və URL yönləndirmə planı. Böyük həcm ayrıca.</p></article>
  </div></div>

  <div class="qct-price-category"><div><p class="qct-section-label">GÖRÜNÜRLÜK & SATIŞ</p><h2>SEO, reklam və avtomatlaşdırma</h2></div><div class="qct-price-rows">
    <article><span>Texniki SEO — birdəfəlik</span><strong>290–390 AZN</strong><p>Tarama, indeks, canonical, sitemap, metadata, mobil və performans yoxlaması; əhatəyə görə əsas düzəlişlər.</p></article>
    <article><span>SEO Care</span><strong>290 AZN/ay</strong><p>Texniki SEO izləmə, Search Console, sitemap/index və əsas metadata optimallaşdırması.</p></article>
    <article><span>Dinamik SEO</span><strong>390 AZN/ay</strong><p>SEO Care + sorğu analizi, schema, daxili linklər, GEO/AEO/AIO optimallaşdırması və ayda 1 orijinal məqalə.</p></article>
    <article><span>SEO Growth</span><strong>590 AZN/ay</strong><p>Dinamik SEO + ayda 2 orijinal məqalə, landing page inkişafı, rəqib/sorğu analizi və daha geniş optimallaşdırma.</p></article>
    <article><span>GA4 + Search Console qurulması</span><strong>100–150 AZN</strong><p>Əsas ölçüm, doğrulama və əsas dönüşüm hadisələrinin yoxlanması.</p></article>
    <article><span>Merchant Center qurulması</span><strong>150–250 AZN</strong><p>Hesab, əsas feed hazırlığı və ilkin yoxlama; məhsul məlumatı müştəridən hazır gəlir.</p></article>
    <article><span>Sürət optimallaşdırması</span><strong>190–290 AZN</strong><p>Əsas performans problemləri, şəkil/asset və front-end optimallaşdırması; server/platform limiti ayrıca qeyd olunur.</p></article>
    <article><span>WhatsApp satış axını — əsas</span><strong>190–390 AZN</strong><p>Sayt CTA-ları, hazır mesaj konteksti, əsas sorğu yönləndirməsi və satış axını.</p></article>
    <article><span>WhatsApp / CRM — inkişaf etmiş</span><strong>590 AZN-dən</strong><p>Çoxlu komanda, qayda əsaslı yönləndirmə, CRM/API və əlavə avtomatlaşdırma ehtiyacları.</p></article>
    <article><span>Meta reklamı — hesab/kampaniya qurulması</span><strong>150–250 AZN</strong><p>Əsas kampaniya quruluşu, ölçüm və ilkin konfiqurasiya. Reklam büdcəsi daxil deyil.</p></article>
    <article><span>Meta reklam idarəetməsi</span><strong>250–490 AZN/ay</strong><p>Davamlı kampaniya nəzarəti və optimallaşdırma; kreativ istehsalı və reklam büdcəsi ayrıca.</p></article>
    <article><span>Sadə AI avtomatlaşdırması</span><strong>490 AZN-dən</strong><p>Bir aydın iş axını: lead təsnifatı, məlumat ötürülməsi və ya standart əməliyyat addımı.</p></article>
    <article><span>İnteqrasiyalı AI avtomatlaşdırması</span><strong>990 AZN-dən</strong><p>CRM/API, çox mərhələli workflow və daha geniş əməliyyat inteqrasiyası.</p></article>
    <article><span>Avtomatlaşdırma baxımı</span><strong>120–250 AZN/ay</strong><p>Mövcud workflow-ların izlənməsi, kiçik qayda düzəlişləri və texniki dəstək.</p></article>
  </div></div>
</div></section>

<section class="qct-benefits"><div class="qct-shell"><div class="qct-section-head"><div><p class="qct-section-label">ƏHATƏ QAYDALARI</p><h2>Qiymət ucuz görünmək üçün deyil, nə aldığınızı aydın etmək üçündür.</h2></div></div><div class="qct-benefit-grid">
  <article><h3>Məhsul girişi</h3><p>1.190 AZN e-ticarət giriş paketinə 10 məhsula qədər standart giriş daxildir. Əlavə məhsul, kompleks variant, təsvir yazılması və şəkil redaktəsi ayrıca.</p></article>
  <article><h3>Çox dil</h3><p>Çoxdilli paket texniki dil quruluşunu əhatə edir; peşəkar tərcümə və bazara uyğun lokalizasiya mətnləri daxil deyil.</p></article>
  <article><h3>Reviziya</h3><p>Başlanğıc sayt paketlərində 2 reviziya turu daxildir. Yeni səhifə və yeni funksiya əlavə reviziya deyil, əhatə dəyişikliyidir.</p></article>
  <article><h3>SEO və AI</h3><p>SEO/GEO/AEO/AIO görünürlük siqnallarını gücləndirir; Google, ChatGPT və digər platformalarda sıralama və görünürlük zəmanəti verilmir.</p></article>
</div></div></section>

<section class="qct-pricing-faq"><div class="qct-shell"><p class="qct-section-label">TEZ-TEZ VERİLƏN SUALLAR</p><h2>Qiymətləndirmə haqqında</h2><div class="qct-faq-grid">{faq.map(i=><details><summary>{i.q}</summary><p>{i.a}</p></details>)}</div></div></section>
<section class="qct-close"><div class="qct-shell qct-close-grid"><div><p class="qct-section-label">60 SANİYƏDƏ BAŞLAYIN</p><h2>Ehtiyacınızı seçin.<br/><em>Giriş qiymətini görün.</em></h2></div><a class="qct-btn qct-btn-light" href="/az/#qiymet-hesabla">Canlı hesablayın <span>→</span></a></div></section>
</div>
<Footer slot="footer" lang="az" />
</BaseLayout>
