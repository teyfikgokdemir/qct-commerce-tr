---
interface Props { lang: string; }
const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const isEnglish = lang === 'en';
const isGeorgian = lang === 'ka';

const serviceLinks = isEnglish ? [
  ['E-commerce Systems', '/en/ecommerce/'],
  ['B2B Web Design', '/en/web-design/'],
  ['SEO, GEO, AEO & AIO', '/en/search-visibility/'],
  ['AI & Sales Automation', '/en/ai-automation/']
] : [
  ['Tüm Hizmetler', '/hizmetler/'],
  ['E-Ticaret Altyapısı', '/e-ticaret/'],
  ['Shopify Kurulum', '/shopify-magaza-kurulumu/'],
  ['ikas Kurulum', '/ikas-magaza-kurulumu/'],
  ['Web Tasarım', '/web-tasarim/'],
  ['WhatsApp Satış', '/whatsapp-satis/'],
  ['SEO, GEO & AIO', '/seo-geo/'],
  ['Meta Reklamları', '/meta-reklamlari/'],
  ['Yapay Zekâ', '/yapay-zeka-otomasyonlari/']
];

const quickLinks = isGeorgian ? [
  ['მთავარი', '/ka/georgia/'],
  ['ვისთვისაა', '/ka/georgia/#fit'],
  ['გადაწყვეტილებები', '/ka/georgia/#system'],
  ['აუდიტი', '/ka/georgia/#audit'],
  ['კონტაქტი', 'mailto:info@qctcommerce.com']
] : isEnglish ? [
  ['Home', '/en/'],
  ['Work', '/en/work/'],
  ['About', '/en/about/'],
  ['How We Work', '/en/how-we-work/'],
  ['Audit', '/en/audit/'],
  ['Contact', '/en/contact/']
] : [
  ['Ana Sayfa', '/'],
  ['Çalışmalar', '/calismalar/'],
  ['Hakkımızda', '/hakkimizda/'],
  ['Fiyatlar', '/fiyatlar/'],
  ['Blog', '/blog/'],
  ['İletişim', '/iletisim/']
];

const servicePaths = ['/hizmetler/', '/e-ticaret/', '/web-tasarim/', '/whatsapp-satis/', '/seo-geo/', '/meta-reklamlari/', '/yapay-zeka-otomasyonlari/'];
const englishServicePaths = ['/en/ecommerce/', '/en/web-design/', '/en/search-visibility/', '/en/ai-automation/'];
const isCurrent = (path: string) => currentPath === path;
const isServiceCurrent = servicePaths.includes(currentPath);
const isEnglishServiceCurrent = englishServicePaths.includes(currentPath);
---
<header id="masthead" class="site-header" data-site-header>
  <div class="site-header__inner container">
    <div class="site-branding"><a class="site-title" href={isGeorgian ? '/ka/georgia/' : isEnglish ? '/en/' : '/'} rel="home">QCT Commerce</a></div>
    <button class="site-menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" data-menu-toggle>
      <span class="screen-reader-text">{isGeorgian ? 'მენიუს გახსნა' : isEnglish ? 'Open menu' : 'Menüyü aç'}</span><span class="site-menu-toggle__bar"></span><span class="site-menu-toggle__bar"></span>
    </button>
    
    <nav id="site-navigation" class="main-navigation" aria-label={isGeorgian ? 'მთავარი მენიუ' : isEnglish ? 'Main menu' : 'Ana menü'} aria-hidden="true">
      <div class="mobile-nav-head">
        <span class="mobile-nav-title">{isGeorgian ? 'QCT COMMERCE' : isEnglish ? 'QCT COMMERCE' : 'QCT COMMERCE'}</span>
        <button class="mobile-nav-close" type="button" aria-label={isGeorgian ? 'მენიუს დახურვა' : isEnglish ? 'Close menu' : 'Menüyü kapat'} data-mobile-close>×</button>
      </div>
      <!-- MOBILE ONLY PANEL -->
      <div class="mobile-only-panel">
        <nav class="qct-mobile-primary" aria-label={isEnglish ? 'Mobile navigation' : 'Mobil navigasyon'}>
          {quickLinks.map(([label, href]) => (
            <a href={href} class="qct-mobile-primary__link">
              <span>{label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>

        {!isGeorgian && (
          <div class="qct-mobile-services">
            <div class="qct-mobile-section-head">
              <span>{isEnglish ? 'SERVICES' : 'HİZMETLER'}</span>
              <small>{isEnglish ? 'What we do' : 'Neler yapıyoruz'}</small>
            </div>
            <div class="qct-mobile-services__grid">
              {serviceLinks.map(([label, href]) => (
                <a href={href}>{label}</a>
              ))}
            </div>
          </div>
        )}

        <div class="qct-mobile-bottom">
          <div class="qct-mobile-languages" aria-label={isEnglish ? 'Language' : 'Dil seçimi'}>
            <a href="/" class:list={[{ active: !isEnglish && !isGeorgian }]}>TR</a>
            <a href="/en/" class:list={[{ active: isEnglish }]}>EN</a>
            <a href="/ka/georgia/" class:list={[{ active: isGeorgian }]}>KA</a>
          </div>
          <a class="qct-mobile-project" href={isEnglish ? "/en/contact/" : "/iletisim/"}>
            <span>{isEnglish ? 'Start a project' : 'Proje başlat'}</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <!-- DESKTOP ONLY NAVIGATION (Aesthetic 1-Column Dark Dropdown) -->
      <div class="desktop-only-menu">
        {isGeorgian ? (
          <ul class="primary-menu">
            <li><a href="/ka/georgia/" aria-current="page">მთავარი</a></li><li><a href="/ka/georgia/#fit">ვისთვისაა</a></li><li><a href="/ka/georgia/#system">გადაწყვეტილებები</a></li><li><a href="/ka/georgia/#audit">აუდიტი</a></li><li><a href="mailto:info@qctcommerce.com">კონტაქტი</a></li><li><a href="/en/georgia/" hreflang="en">EN</a></li>
          </ul>
        ) : isEnglish ? (
          <ul class="primary-menu">
            <li><a href="/en/" aria-current={isCurrent('/en/') ? 'page' : undefined}>Home</a></li>
            <li class:list={['menu-item-has-children', { 'is-current': isEnglishServiceCurrent }]}>
              <button class="submenu-toggle" type="button" aria-expanded="false" data-submenu-toggle><span>Solutions</span></button>
              <ul class="sub-menu">
                <li><a href="/en/ecommerce/">E-commerce systems</a></li><li><a href="/en/web-design/">B2B web design</a></li><li><a href="/en/search-visibility/">SEO, GEO, AEO & AIO</a></li><li><a href="/en/ai-automation/">AI & sales automation</a></li>
              </ul>
            </li>
            <li class="menu-item-has-children"><button class="submenu-toggle" type="button" aria-expanded="false" data-submenu-toggle><span>Work</span></button><ul class="sub-menu"><li><a href="/en/work/" aria-current={isCurrent('/en/work/') ? 'page' : undefined}>View selected work</a></li><li><a href="/en/contact/">Start a project</a></li></ul></li><li><a href="/en/about/" aria-current={isCurrent('/en/about/') ? 'page' : undefined}>About</a></li><li><a href="/en/georgia/" aria-current={isCurrent('/en/georgia/') ? 'page' : undefined}>Georgia</a></li><li><a href="/en/how-we-work/" aria-current={isCurrent('/en/how-we-work/') ? 'page' : undefined}>How we work</a></li><li><a href="/en/audit/" aria-current={isCurrent('/en/audit/') ? 'page' : undefined}>Audit</a></li><li><a href="/en/contact/" aria-current={isCurrent('/en/contact/') ? 'page' : undefined}>Contact</a></li>
            {currentPath === '/en/georgia/' && <li><a href="/ka/georgia/" hreflang="ka">KA</a></li>}<li><a href="/" hreflang="tr">TR</a></li>
          </ul>
        ) : (
          <ul class="primary-menu">
            <li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Ana sayfa</a></li>
            <li class:list={['menu-item-has-children', { 'is-current': isServiceCurrent }]}><button class="submenu-toggle" type="button" aria-expanded="false" data-submenu-toggle><span>Hizmetler</span></button><ul class="sub-menu"><li><a href="/hizmetler/">Tüm hizmetler</a></li><li><a href="/e-ticaret/">E-ticaret altyapısı</a></li><li><a href="/shopify-magaza-kurulumu/">Shopify kurulum</a></li><li><a href="/ikas-magaza-kurulumu/">ikas kurulum</a></li><li><a href="/web-tasarim/">Web tasarım</a></li><li><a href="/whatsapp-satis/">WhatsApp satış sistemleri</a></li><li><a href="/seo-geo/">SEO, GEO, AEO ve AIO</a></li><li><a href="/meta-reklamlari/">Meta reklamları</a></li><li><a href="/yapay-zeka-otomasyonlari/">Yapay zekâ otomasyonları</a></li></ul></li>
            <li class="menu-item-has-children"><button class="submenu-toggle" type="button" aria-expanded="false" data-submenu-toggle><span>Çalışmalar</span></button><ul class="sub-menu"><li><a href="/calismalar/">Çalışmaları gör</a></li><li><a href="/iletisim/">Proje başlat</a></li></ul></li><li><a href="/hakkimizda/">Hakkımızda</a></li><li><a href="/fiyatlar/" aria-current={isCurrent('/fiyatlar/') ? 'page' : undefined}>Fiyatlar</a></li><li><a href="/blog/">Blog</a></li><li><a href="/iletisim/">İletişim</a></li><li><a href="/en/" hreflang="en">EN</a></li>
          </ul>
        )}
      </div>
    </nav>
  </div>
</header>
<div class="mobile-menu-backdrop" data-mobile-backdrop hidden></div>

<style is:global>
  @media (min-width: 1000px) {
    .mobile-nav-head {
      display: none !important;
    }
    .mobile-only-panel {
      display: none !important;
    }

    .desktop-only-menu {
      display: flex !important;
      align-items: center !important;
    }

    .primary-menu > li > a,
    .submenu-toggle,
    .submenu-toggle span {
      color: #111118 !important;
      font-weight: 800 !important;
      font-size: 0.88rem !important;
    }

    .primary-menu > li > a:hover,
    .submenu-toggle:hover {
      color: #e66b5f !important;
    }

    /* Desktop Aesthetic 1-Column Dark Dropdown Popover */
    .sub-menu {
      position: absolute !important;
      top: calc(100% + 8px) !important;
      left: 0 !important;
      width: 280px !important;
      min-width: 280px !important;
      background: #111118 !important;
      border: 1px solid rgba(255, 255, 255, 0.12) !important;
      border-radius: 16px !important;
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.65) !important;
      padding: 8px !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 2px !important;
      z-index: 9999 !important;
    }

    .sub-menu li {
      list-style: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .sub-menu a {
      background: transparent !important;
      border: none !important;
      color: #f1f2f6 !important;
      font-size: 0.86rem !important;
      font-weight: 600 !important;
      padding: 10px 14px !important;
      border-radius: 10px !important;
      white-space: nowrap !important;
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      transition: background 180ms ease, color 180ms ease, transform 180ms ease !important;
    }

    .sub-menu a:hover,
    .sub-menu a:focus-visible {
      background: rgba(255, 255, 255, 0.08) !important;
      color: #ffffff !important;
      transform: translateX(3px) !important;
    }
  }

  @media (max-width: 999px) {
    .desktop-only-menu {
      display: none !important;
    }

    .mobile-nav-head {
      display: flex !important;
      position: sticky;
      top: 0;
      z-index: 2;
      background: rgba(10,10,16,.96);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }
    .mobile-only-panel {
      display: flex !important;
      flex-direction: column !important;
      gap: 10px !important;
      width: 100% !important;
    }
  }

  /* ctseg Standard Mythborn Mobile Cards 1:1 */
  .mobile-myth-card {
    background: #1d222b !important;
    border: 1.5px solid #363e4d !important;
    border-radius: 16px !important;
    padding: 14px !important;
    margin-bottom: 8px !important;
  }

  .myth-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .myth-card-title {
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #ffffff !important;
    text-transform: uppercase;
  }

  .myth-card-badge {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 3px 7px;
    border-radius: 6px;
    background: #e66b5f;
    color: #ffffff !important;
  }

  .mobile-lang-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .mobile-lang-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10px 4px;
    border-radius: 12px;
    border: 1.5px solid #3d4757;
    background: #262d3a;
    color: #ffffff !important;
    text-decoration: none;
    text-align: center;
  }

  .mobile-lang-item.active {
    background: #e66b5f !important;
    border-color: #f0887e !important;
  }

  .mobile-lang-item .lang-code {
    font-size: 0.85rem;
    font-weight: 800;
    color: #ffffff !important;
    display: block;
  }

  .mobile-lang-item .lang-name {
    font-size: 0.65rem;
    color: #d2d6df !important;
    margin-top: 2px;
    font-weight: 600;
    display: block;
  }

  .mobile-solutions-grid,
  .mobile-nav-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    margin-top: 4px;
  }

  .mobile-solution-item,
  .mobile-nav-item {
    display: flex;
    flex-direction: column;
    padding: 12px;
    border-radius: 12px;
    background: #262d3a !important;
    border: 1.5px solid #3d4757 !important;
    color: #ffffff !important;
    text-decoration: none;
  }

  .mobile-solution-item .sol-title,
  .mobile-nav-item strong {
    font-size: 0.85rem;
    font-weight: 800;
    color: #ffffff !important;
  }

  .mobile-cta-btn {
    width: 100% !important;
    min-height: 50px !important;
    margin-top: 6px !important;
    border-radius: 14px !important;
    background: #e66b5f !important;
    color: #ffffff !important;
    font-size: 0.95rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.08em !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
  }
</style>
<style is:global>
@media (max-width:999px){
  .site-menu-toggle{touch-action:manipulation}
  .main-navigation.is-open{display:flex!important}
  .mobile-nav-close{touch-action:manipulation}
}
</style>

