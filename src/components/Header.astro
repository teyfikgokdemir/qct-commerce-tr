---
interface Props { lang: string; }
const currentPath = Astro.url.pathname;
const servicePaths = ['/hizmetler/', '/e-ticaret/', '/web-tasarim/', '/whatsapp-satis/', '/seo-geo/', '/meta-reklamlari/', '/yapay-zeka-otomasyonlari/'];
const isCurrent = (path: string) => currentPath === path;
const isServiceCurrent = servicePaths.includes(currentPath);
---
<header id="masthead" class="site-header" data-site-header>
	<div class="site-header__inner container">
		<div class="site-branding">
			<a class="site-title" href="/" rel="home">QCT Commerce</a>
		</div>

		<button class="site-menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" data-menu-toggle>
			<span class="screen-reader-text">Menüyü aç</span>
			<span class="site-menu-toggle__bar"></span>
			<span class="site-menu-toggle__bar"></span>
		</button>

		<nav id="site-navigation" class="main-navigation" aria-label="Ana menü">
			<ul class="primary-menu">
				<li><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>Ana sayfa</a></li>
				<li class:list={['menu-item-has-children', { 'is-current': isServiceCurrent }]}>
					<button class="submenu-toggle" type="button" aria-expanded="false" data-submenu-toggle><span>Hizmetler</span></button>
					<ul class="sub-menu">
						<li><a href="/hizmetler/" aria-current={isCurrent('/hizmetler/') ? 'page' : undefined}>Tüm hizmetler</a></li>
						<li><a href="/e-ticaret/" aria-current={isCurrent('/e-ticaret/') ? 'page' : undefined}>E-ticaret altyapısı</a></li>
						<li><a href="/web-tasarim/" aria-current={isCurrent('/web-tasarim/') ? 'page' : undefined}>Web tasarım</a></li>
						<li><a href="/whatsapp-satis/" aria-current={isCurrent('/whatsapp-satis/') ? 'page' : undefined}>WhatsApp satış sistemleri</a></li>
						<li><a href="/seo-geo/" aria-current={isCurrent('/seo-geo/') ? 'page' : undefined}>SEO, GEO, AEO ve AIO</a></li>
						<li><a href="/meta-reklamlari/" aria-current={isCurrent('/meta-reklamlari/') ? 'page' : undefined}>Meta reklamları</a></li>
						<li>
							<a href="/yapay-zeka-otomasyonlari/" aria-current={isCurrent('/yapay-zeka-otomasyonlari/') ? 'page' : undefined}>Yapay zekâ otomasyonları</a>
						</li>
					</ul>
				</li>
				<li><a href="/calismalar/" aria-current={currentPath.startsWith('/calismalar/') ? 'page' : undefined}>Çalışmalar</a></li>
				<li><a href="/hakkimizda/" aria-current={isCurrent('/hakkimizda/') ? 'page' : undefined}>Hakkımızda</a></li>
				<li><a href="/blog/" aria-current={currentPath.startsWith('/blog/') ? 'page' : undefined}>Blog</a></li>
				<li><a href="/iletisim/" aria-current={isCurrent('/iletisim/') ? 'page' : undefined}>İletişim</a></li>
			</ul>
		</nav>
	</div>
</header>
