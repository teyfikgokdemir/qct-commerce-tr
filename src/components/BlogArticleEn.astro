---
import BaseLayout from '../layouts/BaseLayout.astro';import Header from './Header.astro';import Footer from './Footer.astro';import type {BlogArticleEn} from '../data/blog-en';
interface Props{article:BlogArticleEn} const {article}=Astro.props;const SITE='https://qctcommerce.com';const canonical=new URL('/en/blog/'+article.slug+'/',SITE).toString();const schema={'@context':'https://schema.org','@type':'Article','@id':canonical+'#article',headline:article.title,description:article.description,datePublished:article.published,dateModified:article.modified,inLanguage:'en-US',author:{'@id':SITE+'/#organization'},publisher:{'@id':SITE+'/#organization'},mainEntityOfPage:{'@id':canonical+'#webpage'}};
---
<BaseLayout title={article.title} description={article.description} lang="en" breadcrumbLabel={article.title}><Header slot="header" lang="en"/><script slot="schema" type="application/ld+json" set:html={JSON.stringify(schema)}/><article class="qct-article"><header><div class="container"><nav class="qct-breadcrumb"><a href="/en/">Home</a><span>/</span><a href="/en/blog/">Blog</a></nav><p class="qct-section__eyebrow">GUIDE</p><h1>{article.title}</h1><p class="lead">{article.intro}</p></div></header><div class="container layout"><aside><h2>Short answer</h2><ul>{article.summary.map(x=><li>{x}</li>)}</ul></aside><main>{article.sections.map(s=><section><h2>{s.heading}</h2>{s.paragraphs.map(p=><p>{p}</p>)}</section>)}<div class="related"><h2>Related service</h2><a href={article.relatedHref}>{article.relatedLabel} →</a></div></main></div></article><Footer slot="footer" lang="en"/></BaseLayout>
<style>.qct-article header{padding:calc(var(--qct-hero-clearance) + 46px) 0 62px;border-bottom:1px solid var(--qct-color-line)}.qct-article h1{font-size:clamp(2.5rem,4.5vw,4rem);max-width:22ch}.lead{font-size:1.15rem;line-height:1.75;max-width:820px;color:var(--qct-color-muted)}.layout{display:grid;grid-template-columns:minmax(220px,.35fr) minmax(0,.9fr);gap:70px;padding:70px 20px}.layout aside{align-self:start;position:sticky;top:var(--qct-anchor-offset)}.layout aside li,.layout main p{color:var(--qct-color-muted);line-height:1.75}.layout main section{padding:28px 0;border-top:1px solid var(--qct-color-line)}.related{padding:28px;background:var(--qct-color-ink);color:white}.related a{color:white}@media(max-width:760px){.layout{grid-template-columns:1fr;gap:30px}.layout aside{position:static}}</style>