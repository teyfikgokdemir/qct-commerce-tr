---
interface Props { lang: 'tr' | 'en'; }
const { lang } = Astro.props;
const isEnglish = lang === 'en';
const copy = isEnglish ? {
  eyebrow:'SHORT PROJECT BRIEF',
  title:'Give us the commercial context before the first call.',
  intro:'A few structured answers are enough. Nothing is sent until you choose WhatsApp.',
  labels:{business:'Business type',platform:'Current platform',market:'Target market',priority:'Main priority',timeline:'Target timing',website:'Current website (optional)'},
  placeholders:{market:'e.g. Türkiye, Germany, GCC',website:'https://'},
  submit:'Create WhatsApp brief',
  options:{
    business:['Manufacturer','Exporter','Distributor / B2B','E-commerce brand','Service business','Other'],
    platform:['No current platform','Shopify','ikas','WooCommerce','Ticimax','IdeaSoft','Custom / other'],
    priority:['New website / store','Platform migration','Conversion improvement','SEO / AI visibility','WhatsApp sales flow','Advertising / landing pages','Automation / operations'],
    timeline:['As soon as possible','Within 1 month','1–3 months','3+ months','Not decided']
  }
} : {
  eyebrow:'KISA PROJE BRİEFİ',
  title:'İlk görüşmeden önce ticari bağlamı netleştirelim.',
  intro:'Birkaç yapılandırılmış cevap yeterli. WhatsApp’ı seçmeden hiçbir bilgi gönderilmez.',
  labels:{business:'İşletme türü',platform:'Mevcut platform',market:'Hedef pazar',priority:'Öncelikli ihtiyaç',timeline:'Hedef zamanlama',website:'Mevcut web sitesi (opsiyonel)'},
  placeholders:{market:'Örn. Türkiye, Almanya, Körfez ülkeleri',website:'https://'},
  submit:'WhatsApp briefi oluştur',
  options:{
    business:['Üretici','İhracatçı','Distribütör / B2B','E-ticaret markası','Hizmet işletmesi','Diğer'],
    platform:['Mevcut platform yok','Shopify','ikas','WooCommerce','Ticimax','IdeaSoft','Özel / diğer'],
    priority:['Yeni web sitesi / mağaza','Platform taşıma','Dönüşüm iyileştirme','SEO / AI görünürlüğü','WhatsApp satış akışı','Reklam / landing page','Otomasyon / operasyon'],
    timeline:['Mümkün olan en kısa sürede','1 ay içinde','1–3 ay','3+ ay','Henüz net değil']
  }
};
---
<section class="section qct-brief" aria-labelledby="qct-brief-title">
  <div class="container qct-brief__grid">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="qct-brief-title">{copy.title}</h2>
      <p>{copy.intro}</p>
    </div>
    <form class="qct-brief__form" data-lead-brief>
      <label><span>{copy.labels.business}</span><select name="business" required><option value=""></option>{copy.options.business.map(v=><option value={v}>{v}</option>)}</select></label>
      <label><span>{copy.labels.platform}</span><select name="platform" required><option value=""></option>{copy.options.platform.map(v=><option value={v}>{v}</option>)}</select></label>
      <label><span>{copy.labels.market}</span><input name="market" type="text" placeholder={copy.placeholders.market} required /></label>
      <label><span>{copy.labels.priority}</span><select name="priority" required><option value=""></option>{copy.options.priority.map(v=><option value={v}>{v}</option>)}</select></label>
      <label><span>{copy.labels.timeline}</span><select name="timeline" required><option value=""></option>{copy.options.timeline.map(v=><option value={v}>{v}</option>)}</select></label>
      <label><span>{copy.labels.website}</span><input name="website" type="url" placeholder={copy.placeholders.website} /></label>
      <button class="button button--primary" type="submit">{copy.submit}</button>
    </form>
  </div>
</section>

<script is:inline define:vars={{ isEnglish }}>
(() => {
  const form = document.querySelector('[data-lead-brief]');
  if (!(form instanceof HTMLFormElement)) return;
  let started = false;
  const track = (name) => {
    if (typeof window.qctTrackEvent === 'function') window.qctTrackEvent(name, { form_name: 'project_brief' });
  };
  form.addEventListener('input', () => {
    if (!started) {
      started = true;
      track('form_start');
    }
  }, { once: true });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const values = Object.fromEntries(data.entries());
    const labels = isEnglish
      ? ['Business type','Current platform','Target market','Main priority','Target timing','Current website']
      : ['İşletme türü','Mevcut platform','Hedef pazar','Öncelikli ihtiyaç','Hedef zamanlama','Mevcut web sitesi'];
    const keys = ['business','platform','market','priority','timeline','website'];
    const intro = isEnglish
      ? 'Hello QCT Commerce, I completed the short project brief:'
      : 'Merhaba QCT Commerce, kısa proje briefini doldurdum:';
    const lines = keys.map((key, i) => values[key] ? labels[i] + ': ' + values[key] : '').filter(Boolean);
    const message = [intro, ...lines].join('\n');
    track('form_submit');
    window.open('https://wa.me/905456782655?text=' + encodeURIComponent(message), '_blank', 'noopener,noreferrer');
  });
})();
</script>

<style>
.qct-brief { background:linear-gradient(180deg,#f8f3ef,#efe6e1); border-block:1px solid rgba(23,21,20,.08); }
.qct-brief__grid { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:clamp(2rem,6vw,5rem); align-items:start; }
.qct-brief__grid h2 { margin:.5rem 0 1rem; font-size:clamp(2rem,4vw,3.4rem); line-height:1.05; letter-spacing:-.035em; max-width:13ch; }
.qct-brief__grid>div>p:last-child { color:#665e59; line-height:1.7; max-width:46ch; }
.qct-brief__form { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; padding:clamp(1.25rem,3vw,2rem); background:#fffaf5; border:1px solid rgba(73,53,49,.12); border-radius:24px; box-shadow:0 18px 48px rgba(58,37,32,.07); }
.qct-brief__form label { display:grid; gap:.45rem; }
.qct-brief__form label span { font-size:.78rem; font-weight:800; letter-spacing:.04em; color:#4f4743; }
.qct-brief__form input,.qct-brief__form select { width:100%; min-height:48px; border:1px solid rgba(73,53,49,.18); border-radius:12px; background:#fff; color:#171514; padding:.72rem .8rem; font:inherit; }
.qct-brief__form input:focus,.qct-brief__form select:focus { outline:2px solid rgba(230,107,95,.28); border-color:#e66b5f; }
.qct-brief__form button { grid-column:1/-1; min-height:50px; justify-content:center; }
@media(max-width:820px){.qct-brief__grid{grid-template-columns:1fr}.qct-brief__form{grid-template-columns:1fr}.qct-brief__form button{grid-column:auto}}
</style>
