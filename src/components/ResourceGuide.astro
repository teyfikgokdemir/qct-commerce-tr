---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro';
import type { Resource } from '../data/resources';
const { resource } = Astro.props as { resource: Resource };
const canonical = `https://qctcommerce.com/rehberler/${resource.slug}/`;
const faqSchema = { '@context':'https://schema.org', '@type':'FAQPage', mainEntity: resource.faqs.map((faq) => ({ '@type':'Question', name:faq.q, acceptedAnswer:{ '@type':'Answer', text:faq.a } })) };
const articleSchema = { '@context':'https://schema.org', '@type':'Article', headline:resource.title, description:resource.description, inLanguage:'tr-TR', mainEntityOfPage:canonical, author:{'@id':'https://qctcommerce.com/#organization'}, publisher:{'@id':'https://qctcommerce.com/#organization'}, datePublished:resource.published, dateModified:resource.modified };
---
<BaseLayout title={`${resource.title} | QCT Commerce`} description={resource.description} lang="tr" type="article" pageType="WebPage" breadcrumbs={[{name:'Ana sayfa',url:'/'},{name:'Rehberler',url:'/rehberler/'},{name:resource.title,url:`/rehberler/${resource.slug}/`}] }>
  <Header slot="header" lang="tr" /><script slot="schema" type="application/ld+json" set:html={JSON.stringify(articleSchema)} /><script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <article class="resource"><header class="resource__hero"><div class="container"><nav><a href="/">Ana sayfa</a><span>/</span><a href="/rehberler/">Rehberler</a></nav><p>QCT COMMERCE KAYNAKLARI</p><h1>{resource.title}</h1><div class="resource__intro">{resource.intro}</div></div></header>
  <div class="container resource__grid"><aside><strong>Kısa cevap</strong><p>{resource.answer}</p><a href={resource.service.href}>{resource.service.label} →</a></aside><div class="resource__body">{resource.sections.map((section) => <section><h2>{section.heading}</h2><p>{section.text}</p>{section.points && <ul>{section.points.map((point) => <li>{point}</li>)}</ul>}</section>)}<section class="resource__comparison">{resource.table && <div class="resource__table-wrap" role="region" aria-label={resource.table.caption} tabindex="0"><table><caption>{resource.table.caption}</caption><thead><tr>{resource.table.headers.map((cell)=><th scope="col">{cell}</th>)}</tr></thead><tbody>{resource.table.rows.map((row)=><tr>{row.map((cell,i)=>i===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></div>}</section><section class="resource__example"><p>HESAPLAMA / UYGULAMA ÖRNEĞİ</p><h2>{resource.example.title}</h2><p>{resource.example.text}</p></section><p class="resource__date">Yayın: <time datetime={resource.published}>{resource.published}</time> · İçerik güncellemesi: <time datetime={resource.modified}>{resource.modified}</time></p>{resource.sources && <nav class="resource__sources" aria-label="Kaynaklar"><h2>Kaynaklar</h2>{resource.sources.map((source)=><a href={source.href}>{source.label}</a>)}</nav>}<section><h2>Sık sorulan sorular</h2>{resource.faqs.map((faq) => <details><summary>{faq.q}</summary><p>{faq.a}</p></details>)}</section><nav class="resource__related" aria-label="İlgili kaynaklar"><h2>İlgili kaynaklar</h2>{resource.related.map((item) => <a href={item.href}>{item.label}<span>→</span></a>)}</nav><section class="resource__cta"><h2>{resource.cta?.title}</h2><p>{resource.cta?.text}</p><a href="/iletisim/">Talep oluştur</a></section></div></div></article><Footer slot="footer" lang="tr" />
</BaseLayout>
<style>
.resource__body,.resource__grid aside{min-width:0}.resource__date{font-size:.8rem;color:var(--qct-color-muted)}.resource__sources{display:grid;gap:.6rem;padding-block:1.5rem}.resource__sources a{color:var(--qct-color-accent-strong)}.resource__table-wrap{max-width:100%;overflow-x:auto}.resource table{border-collapse:collapse;width:100%;min-width:440px;font-size:.88rem}.resource caption{text-align:left;font-weight:750;color:var(--qct-color-ink);margin-bottom:1rem}.resource th,.resource td{border-bottom:1px solid var(--qct-color-line);padding:12px;text-align:left;vertical-align:top;line-height:1.6}.resource th{color:var(--qct-color-ink)}.resource td{color:var(--qct-color-muted)}.resource{background:var(--qct-color-background);color:var(--qct-color-text)}.resource__hero{padding:calc(var(--qct-hero-clearance) + 64px) 0 70px;border-bottom:1px solid var(--qct-color-line);text-align:center}.resource__hero nav{display:flex;justify-content:center;gap:.6rem;font-size:.85rem;margin-bottom:2rem}.resource__hero nav a{color:var(--qct-color-muted)}.resource__hero>div>p,.resource__example>p{color:var(--qct-color-accent-strong);font-size:.75rem;font-weight:800;letter-spacing:.14em}.resource h1{color:var(--qct-color-ink);font-size:clamp(2.35rem,5vw,4.4rem);letter-spacing:-.055em;line-height:1.03;margin:0 auto 1.4rem;max-width:30ch;text-wrap:balance}.resource__intro{color:var(--qct-color-muted);font-size:1.12rem;line-height:1.75;margin:auto;max-width:760px}.resource__grid{display:grid;grid-template-columns:minmax(220px,.34fr) minmax(0,.9fr);gap:clamp(40px,7vw,100px);padding-block:clamp(54px,7vw,96px)}.resource__grid aside{align-self:start;border-top:3px solid var(--qct-color-accent);position:sticky;top:120px;padding-top:1rem}.resource__grid aside strong{color:var(--qct-color-ink);font-size:1.1rem}.resource__grid aside p{color:var(--qct-color-muted);line-height:1.65}.resource__grid aside a{color:var(--qct-color-accent-strong);font-weight:800}.resource__body section{border-top:1px solid var(--qct-color-line-strong);padding:clamp(28px,4vw,46px) 0}.resource h2{color:var(--qct-color-ink);font-size:clamp(1.48rem,2.7vw,2.2rem);letter-spacing:-.035em;line-height:1.18;margin:0 0 1rem;text-wrap:balance}.resource__body p,.resource li{color:var(--qct-color-muted);line-height:1.78}.resource li{margin:.45rem 0}.resource__example{background:#171412;border:0!important;padding:clamp(26px,4vw,42px)!important}.resource__example h2,.resource__example p{color:#fffaf5!important}.resource__example p:last-child{color:#d8d0c7!important}.resource details{border-top:1px solid var(--qct-color-line);padding:1rem 0}.resource details:last-child{border-bottom:1px solid var(--qct-color-line)}.resource summary{color:var(--qct-color-ink);cursor:pointer;font-weight:750}.resource details p{margin-bottom:0}.resource__related{display:grid;gap:.65rem;margin-top:1rem}.resource__related a{align-items:center;border:1px solid var(--qct-color-line-strong);color:var(--qct-color-ink);display:flex;justify-content:space-between;padding:1rem 1.1rem;text-decoration:none}.resource__related span{color:var(--qct-color-accent-strong)}.resource__cta{background:#eee9e2;border:0!important;margin-top:2rem;padding:clamp(26px,4vw,42px)!important}.resource__cta a{background:var(--qct-color-ink);color:#fffaf5;display:inline-block;font-weight:800;margin-top:.5rem;padding:.9rem 1.15rem;text-decoration:none}@media(max-width:760px){.resource__grid{grid-template-columns:1fr}.resource__grid aside{position:static}.resource__hero{padding-top:calc(var(--qct-hero-clearance) + 44px)}.resource h1{font-size:clamp(1.7rem,7vw,2.2rem);line-height:1.12}}
</style>
