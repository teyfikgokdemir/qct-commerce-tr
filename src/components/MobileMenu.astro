---
interface Props {
  lang: string;
  currentPath: string;
  trHref: string;
  enHref?: string;
  azHref?: string;
  serviceLinks: string[][];
  audienceLinks: string[][];
  quickLinks: string[][];
}
const { lang, currentPath, trHref, enHref, azHref, serviceLinks, audienceLinks, quickLinks } = Astro.props;
const isEnglish = lang === 'en';
const isAzerbaijani = lang === 'az';
const isCurrent = (path: string) => currentPath === path;
---
<div class="qctm-root" data-qctm-root>
  <button class="qctm-toggle" type="button" aria-expanded="false" aria-controls="qctm-panel" aria-label={isAzerbaijani ? 'Menyunu aç' : isEnglish ? 'Open menu' : 'Menüyü aç'} data-qctm-toggle>
    <span></span><span></span>
  </button>

  <div class="qctm-backdrop" data-qctm-backdrop hidden></div>

  <aside id="qctm-panel" class="qctm-panel" role="dialog" aria-label={isAzerbaijani ? 'Mobil menyu' : isEnglish ? 'Mobile menu' : 'Mobil menü'} aria-hidden="true" inert data-qctm-panel>
    <div class="qctm-head">
      <a class="qctm-brand" href={isAzerbaijani ? '/az/' : isEnglish ? '/en/' : '/'}>QCT COMMERCE</a>
      <button class="qctm-close" type="button" aria-label={isAzerbaijani ? 'Menyunu bağla' : isEnglish ? 'Close menu' : 'Menüyü kapat'} data-qctm-close>×</button>
    </div>

    <nav class="qctm-primary" aria-label={isAzerbaijani ? 'Mobil naviqasiya' : isEnglish ? 'Mobile navigation' : 'Mobil navigasyon'}>
      {quickLinks.map(([label, href]) => (
        <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
          <span>{label}</span><i aria-hidden="true">↗</i>
        </a>
      ))}
    </nav>

    {true && (
      <div class="qctm-groups">
        <section class="qctm-group" data-qctm-group>
          <button class="qctm-group-toggle" type="button" aria-expanded="false" data-qctm-group-toggle>
            <span><strong>{isAzerbaijani ? 'Xidmətlər' : isEnglish ? 'Solutions' : 'Hizmetler'}</strong><small>{isAzerbaijani ? 'Nə edirik' : isEnglish ? 'What we do' : 'Neler yapıyoruz'}</small></span>
            <i aria-hidden="true">+</i>
          </button>
          <div class="qctm-group-panel" hidden data-qctm-group-panel>
            {serviceLinks.map(([label, href]) => (
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}><span>{label}</span><i aria-hidden="true">↗</i></a>
            ))}
          </div>
        </section>

        <section class="qctm-group" data-qctm-group>
          <button class="qctm-group-toggle" type="button" aria-expanded="false" data-qctm-group-toggle>
            <span><strong>{isAzerbaijani ? 'Kimlər üçün' : isEnglish ? 'Who we help' : 'Kimler için'}</strong><small>{isAzerbaijani ? 'Biznes modelinizə görə başlayın' : isEnglish ? 'Choose your business context' : 'İşletme yapınıza göre başlayın'}</small></span>
            <i aria-hidden="true">+</i>
          </button>
          <div class="qctm-group-panel" hidden data-qctm-group-panel>
            {audienceLinks.map(([label, href]) => (
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}><span>{label}</span><i aria-hidden="true">↗</i></a>
            ))}
          </div>
        </section>
      </div>
    )}

    <div class="qctm-bottom">
      <div class="qctm-languages">
        <a href={trHref} hreflang="tr-TR" class:list={[{ active: !isEnglish && !isAzerbaijani }]}>TR</a>
        <a href={enHref} hreflang="en" class:list={[{ active: isEnglish }]}>EN</a>
        <a href={azHref} hreflang="az-AZ" class:list={[{ active: isAzerbaijani }]}>AZ</a>
      </div>
      <a class="qctm-project" href={isAzerbaijani ? 'mailto:info@qctcommerce.com?subject=Azerbaijan%20digital%20project' : isEnglish ? '/en/contact/' : '/iletisim/'}>
        <span>{isAzerbaijani ? 'Layihəyə başlayın' : isEnglish ? 'Start a project' : 'Proje başlat'}</span><i aria-hidden="true">→</i>
      </a>
    </div>
  </aside>
</div>

<script is:inline>
(() => {
  const root = document.querySelector('[data-qctm-root]');
  if (!root || root.dataset.ready === 'true') return;
  root.dataset.ready = 'true';

  const toggle = root.querySelector('[data-qctm-toggle]');
  const panel = root.querySelector('[data-qctm-panel]');
  const close = root.querySelector('[data-qctm-close]');
  const backdrop = root.querySelector('[data-qctm-backdrop]');
  if (!toggle || !panel || !close || !backdrop) return;

  const background = new Map();
  const desktop = window.matchMedia('(min-width: 1000px)');
  const focusable = () => [...panel.querySelectorAll('a[href], button:not([disabled]), [tabindex="0"]')]
    .filter((element) => !element.closest('[hidden], [inert]') && element.getClientRects().length);
  const isolateBackground = () => {
    // Isolate sibling branches up to body without making the panel's ancestors inert.
    for (let branch = root; branch.parentElement && branch !== document.body; branch = branch.parentElement) {
      for (const sibling of branch.parentElement.children) {
        if (sibling === branch) continue;
        background.set(sibling, sibling.inert);
        sibling.inert = true;
      }
    }
  };
  let scrollY = 0;

  const setOpen = (open) => {
    if (open === panel.classList.contains('is-open')) return;
    if (open) scrollY = window.scrollY;
    panel.inert = !open;
    toggle.setAttribute('aria-expanded', String(open));
    panel.classList.toggle('is-open', open);
    panel.setAttribute('aria-hidden', String(!open));
    backdrop.hidden = !open;
    document.documentElement.classList.toggle('qctm-lock', open);
    document.body.classList.toggle('qctm-lock', open);
    if (open) {
      panel.setAttribute('aria-modal', 'true');
      isolateBackground();
      close.focus({ preventScroll: true });
    } else {
      panel.removeAttribute('aria-modal');
      background.forEach((inert, element) => { element.inert = inert; });
      background.clear();
      window.scrollTo(0, scrollY);
      toggle.focus({ preventScroll: true });
    }
  };

  toggle.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  close.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();
    setOpen(false);
  });

  backdrop.addEventListener('click', () => setOpen(false));

  panel.addEventListener('click', (event) => {
    const groupToggle = event.target.closest('[data-qctm-group-toggle]');
    if (groupToggle) {
      event.preventDefault();
      event.stopPropagation();
      const group = groupToggle.closest('[data-qctm-group]');
      const groupPanel = group?.querySelector('[data-qctm-group-panel]');
      if (!group || !groupPanel) return;
      const open = groupToggle.getAttribute('aria-expanded') === 'true';
      groupToggle.setAttribute('aria-expanded', String(!open));
      group.classList.toggle('is-open', !open);
      groupPanel.hidden = open;
      return;
    }

    const link = event.target.closest('a[href]');
    if (link) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (!panel.classList.contains('is-open')) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      setOpen(false);
    } else if (event.key === 'Tab') {
      const items = focusable();
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && (document.activeElement === first || !panel.contains(document.activeElement))) {
        event.preventDefault();
        last?.focus();
      } else if (!event.shiftKey && (document.activeElement === last || !panel.contains(document.activeElement))) {
        event.preventDefault();
        first?.focus();
      }
    }
  });
  desktop.addEventListener('change', (event) => { if (event.matches) setOpen(false); });
})();
</script>

<style is:global>
@media (min-width:1000px){
  .qctm-root{display:none!important}
}
@media (max-width:999px){
  body.qctm-lock .site-header{z-index:10000!important}
  .qctm-root{display:block}
  .qctm-toggle{
    display:grid!important;
    place-items:center!important;
    gap:5px!important;
    width:46px!important;
    height:46px!important;
    padding:0!important;
    position:relative!important;
    z-index:170!important;
    cursor:pointer!important;
    border:1px solid rgba(0, 47, 167, .4)!important;
    border-radius:14px!important;
    background:
      rgba(9, 17, 30, .92)!important;
    box-shadow:
      0 10px 24px rgba(0,0,0,.18),
      inset 0 1px 0 rgba(255,255,255,.06)!important;
    transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease!important;
  }
  .qctm-toggle:hover,
  .qctm-toggle:focus-visible{
    transform:translateY(-1px)!important;
    border-color:#002fa7!important;
    box-shadow:
      0 14px 30px rgba(0,0,0,.24),
      0 0 0 3px rgba(0, 47, 167, .2),
      inset 0 1px 0 rgba(255,255,255,.08)!important;
  }
  .qctm-toggle span{
    display:block!important;
    width:19px!important;
    height:2px!important;
    background: #ffffff !important;
    border-radius:999px!important;
    box-shadow: none !important;
  }
  body.qctm-lock .qctm-toggle{
    opacity:0!important;
    visibility:hidden!important;
    pointer-events:none!important;
    transform:scale(.92)!important;
  }
  .qctm-backdrop{position:fixed!important;inset:0!important;z-index:159!important;background:rgba(5, 9, 16, .75)!important;backdrop-filter:blur(4px)!important}
  .qctm-backdrop[hidden]{display:none!important}
  .qctm-panel{
    position:fixed!important;inset:0!important;z-index:160!important;display:flex!important;flex-direction:column!important;gap:16px!important;
    width:100%!important;height:100dvh!important;overflow-y:auto!important;padding:calc(14px + env(safe-area-inset-top)) 16px calc(14px + env(safe-area-inset-bottom))!important;
    background: #090d16 !important;color: #f8fafc !important;transform:translateX(100%)!important;visibility:hidden!important;pointer-events:none!important;
    transition:transform .22s ease,visibility 0s .22s!important;overscroll-behavior:contain!important;contain:layout paint!important;
  }
  .qctm-panel.is-open{transform:translateX(0)!important;visibility:visible!important;pointer-events:auto!important;transition-delay:0s!important}
  html.qctm-lock,body.qctm-lock{overflow:hidden!important;overscroll-behavior:none!important}
  .qctm-head{display:flex!important;align-items:center!important;justify-content:space-between!important;padding-bottom:12px!important;border-bottom:1px solid rgba(255, 255, 255, .1)!important}
  .qctm-brand{color: #f8fafc !important;text-decoration:none!important;font-size:.82rem!important;font-weight:900!important;letter-spacing:.12em!important}
  .qctm-close{
    width:42px!important;
    height:42px!important;
    border-radius:14px!important;
    border:1px solid rgba(255, 255, 255, .14)!important;
    background:
      rgba(255, 255, 255, .06)!important;
    color:#60a5fa!important;
    font-size:19px!important;
    font-weight:500!important;
    cursor:pointer!important;
    box-shadow:inset 0 1px 0 rgba(255,255,255,.05)!important;
    transition:transform .18s ease,border-color .18s ease,background .18s ease!important;
  }
  .qctm-close:hover,
  .qctm-close:focus-visible{
    transform:rotate(3deg) scale(1.03)!important;
    border-color:#002fa7!important;
    background:rgba(0, 47, 167, .15)!important;
  }
  .qctm-primary{display:grid!important;grid-template-columns:1fr 1fr!important;gap:8px!important}
  .qctm-primary a{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:10px!important;min-height:54px!important;padding:12px 13px!important;border:1px solid rgba(255, 255, 255, .09)!important;border-radius:14px!important;background:rgba(255, 255, 255, .04)!important;color: #f8fafc !important;text-decoration:none!important;font-weight:800!important;font-size:.96rem!important}
  .qctm-primary a i,.qctm-group-panel a i{color:#60a5fa!important;font-style:normal!important}
  .qctm-groups{display:grid!important;gap:10px!important}
  .qctm-group{border:1px solid rgba(255, 255, 255, .1)!important;border-radius:16px!important;background:rgba(255, 255, 255, .04)!important;overflow:hidden!important}
  .qctm-group-toggle{width:100%!important;min-height:76px!important;padding:14px 16px!important;border:0!important;background:rgba(255, 255, 255, .04)!important;color: #f8fafc !important;display:grid!important;grid-template-columns:1fr auto!important;align-items:center!important;gap:14px!important;text-align:left!important;cursor:pointer!important}
  .qctm-group-toggle>span{display:grid!important;gap:4px!important}
  .qctm-group-toggle strong{color: #f8fafc !important;font-size:1.04rem!important;font-weight:900!important}
  .qctm-group-toggle small{color:rgba(148,163,184,.78)!important;font-size:.67rem!important}
  .qctm-group-toggle>i{color:#60a5fa!important;font-style:normal!important;font-size:1.5rem!important;line-height:1!important}
  .qctm-group.is-open .qctm-group-toggle>i{font-size:0!important}
  .qctm-group.is-open .qctm-group-toggle>i::after{content:'−';font-size:1.5rem!important}
  .qctm-group-panel{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:1px!important;background:rgba(255, 255, 255, .08)!important;border-top:1px solid rgba(255, 255, 255, .08)!important}
  .qctm-group-panel[hidden]{display:none!important}
  .qctm-group-panel a{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:8px!important;min-height:46px!important;padding:10px 11px!important;background:#0c111c!important;color: #f8fafc !important;text-decoration:none!important;font-size:.74rem!important;font-weight:760!important;line-height:1.2!important}
  .qctm-group-panel a[aria-current="page"]{color:#60a5fa!important;background:#131c2e!important}
  .qctm-bottom{margin-top:auto!important;position:sticky!important;bottom:0!important;display:grid!important;grid-template-columns:auto 1fr!important;align-items:center!important;gap:10px!important;padding:10px 0 0!important;background:linear-gradient(180deg,rgba(9,13,22,0),#090d16 22%)!important}
  .qctm-languages{display:flex!important;gap:6px!important}
  .qctm-languages a{display:grid!important;place-items:center!important;width:36px!important;height:36px!important;border-radius:999px!important;border:1px solid rgba(255, 255, 255, .14)!important;background:rgba(255, 255, 255, .04)!important;color: #f8fafc !important;text-decoration:none!important;font-size:.64rem!important;font-weight:900!important}
  .qctm-languages a.active{background: #002fa7 !important; border-color: #002fa7 !important; color: #ffffff !important; box-shadow: 0 0 12px rgba(0, 47, 167, .4) !important}
  .qctm-project{display:flex!important;align-items:center!important;justify-content:space-between!important;min-height:48px!important;padding:0 15px!important;border-radius:12px!important;background: #002fa7 !important; color: #ffffff !important; box-shadow: 0 6px 20px rgba(0, 47, 167, .35) !important;text-decoration:none!important;font-size:.84rem!important;font-weight:900!important}
  .qctm-project i{font-style:normal!important}
  @media(max-width:420px){.qctm-group-panel{grid-template-columns:1fr!important}}
}
</style>
