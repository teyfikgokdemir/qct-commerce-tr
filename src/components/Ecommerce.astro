---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import ServicePage from './service/ServicePage.astro'; import { getPageSeo } from '../i18n/seo';
interface Props { lang: string; } const { lang } = Astro.props; const seo = getPageSeo('e-commerce');
const serviceDescription = 'Ürün keşfinden ödeme ve sipariş yönetimine kadar müşterinin satın almasını kolaylaştıran e-ticaret altyapıları kuruyoruz.';
---
<BaseLayout title={seo.title} description={seo.description} lang={lang} breadcrumbLabel="E-ticaret altyapısı" service={{name:'E-ticaret altyapısı',description:serviceDescription}}>
<Header slot="header" lang={lang}/><ServicePage lang={lang} eyebrow="E-ticaret altyapısı" title="Ziyaretçiyi müşteriye dönüştüren e-ticaret deneyimleri." lead={serviceDescription} ctaPrimary="Projenizi konuşalım" ctaSecondary="Tüm hizmetler"
problem={{eyebrow:'SATIŞTAKİ SORUN',title:'Satış kaybı çoğu zaman ödeme sayfasından önce başlar.',intro:['Belirsiz ürün bilgisi, zor kullanılan mobil ekranlar ve güven vermeyen adımlar müşterinin kararını geciktirir.'],items:[{title:'Ürün keşfi zorlaşır',text:'Kategori, filtre ve ürün bilgileri müşterinin karşılaştırma yapmasını desteklemiyorsa ilgi siparişe dönüşmez.'},{title:'Mobil alışveriş kesilir',text:'Küçük ekranda uzun ve belirsiz akışlar sepet terkini artırır.'},{title:'Operasyon yavaşlar',text:'Ürün, stok ve içerik güncellemesi zor olduğunda mağaza ekibin işini büyütür.'}]}}
benefits={{eyebrow:'YAKLAŞIM',title:'Müşterinin kararını kolaylaştıran, ekibin yönetebildiği mağaza.',lead:'Teknoloji seçimini ürün yapınız, satış modeliniz ve operasyon ihtiyacınız belirler.',items:[{title:'Açık ürün mimarisi',text:'Kategori, filtre, ürün sayfası ve iç bağlantılar satın alma niyetine göre düzenlenir.'},{title:'Mobil öncelikli deneyim',text:'Ürün inceleme, sepete ekleme ve ödeme adımları telefonda rahat kullanılır.'},{title:'Güvenli satın alma akışı',text:'Teslimat, ödeme ve sonraki adımlar müşteriye açık biçimde gösterilir.'}]}}
included={{eyebrow:'KAPSAM',title:'E-ticaret projesinde neler var?',lead:'Kapsam iş modeline göre netleştirilir.',items:[{title:'Mağaza mimarisi',text:'Kategori ve koleksiyon yapısı.'},{title:'Ürün sayfaları',text:'Karar vermeyi destekleyen içerik ve arayüz.'},{title:'Sepet ve ödeme',text:'Açık, güvenilir satın alma akışı.'},{title:'Mobil deneyim',text:'Farklı ekranlarda tutarlı kullanım.'},{title:'Yönetim altyapısı',text:'Ürün ve içerik güncelleme düzeni.'},{title:'Ölçüm temeli',text:'Kritik e-ticaret eylemlerinin izlenmesi.'}]}}
process={{eyebrow:'SÜREÇ',title:'İş modelinden yayına.',steps:[{number:'01',title:'Analiz',text:'Ürünleri, satış modelini ve mevcut sorunları inceleriz.'},{number:'02',title:'Müşteri yolculuğu',text:'Keşif, ürün, sepet ve ödeme adımlarını planlarız.'},{number:'03',title:'Tasarım ve geliştirme',text:'Hızlı ve erişilebilir mağazayı kurarız.'},{number:'04',title:'Test ve yayın',text:'Kritik senaryoları test edip kontrollü geçiş yaparız.'}]}}
answers={{title:'E-ticaret altyapısı hakkında kısa cevaplar',lead:'E-ticaret altyapısı, müşterinin ürün keşfinden ödemeye ve işletmenin sipariş yönetimine kadar bütün satış akışını kapsar.',items:[{question:'E-ticaret altyapısı nedir?',answer:'Ürün, kategori, sepet, ödeme, teslimat, sipariş ve içerik yönetimini bir araya getiren teknik ve operasyonel satış sistemidir.'},{question:'Kimler için uygundur?',answer:'Doğrudan online satış yapmak veya pazaryeri satışlarını kendi mağazasıyla tamamlamak isteyen üretici, perakendeci ve markalar için uygundur.'},{question:'Ne zaman yeniden kurulmalıdır?',answer:'Mobil alışveriş zorlaştığında, ürün yönetimi yavaşladığında, entegrasyonlar çalışmadığında veya mevcut yapı büyümeyi sınırladığında yeniden kurulum değerlendirilebilir.'},{question:'Nasıl ilerler?',answer:'İş modeli ve ürün verisi incelenir; müşteri yolculuğu, platform, entegrasyon, içerik, test ve yayın kapsamı birlikte belirlenir.'}]}}
relatedLinks={[{title:'Shopify mağaza kurma rehberi',text:'Platform, ödeme, kargo ve yayın hazırlığını adım adım inceleyin.',href:'/blog/shopify-magaza-kurma-rehberi/'},{title:'E-ticarette yapılan hatalar',text:'Ürün, mobil ve ödeme akışındaki temel riskleri görün.',href:'/blog/e-ticarette-yapilan-hatalar/'},{title:'Pazaryerinden kendi sitenize geçiş',text:'İkinci satış kanalını kontrollü biçimde planlayın.',href:'/blog/pazaryerinden-kendi-sitene-gecis/'}]}
faq={{eyebrow:'SIK SORULANLAR',title:'E-ticaret altyapısı hakkında',items:[{q:'Mevcut mağazamızı geliştirebilir misiniz?',a:'Evet. Mevcut altyapıyı, müşteri yolculuğunu ve yönetim ihtiyaçlarını inceleyerek iyileştirme veya yeniden kurulum seçeneklerini belirleriz.'},{q:'Hangi e-ticaret altyapısını kullanıyorsunuz?',a:'Platform kararını ürün sayısı, entegrasyonlar, ekip kapasitesi ve büyüme planına göre veririz.'},{q:'Mobil deneyim projeye dahil mi?',a:'Evet. Mağaza akışı baştan itibaren mobil kullanım önceliğiyle tasarlanır.'}]}}
final={{title:'E-ticaret altyapınızı satış hedefinizle aynı hizaya getirin.',text:'Mevcut mağazanızı veya yeni projenizi birlikte değerlendirelim.',cta:'İletişime geçin',ctaSecondary:'E-posta gönderin'}} /> <Footer slot="footer" lang={lang}/></BaseLayout>
