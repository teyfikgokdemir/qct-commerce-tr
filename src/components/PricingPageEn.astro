---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

const faqItems = [
  { q: 'Website project pricing ne kadar?', a: 'QCT Commerce’te kişisel veya portföy sitesi 6.900 TL, kurumsal web sitesi 8.900 TL ve e-ticaret sitesi kurulumu 9.900 TL başlangıç fiyatıyla sunulur. Kapsam; sayfa, ürün, entegrasyon ve ek hizmetlere göre değişir.' },
  { q: 'Mevcut web sitesi yenileme fiyatı nedir?', a: 'Temel site yenileme çalışmaları 4.900 TL’den başlar. Mobil düzen, tasarım, hız, teknik sorunlar ve SEO geçiş gereksinimi mevcut siteye göre değerlendirilir.' },
  { q: 'SEO, GEO, AEO and AI visibility çalışması ne kadar?', a: 'Başlangıç görünürlük paketi 3.900 TL’den başlar. Technical SEO, arama niyeti, içerik yapısı, GEO ve AEO ihtiyaçları sitenin mevcut durumuna göre kapsamlanır.' },
  { q: 'Site analizi yaptırabilir miyim?', a: 'Evet. Teknik, mobil, hız, görünürlük ve dönüşüm odaklı site analizi 1.490 TL’den başlar. Analiz sonunda önceliklendirilmiş iyileştirme planı sunulur.' },
  { q: 'Platform, lisans ve üçüncü taraf ücretleri fiyatlara dahil mi?', a: 'Hayır. Aksi açıkça belirtilmedikçe ikas, Shopify, Ticimax veya diğer platformların abonelik/lisans bedelleri; ücretli tema ve uygulamalar; ödeme sağlayıcı komisyonları; alan adı, harici barındırma, reklam bütçesi ve üçüncü taraf servis ücretleri QCT Commerce hizmet bedeline dahil değildir.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout
  title="Website Pricing 2026 | E-commerce, SEO & Redesign | QCT"
  description="2026 website pricing in Türkiye: personal sites 6,900 TL, corporate websites 8,900 TL, e-commerce 9,900 TL, redesign 4,900 TL and SEO/GEO/AEO from 3,900 TL."
  lang="en"
  breadcrumbLabel="Pricing"
>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header slot="header" lang="en" />
  <link rel="stylesheet" href="/styles/qct-v2.css?v=20260921-2" />
  <div class="qct-v2">
    <section class="qct-pricing-hero">
      <div class="qct-shell">
        <p class="qct-eyebrow">WEBSITE PRICING 2026</p>
        <h1>Know what you get.<br/><em>And what you pay.</em></h1>
        <p class="qct-lead">We publish clear starting prices for websites, e-commerce setup, redesign, product entry and SEO–GEO–AEO visibility work in Türkiye.</p>
        <p class="qct-pricing-disclaimer"><strong>Pricing note:</strong> These are QCT Commerce service fees. Platform subscriptions/licences, paid themes or apps, payment commissions, ad budget and other third-party costs are excluded unless stated otherwise.</p>
        <div class="qct-hero-actions">
          <a class="qct-btn qct-btn-primary" href="/en/#fiyat-hesapla">Calculate live price <span>→</span></a>
          <a class="qct-text-link" href="/en/contact/">Discuss the project</a>
        </div>
      </div>
    </section>

    <section class="qct-pricing-list">
      <div class="qct-shell">
        <div class="qct-price-category">
          <div><p class="qct-section-label">NEW WEBSITE</p><h2>Website project pricing</h2></div>
          <div class="qct-price-rows">
            <article><span>Personal / portfolio website</span><strong>6.900 TL</strong><small>Starting price</small><p>Mobil uyumlu modern yapı, temel SEO, iletişim ve içerik sayfaları.</p></article>
            <article><span>Corporate website</span><strong>8.900 TL</strong><small>Starting price</small><p>Şirket, hizmet, referans, iletişim ve dönüşüm odaklı profesyonel yapı.</p></article>
            <article><span>E-commerce website</span><strong>9.900 TL</strong><small>Starting price</small><p>Shopify, ikas, WooCommerce, Ticimax veya IdeaSoft kurulum ve satışa hazırlık.</p></article>
          </div>
        </div>

        <div class="qct-price-category">
          <div><p class="qct-section-label">EXISTING WEBSITE</p><h2>Redesign and improvement</h2></div>
          <div class="qct-price-rows">
            <article><span>Website audit & roadmap</span><strong>1.490 TL</strong><small>Starting price</small><p>Teknik, mobil, hız, SEO, içerik ve dönüşüm sorunlarının önceliklendirilmesi.</p></article>
            <article><span>Website redesign</span><strong>4.900 TL</strong><small>Starting price</small><p>Görsel kalite, mobil UX, CTA, sayfa yapısı ve temel teknik düzenlemeler.</p></article>
            <article><span>Platform migration</span><strong>7.900 TL</strong><small>Starting price</small><p>İçerik, ürün, kategori, URL ve temel SEO yönlendirme planıyla geçiş.</p></article>
          </div>
        </div>

        <div class="qct-price-category">
          <div><p class="qct-section-label">VISIBILITY</p><h2>SEO, GEO, AEO and AI visibility</h2></div>
          <div class="qct-price-rows">
            <article><span>Technical SEO</span><strong>2.490 TL</strong><small>Starting price</small><p>Tarama, indeksleme, metadata, canonical, sitemap, mobil ve performans kontrolü.</p></article>
            <article><span>SEO + GEO + AEO + AI görünürlük</span><strong>3.900 TL</strong><small>Starting price</small><p>Google ve üretken yapay zekâ aramalarında bulunabilirliği güçlendiren teknik ve içerik çalışması.</p></article>
            <article><span>GA4 + Search Console</span><strong>990 TL</strong><small>Starting price</small><p>Temel ölçüm, doğrulama ve görünürlük verisinin takip edilmesi.</p></article>
          </div>
        </div>

        <div class="qct-price-category">
          <div><p class="qct-section-label">PRODUCT ENTRY</p><h2>E-commerce product entry</h2></div>
          <div class="qct-price-rows">
            <article><span>1–25 ürün</span><strong>1.490 TL</strong><p>Product name, price, stock, SKU, category, image, variant and existing description.</p></article>
            <article><span>26–50 ürün</span><strong>2.490 TL</strong><p>Standard product-entry scope.</p></article>
            <article><span>51–100 ürün</span><strong>3.990 TL</strong><p>Standard product-entry scope.</p></article>
            <article><span>101–250 ürün</span><strong>7.900 TL</strong><p>Standard product-entry scope.</p></article>
            <article><span>251–500 ürün</span><strong>12.900 TL</strong><p>Standard product-entry scope.</p></article>
          </div>
        </div>
      </div>
    </section>

    <section class="qct-pricing-faq">
      <div class="qct-shell">
        <p class="qct-section-label">FREQUENTLY ASKED QUESTIONS</p>
        <h2>About pricing</h2>
        <div class="qct-faq-grid">
          {faqItems.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
        </div>
      </div>
    </section>

    <section class="qct-close">
      <div class="qct-shell qct-close-grid">
        <div><p class="qct-section-label">START IN 60 SECONDS</p><h2>Choose what you need.<br/><em>See your price.</em></h2></div>
        <a class="qct-btn qct-btn-light" href="/en/#fiyat-hesapla">Calculate live <span>→</span></a>
      </div>
    </section>
  </div>
  <Footer slot="footer" lang="en" />
</BaseLayout>
