---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

const faqItems = [
  { q: 'How much does a website project cost?', a: 'QCT Commerce starting prices are 6.900 TL for a personal or portfolio website, 8.900 TL for a corporate website and 9.900 TL for e-commerce setup. Scope varies by pages, products, integrations and additional services.' },
  { q: 'How much does an existing website redesign cost?', a: 'Basic website redesign starts at 6.900 TL. Mobile layout, design, speed, technical issues and SEO migration requirements are assessed against the existing website.' },
  { q: 'How much does SEO, GEO, AEO and AI visibility work cost?', a: 'The starter visibility package starts at 3.990 TL. Technical SEO, search intent, content structure, GEO and AEO needs are scoped according to the current state of the website.' },
  { q: 'Can I request a website audit?', a: 'Yes. A website audit covering technical issues, mobile experience, speed, visibility and conversion starts at 1.490 TL. The audit provides a prioritised improvement plan.' },
  { q: 'Are platform, licence and third-party fees included?', a: 'No. Unless explicitly stated otherwise, QCT Commerce service fees exclude subscriptions or licences for ikas, Shopify, Ticimax or other platforms; paid themes and apps; payment-provider commissions; domain names, external hosting, ad budgets and third-party service fees.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout
  title="Website Pricing 2026 | E-commerce, SEO & Redesign | QCT"
  description="2026 website pricing in Türkiye: personal sites 6,900 TL, corporate websites 8,900 TL, e-commerce 9,900 TL, redesign 6,900 TL and SEO/GEO/AEO from 3,990 TL."
  lang="en"
  breadcrumbLabel="Pricing"
>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header slot="header" lang="en" />
  <link rel="stylesheet" href="/styles/qct-v2.css?v=20261101-edge-elite" />
  <div class="qct-v2">
    <section class="qct-pricing-hero">
      <div class="qct-shell">
        <p class="qct-eyebrow">TRANSPARENT & PREDICTABLE INVESTMENT · 2026</p>
        <h1>Know what you get.<br/><em>And what you pay.</em></h1>
        <p class="qct-lead">We publish clear starting prices, precise scope boundaries and realistic timelines for websites, e-commerce stores, redesigns and search visibility in Türkiye.</p>
        
        <div class="qct-pricing-hero-badges">
          <span>✓ Standardized Transparent Scopes</span>
          <span>✓ Zero Hidden Surcharges</span>
          <span>✓ Clear Written Agreements & Deliverables</span>
        </div>

        <div class="qct-pricing-disclaimer-grid">
          <div class="qct-pricing-disclaimer"><strong>Scope Transparency:</strong> Published rates reflect standardized entry-level deliverables. Tailored integrations, multi-market translations, and massive catalogs are quoted separately.</div>
          <div class="qct-pricing-disclaimer"><strong>Third-Party Expenses:</strong> Platform subscriptions, domain names, external hosting, and advertising budgets are handled directly by the client.</div>
        </div>

        <div class="qct-hero-actions">
          <a class="qct-btn qct-btn-primary" href="/en/#fiyat-hesapla">Calculate live price <span>→</span></a>
          <a class="qct-text-link" href="/en/contact/">Request tailored quote</a>
        </div>
      </div>
    </section>

    <section class="qct-pricing-list">
      <div class="qct-shell">
        <!-- Flagship QCT EDGE Showcase Banner -->
        <div class="qct-pricing-edge-card">
          <div class="qct-pricing-edge-card__info">
            <div class="qct-pricing-edge-card__tags">
              <span class="qct-pricing-edge-card__tag">NEXT-GEN WEB INFRASTRUCTURE</span>
              <span class="qct-pricing-edge-card__gift">★ 3 MONTHS DYNAMIC SEO INCLUDED</span>
            </div>
            <h2>QCT EDGE Start</h2>
            <p>Built with Astro 7 & Cloudflare for instant page loads, complete search & AI engine visibility (ChatGPT, Perplexity), and zero plugin maintenance anxiety.</p>
            <ul class="qct-pricing-edge-card__perks">
              <li><span>⚡</span> Instant page delivery across global edge nodes</li>
              <li><span>🔍</span> Full discovery signals for Google & AI search engines</li>
              <li><span>🎁</span> 3 Months complimentary Dynamic SEO & growth engineering</li>
              <li><span>🛡️</span> Zero plugin vulnerabilities and cyber-secure architecture</li>
            </ul>
          </div>
          <div class="qct-pricing-edge-card__action">
            <div class="qct-pricing-edge-card__price">
              <small>2026 Launch Starting Price</small>
              <strong>24.900 TL</strong>
              <span>INCL. 20% VAT</span>
            </div>
            <a class="qct-btn qct-btn-primary" href="/en/next-generation-web-foundation/">Explore QCT EDGE <span>→</span></a>
            <small class="qct-pricing-edge-card__note">Valid for projects confirmed by 31 December 2026</small>
          </div>
        </div>
        <div class="qct-price-category">
          <div><p class="qct-section-label">NEW WEBSITE</p><h2>Website project pricing</h2></div>
          <div class="qct-price-rows">
            <article><div class="qct-price-info"><span>Personal / portfolio website</span><p>A modern mobile-friendly structure, basic SEO, contact and content pages.</p></div><div class="qct-price-tag"><strong>6.900 TL</strong><small>Starting price</small></div></article>
            <article><div class="qct-price-info"><span>Corporate website</span><p>A professional structure covering the company, services, references, contact and conversion.</p></div><div class="qct-price-tag"><strong>8.900 TL</strong><small>Starting price</small></div></article>
            <article><div class="qct-price-info"><span>E-commerce website</span><p>Shopify, ikas, WooCommerce, Ticimax or IdeaSoft setup and sales preparation.</p></div><div class="qct-price-tag"><strong>9.900 TL</strong><small>Starting price</small></div></article>
          </div>
        </div>

        <div class="qct-price-category">
          <div><p class="qct-section-label">EXISTING WEBSITE</p><h2>Redesign and improvement</h2></div>
          <div class="qct-price-rows">
            <article><div class="qct-price-info"><span>Website audit & roadmap</span><p>Prioritisation of technical, mobile, speed, SEO, content and conversion issues.</p></div><div class="qct-price-tag"><strong>1.490 TL</strong><small>Starting price</small></div></article>
            <article><div class="qct-price-info"><span>Website redesign</span><p>Up to 5 priority pages covering visual quality, mobile UX, CTAs, page structure and core technical improvements.</p></div><div class="qct-price-tag"><strong>6.900 TL</strong><small>Starting price</small></div></article>
            <article><div class="qct-price-info"><span>Platform migration</span><p>Migration with a plan for content, products, categories, URLs and basic SEO redirects.</p></div><div class="qct-price-tag"><strong>7.900 TL</strong><small>Starting price</small></div></article>
          </div>
        </div>

        <div class="qct-price-category">
          <div><p class="qct-section-label">VISIBILITY</p><h2>SEO, GEO, AEO and AI visibility</h2></div>
          <div class="qct-price-rows">
            <article><div class="qct-price-info"><span>Technical SEO</span><p>Crawling, indexing, metadata, canonical, sitemap, mobile and performance checks.</p></div><div class="qct-price-tag"><strong>2.490 TL</strong><small>Starting price</small></div></article>
            <article><div class="qct-price-info"><span>SEO Care</span><p>Technical SEO monitoring, Search Console, sitemap/index checks and core metadata improvements.</p></div><div class="qct-price-tag"><strong>3.990 TL / month</strong><small>Technical visibility maintenance</small></div></article>
            <article><div class="qct-price-info"><span>Dynamic SEO</span><p>SEO Care plus query analysis, schema, internal linking, priority-page optimisation, GEO/AEO/AIO work and 1 original article per month.</p></div><div class="qct-price-tag"><strong>5.990 TL / month</strong><small>Recommended</small></div></article>
            <article><div class="qct-price-info"><span>SEO Growth</span><p>Dynamic SEO plus 2 original articles per month, landing-page improvements, competitor/query analysis and broader optimisation.</p></div><div class="qct-price-tag"><strong>7.990 TL / month</strong><small>Content + landing-page growth</small></div></article>
            <article><div class="qct-price-info"><span>GA4 + Search Console</span><p>Basic measurement, verification and visibility data tracking.</p></div><div class="qct-price-tag"><strong>990 TL</strong><small>Starting price</small></div></article>
          </div>
        </div>

        <div class="qct-price-category">
          <div><p class="qct-section-label">PRODUCT ENTRY</p><h2>E-commerce product entry</h2></div>
          <div class="qct-price-rows">
            <article><span>1–25 products</span><strong>1.490 TL</strong><p>Product name, price, stock, SKU, category, image, variant and existing description.</p></article>
            <article><span>26–50 products</span><strong>2.490 TL</strong><p>Standard product-entry scope.</p></article>
            <article><span>51–100 products</span><strong>3.990 TL</strong><p>Standard product-entry scope.</p></article>
            <article><span>101–250 products</span><strong>7.900 TL</strong><p>Standard product-entry scope.</p></article>
            <article><span>251–500 products</span><strong>12.900 TL</strong><p>Standard product-entry scope.</p></article>
          </div>
        </div>
      </div>
    </section>

    <section class="qct-pricing-faq">
      <div class="qct-shell">
        <p class="qct-section-label">FREQUENTLY ASKED QUESTIONS</p>
        <h2>About pricing</h2>
        <div class="qct-faq-grid">
          {faqItems.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
        </div>
      </div>
    </section>

    <section class="qct-close">
      <div class="qct-shell qct-close-grid">
        <div><p class="qct-section-label">START IN 60 SECONDS</p><h2>Choose what you need.<br/><em>See your price.</em></h2></div>
        <a class="qct-btn qct-btn-light" href="/en/#fiyat-hesapla">Calculate live <span>→</span></a>
      </div>
    </section>
  </div>
  <Footer slot="footer" lang="en" />
</BaseLayout>
