---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

const faqItems = [
  { q: 'How much does a website project cost?', a: 'QCT Commerce starting prices are 6.900 TL for a personal or portfolio website, 8.900 TL for a corporate website and 9.900 TL for e-commerce setup. Scope varies by pages, products, integrations and additional services.' },
  { q: 'How much does an existing website redesign cost?', a: 'Basic website redesign starts at 6.900 TL. Mobile layout, design, speed, technical issues and SEO migration requirements are assessed against the existing website.' },
  { q: 'How much does SEO, GEO, AEO and AI visibility work cost?', a: 'The starter visibility package starts at 3.990 TL. Technical SEO, search intent, content structure, GEO and AEO needs are scoped according to the current state of the website.' },
  { q: 'Can I request a website audit?', a: 'Yes. A website audit covering technical issues, mobile experience, speed, visibility and conversion starts at 1.490 TL. The audit provides a prioritised improvement plan.' },
  { q: 'Are platform, licence and third-party fees included?', a: 'No. Unless explicitly stated otherwise, QCT Commerce service fees exclude subscriptions or licences for ikas, Shopify, Ticimax or other platforms; paid themes and apps; payment-provider commissions; domain names, external hosting, ad budgets and third-party service fees.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<BaseLayout
  title="Website Pricing 2026 | E-commerce, SEO & Redesign | QCT"
  description="2026 website pricing in Türkiye: personal sites 6,900 TL, corporate websites 8,900 TL, e-commerce 9,900 TL, redesign 6,900 TL and SEO/GEO/AEO from 3,990 TL."
  lang="en"
  breadcrumbLabel="Pricing"
>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header slot="header" lang="en" />
  <link rel="stylesheet" href="/styles/qct-v2.css?v=20261101-edge-elite" />
  <div class="qct-v2">
    <section class="qct-pricing-hero">
      <div class="qct-shell">
        <p class="qct-eyebrow">TRANSPARENT & PREDICTABLE INVESTMENT · 2026</p>
        <h1>Know what you get.<br/><em>And what you pay.</em></h1>
        <p class="qct-lead">Select the ideal digital infrastructure matched to your business milestones with zero surprise costs. Clear scope boundaries, transparent pricing, and continuous technical support.</p>

        <!-- Elite 3-Tier Spotlight Matrix -->
        <div class="qct-pricing-spotlight">
          <!-- Card 1: Corporate Web -->
          <article class="qct-pricing-card">
            <div class="qct-pricing-card__head">
              <span class="qct-pricing-card__label">CORPORATE STARTER</span>
              <h3>Corporate Web</h3>
              <p class="qct-pricing-card__desc">A high-speed, prestigious, and mobile-first presence for your brand.</p>
            </div>
            <div class="qct-pricing-card__price">
              <strong>8.900 TL</strong>
              <small>Excl. VAT starting price · Typical scope 12.900–16.900 TL</small>
            </div>
            <ul class="qct-pricing-card__list">
              <li><i>✓</i> <span><strong>Up to 5 Essential Pages:</strong> Home, About, Services, and Contact journey</span></li>
              <li><i>✓</i> <span><strong>Responsive & Fluid:</strong> Seamless experience across mobile, tablet & desktop</span></li>
              <li><i>✓</i> <span><strong>Direct Lead Flows:</strong> WhatsApp routing and interactive contact inquiry</span></li>
              <li><i>✓</i> <span><strong>Technical SEO Foundations:</strong> Search engine indexing and crawl readiness</span></li>
            </ul>
            <a class="qct-pricing-card__btn" href="/en/#fiyat-hesapla">Customize Package <span>→</span></a>
          </article>

          <!-- Card 2: QCT EDGE (Featured) -->
          <article class="qct-pricing-card qct-pricing-card--featured">
            <span class="qct-pricing-card__badge">★ 2026 LAUNCH ADVANTAGE</span>
            <div class="qct-pricing-card__head">
              <span class="qct-pricing-card__label">NEXT-GEN INFRASTRUCTURE</span>
              <h3>QCT EDGE Start</h3>
              <p class="qct-pricing-card__desc">Astro 7 and Cloudflare edge architecture with 3 months of complimentary Dynamic SEO.</p>
            </div>
            <div class="qct-pricing-card__price">
              <strong>24.900 TL</strong>
              <small>Incl. 20% VAT launch starting price</small>
            </div>
            <ul class="qct-pricing-card__list">
              <li><i>✓</i> <span><strong>3 Months Dynamic SEO Gift:</strong> Continuous search growth (5.990 TL/mo value)</span></li>
              <li><i>✓</i> <span><strong>Instant Page Loads:</strong> Ultra-fast edge delivery that eliminates wait times</span></li>
              <li><i>✓</i> <span><strong>AI Engine & Google Ready:</strong> Full indexing for ChatGPT, Perplexity & Google</span></li>
              <li><i>✓</i> <span><strong>Zero Maintenance Anxiety:</strong> No plugin breakage risks, robust cyber security</span></li>
            </ul>
            <a class="qct-pricing-card__btn qct-pricing-card__btn--highlight" href="/en/next-generation-web-foundation/">Explore QCT EDGE <span>→</span></a>
          </article>

          <!-- Card 3: E-Commerce Store -->
          <article class="qct-pricing-card">
            <div class="qct-pricing-card__head">
              <span class="qct-pricing-card__label">ONLINE COMMERCE & RETAIL</span>
              <h3>E-Commerce Starter</h3>
              <p class="qct-pricing-card__desc">Turnkey online storefront on Shopify, ikas, or WooCommerce with 10 products included.</p>
            </div>
            <div class="qct-pricing-card__price">
              <strong>9.900 TL</strong>
              <small>Excl. VAT starting price · Typical scope 14.900–19.900 TL</small>
            </div>
            <ul class="qct-pricing-card__list">
              <li><i>✓</i> <span><strong>10 Products Included:</strong> Category hierarchy, variants and product entry</span></li>
              <li><i>✓</i> <span><strong>Payments & Logistics:</strong> Virtual POS and automated shipping setup</span></li>
              <li><i>✓</i> <span><strong>Conversion Checkout:</strong> Frictionless, mobile-optimized checkout path</span></li>
              <li><i>✓</i> <span><strong>Platform Flexibility:</strong> Shopify, ikas, or WooCommerce matching</span></li>
            </ul>
            <a class="qct-pricing-card__btn" href="/en/#fiyat-hesapla">Estimate Store Setup <span>→</span></a>
          </article>
        </div>

        <div class="qct-pricing-hero-notes">
          <div class="qct-pricing-disclaimer"><strong>Defined Scope:</strong> Published rates reflect standardized entry-level deliverables. Tailored integrations, multi-market translations, and massive catalogs are quoted separately.</div>
          <div class="qct-pricing-disclaimer"><strong>Third-Party Expenses:</strong> Platform subscriptions, domain names, external hosting, and advertising budgets are handled directly by the client.</div>
        </div>

        <div class="qct-hero-actions">
          <a class="qct-btn qct-btn-primary" href="/en/#fiyat-hesapla">Calculate live price <span>→</span></a>
          <a class="qct-text-link" href="/en/contact/">Request tailored quote</a>
        </div>
      </div>
    </section>

    <section class="qct-pricing-list">
      <div class="qct-shell">
        <div class="qct-price-category">
          <div><p class="qct-section-label">NEW WEBSITE</p><h2>Website project pricing</h2></div>
          <div class="qct-price-rows">
            <article><span>Personal / portfolio website</span><strong>6.900 TL</strong><small>Starting price</small><p>A modern mobile-friendly structure, basic SEO, contact and content pages.</p></article>
            <article><span>Corporate website</span><strong>8.900 TL</strong><small>Starting price</small><p>A professional structure covering the company, services, references, contact and conversion.</p></article>
            <article><span>E-commerce website</span><strong>9.900 TL</strong><small>Starting price</small><p>Shopify, ikas, WooCommerce, Ticimax or IdeaSoft setup and sales preparation.</p></article>
          </div>
        </div>

        <div class="qct-price-category">
          <div><p class="qct-section-label">EXISTING WEBSITE</p><h2>Redesign and improvement</h2></div>
          <div class="qct-price-rows">
            <article><span>Website audit & roadmap</span><strong>1.490 TL</strong><small>Starting price</small><p>Prioritisation of technical, mobile, speed, SEO, content and conversion issues.</p></article>
            <article><span>Website redesign</span><strong>6.900 TL</strong><small>Starting price</small><p>Up to 5 priority pages covering visual quality, mobile UX, CTAs, page structure and core technical improvements.</p></article>
            <article><span>Platform migration</span><strong>7.900 TL</strong><small>Starting price</small><p>Migration with a plan for content, products, categories, URLs and basic SEO redirects.</p></article>
          </div>
        </div>

        <div class="qct-price-category">
          <div><p class="qct-section-label">VISIBILITY</p><h2>SEO, GEO, AEO and AI visibility</h2></div>
          <div class="qct-price-rows">
            <article><span>Technical SEO</span><strong>2.490 TL</strong><small>Starting price</small><p>Crawling, indexing, metadata, canonical, sitemap, mobile and performance checks.</p></article>
            <article><span>SEO Care</span><strong>3.990 TL / month</strong><small>Technical visibility maintenance</small><p>Technical SEO monitoring, Search Console, sitemap/index checks and core metadata improvements.</p></article>
            <article><span>Dynamic SEO</span><strong>5.990 TL / month</strong><small>Recommended</small><p>SEO Care plus query analysis, schema, internal linking, priority-page optimisation, GEO/AEO/AIO work and 1 original article per month.</p></article>
            <article><span>SEO Growth</span><strong>7.990 TL / month</strong><small>Content + landing-page growth</small><p>Dynamic SEO plus 2 original articles per month, landing-page improvements, competitor/query analysis and broader optimisation.</p></article>
            <article><span>GA4 + Search Console</span><strong>990 TL</strong><small>Starting price</small><p>Basic measurement, verification and visibility data tracking.</p></article>
          </div>
        </div>

        <div class="qct-price-category">
          <div><p class="qct-section-label">PRODUCT ENTRY</p><h2>E-commerce product entry</h2></div>
          <div class="qct-price-rows">
            <article><span>1–25 products</span><strong>1.490 TL</strong><p>Product name, price, stock, SKU, category, image, variant and existing description.</p></article>
            <article><span>26–50 products</span><strong>2.490 TL</strong><p>Standard product-entry scope.</p></article>
            <article><span>51–100 products</span><strong>3.990 TL</strong><p>Standard product-entry scope.</p></article>
            <article><span>101–250 products</span><strong>7.900 TL</strong><p>Standard product-entry scope.</p></article>
            <article><span>251–500 products</span><strong>12.900 TL</strong><p>Standard product-entry scope.</p></article>
          </div>
        </div>
      </div>
    </section>

    <section class="qct-pricing-faq">
      <div class="qct-shell">
        <p class="qct-section-label">FREQUENTLY ASKED QUESTIONS</p>
        <h2>About pricing</h2>
        <div class="qct-faq-grid">
          {faqItems.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
        </div>
      </div>
    </section>

    <section class="qct-close">
      <div class="qct-shell qct-close-grid">
        <div><p class="qct-section-label">START IN 60 SECONDS</p><h2>Choose what you need.<br/><em>See your price.</em></h2></div>
        <a class="qct-btn qct-btn-light" href="/en/#fiyat-hesapla">Calculate live <span>→</span></a>
      </div>
    </section>
  </div>
  <Footer slot="footer" lang="en" />
</BaseLayout>
