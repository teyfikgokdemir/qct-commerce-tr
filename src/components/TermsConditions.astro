---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from './Header.astro'; import Footer from './Footer.astro'; import LegalPage from './service/LegalPage.astro'; interface Props{lang:string} const{lang}=Astro.props;
const title='Kullanım Koşulları — QCT Commerce'; const description='QCT Commerce web sitesinin kullanımına, içeriklerine ve hizmet bilgilerine ilişkin temel koşullar.';
---
<BaseLayout title={title} description={description} lang={lang} breadcrumbLabel="Kullanım koşulları"><Header slot="header" lang={lang}/><LegalPage lang={lang} eyebrow="YASAL" title="Kullanım koşulları" lead="Türkiye pazarına yönelik bu web sitesini kullanırken geçerli olan temel ilkeleri ve sınırları açıklar." lastUpdated="19 Temmuz 2026"
sections={[{id:'site-amaci',title:'Sitenin amacı',text:'Bu site QCT Commerce hizmetleri hakkında bilgi vermek ve iletişim kanallarını sunmak amacıyla yayımlanır.'},{id:'bilgi-dogrulugu',title:'Bilgilerin güncelliği',text:'İçerikler makul ölçüde güncel tutulur; hizmet kapsamları ve bilgiler zaman içinde değişebilir.'},{id:'hizmetler',title:'Hizmet kapsamı',text:'Her projenin kapsamı, teslimatları, süresi ve ticari koşulları çalışma başlamadan önce ayrıca belirlenir. Sitedeki genel açıklamalar bağlayıcı proje teklifi değildir.'},{id:'fikri-haklar',title:'Fikri haklar',text:'Aksi yazılı olarak belirtilmedikçe site tasarımı, marka unsurları ve özgün içerikler QCT Commerce’a aittir; üçüncü taraf materyalleri kendi hak koşullarına tabidir.'},{id:'dis-baglantilar',title:'Dış bağlantılar',text:'Kolaylık amacıyla verilen üçüncü taraf bağlantılarının içerik ve uygulamaları QCT Commerce kontrolünde değildir.'},{id:'degisiklikler',title:'Değişiklikler',text:'Bu koşullar site ve hizmetler geliştikçe güncellenebilir. Geçerli sürüm bu sayfada yayımlanan sürümdür.'},{id:'iletisim',title:'İletişim',text:'Kullanım koşullarıyla ilgili sorularınızı info@qctcommerce.com adresine gönderebilirsiniz.'}]}
faqTitle="Sık sorulan sorular" faqItems={[{q:'Bu koşullar proje sözleşmesi yerine geçer mi?',a:'Hayır. Projeye özel kapsam ve ticari koşullar ayrıca yazılı olarak belirlenir.'},{q:'Site içeriği değişebilir mi?',a:'Evet. Hizmetler ve bilgiler gerektiğinde güncellenebilir.'},{q:'Sorularımı nereye iletebilirim?',a:'info@qctcommerce.com adresine yazabilirsiniz.'}]}/><Footer slot="footer" lang={lang}/></BaseLayout>
