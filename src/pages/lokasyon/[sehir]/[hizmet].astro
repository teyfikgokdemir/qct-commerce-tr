---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { trMarkets, programmaticServices, internationalMarketIds, trServicePath, enServicePath } from "../../../data/programmatic-markets";

export function getStaticPaths() {
  return trMarkets
    .filter((market) => internationalMarketIds.has(market.id))
    .flatMap((market) => programmaticServices.map((service) => ({
      params: { sehir: market.id, hizmet: service.trSlug },
      props: { market, service },
    })));
}

const { market, service } = Astro.props;
const title = `${market.name} ${service.trName} Hizmeti | QCT Commerce`;
const description = `${market.name} için ${service.trName.toLowerCase()} çözümü: ${service.trOutcome} QCT Commerce ile ölçülebilir ve ölçeklenebilir dijital büyüme altyapısı.`;
const alternates = [
  { lang: "tr-TR", href: trServicePath(market.id, service) },
  { lang: "en", href: enServicePath(market.alternateId, service) },
];
const breadcrumbs = [
  { name: "Ana sayfa", url: "/" },
  { name: market.name, url: `/lokasyon/${market.id}/` },
  { name: service.trName, url: trServicePath(market.id, service) },
];
---

<BaseLayout title={title} description={description} lang="tr" alternates={alternates} breadcrumbs={breadcrumbs} pageType="WebPage" areaServed={market.areaServed} service={{ name: `${market.name} ${service.trName}`, description }}>
  <Header slot="header" lang="tr" />
  <style is:inline>
.qct-programmatic{background:#f3eee7;color:#171514}
.qct-programmatic .section{padding:clamp(72px,9vw,124px) 0}
.qct-programmatic .page-hero{background:radial-gradient(circle at 78% 20%,rgba(230,107,95,.22),transparent 34%),linear-gradient(145deg,#171514 0%,#26211f 100%);color:#f8f2eb;display:grid;align-items:center;min-height:clamp(450px,52svh,530px);overflow:hidden;position:relative}
.qct-programmatic .page-hero::after{background:linear-gradient(120deg,transparent 10%,rgba(255,255,255,.06),transparent 56%);content:"";inset:0;pointer-events:none;position:absolute;transform:translateX(38%)}
.qct-programmatic .page-hero .container{position:relative;z-index:1}
.qct-programmatic .eyebrow{color:#e66b5f;font-size:.78rem;font-weight:800;letter-spacing:.14em;margin:0 0 16px;text-transform:uppercase}
.qct-programmatic h1,.qct-programmatic h2,.qct-programmatic h3,.qct-programmatic p{opacity:1;visibility:visible}
.qct-programmatic h1{color:#fffaf5;font-size:clamp(2.9rem,4.2vw,4.15rem);line-height:1.04;letter-spacing:-.04em;max-width:1080px;margin:0}
.qct-programmatic .page-hero h1{max-width:1080px;text-wrap:balance}
.qct-programmatic .page-hero__lead{color:rgba(255,250,245,.74);font-size:clamp(1rem,1.45vw,1.18rem);line-height:1.6;margin:20px 0 0;max-width:760px}
.qct-programmatic .hero__actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:24px}
.qct-programmatic .section-heading{max-width:900px;margin-bottom:38px}
.qct-programmatic .section-heading h2{color:#171514;font-size:clamp(2.15rem,3.6vw,3.55rem);letter-spacing:-.04em;line-height:1.04;margin:0;max-width:900px}
.qct-programmatic .section-heading>p:not(.eyebrow){color:#655d58;font-size:1.08rem;line-height:1.75;margin-top:20px}
.qct-programmatic .service-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.qct-programmatic .service-card{background:#fffaf5;border:1px solid rgba(23,21,20,.1);border-radius:24px;padding:clamp(26px,3vw,38px);box-shadow:0 18px 50px rgba(23,21,20,.06);color:inherit;text-decoration:none}
.qct-programmatic .service-card h3{color:#171514;font-size:clamp(1.25rem,1.65vw,1.6rem);line-height:1.2;margin:0 0 14px}
.qct-programmatic .service-card p{color:#655d58;line-height:1.7;margin:0}
.qct-programmatic .service-card strong{display:block;color:#171514;font-size:.92rem;margin-top:22px}
.qct-programmatic .section:nth-of-type(even){background:#ebe4dc}
.qct-programmatic>.section:last-of-type .container{background:#fffaf5;border:1px solid rgba(23,21,20,.1);border-radius:28px;box-shadow:0 22px 60px rgba(23,21,20,.07);padding:clamp(34px,6vw,70px)}
.qct-programmatic>.section:last-of-type .section-heading{margin-bottom:0}
@media(max-width:760px){.qct-programmatic .service-grid{grid-template-columns:1fr}.qct-programmatic .page-hero{min-height:auto;padding:78px 0 62px}.qct-programmatic h1{font-size:clamp(2.35rem,10.5vw,3.35rem);line-height:1.08}.qct-programmatic .section-heading h2{font-size:clamp(1.95rem,8vw,2.65rem)}.qct-programmatic>.section:last-of-type .container{border-radius:22px;padding:28px 22px}}
</style>
  <div class="qct-programmatic">

  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">{market.name.toUpperCase()} · {service.trName.toUpperCase()}</p>
      <h1>{market.name} için {service.trName}.</h1>
      <p class="page-hero__lead">{market.name} pazarında amaç, {service.trIntent}. Bu sayfa genel lokasyon içeriğinin tekrarı değil; belirli hizmet niyetine göre hazırlanmış ticari kapsamdır.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/iletisim/">{market.name} projesi için görüşme</a>
        <a class="button button--secondary" href={service.trCorePath}>Ana hizmeti inceleyin</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">TİCARİ BAĞLAM</p>
        <h2>{service.trName}, {market.name} için hangi ticari problemi çözmeli?</h2>
        <p>{market.commercialContext}</p>
      </div>
      <div class="service-grid">
        <article class="service-card"><h3>Hedef</h3><p>{service.trOutcome}</p></article>
        <article class="service-card"><h3>Pazar uyumu</h3><p>{market.marketAngle}; hizmet kapsamı bu önceliğe göre şekillenir.</p></article>
        <article class="service-card"><h3>Ölçüm</h3><p>Organik görünürlük, nitelikli talep, dönüşüm yolları ve teknik performans birlikte izlenir.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">KAPSAM</p>
        <h2>Temel teslim bileşenleri.</h2>
        <p>{market.industries.join(", ")} odaklı şirketlerde bu bileşenleri birbirinden kopuk işler olarak değil, aynı ticari sistemin parçaları olarak ele alıyoruz.</p>
      </div>
      <div class="service-grid">
        {service.trDeliverables.map((item) => (
          <article class="service-card"><h3>{item}</h3><p>{market.name} hedefiyle uyumlu, ölçülebilir ve sürdürülebilir uygulama kapsamına dahil edilir.</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">SONRAKİ ADIM</p>
        <h2>{market.name} için {service.trName.toLowerCase()} kapsamını netleştirelim.</h2>
        <p>Mevcut yapıyı ve hedef sorguları değerlendirip ilk uygulanabilir kapsamı belirliyoruz.</p>
        <a class="button button--primary" href="/iletisim/">Proje görüşmesi başlatın</a>
      </div>
    </div>
  </section>

  </div>
  <Footer slot="footer" lang="tr" />
</BaseLayout>
