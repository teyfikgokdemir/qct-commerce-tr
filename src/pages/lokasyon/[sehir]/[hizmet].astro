---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { trMarkets, programmaticServices, internationalMarketIds, trServicePath, enServicePath } from "../../../data/programmatic-markets";

export function getStaticPaths() {
  return trMarkets
    .filter((market) => internationalMarketIds.has(market.id))
    .flatMap((market) => programmaticServices.map((service) => ({
      params: { sehir: market.id, hizmet: service.trSlug },
      props: { market, service },
    })));
}

const { market, service } = Astro.props;
const title = `${market.name} ${service.trName} Hizmeti | QCT Commerce`;
const description = `${market.name} için ${service.trName.toLowerCase()} çözümü: ${service.trOutcome} QCT Commerce ile ölçülebilir ve ölçeklenebilir dijital büyüme altyapısı.`;
const alternates = [
  { lang: "tr-TR", href: trServicePath(market.id, service) },
  { lang: "en", href: enServicePath(market.alternateId, service) },
];
const breadcrumbs = [
  { name: "Ana sayfa", url: "/" },
  { name: market.name, url: `/lokasyon/${market.id}/` },
  { name: service.trName, url: trServicePath(market.id, service) },
];
---

<BaseLayout title={title} description={description} lang="tr" alternates={alternates} breadcrumbs={breadcrumbs} pageType="CollectionPage" areaServed={market.areaServed}>
  <Header slot="header" lang="tr" />

  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">{market.name.toUpperCase()} · {service.trName.toUpperCase()}</p>
      <h1>{market.name} için {service.trName}.</h1>
      <p class="page-hero__lead">{market.name} pazarında amaç, {service.trIntent}. Bu sayfa genel lokasyon içeriğinin tekrarı değil; belirli hizmet niyetine göre hazırlanmış ticari kapsamdır.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/iletisim/">{market.name} projesi için görüşme</a>
        <a class="button button--secondary" href={service.trCorePath}>Ana hizmeti inceleyin</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">TİCARİ BAĞLAM</p>
        <h2>{service.trName}, {market.name} için hangi ticari problemi çözmeli?</h2>
        <p>{market.commercialContext}</p>
      </div>
      <div class="service-grid">
        <article class="service-card"><h3>Hedef</h3><p>{service.trOutcome}</p></article>
        <article class="service-card"><h3>Pazar uyumu</h3><p>{market.marketAngle}; hizmet kapsamı bu önceliğe göre şekillenir.</p></article>
        <article class="service-card"><h3>Ölçüm</h3><p>Organik görünürlük, nitelikli talep, dönüşüm yolları ve teknik performans birlikte izlenir.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">KAPSAM</p>
        <h2>Temel teslim bileşenleri.</h2>
        <p>{market.industries.join(", ")} odaklı şirketlerde bu bileşenleri birbirinden kopuk işler olarak değil, aynı ticari sistemin parçaları olarak ele alıyoruz.</p>
      </div>
      <div class="service-grid">
        {service.trDeliverables.map((item) => (
          <article class="service-card"><h3>{item}</h3><p>{market.name} hedefiyle uyumlu, ölçülebilir ve sürdürülebilir uygulama kapsamına dahil edilir.</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">SONRAKİ ADIM</p>
        <h2>{market.name} için {service.trName.toLowerCase()} kapsamını netleştirelim.</h2>
        <p>Mevcut yapıyı ve hedef sorguları değerlendirip ilk uygulanabilir kapsamı belirliyoruz.</p>
        <a class="button button--primary" href="/iletisim/">Proje görüşmesi başlatın</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang="tr" />
</BaseLayout>
