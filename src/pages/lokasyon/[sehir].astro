---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { trMarkets, programmaticServices, trServicePath } from "../../data/programmatic-markets";

export function getStaticPaths() {
  return trMarkets.map((market) => ({
    params: { sehir: market.id },
    props: { market },
  }));
}

const { market } = Astro.props;
const isCountry = market.type === "country";
const title = `${market.name} Web Tasarım ve E-Ticaret Ajansı | QCT Commerce`;
const description = `${market.name} için web tasarım, e-ticaret ve SEO/GEO çözümleri. ${market.marketAngle}; QCT Commerce ile ölçülebilir dijital talep altyapısı kurun.`;
const alternates = [
  { lang: "tr-TR", href: `/lokasyon/${market.id}/` },
  { lang: "en", href: `/en/location/${market.alternateId}/` },
];
const marketServicePages = programmaticServices;
const breadcrumbs = [
  { name: "Ana sayfa", url: "/" },
  { name: "Hizmetler", url: "/hizmetler/" },
  { name: market.name, url: `/lokasyon/${market.id}/` },
];
---

<BaseLayout title={title} description={description} lang="tr" alternates={alternates} breadcrumbs={breadcrumbs} pageType="CollectionPage" areaServed={market.areaServed}>
  <Header slot="header" lang="tr" />
  <style is:inline>
.qct-programmatic{background:#f3eee7;color:#171514}
.qct-programmatic .section{padding:clamp(72px,9vw,124px) 0}
.qct-programmatic .page-hero{background:radial-gradient(circle at 78% 20%,rgba(230,107,95,.22),transparent 34%),linear-gradient(145deg,#171514 0%,#26211f 100%);color:#f8f2eb;display:grid;align-items:center;min-height:clamp(450px,52svh,530px);overflow:hidden;position:relative}
.qct-programmatic .page-hero::after{background:linear-gradient(120deg,transparent 10%,rgba(255,255,255,.06),transparent 56%);content:"";inset:0;pointer-events:none;position:absolute;transform:translateX(38%)}
.qct-programmatic .page-hero .container{position:relative;z-index:1}
.qct-programmatic .eyebrow{color:#e66b5f;font-size:.78rem;font-weight:800;letter-spacing:.14em;margin:0 0 16px;text-transform:uppercase}
.qct-programmatic h1,.qct-programmatic h2,.qct-programmatic h3,.qct-programmatic p{opacity:1;visibility:visible}
.qct-programmatic h1{color:#fffaf5;font-size:clamp(2.9rem,4.2vw,4.15rem);line-height:1.04;letter-spacing:-.04em;max-width:1080px;margin:0}
.qct-programmatic .page-hero h1{max-width:1080px;text-wrap:balance}
.qct-programmatic .page-hero__lead{color:rgba(255,250,245,.74);font-size:clamp(1rem,1.45vw,1.18rem);line-height:1.6;margin:20px 0 0;max-width:760px}
.qct-programmatic .hero__actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:24px}
.qct-programmatic .section-heading{max-width:900px;margin-bottom:38px}
.qct-programmatic .section-heading h2{color:#171514;font-size:clamp(2.15rem,3.6vw,3.55rem);letter-spacing:-.04em;line-height:1.04;margin:0;max-width:900px}
.qct-programmatic .section-heading>p:not(.eyebrow){color:#655d58;font-size:1.08rem;line-height:1.75;margin-top:20px}
.qct-programmatic .service-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.qct-programmatic .service-card{background:#fffaf5;border:1px solid rgba(23,21,20,.1);border-radius:24px;padding:clamp(26px,3vw,38px);box-shadow:0 18px 50px rgba(23,21,20,.06);color:inherit;text-decoration:none}
.qct-programmatic .service-card h3{color:#171514;font-size:clamp(1.25rem,1.65vw,1.6rem);line-height:1.2;margin:0 0 14px}
.qct-programmatic .service-card p{color:#655d58;line-height:1.7;margin:0}
.qct-programmatic .service-card strong{display:block;color:#171514;font-size:.92rem;margin-top:22px}
.qct-programmatic .section:nth-of-type(even){background:#ebe4dc}
.qct-programmatic>.section:last-of-type .container{background:#fffaf5;border:1px solid rgba(23,21,20,.1);border-radius:28px;box-shadow:0 22px 60px rgba(23,21,20,.07);padding:clamp(34px,6vw,70px)}
.qct-programmatic>.section:last-of-type .section-heading{margin-bottom:0}
@media(max-width:760px){.qct-programmatic .service-grid{grid-template-columns:1fr}.qct-programmatic .page-hero{min-height:auto;padding:78px 0 62px}.qct-programmatic h1{font-size:clamp(2.35rem,10.5vw,3.35rem);line-height:1.08}.qct-programmatic .section-heading h2{font-size:clamp(1.95rem,8vw,2.65rem)}.qct-programmatic>.section:last-of-type .container{border-radius:22px;padding:28px 22px}}
</style>
  <div class="qct-programmatic">

  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">{isCountry ? "ULUSLARARASI PAZAR" : "YEREL BÜYÜME"} · {market.name.toUpperCase()}</p>
      <h1>{market.name} için dijital büyüme altyapısı.</h1>
      <p class="page-hero__lead">{market.audience} için web, e-ticaret ve arama görünürlüğünü tek ticari akışta kurguluyoruz. Hedef: {market.marketAngle}.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/iletisim/">{market.name} için proje görüşmesi</a>
        <a class="button button--secondary" href="/calismalar/">Çalışmaları inceleyin</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">PAZAR BAĞLAMI</p>
        <h2>{market.name} pazarında dijital talebi ticari bağlama göre kuruyoruz.</h2>
        <p>{market.commercialContext}</p>
      </div>
      <div class="service-grid">
        <article class="service-card"><h3>Arama görünürlüğü</h3><p>SEO, GEO, AEO ve AIO sinyallerini hizmet, sektör ve içerik mimarisine bağlıyoruz.</p></article>
        <article class="service-card"><h3>Dönüşüm akışı</h3><p>Form, WhatsApp, teklif ve güven unsurlarını karar aşamasına göre konumlandırıyoruz.</p></article>
        <article class="service-card"><h3>Teknik temel</h3><p>Mobil performans, analitik ölçüm, yapılandırılmış veri ve çok dilli genişleme aynı sistemde ilerler.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">ÖNCELİKLİ ALANLAR</p>
        <h2>{market.name} için önce ticari etki üreten alanlara odaklanıyoruz.</h2>
      </div>
      <div class="service-grid">
        {market.priorityServices.map((service, index) => {
          const sector = market.industries[index % market.industries.length];
          const detail = index === 0
            ? `${sector} odaklı şirketlerde ${service.toLowerCase()} tarafını karar vericinin ilk temas ettiği bilgi ve güven katmanıyla bağlıyoruz.`
            : index === 1
              ? `${market.name} pazarında ${service.toLowerCase()} kapsamını ürün/hizmet keşfinden nitelikli talebe uzanan akışın bir parçası olarak kuruyoruz.`
              : `${service}, ${market.marketAngle}; içerik, teknik temel ve ölçümü bu ticari önceliğe göre birlikte ele alıyoruz.`;
          return (
            <article class="service-card">
              <h3>{service}</h3>
              <p>{detail}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  {marketServicePages.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">PAZAR & HİZMET</p>
          <h2>{market.name} için odaklanmış hizmet sayfaları.</h2>
          <p>Genel pazar sayfasını, belirli hizmet aramalarına cevap veren daha net ticari kapsamlarla destekliyoruz.</p>
        </div>
        <div class="service-grid">
          {marketServicePages.map((service) => (
            <a class="service-card" href={trServicePath(market.id, service)}>
              <h3>{service.trName}</h3>
              <p>{service.trOutcome}</p>
              <strong>Detayı inceleyin →</strong>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">İLGİLİ ÇÖZÜMLER</p>
        <h2>{market.name} projesini tek bir landing page'e sıkıştırmıyoruz.</h2>
      </div>
      <div class="service-grid">
        <a class="service-card" href="/web-tasarim/"><h3>Web Tasarım</h3><p>Kurumsal güven, hız ve dönüşüm odaklı web mimarisi.</p><strong>İnceleyin →</strong></a>
        <a class="service-card" href="/e-ticaret/"><h3>E-Ticaret</h3><p>Shopify, ikas ve ihtiyaca uygun satış altyapıları.</p><strong>İnceleyin →</strong></a>
        <a class="service-card" href="/seo-geo/"><h3>SEO / GEO</h3><p>Arama motorları ve yapay zekâ destekli keşif kanalları için görünürlük.</p><strong>İnceleyin →</strong></a>
        <a class="service-card" href={isCountry ? "/ihracatcilar/" : "/ureticiler/"}><h3>{isCountry ? "İhracatçılar" : "B2B ve üreticiler"}</h3><p>{isCountry ? "Hedef pazara özel çok dilli talep ve landing page mimarisi." : "Ürün, hizmet ve teklif akışını karar verici odaklı yapılandırma."}</p><strong>İnceleyin →</strong></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">SONRAKİ ADIM</p>
        <h2>{market.name} için ölçülebilir bir büyüme planı çıkaralım.</h2>
        <p>Mevcut sitenizi, hedef sorguları ve dönüşüm akışını değerlendirip ilk uygulanabilir kapsamı netleştiriyoruz.</p>
        <a class="button button--primary" href="/iletisim/">Proje görüşmesi başlatın</a>
      </div>
    </div>
  </section>

  </div>
  <Footer slot="footer" lang="tr" />
</BaseLayout>
