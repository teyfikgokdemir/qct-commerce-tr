---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { trMarkets } from "../../data/programmatic-markets";

export function getStaticPaths() {
  return trMarkets.map((market) => ({
    params: { sehir: market.id },
    props: { market },
  }));
}

const { market } = Astro.props;
const isCountry = market.type === "country";
const regionLabel = isCountry ? `${market.name} pazarı` : `${market.name} bölgesi`;
const title = `${market.name} Web Tasarım ve E-Ticaret Ajansı | QCT Commerce`;
const description = `${market.name} için web tasarım, e-ticaret ve SEO/GEO çözümleri. ${market.marketAngle}; QCT Commerce ile ölçülebilir dijital talep altyapısı kurun.`;
const alternates = [
  { lang: "tr-TR", href: `/lokasyon/${market.id}/` },
  { lang: "en", href: `/en/location/${market.alternateId}/` },
];
const breadcrumbs = [
  { name: "Ana sayfa", url: "/" },
  { name: "Hizmetler", url: "/hizmetler/" },
  { name: market.name, url: `/lokasyon/${market.id}/` },
];
---

<BaseLayout
  title={title}
  description={description}
  lang="tr"
  alternates={alternates}
  breadcrumbs={breadcrumbs}
  pageType="CollectionPage"
  areaServed={market.areaServed}
>
  <div class="qct-v2" data-qct-v2>
    <section class="qct-hero">
      <div class="qct-shell qct-hero-grid">
        <div class="qct-hero-copy">
          <p class="qct-eyebrow">{isCountry ? "ULUSLARARASI PAZAR" : "YEREL BÜYÜME"} · WEB · E-TİCARET · SEO/GEO</p>
          <h1 class="qct-hero-title">
            <em>{market.name}</em> için satışa çalışan dijital altyapı
          </h1>
          <p class="qct-lead">
            {market.audience} için yalnızca bir web sitesi değil; arama niyeti, güven, mobil performans ve teklif akışını birlikte çalışan bir sisteme dönüştürüyoruz.
            <strong> Hedef: {market.marketAngle}.</strong>
          </p>
          <div class="qct-hero-actions">
            <a class="qct-btn qct-btn-primary" href="/iletisim/">{market.name} için proje görüşmesi <span>→</span></a>
            <a class="qct-btn qct-btn-secondary" href="/calismalar/">Çalışmaları inceleyin</a>
          </div>
          <div class="qct-proof-line">
            {market.priorityServices.map((service) => <span>{service}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section class="qct-benefits">
      <div class="qct-shell qct-benefit-grid">
        <article>
          <p class="qct-section-label">PAZAR BAĞLAMI</p>
          <h3>{market.name} için kopya sayfa değil, ayrı ticari senaryo</h3>
          <p>{market.commercialContext}</p>
        </article>
        <article>
          <p class="qct-section-label">ARAMA GÖRÜNÜRLÜĞÜ</p>
          <h3>SEO + GEO + AEO + AIO birlikte</h3>
          <p>Sayfa mimarisini klasik Google sorguları kadar yapay zekâ destekli arama ve cevap motorlarının okuyabileceği açık hizmet, sektör ve kapsam sinyalleriyle kuruyoruz.</p>
        </article>
        <article>
          <p class="qct-section-label">DÖNÜŞÜM</p>
          <h3>Ziyaretten ticari görüşmeye</h3>
          <p>CTA, WhatsApp, teklif formu, vaka çalışması ve güven unsurlarını kullanıcının karar aşamasına göre yerleştiriyoruz; amaç yalnızca trafik değil nitelikli talep.</p>
        </article>
        <article>
          <p class="qct-section-label">TEKNİK TEMEL</p>
          <h3>Hızlı, ölçülebilir ve genişleyebilir</h3>
          <p>Mobil performans, analitik ölçüm, teknik SEO, yapılandırılmış veri ve çok dilli genişleme aynı teknik temel üzerinde ilerler.</p>
        </article>
      </div>
    </section>

    <section class="qct-shell">
      <div class="qct-section-head">
        <p class="qct-section-label">{regionLabel.toUpperCase()} İÇİN ÖNCELİKLİ ALANLAR</p>
        <h2>İlk etapta neyi iyileştiriyoruz?</h2>
        <p>{market.name} için programatik sayfa üretimini gerçek bir hizmet mimarisine bağlıyoruz. Her sayfanın arama niyeti, ticari amacı ve dahili bağlantı rotası belirli.</p>
      </div>
      <div class="qct-benefit-grid">
        {market.priorityServices.map((service, index) => (
          <article>
            <span class="qct-card-kicker">0{index + 1}</span>
            <h3>{service}</h3>
            <p>{market.industries.join(", ")} odaklı şirketlerde bu hizmeti satış sürecinin diğer parçalarıyla birlikte kurguluyoruz.</p>
          </article>
        ))}
      </div>
    </section>

    <section class="qct-shell">
      <div class="qct-section-head">
        <p class="qct-section-label">İLGİLİ ÇÖZÜMLER</p>
        <h2>{market.name} projesini tek sayfaya sıkıştırmıyoruz.</h2>
      </div>
      <div class="qct-benefit-grid">
        <article>
          <h3>Web Tasarım</h3>
          <p>Kurumsal güven, hız ve dönüşüm odaklı web mimarisi.</p>
          <a href="/web-tasarim/">Web tasarım hizmeti →</a>
        </article>
        <article>
          <h3>E-Ticaret</h3>
          <p>Shopify, ikas ve ihtiyaca uygun satış altyapıları.</p>
          <a href="/e-ticaret/">E-ticaret çözümleri →</a>
        </article>
        <article>
          <h3>SEO / GEO</h3>
          <p>Arama motorları ve yapay zekâ destekli keşif kanalları için görünürlük.</p>
          <a href="/seo-geo/">SEO / GEO hizmeti →</a>
        </article>
        <article>
          <h3>{isCountry ? "İhracatçılar" : "B2B ve üreticiler"}</h3>
          <p>{isCountry ? "Hedef pazara özel çok dilli talep ve landing page mimarisi." : "Ürün, hizmet ve teklif akışını karar verici odaklı yapılandırma."}</p>
          <a href={isCountry ? "/ihracatcilar/" : "/ureticiler/"}>Segment çözümünü inceleyin →</a>
        </article>
      </div>
    </section>

    <section class="qct-close">
      <div class="qct-shell qct-close-grid">
        <div>
          <p class="qct-section-label">{market.name.toUpperCase()} İÇİN PROJE PLANI</p>
          <h2>Trafik değil, <em>ticari sonuç üreten</em> bir yapı kuralım.</h2>
          <p>Mevcut sitenizi, hedef sorgularınızı ve dönüşüm akışınızı birlikte değerlendirip ilk uygulanabilir büyüme planını çıkaralım.</p>
        </div>
        <a class="qct-btn qct-btn-light" href="/iletisim/">Proje görüşmesi başlatın <span>→</span></a>
      </div>
    </section>
  </div>
</BaseLayout>
