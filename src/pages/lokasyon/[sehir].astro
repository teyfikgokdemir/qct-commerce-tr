---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { trMarkets, programmaticServices, internationalMarketIds, trServicePath } from "../../data/programmatic-markets";

export function getStaticPaths() {
  return trMarkets.map((market) => ({
    params: { sehir: market.id },
    props: { market },
  }));
}

const { market } = Astro.props;
const isCountry = market.type === "country";
const title = `${market.name} Web Tasarım ve E-Ticaret Ajansı | QCT Commerce`;
const description = `${market.name} için web tasarım, e-ticaret ve SEO/GEO çözümleri. ${market.marketAngle}; QCT Commerce ile ölçülebilir dijital talep altyapısı kurun.`;
const alternates = [
  { lang: "tr-TR", href: `/lokasyon/${market.id}/` },
  { lang: "en", href: `/en/location/${market.alternateId}/` },
];
const marketServicePages = internationalMarketIds.has(market.id) ? programmaticServices : [];
const breadcrumbs = [
  { name: "Ana sayfa", url: "/" },
  { name: "Hizmetler", url: "/hizmetler/" },
  { name: market.name, url: `/lokasyon/${market.id}/` },
];
---

<BaseLayout title={title} description={description} lang="tr" alternates={alternates} breadcrumbs={breadcrumbs} pageType="CollectionPage" areaServed={market.areaServed}>
  <Header slot="header" lang="tr" />

  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">{isCountry ? "ULUSLARARASI PAZAR" : "YEREL BÜYÜME"} · {market.name.toUpperCase()}</p>
      <h1>{market.name} için dijital büyüme altyapısı.</h1>
      <p class="page-hero__lead">{market.audience} için web, e-ticaret ve arama görünürlüğünü tek ticari akışta kurguluyoruz. Hedef: {market.marketAngle}.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/iletisim/">{market.name} için proje görüşmesi</a>
        <a class="button button--secondary" href="/calismalar/">Çalışmaları inceleyin</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">PAZAR BAĞLAMI</p>
        <h2>{market.name} için kopya lokasyon sayfası değil, ayrı ticari senaryo.</h2>
        <p>{market.commercialContext}</p>
      </div>
      <div class="service-grid">
        <article class="service-card"><h3>Arama görünürlüğü</h3><p>SEO, GEO, AEO ve AIO sinyallerini hizmet, sektör ve içerik mimarisine bağlıyoruz.</p></article>
        <article class="service-card"><h3>Dönüşüm akışı</h3><p>Form, WhatsApp, teklif ve güven unsurlarını karar aşamasına göre konumlandırıyoruz.</p></article>
        <article class="service-card"><h3>Teknik temel</h3><p>Mobil performans, analitik ölçüm, yapılandırılmış veri ve çok dilli genişleme aynı sistemde ilerler.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">ÖNCELİKLİ ALANLAR</p>
        <h2>{market.name} için önce ticari etki üreten alanlara odaklanıyoruz.</h2>
      </div>
      <div class="service-grid">
        {market.priorityServices.map((service) => (
          <article class="service-card">
            <h3>{service}</h3>
            <p>{market.industries.join(", ")} odaklı şirketlerde bu alanı satış ve talep sürecinin diğer parçalarıyla birlikte kurguluyoruz.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {marketServicePages.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">PAZAR × HİZMET</p>
          <h2>{market.name} için odaklanmış hizmet sayfaları.</h2>
          <p>Genel pazar sayfasını, belirli hizmet aramalarına cevap veren daha net ticari kapsamlarla destekliyoruz.</p>
        </div>
        <div class="service-grid">
          {marketServicePages.map((service) => (
            <a class="service-card" href={trServicePath(market.id, service)}>
              <h3>{service.trName}</h3>
              <p>{service.trOutcome}</p>
              <strong>Detayı inceleyin →</strong>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">İLGİLİ ÇÖZÜMLER</p>
        <h2>{market.name} projesini tek bir landing page'e sıkıştırmıyoruz.</h2>
      </div>
      <div class="service-grid">
        <a class="service-card" href="/web-tasarim/"><h3>Web Tasarım</h3><p>Kurumsal güven, hız ve dönüşüm odaklı web mimarisi.</p><strong>İnceleyin →</strong></a>
        <a class="service-card" href="/e-ticaret/"><h3>E-Ticaret</h3><p>Shopify, ikas ve ihtiyaca uygun satış altyapıları.</p><strong>İnceleyin →</strong></a>
        <a class="service-card" href="/seo-geo/"><h3>SEO / GEO</h3><p>Arama motorları ve yapay zekâ destekli keşif kanalları için görünürlük.</p><strong>İnceleyin →</strong></a>
        <a class="service-card" href={isCountry ? "/ihracatcilar/" : "/ureticiler/"}><h3>{isCountry ? "İhracatçılar" : "B2B ve üreticiler"}</h3><p>{isCountry ? "Hedef pazara özel çok dilli talep ve landing page mimarisi." : "Ürün, hizmet ve teklif akışını karar verici odaklı yapılandırma."}</p><strong>İnceleyin →</strong></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">SONRAKİ ADIM</p>
        <h2>{market.name} için ölçülebilir bir büyüme planı çıkaralım.</h2>
        <p>Mevcut sitenizi, hedef sorguları ve dönüşüm akışını değerlendirip ilk uygulanabilir kapsamı netleştiriyoruz.</p>
        <a class="button button--primary" href="/iletisim/">Proje görüşmesi başlatın</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang="tr" />
</BaseLayout>
