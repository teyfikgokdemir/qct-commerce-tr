---
import PlatformSetupPage from '../../components/PlatformSetupPage.astro';
const faqItems = [
  { q: 'Shopify mağaza kurulumu ne kadar?', a: 'QCT Commerce standart Shopify mağaza kurulumu 9.900 TL’den başlar. Ürün girişi, özel uygulama, çoklu dil veya özel geliştirme ihtiyaçları ayrıca hesaplanır.' },
  { q: 'Shopify tema ve abonelik ücreti dahil mi?', a: 'Hayır. Shopify aboneliği, ücretli tema ve üçüncü taraf uygulama lisansları platform veya sağlayıcıya ayrıca ödenir.' },
  { q: 'Mevcut mağazam yenilenebilir mi?', a: 'Evet. Mevcut Shopify mağazanız mobil deneyim, tema, hız, ürün sayfaları, SEO ve dönüşüm akışı açısından yenilenebilir.' },
  { q: 'Shopify ürün girişi yapıyor musunuz?', a: 'Evet. Ürün ekleme hizmeti adet bazında ayrıca fiyatlandırılır ve standart ya da optimize içerik kapsamıyla uygulanabilir.' },
];
---
<PlatformSetupPage platform="Shopify" title="Shopify Mağaza Kurulumu & Fiyatları 2026 | QCT Commerce" description="Shopify mağaza kurulumu 9.900 TL’den. Tema düzeni, mobil optimizasyon, ödeme, kargo, ürün yapısı, teknik SEO ve yayına hazırlık. Şeffaf fiyatla başlayın." heading="Shopify mağazanızı satışa hazır kurun." lead="Sıfırdan Shopify mağaza kurulumu, mevcut mağaza yenileme, ürün girişi, tema düzenleme, ödeme–kargo ayarları ve teknik görünürlük çalışmalarını tek kapsamda yürütüyoruz." strengths={['Mobil alışveriş deneyimi','Tema & marka uyarlaması','Ödeme ve kargo düzeni','SEO & ölçüm temeli']} faqItems={faqItems} />
