---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const title = 'ციფრული გაყიდვების სისტემები ქართული კომპანიებისთვის | QCT Commerce';
const description = 'მრავალენოვანი B2B ვებსაიტები, საექსპორტო კატალოგები, SEO, GEO და გაყიდვების ავტომატიზაცია ქართული კომპანიებისთვის, რომლებიც თურქეთის, ევროპის და ყურის ბაზრებზე გადიან.';
const alternates = [
  { lang: 'en', href: '/en/georgia/' },
  { lang: 'ka-GE', href: '/ka/georgia/' },
];
const faqItems = [
  { q: 'მუშაობს თუ არა QCT Commerce კომპანიებთან საქართველოს სხვადასხვა ქალაქში?', a: 'დიახ. დისტანციურად ვმუშაობთ თბილისიდან, ბათუმიდან, ქუთაისიდან, რუსთავიდან და საქართველოს სხვა ბიზნეს ცენტრებიდან მოქმედ კომპანიებთან. პროექტი ეფუძნება სექტორს, სამიზნე ბაზარს და გაყიდვების პროცესს.' },
  { q: 'შეგიძლიათ ქართული და ინგლისური B2B ვებსაიტის შექმნა?', a: 'დიახ. ქართულ და ინგლისურ კონტენტს ერთიანად ვგეგმავთ, ხოლო საჭიროების შემთხვევაში ვამატებთ თურქულ ან სხვა სამიზნე ბაზრის ენას.' },
  { q: 'რომელი ქართული კომპანიებისთვის არის ეს მომსახურება ყველაზე შესაფერისი?', a: 'ყველაზე კარგი შესაბამისობა აქვთ ექსპორტიორ მწარმოებლებს, დისტრიბუტორებს, საბითუმო კომპანიებს, ლოგისტიკურ ბიზნესებს, სამშენებლო მომწოდებლებს და მზარდ საცალო ბრენდებს.' },
  { q: 'შეიძლება თუ არა ვებსაიტმა ფასის, ნიმუშის ან დისტრიბუტორის მოთხოვნები მიიღოს?', a: 'დიახ. სისტემა შეიძლება მოიცავდეს პროდუქტის კატალოგებს, ტექნიკურ დოკუმენტებს, ფასის მოთხოვნის ფორმებს, ნიმუშის მოთხოვნებს, პარტნიორის განაცხადებს და CRM-თან დაკავშირებულ ლიდების გადანაწილებას.' },
  { q: 'უზრუნველყოფთ SEO, GEO, AEO და AI ხილვადობას?', a: 'დიახ. ვაწყობთ ტექნიკურ SEO-ს, ბაზარზე მორგებულ კონტენტს, პასუხებზე ორიენტირებულ სექციებს, entity სიგნალებს და სტრუქტურირებულ მონაცემებს, რათა საძიებო და AI სისტემებმა სწორად გაიგონ კომპანია და მისი შეთავაზება.' },
  { q: 'შეგიძლიათ CRM-ისა და გაყიდვების ავტომატიზაციის დაკავშირება?', a: 'დიახ. შესაძლებელია მოთხოვნების მიღება, კვალიფიკაცია, პასუხისმგებელ პირზე გადანაწილება, ავტომატური დადასტურება და follow-up ადამიანური გაყიდვების პროცესის კონტროლის შენარჩუნებით.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://qctcommerce.com/ka/georgia/#faq',
  url: 'https://qctcommerce.com/ka/georgia/',
  inLanguage: 'ka-GE',
  mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---
<BaseLayout title={title} description={description} lang="ka" breadcrumbLabel="საქართველო" alternates={alternates} areaServed={['Georgia', 'Türkiye', 'European markets', 'Gulf countries']}>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header slot="header" lang="ka" />

  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">საქართველო → თურქეთი, ევროპა და ყურის ქვეყნები</p>
      <h1>გადააქციეთ საერთაშორისო ინტერესი სტრუქტურირებულ გაყიდვებად.</h1>
      <p class="page-hero__lead">ჩვენ ვქმნით მრავალენოვან ციფრულ გაყიდვების სისტემებს ქართველი მწარმოებლებისთვის, დისტრიბუტორებისა და მზარდი კომპანიებისთვის, რომლებსაც სურთ პროდუქტების მკაფიოდ წარდგენა, ხარისხიანი მოთხოვნების მიღება და ახალ ბაზრებზე უფრო თავდაჯერებულად შესვლა.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="mailto:info@qctcommerce.com?subject=Georgia%20market%20project">მოითხოვეთ ბაზრის შეფასება</a>
        <a class="button button--secondary" href="#fit">ნახეთ, ვისთვისაა</a>
      </div>
    </div>
  </section>

  <section id="fit" class="section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">კომერციული ზრდისთვის</p><h2>სწორი არჩევანია კომპანიებისთვის, რომლებსაც რეალური ზრდის მიზანი აქვთ.</h2></div>
      <div class="service-grid">
        <article class="service-card"><h3>ექსპორტიორი მწარმოებლები</h3><p>ტექნიკური კატალოგები, სერტიფიკატები, ნიმუშის მოთხოვნები და დისტრიბუტორის განაცხადები საერთაშორისო მყიდველებისთვის.</p></article>
        <article class="service-card"><h3>დისტრიბუტორები და საბითუმო კომპანიები</h3><p>სტრუქტურირებული პროდუქტის მოძიება, ბრენდების პორტფელი, პარტნიორის განაცხადები და CRM-თან დაკავშირებული შეთავაზების ფორმები.</p></article>
        <article class="service-card"><h3>საცალო და e-commerce ბრენდები</h3><p>უკეთესი პროდუქტის გზა, კონვერსიაზე ორიენტირებული landing page-ები და მრავალარხიანი მომხმარებლის გამოცდილება.</p></article>
        <article class="service-card"><h3>ლოგისტიკა და B2B სერვისები</h3><p>ლიდების კვალიფიკაცია, თვითმომსახურების ინფორმაცია და კომერციული მოთხოვნების ავტომატური გადანაწილება.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">საქართველოს ბაზარზე მორგებული მიდგომა</p><h2>სისტემა ქართული კომპანიების რეალურ კომერციულ საჭიროებებს ეყრდნობა.</h2><p>ვმუშაობთ თბილისიდან, ბათუმიდან, ქუთაისიდან, რუსთავიდან და საქართველოს სხვა ბიზნეს ცენტრებიდან მოქმედ კომპანიებთან. სისტემა მორგებულია ექსპორტზე, დისტრიბუტორების მოძიებაზე, მრავალენოვან პროდუქტის წარდგენასა და საერთაშორისო მოთხოვნების მართვაზე.</p></div>
      <div class="service-grid">
        <article class="service-card"><h3>ინდუსტრიული და სამშენებლო მომწოდებლები</h3><p>ტექნიკური მახასიათებლები, სერტიფიკატები, ჩამოსატვირთი დოკუმენტები და ფასის მოთხოვნის მკაფიო გზა.</p></article>
        <article class="service-card"><h3>საკვები, სასმელი და სამომხმარებლო პროდუქტები</h3><p>პროდუქტის მკაფიო ასორტიმენტი, საექსპორტო პოზიციონირება, დისტრიბუტორის მოძიება და მრავალენოვანი ნდობის კონტენტი.</p></article>
        <article class="service-card"><h3>ლოგისტიკა და სავაჭრო სერვისები</h3><p>მომსახურების არეალის მკაფიო აღწერა, ლიდების კვალიფიკაცია და საერთაშორისო მოთხოვნების გადანაწილება.</p></article>
        <article class="service-card"><h3>საცალო ჯგუფები და მზარდი ბრენდები</h3><p>კონვერსიაზე ორიენტირებული e-commerce გზა, კამპანიის landing page-ები და გაზომვადი მომხმარებლის მოზიდვა.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">კომერციული პრობლემა</p><h2>საერთაშორისო ზრდა ხშირად პირველ საუბრამდეც კი ფერხდება.</h2><p>პოტენციურ მყიდველს უჭირს შეთავაზების სწრაფად გაგება, პროდუქტების შედარება, სანდოობის შემოწმება ან სწორ ადამიანთან დაკავშირება. მნიშვნელოვანი მოთხოვნები სხვადასხვა არხში იკარგება და follow-up ხელით კეთდება.</p></div>
      <div class="process-grid">
        <article><span>01</span><h3>შეთავაზების პოზიციონირება</h3><p>ბაზარზე მორგებული მესიჯები თურქეთის, ევროპის ან ყურის ქვეყნების მყიდველებისთვის.</p></article>
        <article><span>02</span><h3>ნდობის შექმნა</h3><p>პროდუქტები, შესაძლებლობები, სერტიფიკატები, პროექტების მტკიცებულება და მკაფიო შემდეგი ნაბიჯები.</p></article>
        <article><span>03</span><h3>არც ერთი ლიდი არ დაიკარგოს</h3><p>CRM გადანაწილება, ავტომატური პასუხები და გაზომვადი follow-up პირველი მოთხოვნიდან გაყიდვების საუბრამდე.</p></article>
      </div>
    </div>
  </section>

  <section id="system" class="section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">რას შეიძლება მოიცავდეს სისტემა</p><h2>ფოკუსირებული გადაწყვეტა თქვენი ბაზარზე გასვლის გზის მიხედვით.</h2></div>
      <div class="service-grid">
        <article class="service-card"><h3>ინგლისური და სამიზნე ბაზრის ენის ვებსაიტი</h3><p>საერთაშორისო ინფორმაციული არქიტექტურა, მყიდველზე ორიენტირებული კონტენტი და მასშტაბირებადი ლოკალიზაცია.</p></article>
        <article class="service-card"><h3>B2B კატალოგი და მოთხოვნის ფორმები</h3><p>პროდუქტების დაჯგუფება, ტექნიკური დოკუმენტები, ფასის მოთხოვნა და დისტრიბუტორის განაცხადები.</p></article>
        <article class="service-card"><h3>SEO, GEO, AEO და AIO</h3><p>ტექნიკური SEO, გეოგრაფიული რელევანტურობა, პასუხებზე ორიენტირებული კონტენტი და entity სიგნალები საძიებო და AI სისტემებისთვის.</p></article>
        <article class="service-card"><h3>CRM და AI ავტომატიზაცია</h3><p>ლიდების მიღება, კვალიფიკაცია, გადანაწილება და follow-up ადამიანური გაყიდვების პროცესის დაკარგვის გარეშე.</p></article>
      </div>
    </div>
  </section>

  <section id="faq" class="section international-faq">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">ხშირად დასმული კითხვები</p><h2>რას კითხულობენ ქართული კომპანიები პროექტის დაწყებამდე.</h2></div>
      <div class="faq-list">
        {faqItems.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}
      </div>
    </div>
  </section>

  <section id="audit" class="section">
    <div class="container"><div class="section-heading"><p class="eyebrow">პრაქტიკული პირველი ნაბიჯი</p><h2>დაიწყეთ კომერციული ციფრული აუდიტით.</h2><p>ჩვენ ვაფასებთ თქვენს არსებულ ვებსაიტს, საერთაშორისო შეთავაზებას, მოთხოვნის გზებს და სამიზნე ბაზარს. ნებისმიერი ახალი პროექტის შეთავაზებამდე მიიღებთ ფოკუსირებულ შესაძლებლობების რუკას.</p><a class="button button--primary" href="mailto:info@qctcommerce.com?subject=Georgia%20commercial%20digital%20audit">მოითხოვეთ აუდიტი</a></div></div>
  </section>

  <Footer slot="footer" lang="ka" />
</BaseLayout>
