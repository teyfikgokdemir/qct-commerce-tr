---
import BaseLayout from '../../../layouts/BaseLayout.astro';import Header from '../../../components/Header.astro';import Footer from '../../../components/Footer.astro';
const tools=[['Pazaryeri Komisyon Hesaplayıcı','Pazaryeri komisyonu, operasyon maliyeti ve kendi sitenizle farkı hesaplayın.','/tr/araclar/pazaryeri-komisyon-hesaplama/'],['Web Sitesi Fiyat Hesaplayıcı','Kapsama göre tahmini proje aralığını görün.','/tr/araclar/web-sitesi-fiyat-hesaplama/'],['E-Ticaret Maliyet Hesaplayıcı','Dört satış modelini yıllık maliyetle karşılaştırın.','/tr/araclar/e-ticaret-maliyet-hesaplama/']];
---
<BaseLayout title="Ücretsiz E-Ticaret ve Web Hesaplayıcıları | QCT Commerce" description="Pazaryeri komisyonu, web sitesi proje aralığı ve e-ticaret maliyetini hesaplamak için ücretsiz araçlar." lang="tr" breadcrumbs={[{name:'Ana sayfa',url:'/'},{name:'Araçlar',url:'/tr/araclar/'}]}><Header slot="header" lang="tr"/><main class="tools container"><header><p>ÜCRETSİZ ARAÇLAR</p><h1>Kararı hesapla destekleyin</h1><div>Varsayımları kendi verinizle değiştirin; sonuçları teklif veya finansal danışmanlık yerine karar başlangıcı olarak kullanın.</div></header><section>{tools.map(([title,text,href])=><a href={href}><h2>{title}</h2><p>{text}</p><b>Hesapla →</b></a>)}</section></main><Footer slot="footer" lang="tr"/></BaseLayout><style>.tools{padding:calc(var(--qct-hero-clearance) + 64px) 20px 80px}.tools header{text-align:center;margin:0 auto 45px;max-width:720px}.tools header p{color:var(--qct-color-accent-strong);font-size:.75rem;font-weight:800;letter-spacing:.14em}.tools h1,.tools h2{color:var(--qct-color-ink);letter-spacing:-.05em}.tools h1{font-size:clamp(2.4rem,5vw,4.3rem);line-height:1.02;margin:.5rem 0 1.2rem}.tools header div,.tools p{color:var(--qct-color-muted);line-height:1.65}.tools section{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.tools section a{border:1px solid var(--qct-color-line-strong);color:inherit;min-height:210px;padding:22px;text-decoration:none}.tools h2{font-size:1.45rem;margin:0}.tools b{display:block;margin-top:1.8rem}@media(max-width:720px){.tools section{grid-template-columns:1fr}.tools section a{min-height:0}}</style>
