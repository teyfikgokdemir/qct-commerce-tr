---
import InternationalServicePage from '../../../components/InternationalServicePage.astro';
const capabilities=[
  {
    "title": "Corporate websites",
    "text": "Company, service, proof, work, contact and enquiry pages are structured around buyer questions."
  },
  {
    "title": "Personal and portfolio websites",
    "text": "Clear positioning, selected work, biography, contact routes and visibility foundations."
  },
  {
    "title": "Existing website redesign",
    "text": "We retain what works and redesign the areas that actually need improvement."
  },
  {
    "title": "Content architecture",
    "text": "Offer, customer segments, proof and page hierarchy are organised so the website can grow clearly."
  },
  {
    "title": "Mobile-first development",
    "text": "Layouts are designed and tested for mobile rather than compressed from desktop."
  },
  {
    "title": "SEO, GEO, AEO and AIO foundation",
    "text": "Semantic HTML, headings, entity relationships, structured data and source-quality content support search and AI discovery."
  },
  {
    "title": "Enquiry paths",
    "text": "Email, WhatsApp, forms, quotation and project enquiries can be separated by commercial need."
  },
  {
    "title": "Measurement",
    "text": "Important CTA, email, form and WhatsApp actions can be connected to consent-aware measurement."
  }
];
const process=[
  {
    "title": "Business and goal analysis",
    "text": "We define the business model, target customers, current channels, operational constraints and the commercial result the project should support."
  },
  {
    "title": "Current-state audit",
    "text": "We review the existing website or store, analytics, content, technical structure, search visibility and integrations where available."
  },
  {
    "title": "Architecture and scope",
    "text": "We decide what should be retained, rebuilt, migrated or added and document the scope before implementation."
  },
  {
    "title": "Customer journey",
    "text": "We map the route from search or advertising to evaluation, enquiry, checkout or follow-up."
  },
  {
    "title": "Content and interface",
    "text": "We structure information, messages, pages and mobile experience around real customer questions."
  },
  {
    "title": "Implementation",
    "text": "We build the approved structure, connect relevant tools and keep the system maintainable for the internal team."
  },
  {
    "title": "QA and measurement",
    "text": "We test mobile, forms, links, structured data, performance and included measurement events."
  },
  {
    "title": "Launch and improvement",
    "text": "We launch in a controlled way and prioritise later improvements using real usage and commercial evidence."
  }
];
const faqItems=[
  {
    "q": "How much does a website cost?",
    "a": "Starting prices are 6,900 TL for personal/portfolio sites and 8,900 TL for corporate websites."
  },
  {
    "q": "Can you redesign my current website?",
    "a": "Yes. Redesign starts with an audit so existing SEO, content and useful assets are not discarded unnecessarily."
  },
  {
    "q": "Do you write website content?",
    "a": "Content structure and copy can be included, including English and Turkish localisation."
  },
  {
    "q": "Will the site work on mobile?",
    "a": "Yes. Mobile usability is part of design and QA."
  },
  {
    "q": "Can you improve speed and Core Web Vitals?",
    "a": "Performance work can be included after identifying the actual bottlenecks."
  },
  {
    "q": "Is SEO included?",
    "a": "Basic technical SEO is built into the project; broader search and AI visibility can be scoped separately."
  },
  {
    "q": "Can the website collect B2B enquiries?",
    "a": "Yes. Quotation, sample, distributor, export or project enquiries can use separate routes."
  },
  {
    "q": "Do you use templates?",
    "a": "Existing systems can be used when appropriate, but structure and user journey are planned around the business."
  }
];
---
<InternationalServicePage title="Website Design & Development in Türkiye | QCT Commerce" description="Corporate, personal and business website design in Türkiye, including redesign, mobile UX, technical SEO, content architecture and measurable enquiry paths." eyebrow="Website design" heading="Your website should do more than introduce the business. It should move the sales process forward." lead="We build new corporate and personal websites and improve existing sites through content architecture, design, development, mobile UX, performance and search foundations." serviceName="Website design and development" problem="A weak website is not only a visual issue. If visitors cannot quickly understand the offer, trust the company or find the next step, marketing activity does not become qualified demand." capabilities={capabilities} process={process} faqItems={faqItems}/>