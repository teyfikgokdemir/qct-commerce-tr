---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const whatsappUrl = 'https://wa.me/905433856656?text=Hello%20QCT%20Commerce.%20I%20would%20like%20to%20discuss%20an%20international%20digital%20project.';
---
<BaseLayout
  title="Contact QCT Commerce | International Digital Projects"
  description="Contact QCT Commerce about multilingual websites, digital commerce, international visibility and sales automation projects."
  lang="en"
  pageType="ContactPage"
  breadcrumbLabel="Contact"
  areaServed={['Türkiye', 'Georgia', 'Europe', 'Gulf countries']}
>
  <Header slot="header" lang="en" />

  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">Contact QCT Commerce</p>
      <h1>Tell us where your company wants to grow.</h1>
      <p class="page-hero__lead">Share the current commercial challenge, target market and the system you already use. We will identify the most practical first step.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="mailto:info@qctcommerce.com?subject=International%20project%20enquiry">Email the project brief</a>
        <a class="button button--secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Start on WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="section qct-contact-page">
    <div class="container qct-contact-page__grid">
      <div>
        <div class="section-heading">
          <p class="eyebrow">Start with useful context</p>
          <h2>A clear first message leads to a better first decision.</h2>
          <p>You do not need a technical specification. A concise explanation of the commercial situation is enough to begin.</p>
        </div>
        <div class="qct-contact-prompts">
          <article><span>01</span><h3>Current situation</h3><p>What are you selling, to whom, and through which website or sales channels today?</p></article>
          <article><span>02</span><h3>Target market</h3><p>Which country, buyer group or commercial route are you trying to reach?</p></article>
          <article><span>03</span><h3>Main constraint</h3><p>Where are enquiries, product discovery, follow-up or conversion currently breaking down?</p></article>
          <article><span>04</span><h3>Useful evidence</h3><p>Include the current website, catalogue, sales channel or workflow so the first review is grounded in the real system.</p></article>
        </div>
      </div>

      <aside class="qct-contact-card" aria-label="QCT Commerce contact details">
        <p class="eyebrow">Direct contact</p>
        <h2>Speak to the team.</h2>
        <div class="qct-contact-card__item"><span>Email</span><a href="mailto:info@qctcommerce.com">info@qctcommerce.com</a></div>
        <div class="qct-contact-card__item"><span>Telephone</span><a href="tel:+905433856656">+90 543 385 66 56</a></div>
        <div class="qct-contact-card__item"><span>WhatsApp</span><a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Open a project conversation</a></div>
        <div class="qct-contact-card__item"><span>Markets</span><p>Türkiye · Georgia · International</p></div>
        <div class="qct-contact-card__actions">
          <a class="button button--primary" href="mailto:info@qctcommerce.com?subject=Commercial%20digital%20review">Request a commercial review</a>
          <a class="button button--secondary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">Message on WhatsApp</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section qct-international-cta">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Before a platform decision</p>
        <h2>See how we turn commercial needs into a focused system.</h2>
        <p>Our process starts with the market, buyer journey and operational constraint rather than a predetermined tool.</p>
        <a class="button button--primary" href="/en/how-we-work/">Explore how we work</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .qct-contact-page__grid { align-items: start; display: grid; gap: clamp(42px,7vw,96px); grid-template-columns: minmax(0,1.2fr) minmax(320px,.8fr); }
  .qct-contact-prompts { display: grid; gap: 14px; }
  .qct-contact-prompts article { background: #fffaf5; border: 1px solid rgba(23,21,20,.1); border-radius: 22px; padding: 28px; }
  .qct-contact-prompts span { color: #e66b5f; display: block; font-size: .76rem; font-weight: 900; letter-spacing: .14em; margin-bottom: 18px; }
  .qct-contact-prompts h3 { color: #171514; font-size: 1.35rem; margin: 0 0 10px; }
  .qct-contact-prompts p { color: #655d58; line-height: 1.7; margin: 0; }
  .qct-contact-card { background: #171514; border-radius: 28px; color: #fffaf5; padding: clamp(30px,4vw,48px); position: sticky; top: 100px; }
  .qct-contact-card h2 { color: #fffaf5; font-size: clamp(2rem,3vw,3rem); line-height: 1.05; margin: 0 0 34px; }
  .qct-contact-card__item { border-top: 1px solid rgba(255,255,255,.14); padding: 20px 0; }
  .qct-contact-card__item span { color: rgba(255,250,245,.55); display: block; font-size: .75rem; font-weight: 900; letter-spacing: .1em; margin-bottom: 8px; text-transform: uppercase; }
  .qct-contact-card__item a, .qct-contact-card__item p { color: #fffaf5; font-size: 1.05rem; margin: 0; text-decoration-color: rgba(230,107,95,.75); }
  .qct-contact-card__actions { display: grid; gap: 10px; margin-top: 28px; }
  .qct-contact-card__actions .button { justify-content: center; width: 100%; }
  .qct-contact-card__actions .button--secondary { border-color: rgba(255,255,255,.32); color: #fffaf5; }
  @media (max-width: 900px) { .qct-contact-page__grid { grid-template-columns: 1fr; } .qct-contact-card { position: static; } }
</style>
