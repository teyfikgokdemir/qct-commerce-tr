---
import InternationalServicePage from '../../../components/InternationalServicePage.astro';
const capabilities=[
  {
    "title": "Technical SEO",
    "text": "Crawlability, indexing, canonical, sitemap, metadata, performance, mobile rendering and internal links are reviewed first."
  },
  {
    "title": "Search intent and page architecture",
    "text": "Service, product, category and guide pages are aligned with commercial questions people actually search for."
  },
  {
    "title": "GEO — Generative Engine Optimization",
    "text": "Content is structured so generative systems can understand the company, services, scope, evidence and context."
  },
  {
    "title": "AEO — Answer Engine Optimization",
    "text": "Important questions receive concise visible answers supported by deeper explanations."
  },
  {
    "title": "AI visibility and entities",
    "text": "Organization, service, founder, market and content signals are kept consistent across visible content and structured data."
  },
  {
    "title": "ChatGPT, Claude, Gemini and Perplexity",
    "text": "Publicly crawlable, source-quality pages and consistent entity data improve the conditions for AI-assisted discovery; no citation can be guaranteed."
  },
  {
    "title": "Structured data",
    "text": "Organization, Service, Article and FAQ schema are used only when they match visible content."
  },
  {
    "title": "Measurement",
    "text": "Search Console, branded queries, long-tail impressions, qualified enquiries and AI-referral signals are evaluated together where available."
  }
];
const process=[
  {
    "title": "Business and goal analysis",
    "text": "We define the business model, target customers, current channels, operational constraints and the commercial result the project should support."
  },
  {
    "title": "Current-state audit",
    "text": "We review the existing website or store, analytics, content, technical structure, search visibility and integrations where available."
  },
  {
    "title": "Architecture and scope",
    "text": "We decide what should be retained, rebuilt, migrated or added and document the scope before implementation."
  },
  {
    "title": "Customer journey",
    "text": "We map the route from search or advertising to evaluation, enquiry, checkout or follow-up."
  },
  {
    "title": "Content and interface",
    "text": "We structure information, messages, pages and mobile experience around real customer questions."
  },
  {
    "title": "Implementation",
    "text": "We build the approved structure, connect relevant tools and keep the system maintainable for the internal team."
  },
  {
    "title": "QA and measurement",
    "text": "We test mobile, forms, links, structured data, performance and included measurement events."
  },
  {
    "title": "Launch and improvement",
    "text": "We launch in a controlled way and prioritise later improvements using real usage and commercial evidence."
  }
];
const faqItems=[
  {
    "q": "Can you guarantee that ChatGPT or another AI will cite my site?",
    "a": "No. We can improve crawlability, entity clarity, content quality and source signals, but independent AI systems decide what to use."
  },
  {
    "q": "What is GEO?",
    "a": "Generative Engine Optimization structures reliable content and entity context for generative systems."
  },
  {
    "q": "What is AEO?",
    "a": "Answer Engine Optimization focuses on clear and useful answers to real user questions."
  },
  {
    "q": "Does llms.txt guarantee AI visibility?",
    "a": "No. It may help some agents understand site resources, but crawl access, quality HTML, search fundamentals and trustworthy content remain more important."
  },
  {
    "q": "Can you optimise an existing website?",
    "a": "Yes. We can audit technical SEO, content, schema, internal linking and entity consistency."
  },
  {
    "q": "Do you work with English content for businesses in Türkiye?",
    "a": "Yes. English pages can target English-speaking residents, founders and teams operating in Türkiye with the same local scope and TL pricing."
  },
  {
    "q": "How long does SEO take?",
    "a": "Technical issues may be fixed quickly, but competitive visibility depends on indexing, content, authority and market conditions."
  },
  {
    "q": "Do you set up Search Console and GA4?",
    "a": "Yes, basic setup and verification can be scoped separately."
  }
];
---
<InternationalServicePage title="SEO, GEO, AEO & AI Visibility in Türkiye | QCT Commerce" description="Technical SEO, GEO, AEO and AI visibility audits and implementation for Google, ChatGPT, Claude, Gemini, Perplexity and AI-assisted discovery in Türkiye." eyebrow="SEO, GEO, AEO and AIO" heading="Make your business easier to find, understand and cite." lead="We combine technical SEO, search-intent content, entity clarity, structured data, answer-first information and AI-search accessibility for websites in Türkiye." serviceName="SEO, GEO, AEO and AI visibility" problem="Publishing more pages does not solve visibility when the site has indexing problems, weak architecture, unclear entities, generic content or inconsistent information." capabilities={capabilities} process={process} faqItems={faqItems}/>
<section class="dynamic-seo-pricing" aria-labelledby="dynamic-seo-en-title">
  <div class="container">
    <p class="eyebrow">MONTHLY DYNAMIC SEO</p>
    <h2 id="dynamic-seo-en-title">Continuous search and AI visibility, not a one-off checklist.</h2>
    <p class="lead">Technical health, Search Console queries, priority pages, content opportunities and GEO/AEO/AIO signals are reviewed continuously.</p>
    <div class="grid">
      <article><h3>SEO Care</h3><strong>3,990 TL / month</strong><p>Technical monitoring, Search Console, sitemap/index checks and core metadata improvements.</p></article>
      <article class="featured"><span>RECOMMENDED</span><h3>Dynamic SEO</h3><strong>5,990 TL / month</strong><p>SEO Care plus query analysis, schema, internal linking, priority-page optimisation, GEO/AEO/AIO work and one original article each month.</p></article>
      <article><h3>SEO Growth</h3><strong>7,990 TL / month</strong><p>Dynamic SEO plus two original articles, landing-page improvements, competitor/query analysis and broader optimisation.</p></article>
    </div>
  </div>
</section>
<style>
.dynamic-seo-pricing{padding:clamp(4rem,7vw,6rem) 0;background:#f3eee7;color:#171514}.dynamic-seo-pricing .container{text-align:center}.dynamic-seo-pricing .eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.14em;color:#b9473e}.dynamic-seo-pricing h2{max-width:960px;margin:.6rem auto 0;font-size:clamp(2rem,3.5vw,3.5rem);line-height:1.04;letter-spacing:-.04em}.dynamic-seo-pricing .lead{max-width:760px;margin:1rem auto 2rem;color:#655d58;line-height:1.7}.dynamic-seo-pricing .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;max-width:1120px;margin:auto}.dynamic-seo-pricing article{text-align:left;padding:clamp(1.5rem,2.5vw,2.1rem);background:#fffaf5;border:1px solid rgba(23,21,20,.1);border-radius:22px;box-shadow:0 18px 50px rgba(23,21,20,.06)}.dynamic-seo-pricing article.featured{border-color:rgba(185,71,62,.4);transform:translateY(-6px)}.dynamic-seo-pricing article>span{display:inline-block;margin-bottom:1rem;font-size:.68rem;font-weight:800;letter-spacing:.12em;color:#b9473e}.dynamic-seo-pricing h3{margin:0 0 .6rem;font-size:1.35rem}.dynamic-seo-pricing strong{display:block;font-size:clamp(1.8rem,3vw,2.6rem);letter-spacing:-.04em;margin-bottom:1rem}.dynamic-seo-pricing article p{margin:0;color:#655d58;line-height:1.68}@media(max-width:820px){.dynamic-seo-pricing .grid{grid-template-columns:1fr}.dynamic-seo-pricing article.featured{transform:none}}
</style>