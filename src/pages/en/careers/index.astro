---
import BaseLayout from '../../../layouts/BaseLayout.astro';import Header from '../../../components/Header.astro';import Footer from '../../../components/Footer.astro';
const sections=[
  {
    "title": "What to send",
    "text": "Share a short introduction, relevant work or portfolio links, the area you want to contribute to and your preferred working arrangement."
  },
  {
    "title": "Relevant disciplines",
    "text": "Web development, e-commerce operations, UX/UI, technical SEO, content, multilingual localisation, performance, analytics and controlled AI automation are relevant areas."
  },
  {
    "title": "How to apply",
    "text": "Send a concise application to info@qctcommerce.com. General applications are reviewed according to current project and team needs."
  }
];
---
<BaseLayout title="Careers & Collaboration | QCT Commerce" description="English careers and collaboration information for QCT Commerce, including what to include when sending a general application or collaboration proposal." lang="en" breadcrumbLabel="Careers and collaboration"><Header slot="header" lang="en"/><section class="page-hero section"><div class="container"><p class="eyebrow">CAREERS</p><h1>Careers and collaboration</h1><p class="page-hero__lead">For people who want to work with QCT Commerce or propose a relevant collaboration in web, e-commerce, growth or automation.</p></div></section><section class="section"><div class="container"><div class="qct-legal-en">{sections.map(s=><section><h2>{s.title}</h2><p>{s.text}</p></section>)}</div></div></section><Footer slot="footer" lang="en"/></BaseLayout>
<style>.qct-legal-en{max-width:860px}.qct-legal-en section{padding:24px 0;border-top:1px solid var(--qct-color-line)}.qct-legal-en h2{font-size:1.5rem}.qct-legal-en p{color:var(--qct-color-muted);line-height:1.75}</style>