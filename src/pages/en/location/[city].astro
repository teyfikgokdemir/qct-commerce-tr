---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { enMarkets, programmaticServices, internationalMarketEnIds, enServicePath } from "../../../data/programmatic-markets";

export function getStaticPaths() {
  return enMarkets.map((market) => ({
    params: { city: market.id },
    props: { market },
  }));
}

const { market } = Astro.props;
const isCountry = market.type === "country";
const title = `${market.name} Web Design & E-Commerce Agency | QCT Commerce`;
const description = `Web design, e-commerce and SEO/GEO for ${market.name}. We ${market.marketAngle} with a measurable digital demand system built by QCT Commerce.`;
const alternates = [
  { lang: "tr-TR", href: `/lokasyon/${market.alternateId}/` },
  { lang: "en", href: `/en/location/${market.id}/` },
];
const marketServicePages = internationalMarketEnIds.has(market.id) ? programmaticServices : [];
const breadcrumbs = [
  { name: "Home", url: "/en/" },
  { name: "Services", url: "/en/services/" },
  { name: market.name, url: `/en/location/${market.id}/` },
];
---

<BaseLayout title={title} description={description} lang="en" alternates={alternates} breadcrumbs={breadcrumbs} pageType="CollectionPage" areaServed={market.areaServed}>
  <Header slot="header" lang="en" />

  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">{isCountry ? "INTERNATIONAL MARKET" : "LOCAL GROWTH"} · {market.name.toUpperCase()}</p>
      <h1>Digital growth infrastructure for {market.name}.</h1>
      <p class="page-hero__lead">For {market.audience.toLowerCase()}, we connect web, e-commerce and search visibility into one commercial journey. The goal is to {market.marketAngle}.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/en/contact/">Discuss a {market.name} project</a>
        <a class="button button--secondary" href="/en/work/">View selected work</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">MARKET CONTEXT</p>
        <h2>A commercial scenario for {market.name}, not a location-name swap.</h2>
        <p>{market.commercialContext}</p>
      </div>
      <div class="service-grid">
        <article class="service-card"><h3>Search visibility</h3><p>SEO, GEO, AEO and AIO signals are connected to services, sectors and content architecture.</p></article>
        <article class="service-card"><h3>Conversion flow</h3><p>Forms, WhatsApp, proof and enquiry paths are positioned around buyer intent.</p></article>
        <article class="service-card"><h3>Technical foundation</h3><p>Mobile performance, analytics, structured data and multilingual expansion share the same system.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">PRIORITY AREAS</p>
        <h2>We start with the areas most likely to improve commercial performance.</h2>
      </div>
      <div class="service-grid">
        {market.priorityServices.map((service) => (
          <article class="service-card">
            <h3>{service}</h3>
            <p>For {market.industries.join(", ")} businesses, this capability is designed as part of the complete acquisition and conversion journey.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {marketServicePages.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">MARKET & SERVICE</p>
          <h2>Focused service pages for {market.name}.</h2>
          <p>The general market page is supported by service-specific commercial scopes for higher-intent searches.</p>
        </div>
        <div class="service-grid">
          {marketServicePages.map((service) => (
            <a class="service-card" href={enServicePath(market.id, service)}>
              <h3>{service.enName}</h3>
              <p>{service.enOutcome}</p>
              <strong>Explore →</strong>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">RELATED SOLUTIONS</p>
        <h2>A {market.name} project should not depend on one landing page.</h2>
      </div>
      <div class="service-grid">
        <a class="service-card" href="/en/web-design/"><h3>Web Design</h3><p>High-trust, fast and conversion-focused websites.</p><strong>Explore →</strong></a>
        <a class="service-card" href="/en/ecommerce/"><h3>E-Commerce</h3><p>Store architecture and commerce journeys built around the operating model.</p><strong>Explore →</strong></a>
        <a class="service-card" href="/en/search-visibility/"><h3>SEO / GEO</h3><p>Search visibility for conventional and AI-assisted discovery.</p><strong>Explore →</strong></a>
        <a class="service-card" href={isCountry ? "/en/exporters/" : "/en/manufacturers/"}><h3>{isCountry ? "Exporters" : "B2B & manufacturers"}</h3><p>{isCountry ? "Multilingual demand architecture for selected target markets." : "Product, service and enquiry paths designed for business buyers."}</p><strong>Explore →</strong></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">NEXT STEP</p>
        <h2>Define a measurable growth plan for {market.name}.</h2>
        <p>We review the current website, target queries and conversion path, then define the first practical implementation scope.</p>
        <a class="button button--primary" href="/en/contact/">Start a project discussion</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang="en" />
</BaseLayout>
