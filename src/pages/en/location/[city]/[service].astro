---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { enMarkets, programmaticServices, internationalMarketEnIds, trServicePath, enServicePath } from "../../../../data/programmatic-markets";

export function getStaticPaths() {
  return enMarkets
    .filter((market) => internationalMarketEnIds.has(market.id))
    .flatMap((market) => programmaticServices.map((service) => ({
      params: { city: market.id, service: service.enSlug },
      props: { market, service },
    })));
}

const { market, service } = Astro.props;
const title = `${market.name} ${service.enName} Services | QCT Commerce`;
const description = `${service.enName} for ${market.name}: ${service.enOutcome} Build a measurable, scalable digital growth system with QCT Commerce.`;
const azSlug = ({ "web-design":"veb-dizayn", "ecommerce":"e-ticaret", "search-visibility":"seo-geo" } as Record<string,string>)[service.enSlug];
const alternates = [
  { lang: "tr-TR", href: trServicePath(market.alternateId, service) },
  { lang: "en", href: enServicePath(market.id, service) },
  ...(market.id === "azerbaijan" && azSlug ? [{ lang: "az-AZ", href: `/az/${azSlug}/` }] : []),
];
const breadcrumbs = [
  { name: "Home", url: "/en/" },
  { name: market.name, url: `/en/location/${market.id}/` },
  { name: service.enName, url: enServicePath(market.id, service) },
];
---

<BaseLayout title={title} description={description} lang="en" alternates={alternates} breadcrumbs={breadcrumbs} pageType="CollectionPage" areaServed={market.areaServed}>
  <Header slot="header" lang="en" />

  <section class="page-hero section">
    <div class="container">
      <p class="eyebrow">{market.name.toUpperCase()} · {service.enName.toUpperCase()}</p>
      <h1>{service.enName} for {market.name}.</h1>
      <p class="page-hero__lead">For {market.name}, the objective is to {service.enIntent}. This is not a repeated location template; it is a service-specific commercial scope built around buyer intent.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="/en/contact/">Discuss a {market.name} project</a>
        <a class="button button--secondary" href={service.enCorePath}>Explore the core service</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">COMMERCIAL CONTEXT</p>
        <h2>What should {service.enName.toLowerCase()} solve for {market.name}?</h2>
        <p>{market.commercialContext}</p>
      </div>
      <div class="service-grid">
        <article class="service-card"><h3>Outcome</h3><p>{service.enOutcome}</p></article>
        <article class="service-card"><h3>Market fit</h3><p>The objective is to {market.marketAngle}; scope and messaging are built around that priority.</p></article>
        <article class="service-card"><h3>Measurement</h3><p>Organic visibility, qualified enquiries, conversion paths and technical performance are measured together.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">SCOPE</p>
        <h2>Core delivery components.</h2>
        <p>For {market.industries.join(", ")} businesses, these components are treated as parts of one commercial system rather than isolated tasks.</p>
      </div>
      <div class="service-grid">
        {service.enDeliverables.map((item) => (
          <article class="service-card"><h3>{item}</h3><p>Included as a measurable, sustainable implementation component for the {market.name} market.</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">NEXT STEP</p>
        <h2>Define the right {service.enName.toLowerCase()} scope for {market.name}.</h2>
        <p>We review the current structure and target queries, then define the first practical implementation scope.</p>
        <a class="button button--primary" href="/en/contact/">Start a project discussion</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang="en" />
</BaseLayout>
