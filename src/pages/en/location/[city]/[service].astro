---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Header from "../../../../components/Header.astro";
import Footer from "../../../../components/Footer.astro";
import { enMarkets, programmaticServices, internationalMarketEnIds, trServicePath, enServicePath } from "../../../../data/programmatic-markets";

export function getStaticPaths() {
  return enMarkets
    .filter((market) => internationalMarketEnIds.has(market.id))
    .flatMap((market) => programmaticServices.map((service) => ({
      params: { city: market.id, service: service.enSlug },
      props: { market, service },
    })));
}

const { market, service } = Astro.props;
const title = `${market.name} ${service.enName} Services | QCT Commerce`;
const description = `${service.enName} for ${market.name}: ${service.enOutcome} Build a measurable, scalable digital growth system with QCT Commerce.`;
const alternates = [
  { lang: "tr-TR", href: trServicePath(market.alternateId, service) },
  { lang: "en", href: enServicePath(market.id, service) },
];
const breadcrumbs = [
  { name: "Home", url: "/en/" },
  { name: market.name, url: `/en/location/${market.id}/` },
  { name: service.enName, url: enServicePath(market.id, service) },
];
---

<BaseLayout title={title} description={description} lang="en" alternates={alternates} breadcrumbs={breadcrumbs} pageType="CollectionPage" areaServed={market.areaServed}>
  <Header slot="header" lang="en" />
  <link rel="stylesheet" href="/styles/qct-v2.css?v=20260928-1" />
  <div class="qct-v2" data-qct-v2>
    <section class="qct-hero">
      <div class="qct-shell qct-hero-grid">
        <div class="qct-hero-copy">
          <p class="qct-eyebrow">{market.name.toUpperCase()} · {service.enName.toUpperCase()}</p>
          <h1 class="qct-hero-title"><em>{market.name}</em> {service.enName}</h1>
          <p class="qct-lead">
            This is not a location-name swap. For {market.name}, the objective is to <strong>{service.enIntent}</strong>.
          </p>
          <div class="qct-hero-actions">
            <a class="qct-btn qct-btn-primary" href="/en/contact/">Discuss a {market.name} project <span>→</span></a>
            <a class="qct-btn qct-btn-secondary" href={service.enCorePath}>Explore the core service</a>
          </div>
        </div>
      </div>
    </section>

    <section class="qct-benefits">
      <div class="qct-shell qct-benefit-grid">
        <article>
          <p class="qct-section-label">TARGET MARKET</p>
          <h3>{market.name} context</h3>
          <p>{market.commercialContext}</p>
        </article>
        <article>
          <p class="qct-section-label">SERVICE FOCUS</p>
          <h3>What should {service.enName.toLowerCase()} deliver?</h3>
          <p>{service.enOutcome}</p>
        </article>
        <article>
          <p class="qct-section-label">DELIVERY SCOPE</p>
          <h3>Core components</h3>
          <p>{service.enDeliverables.join(" · ")}</p>
        </article>
        <article>
          <p class="qct-section-label">MEASUREMENT</p>
          <h3>More than traffic</h3>
          <p>Organic visibility, qualified enquiries, conversion paths and technical performance are measured together.</p>
        </article>
      </div>
    </section>

    <section class="qct-shell">
      <div class="qct-section-head">
        <p class="qct-section-label">IMPLEMENTATION PRINCIPLE</p>
        <h2>How {service.enName.toLowerCase()} changes for {market.name}</h2>
        <p>The market objective is to {market.marketAngle}; content, information architecture and calls to action are built around that context.</p>
      </div>
      <div class="qct-benefit-grid">
        {service.enDeliverables.map((item, index) => (
          <article>
            <span class="qct-card-kicker">0{index + 1}</span>
            <h3>{item}</h3>
            <p>For {market.industries.join(", ")} businesses, this component is designed as part of the route to a qualified commercial conversation.</p>
          </article>
        ))}
      </div>
    </section>

    <section class="qct-close">
      <div class="qct-shell qct-close-grid">
        <div>
          <p class="qct-section-label">{market.name.toUpperCase()} · {service.enName.toUpperCase()}</p>
          <h2>Build a market-specific, <em>measurable</em> system.</h2>
          <p>We can review the current website and target queries, then define the first practical implementation scope.</p>
        </div>
        <a class="qct-btn qct-btn-light" href="/en/contact/">Start a project discussion <span>→</span></a>
      </div>
    </section>
  </div>
  <Footer slot="footer" lang="en" />
</BaseLayout>
