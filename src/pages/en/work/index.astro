---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const cases = [
  {
    name: 'HEADWEAR',
    sector: 'Multilingual e-commerce',
    image: '/images/work/headwear/headwear-web-deneyimi.webp',
    alt: 'HEADWEAR multilingual e-commerce website on desktop',
    challenge: 'Make a focused product range understandable and purchasable across languages and devices.',
    system: 'Collection architecture, multilingual navigation, product templates, customer account routes and a mobile-first purchase journey.',
    outcome: 'A live Shopify store connecting product discovery, account, cart and purchase actions in one responsive commerce experience.',
    facts: ['Live commerce store', 'Verified Shopify platform', 'Multilingual routes', 'Responsive product and cart flow'],
    caseStudyUrl: '/en/work/headwear/',
    liveUrl: 'https://www.head-wear.com/',
    relatedServices: [
      { label: 'E-commerce systems', href: '/en/ecommerce/' },
      { label: 'B2B web design', href: '/en/web-design/' }
    ]
  },
  {
    name: 'Misima Group',
    sector: 'Corporate and B2B web system',
    image: '/images/work/misima/misima-web-deneyimi.webp',
    alt: 'Misima Group corporate website on desktop',
    challenge: 'Explain several business models without making the group appear fragmented.',
    system: 'A structured information architecture for corporate content, private label services, brands and product discovery across responsive page templates.',
    outcome: 'A live 2025 web experience that gives brand owners, distribution partners and buyers clear routes through the group offer.',
    facts: ['2025 project', 'Strategy, design and development', 'Responsive B2B website', 'Private-label and brand architecture'],
    liveUrl: 'https://www.misima.com.tr/',
    relatedServices: [
      { label: 'B2B web design', href: '/en/web-design/' },
      { label: 'Search visibility', href: '/en/search-visibility/' }
    ]
  },
  {
    name: 'Artman Group',
    sector: 'Corporate supply and operations',
    image: '/images/work/artman/artman-web-deneyimi.webp',
    alt: 'Artman Group corporate website on desktop',
    challenge: 'Present a broad service portfolio as one coherent corporate offer.',
    system: 'Clear service categories, procurement-oriented content, trust sections and action paths organised around commercial questions.',
    outcome: 'A live digital centre where visitors can identify the relevant service and move to the appropriate commercial contact path.',
    facts: ['Türkiye market', 'Corporate B2B website', 'Information architecture and web experience', 'Service-led enquiry paths'],
    liveUrl: 'https://artmangroup.com.tr/',
    relatedServices: [
      { label: 'B2B web design', href: '/en/web-design/' },
      { label: 'AI and sales automation', href: '/en/ai-automation/' }
    ]
  }
];
---
<BaseLayout
  title="Selected Digital Commerce and B2B Work | QCT Commerce"
  description="Explore selected QCT Commerce and QCT Studio projects across multilingual e-commerce, corporate B2B websites and commercial digital systems."
  lang="en"
  pageType="CollectionPage"
  breadcrumbLabel="Selected work"
  areaServed={['Türkiye', 'Georgia', 'Europe', 'Gulf countries']}
>
  <Header slot="header" lang="en" />

  <section class="page-hero section qct-work-hero">
    <div class="container">
      <p class="eyebrow">Selected commercial work</p>
      <h1>Digital systems built around a real business problem.</h1>
      <p class="page-hero__lead">These projects show how product discovery, service architecture, multilingual content and conversion paths can be organised into a clearer commercial experience.</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#cases">Explore the work</a>
        <a class="button button--secondary" href="/en/audit/">Start with an audit</a>
      </div>
    </div>
  </section>

  <section id="cases" class="section qct-work-showcase">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Evidence before claims</p>
        <h2>Three different business models. Three focused digital structures.</h2>
        <p>We describe only observable scope and live outputs. No invented performance figures or unsupported growth claims.</p>
      </div>
      <div class="qct-work-showcase__list">
        {cases.map((item, index) => (
          <article class="qct-work-showcase__card">
            <a class="qct-work-showcase__image" href={item.caseStudyUrl ?? item.liveUrl} target={item.caseStudyUrl ? undefined : '_blank'} rel={item.caseStudyUrl ? undefined : 'noopener noreferrer'} aria-label={item.caseStudyUrl ? `Read the ${item.name} case study` : `Visit the live ${item.name} website`}>
              <img src={item.image} alt={item.alt} width="1600" height="1000" loading="lazy" decoding="async" />
            </a>
            <div class="qct-work-showcase__content">
              <p class="qct-work-showcase__index">0{index + 1} / {item.sector}</p>
              <h2>{item.name}</h2>
              <div class="qct-work-showcase__detail"><h3>Commercial need</h3><p>{item.challenge}</p></div>
              <div class="qct-work-showcase__detail"><h3>System delivered</h3><p>{item.system}</p></div>
              <div class="qct-work-showcase__detail"><h3>Live outcome</h3><p>{item.outcome}</p></div>
              <ul class="qct-work-showcase__facts">{item.facts.map((fact) => <li>{fact}</li>)}</ul>
              <div class="qct-work-showcase__services" aria-label={`Related QCT Commerce services for ${item.name}`}>
                <span>Related capabilities</span>
                {item.relatedServices.map((service) => <a href={service.href}>{service.label}</a>)}
              </div>
              <div class="qct-work-showcase__actions">
                {item.caseStudyUrl && <a class="qct-work-showcase__link" href={item.caseStudyUrl}>Read case study <span aria-hidden="true">→</span></a>}
                <a class="qct-work-showcase__link" href={item.liveUrl} target="_blank" rel="noopener noreferrer">Visit live project <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section qct-international-cta">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Your commercial context</p>
        <h2>The next system should start with your actual sales constraint.</h2>
        <p>We review the current site, offer, buyer journey and lead flow before recommending a platform or build scope.</p>
        <a class="button button--primary" href="/en/audit/">Request a commercial digital audit</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .qct-work-hero h1 { max-width: 920px; }
  .qct-work-showcase { background: #ebe4dc; }
  .qct-work-showcase__list { display: grid; gap: clamp(42px, 7vw, 86px); }
  .qct-work-showcase__card { align-items: start; border-top: 1px solid rgba(23,21,20,.18); display: grid; gap: clamp(30px,5vw,68px); grid-template-columns: minmax(0,1.08fr) minmax(320px,.92fr); padding-top: clamp(26px,4vw,44px); }
  .qct-work-showcase__card:nth-child(even) .qct-work-showcase__image { order: 2; }
  .qct-work-showcase__image { aspect-ratio: 16 / 10; background: #171514; border-radius: 26px; box-shadow: 0 24px 70px rgba(23,21,20,.12); display: block; overflow: hidden; }
  .qct-work-showcase__image img { display: block; height: 100%; object-fit: cover; transition: transform .35s ease; width: 100%; }
  .qct-work-showcase__image:hover img, .qct-work-showcase__image:focus-visible img { transform: scale(1.025); }
  .qct-work-showcase__content { padding-top: 4px; }
  .qct-work-showcase__index { color: #e66b5f; font-size: .78rem; font-weight: 900; letter-spacing: .12em; margin: 0 0 18px; text-transform: uppercase; }
  .qct-work-showcase__content > h2 { color: #171514; font-size: clamp(2.2rem,3.7vw,3.7rem); letter-spacing: -.045em; line-height: 1; margin: 0 0 30px; }
  .qct-work-showcase__detail { border-top: 1px solid rgba(23,21,20,.11); padding: 20px 0; }
  .qct-work-showcase__detail h3 { color: #171514; font-size: 1rem; margin: 0 0 8px; }
  .qct-work-showcase__detail p { color: #655d58; line-height: 1.68; margin: 0; }
  .qct-work-showcase__facts { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 22px 0 0; padding: 0; }
  .qct-work-showcase__facts li { background: #fffaf5; border: 1px solid rgba(23,21,20,.1); border-radius: 999px; color: #4f4843; font-size: .83rem; font-weight: 700; padding: 9px 13px; }
  .qct-work-showcase__services { border-top: 1px solid rgba(23,21,20,.11); display: flex; flex-wrap: wrap; gap: 9px; margin-top: 24px; padding-top: 20px; }
  .qct-work-showcase__services > span { color: #655d58; flex-basis: 100%; font-size: .74rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .qct-work-showcase__services a { border: 1px solid rgba(182,65,55,.22); border-radius: 999px; color: #b64137; font-size: .84rem; font-weight: 800; padding: 8px 12px; text-decoration: none; }
  .qct-work-showcase__services a:hover, .qct-work-showcase__services a:focus-visible { background: rgba(230,107,95,.08); border-color: rgba(182,65,55,.42); }
  .qct-work-showcase__actions { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 24px; }
  .qct-work-showcase__link { color: #b64137; display: inline-flex; font-weight: 800; gap: 8px; min-height: 44px; text-underline-offset: .28em; }
  @media (max-width: 960px) { .qct-work-showcase__card { grid-template-columns: 1fr; } .qct-work-showcase__card:nth-child(even) .qct-work-showcase__image { order: initial; } }
  @media (max-width: 640px) { .qct-work-showcase__image { border-radius: 20px; } .qct-work-showcase__content > h2 { font-size: clamp(2rem,10vw,2.8rem); } }
</style>