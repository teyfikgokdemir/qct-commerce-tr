---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Digital Commerce & International Sales Systems | QCT Commerce';
const description = 'QCT Commerce builds multilingual websites, B2B sales systems, e-commerce experiences and AI automation for companies entering new markets.';
const alternates = [
  { lang: 'tr-TR', href: '/' },
  { lang: 'en', href: '/en/' },
];
---
<BaseLayout title={title} description={description} lang="en" isHome={true} alternates={alternates} areaServed={['Türkiye', 'Georgia', 'Europe', 'Gulf countries']}>
  <Header slot="header" lang="en" />

  <div class="qct-international-home">
    <section class="hero section">
      <div class="container hero__inner">
        <div class="hero__content">
          <p class="eyebrow">Digital commerce across borders</p>
          <h1>Build the sales system your next market expects.</h1>
          <p class="hero__lead">We help manufacturers, distributors and growing brands turn multilingual websites, e-commerce and automation into a practical international sales channel.</p>
          <div class="hero__actions">
            <a class="button button--primary" href="mailto:info@qctcommerce.com?subject=International%20growth%20project">Discuss your market</a>
            <a class="button button--secondary" href="/en/georgia/">Explore Georgia</a>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">What we build</p>
          <h2>Not another website. A connected sales system.</h2>
          <p>Each engagement starts with the commercial gap: weak product discovery, lost enquiries, poor international positioning or manual sales operations.</p>
        </div>
        <div class="service-grid qct-home-solutions">
          <a class="service-card" href="/en/web-design/"><span>01</span><h3>Multilingual B2B websites</h3><p>Clear market positioning, technical product presentation and conversion paths for buyers, partners and distributors.</p><strong>Explore web systems →</strong></a>
          <a class="service-card" href="/en/ecommerce/"><span>02</span><h3>Digital commerce</h3><p>E-commerce architecture, product journeys, checkout improvement and measurement designed around real buying behaviour.</p><strong>Explore commerce →</strong></a>
          <a class="service-card" href="/en/search-visibility/"><span>03</span><h3>International visibility</h3><p>Technical SEO, GEO, AEO and AIO foundations that help companies become discoverable in search and AI-led research.</p><strong>Explore visibility →</strong></a>
          <a class="service-card" href="/en/ai-automation/"><span>04</span><h3>Sales automation</h3><p>CRM, enquiry routing, WhatsApp and AI-assisted workflows that reduce manual follow-up and protect valuable leads.</p><strong>Explore automation →</strong></a>
        </div>
      </div>
    </section>

    <section id="approach" class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Our approach</p>
          <h2>Market first. Technology second.</h2>
          <p>We define the commercial route before choosing platforms, integrations or automation.</p>
        </div>
        <div class="process-grid">
          <article><span>01</span><h3>Commercial audit</h3><p>We examine the current customer journey, website, sales channels and visible revenue leakage.</p></article>
          <article><span>02</span><h3>Market-specific offer</h3><p>We adapt positioning, content, proof and conversion paths to the audience you need to reach.</p></article>
          <article><span>03</span><h3>Build and measure</h3><p>We launch a focused system, track meaningful actions and improve it using real sales evidence.</p></article>
        </div>
      </div>
    </section>

    <section class="section qct-market-entry">
      <div class="container">
        <div class="qct-market-entry__card">
          <div class="section-heading">
            <p class="eyebrow">Country-specific entry</p>
            <h2>One international foundation. Focused market pages.</h2>
            <p>Georgia is our first dedicated market. New country pages are added only after research, demand validation and a clear route to commercial value.</p>
          </div>
          <div class="qct-market-entry__meta">
            <span>Current market</span>
            <strong>Georgia</strong>
            <p>For manufacturers, distributors, retailers and B2B service companies entering Türkiye, Europe and Gulf markets.</p>
            <a class="button button--primary" href="/en/georgia/">Open Georgia market page</a>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="section qct-home-contact">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Start with the market</p>
          <h2>Tell us where your company wants to grow.</h2>
          <p>We will review your current digital sales structure and identify the most practical first step.</p>
          <a class="button button--primary" href="mailto:info@qctcommerce.com?subject=International%20market%20review">Start the conversation</a>
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" lang="en" />
</BaseLayout>