---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const title = 'Digital Commerce & International Sales Systems | QCT Commerce';
const description = 'QCT Commerce builds digital sales systems, multilingual websites, e-commerce experiences and automation for companies in Türkiye and across markets.';
const alternates = [
  { lang: 'tr-TR', href: '/' },
  { lang: 'en', href: '/en/' },
];
const selectedWork = [
  { name: 'HEADWEAR', type: 'Multilingual e-commerce', image: '/images/work/headwear/headwear-web-deneyimi.webp', alt: 'HEADWEAR multilingual e-commerce website', href: '/en/work/headwear/' },
  { name: 'Misima Group', type: 'Corporate and B2B web system', image: '/images/work/misima/misima-web-deneyimi.webp', alt: 'Misima Group corporate website', href: '/en/work/misima/' },
  { name: 'Artman Group', type: 'Corporate service architecture', image: '/images/work/artman/artman-web-deneyimi.webp', alt: 'Artman Group corporate website', href: '/en/work/artman/' },
];
---
<BaseLayout title={title} description={description} lang="en" isHome={true} alternates={alternates} areaServed={['Türkiye', 'Georgia', 'Europe', 'Gulf countries']}>
  <Header slot="header" lang="en" />

  <div class="qct-international-home">
    <section class="hero section">
      <div class="container hero__inner">
        <div class="hero__content">
          <p class="eyebrow">Digital sales systems across markets</p>
          <h1>Build the digital sales system your business and next market need.</h1>
          <p class="hero__lead">QCT Commerce helps manufacturers, distributors and growing brands in Türkiye and across borders connect multilingual websites, e-commerce, search visibility and automation into one practical sales system.</p>
          <div class="hero__actions">
            <a class="button button--primary" href="/en/audit/">Start with an audit</a>
            <a class="button button--secondary" href="/en/work/">View selected work</a>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">What we build</p>
          <h2>Not another website. A connected sales system.</h2>
          <p>Each engagement starts with the commercial gap: weak product discovery, lost enquiries, poor market positioning or manual sales operations.</p>
        </div>
        <div class="service-grid qct-home-solutions">
          <a class="service-card" href="/en/web-design/"><span>01</span><h3>Multilingual B2B websites</h3><p>Clear market positioning, technical product presentation and conversion paths for buyers, partners and distributors.</p><strong>Explore web systems →</strong></a>
          <a class="service-card" href="/en/ecommerce/"><span>02</span><h3>Digital commerce</h3><p>E-commerce architecture, product journeys, checkout improvement and measurement designed around real buying behaviour.</p><strong>Explore commerce →</strong></a>
          <a class="service-card" href="/en/search-visibility/"><span>03</span><h3>Search and AI visibility</h3><p>Technical SEO, GEO, AEO and AIO foundations that help companies become discoverable in search and AI-led research.</p><strong>Explore visibility →</strong></a>
          <a class="service-card" href="/en/ai-automation/"><span>04</span><h3>Sales automation</h3><p>CRM, enquiry routing, WhatsApp and AI-assisted workflows that reduce manual follow-up and protect valuable leads.</p><strong>Explore automation →</strong></a>
        </div>
      </div>
    </section>

    <section id="approach" class="section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Our approach</p>
          <h2>Commercial need first. Technology second.</h2>
          <p>We define the buyer journey, market route and operational constraint before choosing platforms, integrations or automation.</p>
        </div>
        <div class="process-grid">
          <article><span>01</span><h3>Commercial audit</h3><p>We examine the current customer journey, website, sales channels and visible revenue leakage.</p></article>
          <article><span>02</span><h3>Focused sales structure</h3><p>We align positioning, content, proof and conversion paths with the buyers and markets the business needs to reach.</p></article>
          <article><span>03</span><h3>Build and measure</h3><p>We launch a focused system, track meaningful actions and improve it using observable sales evidence.</p></article>
        </div>
      </div>
    </section>

    <section class="section qct-home-work">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Selected work</p>
          <h2>Live systems, not speculative mock-ups.</h2>
          <p>Selected projects from the QCT Studio network across multilingual commerce, corporate B2B websites and service architecture.</p>
        </div>
        <div class="qct-home-work__grid">
          {selectedWork.map((item) => (
            <a class="qct-home-work__card" href={item.href}>
              <span class="qct-home-work__image"><img src={item.image} alt={item.alt} width="1600" height="1000" loading="lazy" decoding="async" /></span>
              <span class="qct-home-work__meta"><small>{item.type}</small><strong>{item.name}</strong><em>View project evidence <span aria-hidden="true">→</span></em></span>
            </a>
          ))}
        </div>
        <a class="qct-home-work__all" href="/en/work/">Explore selected work <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="section qct-market-entry">
      <div class="container">
        <div class="qct-market-entry__card">
          <div class="section-heading">
            <p class="eyebrow">Country-specific entry</p>
            <h2>One commercial foundation. Focused market routes.</h2>
            <p>Georgia is our first dedicated international market page. New country routes are added only after research, demand validation and a clear path to commercial value.</p>
          </div>
          <div class="qct-market-entry__meta">
            <span>Current international focus</span>
            <strong>Georgia</strong>
            <p>For manufacturers, distributors, retailers and B2B service companies connecting Georgia, Türkiye, Europe and Gulf markets.</p>
            <a class="button button--primary" href="/en/georgia/">Open Georgia market page</a>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="section qct-home-contact">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">Start with the constraint</p>
          <h2>Review the current sales system before deciding what to build.</h2>
          <p>The commercial digital audit identifies the buyer journey, market and operational constraints that should shape the project.</p>
          <a class="button button--primary qct-home-contact__button" href="/en/audit/">Request a commercial digital audit</a>
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .qct-home-work__grid { display: grid; gap: 18px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .qct-home-work__card { background: #fffaf5; border: 1px solid rgba(23,21,20,.1); border-radius: 24px; color: inherit; overflow: hidden; text-decoration: none; transition: transform .22s ease, box-shadow .22s ease; }
  .qct-home-work__card:hover, .qct-home-work__card:focus-visible { box-shadow: 0 24px 64px rgba(23,21,20,.11); transform: translateY(-4px); }
  .qct-home-work__image { aspect-ratio: 16 / 10; background: #171514; display: block; overflow: hidden; }
  .qct-home-work__image img { display: block; height: 100%; object-fit: cover; transition: transform .3s ease; width: 100%; }
  .qct-home-work__card:hover img, .qct-home-work__card:focus-visible img { transform: scale(1.025); }
  .qct-home-work__meta { display: flex; flex-direction: column; min-height: 190px; padding: 26px; }
  .qct-home-work__meta small { color: #b64137; font-size: .76rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .qct-home-work__meta strong { color: #171514; font-size: clamp(1.45rem, 2vw, 2rem); margin-top: 18px; }
  .qct-home-work__meta em, .qct-home-work__all { align-items: center; align-self: flex-start; background: transparent; border: 1px solid rgba(182,65,55,.42); border-radius: 2px; color: #b64137; display: inline-flex; font-size: .92rem; font-style: normal; font-weight: 750; gap: 8px; justify-content: center; min-height: 44px; padding: 9px 14px; text-decoration: none; transition: background-color .18s ease, border-color .18s ease, color .18s ease; }
  .qct-home-work__meta em { margin-top: auto; }
  .qct-home-work__all { margin-top: 30px; }
  .qct-home-work__meta em span, .qct-home-work__all span { display: inline-block; transition: transform .18s ease; }
  .qct-home-work__card:hover .qct-home-work__meta em, .qct-home-work__card:focus-visible .qct-home-work__meta em, .qct-home-work__all:hover { background: rgba(230,107,95,.08); border-color: #b64137; color: #171514; }
  .qct-home-work__card:active .qct-home-work__meta em, .qct-home-work__all:active { background: rgba(230,107,95,.16); border-color: #b64137; }
  .qct-home-work__card:focus-visible { outline: 2px solid #b64137; outline-offset: 3px; }
  .qct-home-work__all:focus-visible { border-color: #b64137; color: #171514; outline: 2px solid #b64137; outline-offset: 3px; }
  .qct-home-work__card:hover .qct-home-work__meta em span, .qct-home-work__card:focus-visible .qct-home-work__meta em span, .qct-home-work__all:hover span, .qct-home-work__all:focus-visible span { transform: translateX(3px); }
  @media (max-width: 960px) { .qct-home-work__grid { grid-template-columns: 1fr; } .qct-home-work__meta { min-height: 0; } }
  @media (prefers-reduced-motion: reduce) { .qct-home-work__meta em, .qct-home-work__all, .qct-home-work__meta em span, .qct-home-work__all span { transition: none; } .qct-home-work__card:hover .qct-home-work__meta em span, .qct-home-work__card:focus-visible .qct-home-work__meta em span, .qct-home-work__all:hover span, .qct-home-work__all:focus-visible span { transform: none; } }
</style>

<style is:global>
  html[lang="en"] :is(#approach, #contact) { scroll-margin-top: 84px; }
  html[lang="en"] .qct-home-contact__button {
    align-items: center;
    background: #e66b5f;
    border: 1px solid #e66b5f;
    border-radius: 999px;
    color: #fffaf5;
    display: inline-flex;
    font-weight: 850;
    justify-content: center;
    line-height: 1.2;
    margin-top: 24px;
    min-height: 48px;
    padding: 13px 22px;
    text-decoration: none;
    width: fit-content;
  }
  html[lang="en"] .qct-home-contact__button:hover,
  html[lang="en"] .qct-home-contact__button:focus-visible { background: #c9554b; border-color: #c9554b; transform: translateY(-2px); }
</style>

<script is:inline>
  (function () {
    var homeLink = document.querySelector('[data-en-home-link]');
    var sectionLinks = Array.prototype.slice.call(document.querySelectorAll('[data-en-section-link]'));
    if (!homeLink || !sectionLinks.length || window.location.pathname !== '/en/') return;

    var syncNavigationState = function () {
      var activeSection = window.location.hash.replace('#', '');
      homeLink.removeAttribute('aria-current');
      sectionLinks.forEach(function (link) {
        if (link.getAttribute('data-en-section-link') === activeSection) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
      if (activeSection !== 'approach' && activeSection !== 'contact') homeLink.setAttribute('aria-current', 'page');
    };

    sectionLinks.forEach(function (link) {
      link.addEventListener('click', function () {
        window.setTimeout(syncNavigationState, 0);
      });
    });
    homeLink.addEventListener('click', function () {
      homeLink.setAttribute('aria-current', 'page');
      sectionLinks.forEach(function (link) { link.removeAttribute('aria-current'); });
    });
    window.addEventListener('hashchange', syncNavigationState);
    window.addEventListener('popstate', syncNavigationState);
    syncNavigationState();
  })();
</script>
