---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Page Not Found — QCT Studio"
  description="The page you requested could not be found."
  lang="en"
  noindex={true}
  pageType="WebPage"
>
  <Header slot="header" lang="en" languagePath="/" />

  <section class="qct-error-page">
    <div class="container">
      <p class="qct-error-page__code">404</p>
      <h1>This page could not be found.</h1>
      <p>The address may have changed, or the page may no longer exist.</p>

      <div class="qct-error-page__actions">
        <a class="qct-button qct-button--primary" href="/">Return home</a>
        <a class="qct-button qct-button--secondary" href="/services/">View services</a>
        <a class="qct-button qct-button--secondary" href="/contact/">Contact QCT Studio</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang="en" />
</BaseLayout>

<style>
  .qct-error-page {
    min-height: 72vh;
    display: grid;
    place-items: center;
    padding: 10rem 0 6rem;
    text-align: center;
    background:
      radial-gradient(circle at 50% 30%, rgba(77, 46, 98, 0.12), transparent 42%),
      #f2efe8;
  }

  .qct-error-page__code {
    margin: 0 0 1rem;
    color: #e75757;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.22em;
  }

  .qct-error-page h1 {
    max-width: 780px;
    margin: 0 auto;
    color: #17151a;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .qct-error-page p:not(.qct-error-page__code) {
    max-width: 560px;
    margin: 1.5rem auto 0;
    color: #686268;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .qct-error-page__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>