---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Sayfa Bulunamadı — QCT Commerce"
  description="Aradığınız sayfa bulunamadı; ana sayfaya, hizmetlere veya iletişim sayfasına geçebilirsiniz."
  lang="tr"
  noindex={true}
  pageType="WebPage"
>
  <Header slot="header" lang="tr" />

  <section class="qct-error-page">
    <div class="container">
      <p class="qct-error-page__code">404</p>
      <h1>Aradığınız sayfa bulunamadı.</h1>
      <p>Adres değişmiş veya sayfa kaldırılmış olabilir.</p>

      <div class="qct-error-page__actions">
        <a class="qct-button qct-button--primary" href="/">Ana sayfaya dön</a>
        <a class="qct-button qct-button--secondary" href="/hizmetler/">Hizmetleri incele</a>
        <a class="qct-button qct-button--secondary" href="/iletisim/">İletişime geç</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" lang="tr" />
</BaseLayout>

<style>
  .qct-error-page {
    min-height: 72vh;
    display: grid;
    place-items: center;
    padding: 10rem 0 6rem;
    text-align: center;
    background:
      radial-gradient(circle at 50% 30%, rgba(230, 107, 95, 0.12), transparent 42%),
      #f2efe8;
  }

  .qct-error-page__code {
    margin: 0 0 1rem;
    color: #e66b5f;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.22em;
  }

  .qct-error-page h1 {
    max-width: 780px;
    margin: 0 auto;
    color: #17151a;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .qct-error-page p:not(.qct-error-page__code) {
    max-width: 560px;
    margin: 1.5rem auto 0;
    color: #686268;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .qct-error-page__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
