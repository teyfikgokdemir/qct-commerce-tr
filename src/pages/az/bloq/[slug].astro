---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import Header from '../../../components/Header.astro'; import Footer from '../../../components/Footer.astro'; import { azBlogPosts } from '../../../data/az-blog';
export function getStaticPaths(){return azBlogPosts.map(post=>({params:{slug:post.slug},props:{post}}));}
const { post }=Astro.props;
const SITE='https://qctcommerce.com';
const canonical=new URL('/az/bloq/'+post.slug+'/',SITE).toString();
const articleSchema={'@context':'https://schema.org','@type':'Article','@id':canonical+'#article',headline:post.title,description:post.description,datePublished:'2026-09-28',dateModified:'2026-09-28',inLanguage:'az-AZ',author:{'@id':SITE+'/#organization'},publisher:{'@id':SITE+'/#organization'},mainEntityOfPage:{'@id':canonical+'#webpage'}};
---
<BaseLayout title={post.title+' | QCT Commerce'} description={post.description} lang="az" type="article" breadcrumbLabel={post.title}><script slot="schema" type="application/ld+json" set:html={JSON.stringify(articleSchema)} /><Header slot="header" lang="az" /><article><section class="page-hero section"><div class="container"><p class="eyebrow">BLOQ · AZƏRBAYCAN</p><h1>{post.title}</h1><p class="page-hero__lead">{post.description}</p></div></section>{post.sections.map(([title,text])=><section class="section"><div class="container"><div class="section-heading"><h2>{title}</h2><p>{text}</p></div></div></section>)}</article><Footer slot="footer" lang="az" /></BaseLayout>