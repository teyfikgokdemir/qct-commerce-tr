---
import BaseLayout from '../../layouts/BaseLayout.astro';import Header from '../../components/Header.astro';import Footer from '../../components/Footer.astro';import {sectors} from '../../data/resources';
---
<BaseLayout title="Sektöre Özel Web Sitesi Çözümleri | QCT Commerce" description="Sektörün karar akışına ve müşteri ihtiyacına göre planlanan web sitesi çözümleri." lang="tr" breadcrumbLabel="Sektörler"><Header slot="header" lang="tr"/><main class="sectors container"><header><p>SEKTÖREL ÇÖZÜMLER</p><h1>İş modelinize göre çalışan dijital deneyimler</h1><div>Her sayfa, sektörün ihtiyaçları ve karar süreci için ayrı planlanır.</div></header><div class="sectors__grid">{sectors.map(([slug,title,description])=><a href={`/sektorler/${slug}/`}><h2>{title}</h2><p>{description}</p><b>İncele →</b></a>)}</div></main><Footer slot="footer" lang="tr"/></BaseLayout><style>.sectors{padding:calc(var(--qct-hero-clearance) + 64px) 20px 80px}.sectors header{text-align:center;margin:0 auto 50px;max-width:760px}.sectors header p{color:var(--qct-color-accent-strong);font-size:.75rem;font-weight:800;letter-spacing:.14em}.sectors h1,.sectors h2{color:var(--qct-color-ink);letter-spacing:-.05em}.sectors h1{font-size:clamp(2.4rem,5vw,4.3rem);line-height:1.02;margin:.5rem 0 1.2rem}.sectors header div,.sectors p{color:var(--qct-color-muted);line-height:1.65}.sectors__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.sectors__grid a{border:1px solid var(--qct-color-line-strong);padding:24px;color:inherit;text-decoration:none}.sectors__grid h2{font-size:1.5rem;margin:0}.sectors__grid b{display:block;margin-top:1.4rem}@media(max-width:600px){.sectors__grid{grid-template-columns:1fr}}</style>
