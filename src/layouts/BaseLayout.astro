---
import CookieConsent from '../components/CookieConsent.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const SITE_URL = 'https://qctcommerce.com';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  noindex?: boolean;
  isHome?: boolean;
  pageType?: string;
  breadcrumbLabel?: string;
  service?: { name: string; description: string };
  includeFounder?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
  includeWorkStyles?: boolean;
  includeServiceCardStyles?: boolean;
  alternates?: Array<{ lang: string; href: string }>;
  areaServed?: string[];
}

const {
  title,
  description,
  lang = 'tr',
  image = '/og-image-square.png',
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  noindex = false,
  isHome = false,
  pageType = 'WebPage',
  breadcrumbLabel,
  service,
  includeFounder = false,
  breadcrumbs,
  includeWorkStyles = false,
  includeServiceCardStyles = false,
  alternates: providedAlternates = [],
  areaServed,
} = Astro.props;

const parityRoutes: Record<string,string> = {"/":"/en/","/en/":"/","/hakkimizda/":"/en/about/","/en/about/":"/hakkimizda/","/hizmetler/":"/en/services/","/en/services/":"/hizmetler/","/calismalar/":"/en/work/","/en/work/":"/calismalar/","/calismalar/headwear/":"/en/work/headwear/","/en/work/headwear/":"/calismalar/headwear/","/calismalar/misima/":"/en/work/misima/","/en/work/misima/":"/calismalar/misima/","/calismalar/artman/":"/en/work/artman/","/en/work/artman/":"/calismalar/artman/","/iletisim/":"/en/contact/","/en/contact/":"/iletisim/","/fiyatlar/":"/en/pricing/","/en/pricing/":"/fiyatlar/","/e-ticaret/":"/en/ecommerce/","/en/ecommerce/":"/e-ticaret/","/web-tasarim/":"/en/web-design/","/en/web-design/":"/web-tasarim/","/whatsapp-satis/":"/en/whatsapp-sales/","/en/whatsapp-sales/":"/whatsapp-satis/","/seo-geo/":"/en/search-visibility/","/en/search-visibility/":"/seo-geo/","/meta-reklamlari/":"/en/meta-ads/","/en/meta-ads/":"/meta-reklamlari/","/yapay-zeka-otomasyonlari/":"/en/ai-automation/","/en/ai-automation/":"/yapay-zeka-otomasyonlari/","/shopify-magaza-kurulumu/":"/en/shopify-store-setup/","/en/shopify-store-setup/":"/shopify-magaza-kurulumu/","/ikas-magaza-kurulumu/":"/en/ikas-store-setup/","/en/ikas-store-setup/":"/ikas-magaza-kurulumu/","/blog/":"/en/blog/","/en/blog/":"/blog/","/blog/ikas-fiyatlari-2026-kurulum-tema-seo-maliyetleri/":"/en/blog/ikas-pricing-2026-setup-theme-seo-costs/","/en/blog/ikas-pricing-2026-setup-theme-seo-costs/":"/blog/ikas-fiyatlari-2026-kurulum-tema-seo-maliyetleri/","/blog/web-sitem-google-da-neden-cikmiyor/":"/en/blog/why-is-my-website-not-showing-on-google/","/en/blog/why-is-my-website-not-showing-on-google/":"/blog/web-sitem-google-da-neden-cikmiyor/","/blog/chatgpt-de-firmam-nasil-gorunur/":"/en/blog/how-can-my-company-appear-in-chatgpt/","/en/blog/how-can-my-company-appear-in-chatgpt/":"/blog/chatgpt-de-firmam-nasil-gorunur/","/blog/web-sitesi-yaptirma-fiyatlari-2026/":"/en/blog/website-pricing-2026-what-changes-the-cost/","/en/blog/website-pricing-2026-what-changes-the-cost/":"/blog/web-sitesi-yaptirma-fiyatlari-2026/","/blog/ikas-mi-shopify-mi-2026/":"/en/blog/ikas-vs-shopify-2026-turkiye/","/en/blog/ikas-vs-shopify-2026-turkiye/":"/blog/ikas-mi-shopify-mi-2026/","/blog/mobil-e-ticaret-sitesi-neden-satis-yapmiyor/":"/en/blog/why-mobile-ecommerce-sites-do-not-convert/","/en/blog/why-mobile-ecommerce-sites-do-not-convert/":"/blog/mobil-e-ticaret-sitesi-neden-satis-yapmiyor/","/blog/shopify-magaza-kurma-rehberi/":"/en/blog/shopify-store-setup-guide-turkiye/","/en/blog/shopify-store-setup-guide-turkiye/":"/blog/shopify-magaza-kurma-rehberi/","/blog/e-ticarette-yapilan-hatalar/":"/en/blog/common-ecommerce-mistakes/","/en/blog/common-ecommerce-mistakes/":"/blog/e-ticarette-yapilan-hatalar/","/blog/pazaryerinden-kendi-sitene-gecis/":"/en/blog/move-from-marketplaces-to-your-own-store/","/en/blog/move-from-marketplaces-to-your-own-store/":"/blog/pazaryerinden-kendi-sitene-gecis/","/blog/ai-overviews-geo-aio-seo-rehberi/":"/en/blog/ai-overviews-geo-aeo-aio-seo-guide/","/en/blog/ai-overviews-geo-aeo-aio-seo-guide/":"/blog/ai-overviews-geo-aio-seo-rehberi/","/blog/yapay-zeka-ile-urun-aciklamasi-hazirlama/":"/en/blog/ai-product-descriptions-for-seo-and-sales/","/en/blog/ai-product-descriptions-for-seo-and-sales/":"/blog/yapay-zeka-ile-urun-aciklamasi-hazirlama/","/blog/whatsapp-satis-otomasyonu-rehberi/":"/en/blog/whatsapp-sales-automation-guide/","/en/blog/whatsapp-sales-automation-guide/":"/blog/whatsapp-satis-otomasyonu-rehberi/","/kariyer/":"/en/careers/","/en/careers/":"/kariyer/","/gizlilik-politikasi/":"/en/privacy-policy/","/en/privacy-policy/":"/gizlilik-politikasi/","/kvkk/":"/en/kvkk/","/en/kvkk/":"/kvkk/","/kullanim-kosullari/":"/en/terms/","/en/terms/":"/kullanim-kosullari/","/cerez-politikasi/":"/en/cookie-policy/","/en/cookie-policy/":"/cerez-politikasi/"};
const currentPath = Astro.url.pathname;
const pairedPath = parityRoutes[currentPath];
const alternates = providedAlternates.length ? providedAlternates : pairedPath ? (currentPath.startsWith('/en/') ? [{ lang: 'tr-TR', href: pairedPath }, { lang: 'en', href: currentPath }] : [{ lang: 'tr-TR', href: currentPath }, { lang: 'en', href: pairedPath }]) : [];
const isEnglish = lang === 'en';
const isGeorgian = lang === 'ka';
const isInternational = isEnglish || isGeorgian;
const locale = isGeorgian ? 'ka_GE' : isEnglish ? 'en_US' : 'tr_TR';
const languageTag = isGeorgian ? 'ka-GE' : isEnglish ? 'en-US' : 'tr-TR';
const defaultDescription = isGeorgian
  ? 'QCT Commerce ქმნის მრავალენოვან B2B ვებსაიტებს, ციფრული გაყიდვებისა და ავტომატიზაციის სისტემებს საერთაშორისო ზრდისთვის.'
  : isEnglish
    ? 'QCT Commerce provides website, e-commerce, search visibility and AI-supported digital services for English-speaking businesses and founders operating in Türkiye.'
    : 'QCT Commerce, Türkiye’de işletmeler için e-ticaret altyapıları ve ölçülebilir dijital büyüme sistemleri kurar.';
const pageDescription = description ?? defaultDescription;
const servedMarkets = areaServed ?? (isGeorgian ? ['Georgia', 'Türkiye', 'Europe', 'Gulf countries'] : ['Türkiye']);
const areaServedSchema = servedMarkets.map((name) => ({ '@type': 'Country', name }));
const isIndexable = !noindex;
const ogImageType = image.toLowerCase().endsWith('.png') ? 'image/png' : image.toLowerCase().endsWith('.webp') ? 'image/webp' : 'image/jpeg';
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageUrl = new URL(image, SITE_URL).toString();
const homePath = isGeorgian ? '/ka/georgia/' : isEnglish ? '/en/' : '/';
const homeUrl = new URL(homePath, SITE_URL).toString();
const xDefaultHref = alternates.find((alternate) => alternate.lang === 'en' || alternate.lang === 'en-US')?.href ?? '/en/';
const organizationId = `${SITE_URL}/#organization`;
const founderId = `${SITE_URL}/hakkimizda/#teyfik-gokdemir`;
const websiteId = `${SITE_URL}/${isGeorgian ? 'ka/' : isEnglish ? 'en/' : ''}#website`;
const webpageId = `${canonicalUrl}#webpage`;
const knowsAbout = ['E-commerce architecture','Web design and website improvement','Digital sales systems','Multilingual websites','Conversion optimization','Technical SEO','Generative engine optimization','Answer engine optimization','AI visibility optimization','CRM integration','AI sales automation'];

const organizationSchema = {
  '@type': 'Organization', '@id': organizationId, name: 'QCT Commerce', url: SITE_URL,
  logo: { '@type': 'ImageObject', '@id': `${organizationId}/logo`, url: new URL('/logo.png', SITE_URL).toString(), contentUrl: new URL('/logo.png', SITE_URL).toString(), width: 600, height: 180, caption: 'QCT Commerce' },
  image: { '@type': 'ImageObject', url: ogImageUrl, width: imageWidth, height: imageHeight },
  description: isGeorgian ? 'ციფრული კომერციისა და საერთაშორისო გაყიდვების სისტემები მზარდი კომპანიებისთვის.' : isEnglish ? 'Website, e-commerce, search visibility and AI-supported digital services for English-speaking businesses and founders operating in Türkiye.' : 'QCT Commerce, Türkiye’de e-ticaret ve ölçülebilir dijital büyüme sistemleri kurar.',
  areaServed: areaServedSchema,
  knowsAbout,
  email: 'info@qctcommerce.com',
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'sales', email: 'info@qctcommerce.com', areaServed: servedMarkets, availableLanguage: ['Turkish', 'English', 'Georgian'] }],
  hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Digital commerce and international sales solutions', itemListElement: knowsAbout.map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })) },
  ...(includeFounder ? { founder: { '@id': founderId } } : {}),
};

const founderSchema = includeFounder ? {
  '@type': 'Person', '@id': founderId, name: 'Teyfik Gökdemir', jobTitle: isEnglish ? 'Founder of QCT Commerce' : 'QCT Commerce Kurucusu', worksFor: { '@id': organizationId },
  image: new URL('/images/teyfik-gokdemir-qct-commerce.webp', SITE_URL).toString(),
  sameAs: ['https://teyfikgokdemir.com/', 'https://www.linkedin.com/in/teyfik-g%C3%B6kdemir-0b1a9758'],
  knowsLanguage: ['Türkçe', 'İngilizce'],
  knowsAbout,
} : null;

const websiteSchema = { '@type': 'WebSite', '@id': websiteId, url: homeUrl, name: 'QCT Commerce', description: organizationSchema.description, inLanguage: languageTag, publisher: { '@id': organizationId } };
const webpageSchema: Record<string, unknown> = { '@type': pageType, '@id': webpageId, url: canonicalUrl, name: title, description: pageDescription, inLanguage: languageTag, isPartOf: { '@id': websiteId }, about: { '@id': organizationId }, primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl, width: imageWidth, height: imageHeight } };
let breadcrumbSchema: Record<string, unknown> | null = null;
if (breadcrumbs?.length) {
  const breadcrumbId = `${canonicalUrl}#breadcrumb`;
  breadcrumbSchema = { '@type': 'BreadcrumbList', '@id': breadcrumbId, itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.url, SITE_URL).toString() })) };
  webpageSchema.breadcrumb = { '@id': breadcrumbId };
} else if (breadcrumbLabel) {
  const breadcrumbId = `${canonicalUrl}#breadcrumb`;
  const homeLabel = isGeorgian ? 'მთავარი' : isEnglish ? 'Home' : 'Ana sayfa';
  breadcrumbSchema = { '@type': 'BreadcrumbList', '@id': breadcrumbId, itemListElement: [{ '@type': 'ListItem', position: 1, name: homeLabel, item: homeUrl }, { '@type': 'ListItem', position: 2, name: breadcrumbLabel, item: canonicalUrl }] };
  webpageSchema.breadcrumb = { '@id': breadcrumbId };
}
let serviceSchema: Record<string, unknown> | null = null;
if (service) {
  const serviceId = `${canonicalUrl}#service`;
  serviceSchema = { '@type': 'Service', '@id': serviceId, url: canonicalUrl, name: service.name, description: service.description, serviceType: service.name, provider: { '@id': organizationId }, areaServed: areaServedSchema, mainEntityOfPage: { '@id': webpageId } };
  webpageSchema.mainEntity = { '@id': serviceId };
}
const graphSchema = { '@context': 'https://schema.org', '@graph': [organizationSchema, websiteSchema, webpageSchema, breadcrumbSchema, serviceSchema, founderSchema].filter(Boolean) };
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={pageDescription} />
  {isIndexable ? <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" /> : <meta name="robots" content="noindex, follow" />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260720-1" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="describedby" href="/llms.txt" type="text/markdown" />
  {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.href, SITE_URL).toString()} />)}
  {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(xDefaultHref, SITE_URL).toString()} />}
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="QCT Commerce" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:secure_url" content={ogImageUrl} />
  <meta property="og:image:type" content={ogImageType} />
  <meta property="og:image:width" content={String(imageWidth)} />
  <meta property="og:image:height" content={String(imageHeight)} />
  <meta property="og:image:alt" content="QCT Commerce — E-ticaret ve dijital ticaret sistemleri" />
  <meta property="og:locale" content={locale} />
  {alternates.filter((alternate) => alternate.lang !== languageTag && alternate.lang !== lang).map((alternate) => <meta property="og:locale:alternate" content={alternate.lang.replace('-', '_')} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={pageDescription} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content="QCT Commerce — E-ticaret ve dijital ticaret sistemleri" />
  <script type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
  <slot name="schema" />
  <link rel="stylesheet" href="/styles/base.css?v=20260718-3" />
  <link rel="stylesheet" href="/styles/components.css?v=20260718-3" />
  {isHome ? <><link rel="stylesheet" href="/styles/home.css?v=20260718-3" /><link rel="preload" as="style" href="/styles/animations.css?v=20260718-3" onload="this.onload=null;this.rel='stylesheet'" /><noscript><link rel="stylesheet" href="/styles/animations.css?v=20260718-3" /></noscript></> : <link rel="stylesheet" href="/styles/pages.css?v=20260718-3" />}
  <link rel="stylesheet" href="/styles/utilities.css?v=20260718-3" />
  <link rel="stylesheet" href="/styles/brand.css?v=20260719-1" />
  <link rel="stylesheet" href="/styles/buttons.css?v=20260721-1" />
  {includeServiceCardStyles && <link rel="stylesheet" href="/styles/service-cards-isolated.css?v=20260720-1" />}
  {isInternational && <link rel="stylesheet" href="/styles/international.css?v=20260720-6" />}
  {includeWorkStyles && <><link rel="stylesheet" href="/styles/work.css?v=20260721-3" /><link rel="stylesheet" href="/styles/case-study-overrides.css?v=20260721-2" /></>}
</head>
<body>
  <div id="page" class="site">
    <a class="skip-link screen-reader-text" href="#primary">{isGeorgian ? 'შინაარსზე გადასვლა' : isEnglish ? 'Skip to content' : 'İçeriğe geç'}</a>
    <slot name="header" />
    <main id="primary" class="site-main"><slot /></main>
    <slot name="footer" />
  </div>
  <CookieConsent lang={lang} />
  <WhatsAppButton lang={lang} />
  <script src="/scripts/main.js?v=20260718-3" is:inline></script>
  {isHome && <script src="/scripts/animations.js?v=20260718-3" is:inline></script>}
  <script src="https://teyfikgokdemir.com/cansu-source-beacon.js" data-site="qct-commerce-tr" is:inline></script>
</body>
</html>